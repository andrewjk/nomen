import System
import System/Controls

const WIN_W = 400
const WIN_H = 500
const MAX_TODOS = 6

pub func main = () {
	const win = Window("Nomen Todo", WIN_W, WIN_H)

	var title = Text(win)
	title.set_text("Todo List")

	const cb0 = CheckBox(win)
	const cb1 = CheckBox(win)
	const cb2 = CheckBox(win)
	const cb3 = CheckBox(win)
	const cb4 = CheckBox(win)
	const cb5 = CheckBox(win)

	cb0.set_title("Learn Nomen")
	cb1.set_title("Build a GUI app")
	cb2.set_title("Ship it")
	cb3.set_hidden(true)
	cb4.set_hidden(true)
	cb5.set_hidden(true)

	var todo_count = 3

	const input = TextBox(win)
	input.set_text("Type a new todo...")
	const add_btn = Button(win, "Add")

	// A two-column grid. The title and each checkbox span both columns (full
	// width); the input and Add button share the final row.
	var Container grid = Grid(2, 8)
	grid.padding = 16
	grid.add(title.handle, 0, 30, 2)
	grid.add(cb0.handle, 0, 24, 2)
	grid.add(cb1.handle, 0, 24, 2)
	grid.add(cb2.handle, 0, 24, 2)
	grid.add(cb3.handle, 0, 24, 2)
	grid.add(cb4.handle, 0, 24, 2)
	grid.add(cb5.handle, 0, 24, 2)
	grid.add(input.handle, 0, 24, 1)
	grid.add(add_btn.handle, 0, 32, 1)
	grid.layout(win)
	grid.set_resize_callback(win)

	win.show()

	// Re-layout live while the window is resized. Native controls keep their
	// absolute frames (AppKit pins them to the bottom-left origin), so without
	// this they appear anchored to the bottom as the window grows. Re-running
	// layout on every content-size change re-flips y against the new height
	// (anchoring the grid to the top) and updates intermediate sizes during
	// the drag instead of only when it ends.
	var int prev_w = win.content_width()
	var int prev_h = win.content_height()

	while win.is_visible() {
		const int had_click = Window.process_events()

		const int cur_w = win.content_width()
		const int cur_h = win.content_height()
		if cur_w != prev_w || cur_h != prev_h {
			prev_w = cur_w
			prev_h = cur_h
			grid.layout(win)
		}

		if had_click == 1 {
			// Re-layout on any click (checkbox toggle or otherwise). Hidden
			// controls are skipped by the grid automatically. The window size
			// is unchanged, so mark the tree dirty to pick up any content or
			// visibility change before measuring.
			grid.mark_dirty(grid.root_index())
			grid.layout(win)

			// Hit-test the Add button.
			const int cx = win.click_x()
			const int cy = win.click_y()
			if grid.contains(add_btn.handle, cx, cy) {
				if todo_count < MAX_TODOS {
					const string new_text = input.get_text()
					if todo_count == 3 {
						cb3.set_title(new_text)
						cb3.set_hidden(false)
					}
					if todo_count == 4 {
						cb4.set_title(new_text)
						cb4.set_hidden(false)
					}
					if todo_count == 5 {
						cb5.set_title(new_text)
						cb5.set_hidden(false)
					}
					todo_count += 1
					input.set_text("")
					grid.mark_dirty(grid.root_index())
					grid.layout(win)
				}
			}
		}
	}
}
