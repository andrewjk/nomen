import System
import System::Controls

const WIN_W = 400
const WIN_H = 500

// Creates a checkbox for `text`, lays it out as a full-width row in the todo
// stack (so it lands ABOVE the input row), and moves the control into
// `todos` (its grid handle into `handles`). Used for the starter todos in
// the app's #init — where everything is still a local (see GUI.md, "The App
// run loop": composite `ref` wiring on fields would alias `self`).
func add_todo = (
	ref Container todos,
	Window content,
	ref List<CheckBox> owned,
	ref List<uint64> handles,
	string text
) {
	// Created against the DOCUMENT VIEW (`content`), not the window: the
	// checkboxes must live inside the scroll view, and the todo stack lays
	// them out in document coordinates.
	const cb = CheckBox(content)
	cb.set_title(text)
	todos.add(cb.handle, 0, 24, 1)
	handles.push(cb.handle)
	owned.push(mv cb)
}

// A todo app as an App (the Window.run contract): the framework owns the
// pump, the pool, resize detection, and the relayout of the registered root
// (the window grid) and document (the todo stack). The app handles clicks
// and re-dances the stack when a todo is added or removed.
mv struct TodoApp : App {
	var Text title
	var Scrollable scroll
	var Window doc
	var Container todos
	var List<CheckBox> owned
	var List<uint64> handles
	var TextBox input
	var Button add_btn
	var Container grid

	pub func #init = (self, Window window) {
		var Text title = Text(window)
		title.set_text("Todo List")

		// The todo list lives on a Scrollable's document view: however many
		// todos are added, the input row below stays reachable, and the list
		// scrolls.
		var Scrollable scroll = Scrollable(window)
		var Window content = scroll.content_window()
		var Container todos = VStack(8)
		// Owned checkboxes, index-aligned with `handles` (the grid handles
		// for hit-testing). Reading a CheckBox out of the list would
		// materialize an owning copy whose scope-exit destroy releases the
		// live view — so hit-tests go through these plain ints, and the
		// checkboxes themselves are only ever touched by ownership transfer
		// (push / remove).
		var List<CheckBox> owned = List<CheckBox>()
		var List<uint64> handles = List<uint64>()

		var TextBox input = TextBox(window)
		input.set_placeholder("Type a new todo...")
		var Button add_btn = Button(window, "Add")

		// A vertical root: title, the scrollable list (which GROWS to fill
		// the leftover height), then the input row pinned at the bottom.
		var Container grid = VStack(8)
		grid.padding = 16
		grid.add(title.handle, 0, 30, 1)
		grid.add(scroll.handle, 0, 0, 1, 1)
		var int input_row = grid.add_hstack(grid.root_index(), 8, 1)
		grid.add_to(input_row, input.handle, 0, 24, 1, 1)
		grid.add_to_intrinsic(input_row, add_btn.handle, 1)

		add_todo(ref todos, content, ref owned, ref handles, "Learn Nomen")
		add_todo(ref todos, content, ref owned, ref handles, "Build a GUI app")
		add_todo(ref todos, content, ref owned, ref handles, "Ship it")

		// Move everything into the app's fields.
		self.title = title
		self.scroll = scroll
		self.doc = content
		self.todos = todos
		self.owned = owned
		self.handles = handles
		self.input = input
		self.add_btn = add_btn
		self.grid = grid
	}

	// App.start: register the layout roots. The framework lays the root out
	// on start/show/resize and re-runs the todo stack's document dance
	// (measure unbounded → set_content_size → layout), with the one-time
	// scroll_to_top on the first post-show pass. The registration goes
	// grid-side with scalar handles — one borrow of self per call (two
	// `ref` borrows under one owner would trip the aliasing rule).
	pub func start = (ref self, ref Window win) {
		win.set_content(ref self.grid)
		self.todos.set_document(self.scroll.handle, self.scroll.doc_handle())
	}

	// Add a todo at runtime (fields — every statement borrows `self` once).
	func add_item = (ref self, string text) {
		var CheckBox cb = CheckBox(self.doc)
		cb.set_title(text)
		self.todos.add(cb.handle, 0, 24, 1)
		self.handles.push(cb.handle)
		self.owned.push(mv cb)
	}

	// Re-run the document dance: the framework dances on RESIZE only; an
	// add or delete changes the stack height right now. One `ref` borrow
	// (the todos grid) + scalar handles, so no aliasing.
	func redance = (ref self, ref Window win) {
		nomen_scroll_thunk(ref self.todos, self.scroll.handle, self.scroll.doc_handle(), ref win, 0)
	}

	// App.frame — the old event-loop body.
	pub func frame = (ref self, ref Window win, FrameEvents ev) {
		// Native click event: the Add button arms a shared target/action at
		// construction — was_clicked drains the edge. No coordinates, no
		// hit-testing.
		if self.add_btn.was_clicked() {
			var string new_text = self.input.get_text()
			if new_text != "" {
				self.add_item(new_text)
				self.input.set_text("")
				self.redance(ref win)
				self.scroll.scroll_to_bottom()
			}
		}

		// Right-click deletes a todo. The click arrives in WINDOW
		// coordinates while the todos live in the document view, so
		// translate through the scrollable first — the visible top of the
		// document moves with the scroll position. The grid node is removed
		// first — a freed handle left in the tree would still be measured
		// and re-framed — then the control itself is freed by moving it out
		// of the list into a nested block: its #destroy runs at the block's
		// closing brace, removing the view and releasing it.
		if ev.click == 2 {
			var [tx, ty] = content_click(self.scroll, ev.click_x, ev.click_y)
			var int found = -1
			var uint64 found_handle = 0
			var i = 0
			while i < self.handles.length; i += 1 {
				const uint64 h = self.handles.at(i)
				// ±4px vertical slop: rows are 24px tall with 8px gaps, so a
				// click landing in a gap still resolves to the nearest row.
				// The expanded bands tile the stack exactly (row i claims up
				// to its bottom + 4, the next row claims from its top - 4),
				// so no point matches two rows.
				if self.todos.contains(h, tx, ty) || self.todos.contains(h, tx, ty - 4) || self.todos.contains(h, tx, ty + 4) {
					found = i
					found_handle = h
				}
			}
			if found != -1 {
				self.todos.remove_leaf(found_handle)
				{
					var CheckBox _dead = self.owned.remove_at_or_panic(found)
				}
				var uint64 _gone = self.handles.remove_at_or_panic(found)
				self.redance(ref win)
			}
		}
	}
}

pub func main = () {
	var Window win = Window("Nomen Todo", WIN_W, WIN_H)
	var TodoApp app = TodoApp(win)
	win.run(mv app)
}
