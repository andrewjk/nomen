import System
import System::Controls

const WIN_W = 400
const WIN_H = 500

// Creates a checkbox for `text`, lays it out as a full-width row in the todo
// stack (so it lands ABOVE the input row), and moves the control into
// `todos` (its grid handle into `handles`). Called for the starter todos at
// startup and again on every Add — the todo count is unbounded, and each
// todo owns the control it created (freed on delete, or at exit, by
// #destroy).
func add_todo = (
	ref Container todos,
	Window content,
	ref List<CheckBox> owned,
	ref List<uint64> handles,
	string text
) {
	// Created against the DOCUMENT VIEW (`content`), not the window: the
	// checkboxes must live inside the scroll view, and the todo stack lays
	// them out in document coordinates.
	const cb = CheckBox(content)
	cb.set_title(text)
	todos.add(cb.handle, 0, 24, 1)
	handles.push(cb.handle)
	owned.push(mv cb)
}

// The scrolling list's layout: frame the outer grid (which sizes the scroll
// viewport), then measure the todo stack unbounded, size the document view
// to it, and lay the stack out into that height — the pair the Scrollable
// design note (GUI.md) prescribes. `scroll_to_bottom` keeps the newest todo
// in view.
func layout_todos = (
	ref Container grid,
	Window win,
	ref Scrollable scroll,
	ref Container todos,
	Window content
) {
	grid.layout(win)
	var BoxConstraints bc = BoxConstraints()
	bc.max_width = win.content_width() - 32 // the root grid's 16px padding, both sides
	const Size cs = todos.measure(bc)
	scroll.set_content_size(cs.width, cs.height)
	todos.layout(content)
}

pub func main = () {
	const win = Window("Nomen Todo", WIN_W, WIN_H)

	var title = Text(win)
	title.set_text("Todo List")

	// The todo list lives on a Scrollable's document view: however many todos
	// are added, the input row below stays reachable, and the list scrolls.
	var scroll = Scrollable(win)
	const content = scroll.content_window()
	var todos = VStack(8)
	// Owned checkboxes, index-aligned with `handles` (the grid handles for
	// hit-testing). Reading a CheckBox out of the list would materialize an
	// owning copy whose scope-exit destroy releases the live view — so
	// hit-tests go through these plain ints, and the checkboxes themselves
	// are only ever touched by ownership transfer (push / remove).
	var owned = List<CheckBox>()
	var handles = List<uint64>()

	const input = TextBox(win)
	input.set_placeholder("Type a new todo...")
	const add_btn = Button(win, "Add")

	// A vertical root: title, the scrollable list (which GROWS to fill the
	// leftover height), then the input row pinned at the bottom.
	var Container grid = VStack(8)
	grid.padding = 16
	grid.add(title.handle, 0, 30, 1)
	grid.add(scroll.handle, 0, 0, 1, 1)
	const int input_row = grid.add_hstack(grid.root_index(), 8, 1)
	grid.add_to(input_row, input.handle, 0, 24, 1, 1)
	grid.add_to_intrinsic(input_row, add_btn.handle, 1)

	add_todo(ref todos, content, ref owned, ref handles, "Learn Nomen")
	add_todo(ref todos, content, ref owned, ref handles, "Build a GUI app")
	add_todo(ref todos, content, ref owned, ref handles, "Ship it")
	grid.set_resize_callback(win)

	win.show()
	// Lay out AFTER the window is up: the first layout must see the window's
	// final content size (a title bar shrinks it), or AppKit's autoresizing
	// masks shift controls at show time.
	layout_todos(ref grid, win, ref scroll, ref todos, content)
	scroll.scroll_to_top()

	// Re-layout live while the window is resized: native controls keep their
	// absolute frames (AppKit pins them to the bottom-left origin), so without
	// this they appear anchored to the bottom as the window grows. Re-running
	// layout on every content-size change re-flips y against the new height
	// (anchoring the grid to the top) and updates intermediate sizes during
	// the drag instead of only when it ends. The todo stack re-flows too — its
	// width follows the scrollable.
	var int prev_w = win.content_width()
	var int prev_h = win.content_height()

	while win.is_visible() {
		const int had_click = Window.process_events()

		const int cur_w = win.content_width()
		const int cur_h = win.content_height()
		if cur_w != prev_w || cur_h != prev_h {
			prev_w = cur_w
			prev_h = cur_h
			layout_todos(ref grid, win, ref scroll, ref todos, content)
		}

		if had_click == 1 {
			// Hit-test the Add button (outside the scroll view, so its click
			// coordinates are already the root grid's).
			const int cx = win.click_x()
			const int cy = win.click_y()
			if grid.contains(add_btn.handle, cx, cy) {
				const string new_text = input.get_text()
				if new_text != "" {
					add_todo(ref todos, content, ref owned, ref handles, new_text)
					input.set_text("")
					layout_todos(ref grid, win, ref scroll, ref todos, content)
					scroll.scroll_to_bottom()
				}
			}
		}

		// Right-click deletes a todo. The click arrives in WINDOW coordinates
		// while the todos live in the document view, so translate through the
		// scrollable first — the visible top of the document moves with the
		// scroll position. The grid node is removed first — a freed handle
		// left in the tree would still be measured and re-framed — then the
		// control itself is freed by moving it out of the list into a nested
		// block: its #destroy runs at the block's closing brace, removing the
		// view and releasing it.
		if had_click == 2 {
			const int cx = win.click_x()
			const int cy = win.click_y()
			const [tx, ty] = content_click(scroll, cx, cy)
			var int found = -1
			var uint64 found_handle = 0
			var i = 0
			while i < handles.length; i += 1 {
				const uint64 h = handles.at(i)
				// ±4px vertical slop: rows are 24px tall with 8px gaps, so a
				// click landing in a gap still resolves to the nearest row.
				// The expanded bands tile the stack exactly (row i claims up
				// to its bottom + 4, the next row claims from its top - 4),
				// so no point matches two rows.
				if todos.contains(h, tx, ty) || todos.contains(h, tx, ty - 4) || todos.contains(h, tx, ty + 4) {
					found = i
					found_handle = h
				}
			}
			if found != -1 {
				todos.remove_leaf(found_handle)
				{
					var CheckBox _dead = owned.remove_at_or_panic(found)
				}
				var uint64 _gone = handles.remove_at_or_panic(found)
				layout_todos(ref grid, win, ref scroll, ref todos, content)
			}
		}
	}
}
