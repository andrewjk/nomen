{
	"scopeName": "source.nm",
	"name": "Nomen",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#raw-block" },
		{ "include": "#strings" },
		{ "include": "#chars" },
		{ "include": "#annotations" },
		{ "include": "#function-decl" },
		{ "include": "#lifecycle-decl" },
		{ "include": "#constants" },
		{ "include": "#keywords" },
		{ "include": "#numbers" },
		{ "include": "#types" },
		{ "include": "#function-call" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.nm",
					"match": "//.*"
				},
				{ "include": "#block-comment" }
			]
		},
		"block-comment": {
			"name": "comment.block.nm",
			"begin": "/\\*",
			"end": "\\*/",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.comment.nm" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.comment.nm" }
			},
			"patterns": [{ "include": "#block-comment" }]
		},
		"raw-block": {
			"name": "string.other.nm",
			"contentName": "meta.embedded.block.c.nm",
			"begin": "```",
			"end": "```",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.raw.nm" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.raw.nm" }
			},
			"patterns": [{ "include": "source.c" }]
		},
		"strings": {
			"patterns": [{ "include": "#multiline-string" }, { "include": "#string-double" }]
		},
		"string-double": {
			"name": "string.quoted.double.nm",
			"begin": "\"",
			"end": "\"",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.nm" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.nm" }
			},
			"patterns": [
				{ "include": "#string-interpolation" },
				{
					"name": "constant.character.escape.nm",
					"match": "\\\\."
				}
			]
		},
		"multiline-string": {
			"name": "string.quoted.double.nm",
			"begin": "(?m)\"(?=[^\"\\n]*$)",
			"end": "(?m)^(?![ \\t]*\")",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.nm" }
			},
			"patterns": [
				{ "include": "#string-interpolation" },
				{
					"name": "constant.character.escape.nm",
					"match": "\\\\."
				}
			]
		},
		"string-interpolation": {
			"name": "meta.interpolation.nm",
			"begin": "\\\\\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": { "name": "punctuation.section.interpolation.begin.nm" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.section.interpolation.end.nm" }
			},
			"patterns": [{ "include": "$self" }]
		},
		"chars": {
			"name": "string.quoted.single.nm",
			"match": "'(?:\\\\.|[^'\\\\])'"
		},
		"annotations": {
			"name": "meta.annotation.nm",
			"match": "@[A-Za-z_][A-Za-z0-9_]*",
			"captures": {
				"0": { "name": "variable.annotation.nm" }
			}
		},
		"function-decl": {
			"patterns": [
				{
					"match": "\\b(func)\\s+(#(?:init|destroy|op_\\w+))\\b",
					"captures": {
						"1": { "name": "storage.type.function.nm" },
						"2": { "name": "entity.name.function.nm" }
					}
				},
				{
					"match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.function.nm" },
						"2": { "name": "entity.name.function.nm" }
					}
				}
			]
		},
		"lifecycle-decl": {
			"match": "(#(?:init|destroy))\\s*=",
			"captures": {
				"1": { "name": "entity.name.function.nm" }
			}
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.nm",
					"match": "\\b(?:if|else|while|for|of|in|break|continue|return|switch|case|match)\\b"
				},
				{
					"name": "storage.type.nm",
					"match": "\\b(?:func|struct|class|trait|enum|bitset)\\b"
				},
				{
					"name": "keyword.other.nm",
					"match": "\\b(?:var|const|let|mov|cp|view|import|panic|todo)\\b"
				},
				{
					"name": "storage.modifier.nm",
					"match": "\\b(?:pub|private|inline|out|ref)\\b"
				},
				{
					"name": "keyword.operator.word.nm",
					"match": "\\b(?:as)\\b"
				},
				{
					"name": "variable.language.nm",
					"match": "\\b(?:self)\\b"
				},
				{
					"name": "constant.language.nm",
					"match": "\\b(?:true|false|null|void)\\b"
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.nm",
			"match": "\\b\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
		},
		"types": {
			"patterns": [
				{
					"name": "support.type.primitive.nm",
					"match": "\\b(?:int|uint|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|float16|float32|float64|string|char|bool)\\b"
				},
				{
					"name": "entity.name.type.nm",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				}
			]
		},
		"function-call": {
			"name": "meta.function-call.nm",
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
			"captures": {
				"1": { "name": "entity.name.function.nm" },
				"2": { "name": "punctuation.section.parens.begin.nm" }
			}
		},
		"constants": {
			"name": "entity.name.constant.nm",
			"match": "\\b[A-Z]{2,}[A-Z0-9_]*\\b"
		},
		"operators": {
			"name": "keyword.operator.nm",
			"match": "->|=>|==|!=|>=|<=|<<|>>|&&|\\|\\||\\?\\?|\\+=|-=|\\*=|\\.\\."
		}
	}
}
