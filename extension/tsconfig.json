{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2022",
		"lib": ["es2023"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"rootDir": "..",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
