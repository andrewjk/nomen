{
	"name": "nomen",
	"displayName": "Nomen",
	"version": "0.0.4",
	"description": "Run and Audit support for the Nomen programming language.",
	"categories": [
		"Programming Languages"
	],
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "https://github.com/andrewjk/nomen"
	},
	"publisher": "nomen",
	"main": "./dist/extension.js",
	"scripts": {
		"build": "node esbuild.mjs",
		"dev": "node esbuild.mjs --watch",
		"check": "tsc --noEmit",
		"package": "node esbuild.mjs --minify && vsce package --allow-package-all-secrets --allow-package-env-file",
		"publish": "vsce publish --allow-package-all-secrets --allow-package-env-file",
		"publish:patch": "vsce publish patch --allow-package-all-secrets --allow-package-env-file",
		"publish:minor": "vsce publish minor --allow-package-all-secrets --allow-package-env-file",
		"publish:major": "vsce publish major --allow-package-all-secrets --allow-package-env-file"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"@types/vscode": "^1.85.0",
		"esbuild": "^0.25.0",
		"typescript": "^6.0.3"
	},
	"contributes": {
		"languages": [
			{
				"id": "nomen",
				"extensions": [
					".nm"
				],
				"aliases": [
					"Nomen"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "nomen",
				"scopeName": "source.nm",
				"path": "./syntaxes/nomen.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "nomen.run",
				"title": "Nomen: Run File",
				"enablement": "resourceLangId == nomen"
			},
			{
				"command": "nomen.audit",
				"title": "Nomen: Audit File",
				"enablement": "resourceLangId == nomen"
			}
		],
		"configuration": {
			"title": "Nomen",
			"properties": {
				"nomen.executable": {
					"type": "string",
					"default": "nomen",
					"markdownDescription": "The command used to invoke the Nomen CLI. Supports `${workspaceFolder}`. Defaults to auto-detecting `bin/dist/index.mjs` in the workspace, falling back to `nomen` on your PATH."
				},
				"nomen.arch": {
					"type": "string",
					"enum": [
						"aarch64",
						"c"
					],
					"default": "aarch64",
					"description": "Target architecture passed to the compiler via --arch."
				},
				"nomen.auditRuntime": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to `audit_runtime.c`, linked in when running Audit. Supports `${workspaceFolder}`. Defaults to `${workspaceFolder}/src/audit_runtime.c`."
				},
				"nomen.saveBeforeRun": {
					"type": "boolean",
					"default": true,
					"description": "Save the file before running."
				},
				"nomen.terminal": {
					"type": "string",
					"enum": [
						"dedicated",
						"new"
					],
					"enumDescriptions": [
						"Reuse a single Nomen terminal across runs.",
						"Create a fresh terminal for each run."
					],
					"default": "dedicated",
					"description": "How to manage the terminal used for runs."
				},
				"nomen.diagnostics": {
					"type": "string",
					"enum": [
						"onType",
						"onSave",
						"off"
					],
					"enumDescriptions": [
						"Show parse and compile errors as you type (debounced).",
						"Show errors only when a file is saved.",
						"Disable error diagnostics."
					],
					"default": "onType",
					"description": "When to compute Nomen error diagnostics."
				}
			}
		}
	},
	"icon": "logo.png",
	"engines": {
		"vscode": "^1.85.0"
	}
}
