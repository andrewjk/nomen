
func main() {
	Console.Write("\n")

	// Test for loop and range
	for i in 0..5 {
		Console.Write("hello, world! ")
		Console.Write(i + 1)
		// TODO: if i + 1 < 4
		const x = i + 1
		if x < 4 {
			Console.Write(" is less than 4")
		} else {
			Console.Write(" is 4 or more")
		}
		Console.Write("\n")
	}

	Console.Write("\n")

	// Test while loop
	var y = 0
	while y < 5 {
		Console.Write("hi ")
		y = y + 1
	}

	Console.Write("\n\n")

	var dog = make_dog()
	Console.Write(dog.name)
	Console.Write(": ")
	Console.Write(dog.speak())

	Console.Write("\n\n")

	// Test an array of objects with traits
	const animals: Animal[] = [Dog.init(), Cat.init(), Lizard.init()]
	for a in animals {
		// TODO: Fields in traits??
		//Console.Write(a.name)
		//Console.Write(": ")
		Console.Write(a.speak())
		Console.Write("\n")
	}

	var cat = Cat.init()
	grow_animal(cat)
	Console.Write("cat has age: ")
	Console.Write(cat.age)
}

func make_dog() -> Dog {
	const dog = Dog.init()
	return dog
}

trait Disposable {
	func dispose() {
		Console.Write("\nboom!")
	}
}

trait Animal {
	var name: string
	var age = 1
	func speak() -> string {
		return "..."
	}
}

struct Dog: Animal, Disposable {
	var name = "Dog"
	func speak() -> string {
		return "woof"
	}
}

struct Cat: Animal {
	var name = "Cat"
	func speak() -> string {
		return self.name
	}
}

struct Lizard: Animal {
	var name = "Lizard"
}

func grow_animal(animal: Animal) {
	animal.age = animal.age + 1
}
