pub struct Array {
    pub const int length

    pub func add = (self, Array other, out Array) -> {
        ```
        #arch: c
        int result[self.length + other->length];
        memcpy(result, &self, self.length * sizeof(int));
        memcpy(&result[self.length], other, other->length * sizeof(int));
        return result;
        ```
        return "from_c"
    }

    pub func mul = (self, int other, out Array) -> {
        ```
        #arch: c
        int result[self.length * other];
        memcpy(result, &self, self.length * sizeof(int));
        for (int i = 1; i < other; i++) {
            memcpy(&result[self.length * i], &self, self.length * sizeof(int));
        }
        return result;
        ```
        return "from_c"
    }
}
pub struct Console {
    pub func write = (string line) -> {
        ```
        #arch: c
        printf("%s", line);
        ```
        ```
        #arch: aarch64
        sub sp, sp, #16
        mov x1, x0
        str x1, [sp]
        adr x0, .Lfmt_console_s
        bl _printf
        add sp, sp, #16
        b .Lend_Console_write
        .Lfmt_console_s: .asciz "%s"
        .p2align 2
        .Lend_Console_write:
        ```
    }
}
pub struct Math {
    pub func power = (int base, int exp, out int) -> {
        ```
        #arch: c
        int result = 1;
        for (int i = 0; i < exp; i++) {
            result *= base;
        }
        return result;
        ```
        ```
        #arch: aarch64
        mov x2, #1
        mov x3, #0
        b .Lchk_Math_power
        .Lloop_Math_power:
        mul x2, x2, x0
        add x3, x3, #1
        .Lchk_Math_power:
        cmp x3, x1
        blt .Lloop_Math_power
        mov x0, x2
        ```
        return "from_c"
    }
}
