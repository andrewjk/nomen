import Buffer

pub struct BigInt {
    var int sign = 0
    var int len = 0
    var Buffer digits = Buffer()

    pub func new = (self, int val, out BigInt) {
        self.sign = 1
        var int v = val
        if v < 0 {
            self.sign = -1
            v = 0 - v
        }
        self.digits.alloc_int(4)
        self.digits.store_int(0, v)
        self.len = 1
        return self
    }

    inline func get = (self, int i, out uint64) {
        ```
        #arch: c
        return ((unsigned long long*)((unsigned long long)((unsigned long long*)&self + 32)))[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x0, #32]
        lsl x1, x1, #3
        add x0, x0, x1
        ldr x0, [x0]
        ```
    }

    inline func set = (ref self, int i, uint64 val) {
        ```
        #arch: c
        ((unsigned long long*)((unsigned long long)((unsigned long long*)self + 32)))[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #32]
        lsl x1, x1, #3
        add x0, x0, x1
        str x2, [x0]
        ```
    }

    func ensure = (ref self, int needed) {
        self.digits.grow_int(needed)
    }

    func clear = (ref self, int len) {
        self.digits.zero_int(len)
    }

    func copy_range_from = (ref self, BigInt src, int start, int count) {
        self.ensure(count)
        var int i = 0
        while i < count {
            self.set(i, src.get(start + i))
            i = i + 1
        }
        self.len = count
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
    }

    func add_at = (ref self, BigInt other, int shift) {
        self.ensure(other.len + shift + 1)
        var int carry = 0
        var int i = 0
        while i < other.len || carry != 0 {
            var uint64 a_val = 0
            if i + shift < self.len {
                a_val = self.get(i + shift)
            }
            var uint64 b_val = 0
            if i < other.len {
                b_val = other.get(i)
            }
            var uint64 sum = a_val + b_val
            var int c1 = 0
            if sum < a_val {
                c1 = 1
            }
            var uint64 sum2 = sum + carry
            var int c2 = 0
            if sum2 < sum {
                c2 = 1
            }
            self.set(i + shift, sum2)
            carry = c1 + c2
            i = i + 1
        }
        if i + shift > self.len {
            self.len = i + shift
        }
    }

    func sub_at = (ref self, BigInt other, int shift) {
        var int borrow = 0
        var int i = 0
        while i < other.len {
            var uint64 a_val = self.get(i + shift)
            var uint64 b_val = other.get(i)
            var uint64 diff = a_val - borrow
            var int new_borrow = 0
            if diff > a_val {
                new_borrow = 1
            }
            var uint64 diff2 = diff - b_val
            if diff2 > diff {
                borrow = new_borrow + 1
            } else {
                borrow = new_borrow
            }
            self.set(i + shift, diff2)
            i = i + 1
        }
        while borrow != 0 {
            var uint64 a_val = self.get(i + shift)
            var uint64 diff = a_val - borrow
            if diff > a_val {
                borrow = 1
            } else {
                borrow = 0
            }
            self.set(i + shift, diff)
            i = i + 1
        }
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
    }

    func div128 = (self, uint64 hi, uint64 lo, uint64 d, out uint64) {
        ```
        #arch: c
        unsigned __int128 dividend = ((unsigned __int128)(unsigned long long)hi << 64) | (unsigned long long)lo;
        return (unsigned long long)(dividend / (unsigned long long)d);
        ```
        ```
        #arch: aarch64
        mov x4, x1
        mov x0, #0
        mov x7, 63

        .Ldiv128_loop:
        adds x4, x4, x4
        lsr x5, x2, x7
        and x5, x5, #1
        orr x4, x4, x5
        b.cs .Ldiv128_subtract
        cmp x4, x3
        b.lo .Ldiv128_skip

        .Ldiv128_subtract:
        sub x4, x4, x3
        mov x5, #1
        lsl x5, x5, x7
        orr x0, x0, x5

        .Ldiv128_skip:
        subs x7, x7, #1
        b.ge .Ldiv128_loop

        b .return_BigInt_div128
        ```
        return 0
    }

    pub func cmp = (self, BigInt other, out int) {
        if self.len != other.len {
            if self.len > other.len {
                return 1
            }
            return -1
        }
        var int i = self.len - 1
        while i >= 0 {
            var uint64 a = self.get(i)
            var uint64 b = other.get(i)
            if a != b {
                if a > b {
                    return 1
                }
                return -1
            }
            i = i - 1
        }
        return 0
    }

    pub func add_to = (ref self, BigInt a, BigInt b) {
        if a.len == 1 && b.len == 1 {
            var uint64 a_val = a.get(0)
            var uint64 b_val = b.get(0)
            var uint64 sum = a_val + b_val
            var int carry = 0
            if sum < a_val {
                carry = 1
            }
            self.ensure(2)
            self.set(0, sum)
            self.set(1, carry)
            self.len = 1 + carry
            return
        }
        var int a_len = a.len
        var int b_len = b.len
        var int max_len = a_len
        if b_len > max_len {
            max_len = b_len
        }
        self.ensure(max_len + 2)
        var int carry = 0
        var int i = 0
        var int last_nonzero = 1
        while i < max_len || carry != 0 {
            var uint64 a_val = 0
            if i < a_len {
                a_val = a.get(i)
            }
            var uint64 b_val = 0
            if i < b_len {
                b_val = b.get(i)
            }
            var uint64 sum = a_val + b_val
            var int c1 = 0
            if sum < a_val {
                c1 = 1
            }
            var uint64 sum2 = sum + carry
            var int c2 = 0
            if sum2 < sum {
                c2 = 1
            }
            self.set(i, sum2)
            if sum2 != 0 {
                last_nonzero = i + 1
            }
            carry = c1 + c2
            i = i + 1
        }
        self.len = i
        if last_nonzero < self.len {
            self.len = last_nonzero
        }
        if self.len == 0 {
            self.len = 1
        }
    }

    pub func sub_to = (ref self, BigInt a, BigInt b) {
        if a.len == 1 && b.len == 1 {
            self.ensure(1)
            self.set(0, a.get(0) - b.get(0))
            self.len = 1
            return
        }
        self.ensure(a.len)
        var int borrow = 0
        var int i = 0
        var int last_nonzero = 1
        while i < a.len {
            var uint64 a_val = a.get(i)
            var uint64 b_val = 0
            if i < b.len {
                b_val = b.get(i)
            }
            var uint64 diff = a_val - borrow
            var int new_borrow = 0
            if diff > a_val {
                new_borrow = 1
            }
            var uint64 diff2 = diff - b_val
            if diff2 > diff {
                borrow = new_borrow + 1
            } else {
                borrow = new_borrow
            }
            self.set(i, diff2)
            if diff2 != 0 {
                last_nonzero = i + 1
            }
            i = i + 1
        }
        self.len = a.len
        if last_nonzero < self.len {
            self.len = last_nonzero
        }
        if self.len == 0 {
            self.len = 1
        }
    }

    pub func mul_to = (ref self, BigInt a, BigInt b, var BigInt scratch) {
        if a.len == 1 || b.len == 1 {
            var uint64 sv
            var int other_len
            if a.len == 1 {
                sv = a.get(0)
                other_len = b.len
            } else {
                sv = b.get(0)
                other_len = a.len
            }
            self.ensure(other_len + 1)
            var uint64 sv_lo = sv & 4294967295
            var uint64 sv_hi = sv >> 32
            var uint64 carry = 0
            var int i = 0
            var int last_nonzero = 0
            if a.len == 1 {
                while i < other_len || carry != 0 {
                    var uint64 ov = 0
                    if i < other_len {
                        ov = b.get(i)
                    }
                    var uint64 ov_lo = ov & 4294967295
                    var uint64 ov_hi = ov >> 32
                    var uint64 p_lo = sv_lo * ov_lo
                    var uint64 p_lh = sv_hi * ov_lo
                    var uint64 p_hl = sv_lo * ov_hi
                    var uint64 p_hi = sv_hi * ov_hi
                    var uint64 cross = p_lh + p_hl
                    var int cross_c = 0
                    if cross < p_lh {
                        cross_c = 1
                    }
                    var uint64 lo = p_lo + carry
                    var int c1 = 0
                    if lo < p_lo {
                        c1 = 1
                    }
                    var uint64 lo2 = lo + (cross << 32)
                    var int c2 = 0
                    if lo2 < lo {
                        c2 = 1
                    }
                    carry = c1 + c2 + ((cross >> 32) + (cross_c as uint64 << 32)) as int + p_hi as int
                    self.set(i, lo2)
                    if lo2 != 0 {
                        last_nonzero = i + 1
                    }
                    i = i + 1
                }
            } else {
                while i < other_len || carry != 0 {
                    var uint64 ov = 0
                    if i < other_len {
                        ov = a.get(i)
                    }
                    var uint64 ov_lo = ov & 4294967295
                    var uint64 ov_hi = ov >> 32
                    var uint64 p_lo = sv_lo * ov_lo
                    var uint64 p_lh = sv_hi * ov_lo
                    var uint64 p_hl = sv_lo * ov_hi
                    var uint64 p_hi = sv_hi * ov_hi
                    var uint64 cross = p_lh + p_hl
                    var int cross_c = 0
                    if cross < p_lh {
                        cross_c = 1
                    }
                    var uint64 lo = p_lo + carry
                    var int c1 = 0
                    if lo < p_lo {
                        c1 = 1
                    }
                    var uint64 lo2 = lo + (cross << 32)
                    var int c2 = 0
                    if lo2 < lo {
                        c2 = 1
                    }
                    carry = c1 + c2 + ((cross >> 32) + (cross_c as uint64 << 32)) as int + p_hi as int
                    self.set(i, lo2)
                    if lo2 != 0 {
                        last_nonzero = i + 1
                    }
                    i = i + 1
                }
            }
            self.len = i
            if last_nonzero < self.len {
                self.len = last_nonzero
            }
            if self.len == 0 {
                self.len = 1
            }
            return
        }

        // Multi-limb × multi-limb: Karatsuba for large operands, schoolbook for small
        var int new_len = a.len + b.len
        if a.len < 32 && b.len < 32 {
            // Schoolbook for small operands
            scratch.ensure(new_len)
            scratch.clear(new_len)
            scratch.len = new_len
            var int i = 0
            while i < a.len {
                var uint64 ai = a.get(i)
                var uint64 ai_lo = ai & 4294967295
                var uint64 ai_hi = ai >> 32
                var uint64 carry = 0
                var int j = 0
                while j < b.len || carry != 0 {
                    var uint64 bj_lo = 0
                    var uint64 bj_hi = 0
                    if j < b.len {
                        var uint64 bj = b.get(j)
                        bj_lo = bj & 4294967295
                        bj_hi = bj >> 32
                    }
                    var uint64 lo_prod = ai_lo * bj_lo
                    var uint64 cross1 = ai_hi * bj_lo
                    var uint64 cross2 = ai_lo * bj_hi
                    var uint64 hi_prod = ai_hi * bj_hi
                    var uint64 sum_cross = cross1 + cross2
                    var int cross_carry = 0
                    if sum_cross < cross1 {
                        cross_carry = 1
                    }
                    var uint64 cross_lo = sum_cross << 32
                    var uint64 cross_hi = (sum_cross >> 32) + (cross_carry as uint64 << 32)
                    var uint64 old = scratch.get(j + i)
                    var uint64 cur = old + carry
                    var int c1 = 0
                    if cur < old {
                        c1 = 1
                    }
                    var uint64 cur2 = cur + lo_prod
                    var int c2 = 0
                    if cur2 < cur {
                        c2 = 1
                    }
                    var uint64 cur3 = cur2 + cross_lo
                    var int c3 = 0
                    if cur3 < cur2 {
                        c3 = 1
                    }
                    carry = c1 + c2 + c3 + cross_hi as int + hi_prod as int
                    scratch.set(j + i, cur3)
                    j = j + 1
                }
                i = i + 1
            }
            self.ensure(new_len)
            var int last_nonzero = 1
            var int k = 0
            while k < new_len {
                var uint64 val = scratch.get(k)
                self.set(k, val)
                if val != 0 {
                    last_nonzero = k + 1
                }
                k = k + 1
            }
            self.len = last_nonzero
            return
        }

        // Karatsuba: split a = a1*B^m + a0, b = b1*B^m + b0
        // result = z2*B^(2m) + z1*B^m + z0
        // z0 = a0*b0, z2 = a1*b1, z1 = (a0+a1)*(b0+b1) - z0 - z2
        var int m = a.len
        if b.len > m {
            m = b.len
        }
        m = m / 2

        var int a0_len = m
        if a0_len > a.len {
            a0_len = a.len
        }
        var int b0_len = m
        if b0_len > b.len {
            b0_len = b.len
        }
        var int a1_len = a.len - a0_len
        var int b1_len = b.len - b0_len

        var BigInt a0 = BigInt()
        var BigInt a1 = BigInt()
        var BigInt b0 = BigInt()
        var BigInt b1 = BigInt()
        a0.copy_range_from(a, 0, a0_len)
        b0.copy_range_from(b, 0, b0_len)
        if a1_len > 0 {
            a1.copy_range_from(a, m, a1_len)
        }
        if b1_len > 0 {
            b1.copy_range_from(b, m, b1_len)
        }

        // z0 = a0 * b0
        var BigInt z0 = BigInt()
        var BigInt s0 = BigInt()
        z0.mul_to(a0, b0, s0)

        // z2 = a1 * b1 (only if both have high parts)
        var BigInt z2 = BigInt()
        var BigInt s2 = BigInt()
        if a1_len > 0 && b1_len > 0 {
            z2.mul_to(a1, b1, s2)
        }

        // z1 = (a0+a1)*(b0+b1) - z0 - z2
        var BigInt aa = BigInt()
        var BigInt bb = BigInt()
        var BigInt z1 = BigInt()
        var BigInt s1 = BigInt()
        aa.add_to(a0, a1)
        bb.add_to(b0, b1)
        z1.mul_to(aa, bb, s1)
        z1.sub_at(z0, 0)
        z1.sub_at(z2, 0)

        // Combine: self = z0 + z1 << m + z2 << (2*m)
        self.ensure(new_len)
        self.clear(new_len)
        self.len = new_len
        self.add_at(z0, 0)
        self.add_at(z1, m)
        self.add_at(z2, m + m)
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
    }

    // Knuth's Algorithm D for multi-limb division (TAOCP Vol 2, 4.3.1)
    // self = quotient, a = dividend, b = divisor, remainder = remainder
    // Uses remainder's internal buffer as working space
    pub func div = (self, BigInt a, BigInt b, var BigInt remainder, out BigInt) {
        if b.len == 1 {
            var uint64 divisor = b.get(0)
            self.ensure(a.len)
            self.len = a.len
            var uint64 rem = 0
            var int last_nonzero = 1
            var int i = a.len - 1
            while i >= 0 {
                var uint64 ai = a.get(i)
                var uint64 q_val = self.div128(rem, ai, divisor)
                var uint64 d_lo = divisor & 4294967295
                var uint64 d_hi = divisor >> 32
                var uint64 q_lo = q_val & 4294967295
                var uint64 q_hi = q_val >> 32
                var uint64 p_ll = q_lo * d_lo
                var uint64 p_lh = q_lo * d_hi
                var uint64 p_hl = q_hi * d_lo
                var uint64 p_hh = q_hi * d_hi
                var uint64 p_mid = p_lh + p_hl
                var int p_mc = 0
                if p_mid < p_lh {
                    p_mc = 1
                }
                var uint64 p_lo_val = p_ll + (p_mid << 32)
                var int p_lo_c = 0
                if p_lo_val < p_ll {
                    p_lo_c = 1
                }
                var uint64 p_hi_val = p_hh + (p_mid >> 32) + (p_mc as uint64 * 4294967296) + p_lo_c as uint64
                var uint64 sub_lo = ai - p_lo_val
                rem = sub_lo
                self.set(i, q_val)
                if q_val != 0 {
                    last_nonzero = i + 1
                }
                i = i - 1
            }
            if last_nonzero < self.len {
                self.len = last_nonzero
            }
            if self.len == 0 {
                self.len = 1
            }
            remainder.len = 1
            remainder.ensure(1)
            remainder.set(0, rem)
            return self
        }

        // --- Knuth's Algorithm D for multi-limb division ---
        // Uses remainder's digits buffer as working space:
        // [0..n-1] = working divisor (normalized b)
        // [n..n+a.len+1] = working dividend (normalized a)
        var int n = b.len
        var int m = a.len - n
        if m < 0 {
            self.ensure(1)
            self.set(0, 0)
            self.len = 1
            remainder.ensure(a.len)
            remainder.clear(remainder.digits.get_cap())
            var int ci = 0
            while ci < a.len {
                remainder.set(ci, a.get(ci))
                ci = ci + 1
            }
            remainder.len = a.len
            return self
        }

        // D1. Normalize
        var uint64 v_top = b.get(n - 1)
        var int shift = 0
        var uint64 clz_mask = 9223372036854775808
        while (clz_mask & v_top) == 0 {
            shift = shift + 1
            clz_mask = clz_mask >> 1
            if shift >= 64 {
                break
            }
        }

        // Ensure remainder buffer is big enough for working divisor + working dividend
        var int working_size = 2 * n + a.len + 3
        remainder.ensure(working_size)
        remainder.clear(working_size)
        var int wd_off = n

        // Shift b left by shift into remainder[0..n-1]
        var uint64 carry = 0
        var int si = 0
        while si < n {
            var uint64 b_val = b.get(si)
            var uint64 shifted = (b_val << shift) | carry
            remainder.digits.store_int(si, shifted as int)
            if shift > 0 {
                carry = b_val >> (64 - shift)
            } else {
                carry = 0
            }
            si = si + 1
        }

        // Shift a left by shift into remainder[wd_off..wd_off+a.len]
        carry = 0
        si = 0
        while si < a.len {
            var uint64 a_val = a.get(si)
            var uint64 shifted = (a_val << shift) | carry
            remainder.digits.store_int(wd_off + si, shifted as int)
            if shift > 0 {
                carry = a_val >> (64 - shift)
            } else {
                carry = 0
            }
            si = si + 1
        }
        remainder.digits.store_int(wd_off + si, carry as int)
        var int u_len = a.len + 1

        // D2. Main loop: for j = m down to 0
        self.ensure(m + 2)
        var int j = m
        while j >= 0 {
            // D3. Calculate q_hat
            var uint64 u_hi = remainder.digits.load_int(wd_off + j + n) as uint64
            var uint64 u_lo = remainder.digits.load_int(wd_off + j + n - 1) as uint64
            var uint64 v_n1 = remainder.digits.load_int(n - 1) as uint64

            var uint64 q_hat = self.div128(u_hi, u_lo, v_n1)

            // q_hat correction: try q_hat, decrement if too large
            if n >= 2 {
                var int try_count = 0
                while try_count < 3 {
                    // compute q_hat * v and compare with u[j+n..j]
                    var uint64 hv_carry = 0
                    var int pi = 0
                    while pi < n {
                        var uint64 vv = remainder.digits.load_int(pi) as uint64
                        var uint64 vv_lo = vv & 4294967295
                        var uint64 vv_hi = vv >> 32
                        var uint64 q_lo = q_hat & 4294967295
                        var uint64 q_hi = q_hat >> 32
                        var uint64 p_ll = q_lo * vv_lo
                        var uint64 p_lh = q_lo * vv_hi
                        var uint64 p_hl = q_hi * vv_lo
                        var uint64 p_hh = q_hi * vv_hi
                        var uint64 s_cross = p_lh + p_hl
                        var int s_overflow = 0
                        if s_cross < p_lh {
                            s_overflow = 1
                        }
                        var uint64 s_lo = p_ll + ((s_cross & 4294967295) << 32)
                        var uint64 s_hi = p_hh + (s_cross >> 32)
                        if s_overflow != 0 {
                            s_hi = s_hi + 4294967296
                        }
                        var uint64 p_lo = s_lo + hv_carry
                        hv_carry = s_hi
                        if p_lo < s_lo {
                            hv_carry = hv_carry + 1
                        }
                        remainder.digits.store_int(wd_off + u_len + 1 + pi, p_lo as int)
                        pi = pi + 1
                    }

                    // Compare hv_carry with u[j+n]
                    var uint64 u_at_jn = remainder.digits.load_int(wd_off + j + n) as uint64
                    if hv_carry > u_at_jn {
                        q_hat = q_hat - 1
                        try_count = try_count + 1
                        continue
                    }
                    if hv_carry < u_at_jn {
                        break
                    }

                    // hv_carry == u_at_jn, compare lower limbs
                    var int cmp_i = n - 1
                    var int q_too_big = 0
                    while cmp_i >= 0 {
                        var uint64 prod_limb = remainder.digits.load_int(wd_off + u_len + 1 + cmp_i) as uint64
                        var uint64 u_limb = remainder.digits.load_int(wd_off + j + cmp_i) as uint64
                        if prod_limb > u_limb {
                            q_too_big = 1
                            break
                        }
                        if prod_limb < u_limb {
                            break
                        }
                        cmp_i = cmp_i - 1
                    }
                    if q_too_big != 0 {
                        q_hat = q_hat - 1
                        try_count = try_count + 1
                        continue
                    }
                    break
                }
            }

            // D4. Multiply and subtract: u[j+n..j] -= q_hat * v
            var uint64 mul_borrow = 0
            var int si2 = 0
            while si2 < n {
                var uint64 vv = remainder.digits.load_int(si2) as uint64
                var uint64 vv_lo = vv & 4294967295
                var uint64 vv_hi = vv >> 32
                var uint64 q_lo = q_hat & 4294967295
                var uint64 q_hi = q_hat >> 32
                var uint64 p_ll = q_lo * vv_lo
                var uint64 p_lh = q_lo * vv_hi
                var uint64 p_hl = q_hi * vv_lo
                var uint64 p_hh = q_hi * vv_hi
                var uint64 s_cross = p_lh + p_hl
                var int sc_overflow = 0
                if s_cross < p_lh {
                    sc_overflow = 1
                }
                var uint64 s_lo = p_ll + ((s_cross & 4294967295) << 32)
                var uint64 s_hi = p_hh + (s_cross >> 32)
                if sc_overflow != 0 {
                    s_hi = s_hi + 4294967296
                }
                var uint64 product = s_lo + mul_borrow
                var uint64 new_mul_borrow = s_hi
                if product < s_lo {
                    new_mul_borrow = new_mul_borrow + 1
                }

                var uint64 u_val = remainder.digits.load_int(wd_off + j + si2) as uint64
                var uint64 diff = u_val - product
                var int diff_borrow = 0
                if diff > u_val {
                    diff_borrow = 1
                }
                var uint64 diff2 = diff - new_mul_borrow
                var int db2 = 0
                if diff2 > diff {
                    db2 = 1
                }
                remainder.digits.store_int(wd_off + j + si2, diff2 as int)
                mul_borrow = (diff_borrow + db2) as uint64
                si2 = si2 + 1
            }

            // Final borrow against u[j+n]
            var uint64 u_jn = remainder.digits.load_int(wd_off + j + n) as uint64
            var uint64 new_u_jn = u_jn - mul_borrow
            remainder.digits.store_int(wd_off + j + n, new_u_jn as int)

            // D5. Test remainder - if borrow was nonzero (negative result), add back
            if new_u_jn > u_jn {
                q_hat = q_hat - 1
                var uint64 add_carry = 0
                var int ai = 0
                while ai < n {
                    var uint64 v_add = remainder.digits.load_int(ai) as uint64
                    var uint64 u_add = remainder.digits.load_int(wd_off + j + ai) as uint64
                    var uint64 sum = u_add + v_add + add_carry
                    var int new_carry = 0
                    if sum < u_add {
                        new_carry = 1
                    } else {
                        if sum == u_add {
                            new_carry = add_carry as int
                        }
                    }
                    remainder.digits.store_int(wd_off + j + ai, sum as int)
                    add_carry = new_carry as uint64
                    ai = ai + 1
                }
                var int carry_idx = 0
                while add_carry != 0 {
                    var uint64 u_carry = remainder.digits.load_int(wd_off + j + n + carry_idx) as uint64
                    var uint64 new_u = u_carry + add_carry
                    remainder.digits.store_int(wd_off + j + n + carry_idx, new_u as int)
                    if new_u >= u_carry {
                        add_carry = 0
                    }
                    carry_idx = carry_idx + 1
                }
            }

            // Store quotient digit
            self.ensure(j + 1)
            self.set(j, q_hat)
            j = j - 1
        }
        self.len = m + 1
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }

        // D7. Unnormalize remainder: shift remainder[0..n-1] right by shift bits
        // Use the low n limbs of remainder.digits (the working dividend area)
        // First save the low n limbs before potentially overwriting
        if shift == 0 {
            var int ri = 0
            while ri < n {
                remainder.set(ri, remainder.digits.load_int(ri) as uint64)
                ri = ri + 1
            }
            remainder.len = n
        } else {
            var int ri2 = 0
            while ri2 < n {
                var uint64 cur = remainder.digits.load_int(ri2) as uint64
                var uint64 next = 0
                if ri2 + 1 < n {
                    next = remainder.digits.load_int(ri2 + 1) as uint64
                }
                var uint64 shifted = (cur >> shift) | (next << (64 - shift))
                remainder.set(ri2, shifted)
                ri2 = ri2 + 1
            }
            remainder.len = n
        }
        while remainder.len > 1 {
            if remainder.get(remainder.len - 1) != 0 {
                break
            }
            remainder.len = remainder.len - 1
        }
        return self
    }

    pub func to_digit = (self, out int) {
        if self.len == 1 {
            return self.get(0) as int
        }
        return -1
    }

    pub func copy_from = (ref self, BigInt other) {
        self.ensure(other.len)
        self.len = other.len
        self.sign = other.sign
        var int i = 0
        while i < other.len {
            self.set(i, other.get(i))
            i = i + 1
        }
    }
}
