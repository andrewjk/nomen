import Buffer

pub struct BigInt {
    var int sign = 0
    var int len = 0
    var Buffer digits = Buffer()

    pub func new = (self, int val, out BigInt) {
        self.sign = 1
        var int v = val
        if v < 0 {
            self.sign = -1
            v = 0 - v
        }
        self.digits.alloc_int(4)
        self.digits.store_int(0, v)
        self.len = 1
        return self
    }

    func get = (self, int i, out uint64) {
        return self.digits.load_int(i) as uint64
    }

    func set = (ref self, int i, uint64 val) {
        self.digits.store_int(i, val as int)
    }

    func ensure = (ref self, int needed) {
        self.digits.grow_int(needed)
    }

    func clear = (ref self, int len) {
        self.digits.zero_int(len)
    }

    pub func cmp = (self, BigInt other, out int) {
        if self.len != other.len {
            if self.len > other.len {
                return 1
            }
            return -1
        }
        var int i = self.len - 1
        while i >= 0 {
            var uint64 a = self.get(i)
            var uint64 b = other.get(i)
            if a != b {
                if a > b {
                    return 1
                }
                return -1
            }
            i = i - 1
        }
        return 0
    }

    pub func add_to = (ref self, BigInt a, BigInt b) {
        var int a_len = a.len
        var int b_len = b.len
        var int max_len = a_len
        if b_len > max_len {
            max_len = b_len
        }
        self.ensure(max_len + 2)
        var int carry = 0
        var int i = 0
        while i < max_len || carry != 0 {
            var uint64 a_val = 0
            if i < a_len {
                a_val = a.get(i)
            }
            var uint64 b_val = 0
            if i < b_len {
                b_val = b.get(i)
            }
            var uint64 sum = a_val + b_val
            var int c1 = 0
            if sum < a_val {
                c1 = 1
            }
            var uint64 sum2 = sum + carry
            var int c2 = 0
            if sum2 < sum {
                c2 = 1
            }
            self.set(i, sum2)
            carry = c1 + c2
            i = i + 1
        }
        self.len = i
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
    }

    pub func sub_to = (ref self, BigInt a, BigInt b) {
        self.ensure(a.len)
        var int borrow = 0
        var int i = 0
        while i < a.len {
            var uint64 a_val = a.get(i)
            var uint64 b_val = 0
            if i < b.len {
                b_val = b.get(i)
            }
            var uint64 diff = a_val - borrow
            var int new_borrow = 0
            if diff > a_val {
                new_borrow = 1
            }
            var uint64 diff2 = diff - b_val
            if diff2 > diff {
                borrow = new_borrow + 1
            } else {
                borrow = new_borrow
            }
            self.set(i, diff2)
            i = i + 1
        }
        self.len = a.len
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
    }

    pub func mul_to = (ref self, BigInt a, BigInt b) {
        var int new_len = a.len + b.len
        var Buffer tmp = Buffer()
        tmp.alloc_int(new_len)
        var int i = 0
        while i < a.len {
            var uint64 ai = a.get(i)
            var uint64 ai_lo = ai & 4294967295
            var uint64 ai_hi = ai >> 32
            var uint64 carry = 0
            var int j = 0
            while j < b.len || carry != 0 {
                var uint64 bj_lo = 0
                var uint64 bj_hi = 0
                if j < b.len {
                    var uint64 bj = b.get(j)
                    bj_lo = bj & 4294967295
                    bj_hi = bj >> 32
                }
                var uint64 lo_prod = ai_lo * bj_lo
                var uint64 cross1 = ai_hi * bj_lo
                var uint64 cross2 = ai_lo * bj_hi
                var uint64 hi_prod = ai_hi * bj_hi
                var uint64 sum_cross = cross1 + cross2
                var int cross_carry = 0
                if sum_cross < cross1 {
                    cross_carry = 1
                }
                var uint64 cross_lo = sum_cross << 32
                var uint64 cross_hi = (sum_cross >> 32) + (cross_carry as uint64 << 32)
                var uint64 old = tmp.load_int(j + i) as uint64
                var uint64 cur = old + carry
                var int c1 = 0
                if cur < old {
                    c1 = 1
                }
                var uint64 cur2 = cur + lo_prod
                var int c2 = 0
                if cur2 < cur {
                    c2 = 1
                }
                var uint64 cur3 = cur2 + cross_lo
                var int c3 = 0
                if cur3 < cur2 {
                    c3 = 1
                }
                carry = c1 + c2 + c3 + cross_hi as int + hi_prod as int
                tmp.store_int(j + i, cur3 as int)
                j = j + 1
            }
            i = i + 1
        }
        self.ensure(new_len)
        self.clear(new_len)
        var int k = 0
        while k < new_len {
            self.set(k, tmp.load_int(k) as uint64)
            k = k + 1
        }
        self.len = new_len
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
    }

    pub func div = (self, BigInt a, BigInt b, var BigInt remainder, out BigInt) {
        self.ensure(a.len + b.len + 1)
        self.clear(self.digits.get_cap())
        self.len = 1
        remainder.ensure(a.len + 1)
        remainder.clear(remainder.digits.get_cap())
        remainder.len = 1

        var int total_bits = a.len * 64 - 1
        var int i = total_bits
        while i >= 0 {
            var int carry = 0
            var int j = 0
            while j < remainder.len {
                var uint64 val = remainder.digits.load_int(j) as uint64
                var uint64 msb = val >> 63
                var uint64 shifted = val << 1
                var uint64 new_val = shifted + carry
                remainder.digits.store_int(j, new_val as int)
                carry = msb as int
                j = j + 1
            }
            if carry != 0 {
                if remainder.len >= remainder.digits.get_cap() {
                    var int nc = remainder.digits.get_cap() * 2
                    remainder.digits.grow_int(nc)
                }
                remainder.digits.store_int(remainder.len, carry)
                remainder.len = remainder.len + 1
            }

            var int word = i / 64
            var int bit = i % 64
            if word < a.len {
                var uint64 limb = a.digits.load_int(word) as uint64
                if (limb & (1 as uint64 << bit)) != 0 {
                    var uint64 r0 = remainder.digits.load_int(0) as uint64
                    remainder.digits.store_int(0, (r0 | 1) as int)
                }
            }

            var int cmp_result = 0
            if remainder.len != b.len {
                if remainder.len > b.len {
                    cmp_result = 1
                } else {
                    cmp_result = -1
                }
            } else {
                var int cj = remainder.len - 1
                while cj >= 0 {
                    var uint64 rd = remainder.digits.load_int(cj) as uint64
                    var uint64 bd = b.digits.load_int(cj) as uint64
                    if rd != bd {
                        if rd > bd {
                            cmp_result = 1
                        } else {
                            cmp_result = -1
                        }
                        break
                    }
                    cj = cj - 1
                }
            }

            if cmp_result >= 0 {
                var int borrow = 0
                var int sj = 0
                while sj < remainder.len {
                    var uint64 r_val = remainder.digits.load_int(sj) as uint64
                    var uint64 diff = r_val - borrow
                    var int new_borrow = 0
                    if diff > r_val {
                        new_borrow = 1
                    }
                    if sj < b.len {
                        var uint64 b_val = b.digits.load_int(sj) as uint64
                        var uint64 diff2 = diff - b_val
                        if diff2 > diff {
                            borrow = new_borrow + 1
                        } else {
                            borrow = new_borrow
                        }
                        remainder.digits.store_int(sj, diff2 as int)
                    } else {
                        borrow = new_borrow
                        remainder.digits.store_int(sj, diff as int)
                    }
                    sj = sj + 1
                }
                while remainder.len > 1 {
                    if (remainder.digits.load_int(remainder.len - 1)) != 0 {
                        break
                    }
                    remainder.len = remainder.len - 1
                }

                if self.digits.get_cap() <= word {
                    var int nc = self.digits.get_cap()
                    while nc <= word {
                        nc = nc * 2
                    }
                    self.digits.grow_int(nc)
                }
                if word >= self.len {
                    self.len = word + 1
                }
                self.digits.store_or_int(word, (1 as uint64 << bit) as int)
            }

            i = i - 1
        }
        while self.len > 1 {
            if (self.digits.load_int(self.len - 1)) != 0 {
                break
            }
            self.len = self.len - 1
        }
        return self
    }

    pub func to_digit = (self, out int) {
        if self.len == 1 {
            return self.get(0) as int
        }
        return -1
    }

    pub func copy_from = (ref self, BigInt other) {
        self.ensure(other.len)
        self.len = other.len
        self.sign = other.sign
        var int i = 0
        while i < other.len {
            self.set(i, other.get(i))
            i = i + 1
        }
    }
}
