import Buffer

pub struct BigInt {
    var int sign = 0
    var int len = 0
    var Buffer digits = Buffer()

    pub func new = (self, int val, out BigInt) {
        self.sign = 1
        var int v = val
        if v < 0 {
            self.sign = -1
            v = 0 - v
        }
        self.digits.alloc(8)
        self.digits.store(0, v as uint32)
        self.len = 1
        return self
    }

    func get = (self, int i, out int) {
        return self.digits.load(i) as int
    }

    func set = (ref self, int i, uint64 val) {
        self.digits.store(i, val as uint32)
    }

    func ensure = (ref self, int needed) {
        self.digits.grow(needed)
    }

    func clear = (ref self, int len) {
        self.digits.zero(len)
    }

    pub func cmp = (self, BigInt other, out int) {
        if self.len != other.len {
            if self.len > other.len {
                return 1
            }
            return -1
        }
        var int i = self.len - 1
        while i >= 0 {
            var int a = self.get(i)
            var int b = other.get(i)
            if a != b {
                if a > b {
                    return 1
                }
                return -1
            }
            i = i - 1
        }
        return 0
    }

    pub func add = (self, BigInt a, BigInt b, out BigInt) {
        var int max_len = a.len
        if b.len > max_len {
            max_len = b.len
        }
        self.ensure(max_len + 2)
        var int carry = 0
        var int i = 0
        while i < max_len || carry != 0 {
            var int sum = carry
            if i < a.len {
                sum = sum + a.get(i)
            }
            if i < b.len {
                sum = sum + b.get(i)
            }
            self.set(i, sum & 4294967295)
            carry = sum >> 32
            i = i + 1
        }
        self.len = i
        while self.len > 1 {
            var int top = self.get(self.len - 1)
            if top != 0 {
                break
            }
            self.len = self.len - 1
        }
        return self
    }

    pub func sub = (self, BigInt a, BigInt b, out BigInt) {
        self.ensure(a.len)
        var int borrow = 0
        var int i = 0
        while i < a.len {
            var int diff = a.get(i) - borrow
            if i < b.len {
                diff = diff - b.get(i)
            }
            if diff < 0 {
                diff = diff + 4294967296
                borrow = 1
            } else {
                borrow = 0
            }
            self.set(i, diff)
            i = i + 1
        }
        self.len = a.len
        while self.len > 1 {
            var int top = self.get(self.len - 1)
            if top != 0 {
                break
            }
            self.len = self.len - 1
        }
        return self
    }

    pub func mul = (self, BigInt a, BigInt b, out BigInt) {
        var int new_len = a.len + b.len
        var Buffer tmp = Buffer()
        tmp.alloc(new_len)
        var int i = 0
        while i < a.len {
            var uint64 carry = 0
            var int j = 0
            while j < b.len || carry != 0 {
                var uint64 cur = (tmp.load(j + i) as uint64) + carry
                if j < b.len {
                    cur = cur + (a.get(i) as uint64) * (b.get(j) as uint64)
                }
                tmp.store(j + i, cur as uint32)
                carry = cur >> 32
                j = j + 1
            }
            i = i + 1
        }
        self.ensure(new_len)
        self.clear(new_len)
        var int k = 0
        while k < new_len {
            self.set(k, tmp.load(k) as uint64)
            k = k + 1
        }
        self.len = new_len
        while self.len > 1 {
            if self.get(self.len - 1) != 0 {
                break
            }
            self.len = self.len - 1
        }
        return self
    }

    pub func div = (self, BigInt a, BigInt b, var BigInt remainder, out BigInt) {
        self.ensure(a.len + b.len + 1)
        self.clear(self.digits.cap)
        self.len = 1
        remainder.ensure(a.len + 1)
        remainder.clear(remainder.digits.cap)
        remainder.len = 1

        var int i = a.len * 32 - 1
        while i >= 0 {
            var uint64 carry = 0
            var int j = 0
            while j < remainder.len {
                var uint64 val = (remainder.digits.load(j) as uint64 << 1) + carry
                remainder.digits.store(j, val as uint32)
                carry = val >> 32
                j = j + 1
            }
            if carry != 0 {
                if remainder.len >= remainder.digits.cap {
                    var int nc = remainder.digits.cap * 2
                    remainder.digits.grow(nc)
                }
                remainder.digits.store(remainder.len, carry as uint32)
                remainder.len = remainder.len + 1
            }

            var int word = i / 32
            var int bit = i % 32
            if word < a.len {
                if ((a.digits.load(word) as int) & (1 << bit)) != 0 {
                    remainder.digits.store(0, (remainder.digits.load(0) as int | 1) as uint32)
                }
            }

            var int cmp_result = 0
            if remainder.len != b.len {
                if remainder.len > b.len {
                    cmp_result = 1
                } else {
                    cmp_result = -1
                }
            } else {
                var int cj = remainder.len - 1
                while cj >= 0 {
                    var int rd = remainder.digits.load(cj) as int
                    var int bd = b.digits.load(cj) as int
                    if rd != bd {
                        if rd > bd {
                            cmp_result = 1
                        } else {
                            cmp_result = -1
                        }
                        break
                    }
                    cj = cj - 1
                }
            }

            if cmp_result >= 0 {
                var int borrow = 0
                var int sj = 0
                while sj < remainder.len {
                    var int diff = (remainder.digits.load(sj) as int) - borrow
                    if sj < b.len {
                        diff = diff - (b.digits.load(sj) as int)
                    }
                    if diff < 0 {
                        diff = diff + 4294967296
                        borrow = 1
                    } else {
                        borrow = 0
                    }
                    remainder.digits.store(sj, diff as uint32)
                    sj = sj + 1
                }
                while remainder.len > 1 {
                    if (remainder.digits.load(remainder.len - 1) as int) != 0 {
                        break
                    }
                    remainder.len = remainder.len - 1
                }

                if self.digits.cap <= word {
                    var int nc = self.digits.cap
                    while nc <= word {
                        nc = nc * 2
                    }
                    self.digits.grow(nc)
                }
                if word >= self.len {
                    self.len = word + 1
                }
                self.digits.store_or(word, (1 << bit) as uint32)
            }

            i = i - 1
        }
        while self.len > 1 {
            if (self.digits.load(self.len - 1) as int) != 0 {
                break
            }
            self.len = self.len - 1
        }
        return self
    }

    pub func to_digit = (self, out int) {
        if self.len == 1 {
            return self.get(0)
        }
        if self.len == 2 {
            return self.get(1) << 32 | self.get(0)
        }
        return -1
    }
}
