{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "nomen",
			"camelcase": "Nomen",
			"title": "Nomen",
			"scope": "source.nomen",
			"file-types": ["nm"],
			"injection-regex": "^(nomen|nm)$",
			"highlights": "queries/highlights.scm",
			"injections": "queries/injections.scm",
			"locals": "queries/locals.scm"
		}
	],
	"metadata": {
		"version": "0.1.0",
		"license": "ISC",
		"description": "Tree-sitter grammar for the Nomen programming language",
		"links": {
			"repository": "https://github.com/andrewjk/nomen"
		}
	},
	"bindings": {
		"c": false,
		"go": false,
		"node": false,
		"python": false,
		"rust": false,
		"swift": false,
		"zig": false
	}
}
