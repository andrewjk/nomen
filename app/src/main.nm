import System
import System/Controls

const int WIN_W = 400
const int WIN_H = 500
const int MAX_TODOS = 6

pub func main = () {
	var Window win = Window("Nomen Todo", WIN_W, WIN_H)

	var Text title = Text(win)
	title.set_text("Todo List")

	var CheckBox cb0 = CheckBox(win)
	var CheckBox cb1 = CheckBox(win)
	var CheckBox cb2 = CheckBox(win)
	var CheckBox cb3 = CheckBox(win)
	var CheckBox cb4 = CheckBox(win)
	var CheckBox cb5 = CheckBox(win)

	cb0.set_title("Learn Nomen")
	cb1.set_title("Build a GUI app")
	cb2.set_title("Ship it")
	cb3.set_hidden(true)
	cb4.set_hidden(true)
	cb5.set_hidden(true)

	var int todo_count = 3

	var TextBox input = TextBox(win)
	input.set_text("Type a new todo...")
	var Button add_btn = Button(win, "Add")

	// A two-column grid. The title and each checkbox span both columns (full
	// width); the input and Add button share the final row.
	var Container grid = Grid(2, 8)
	grid.padding = 16
	grid.add(title.handle, 0, 30, 2)
	grid.add(cb0.handle, 0, 24, 2)
	grid.add(cb1.handle, 0, 24, 2)
	grid.add(cb2.handle, 0, 24, 2)
	grid.add(cb3.handle, 0, 24, 2)
	grid.add(cb4.handle, 0, 24, 2)
	grid.add(cb5.handle, 0, 24, 2)
	grid.add(input.handle, 0, 24, 1)
	grid.add(add_btn.handle, 0, 32, 1)
	grid.layout(win)

	win.show()

	while win.is_visible() {
		var int had_click = Window.process_events()

		if had_click == 1 {
			// Re-layout on any click (checkbox toggle or otherwise). Hidden
			// controls are skipped by the grid automatically. The window size
			// is unchanged, so mark the tree dirty to pick up any content or
			// visibility change before measuring.
			grid.mark_dirty(grid.root_index())
			grid.layout(win)

			// Hit-test the Add button.
			var int cx = win.click_x()
			var int cy = win.click_y()
			if grid.contains(add_btn.handle, cx, cy) {
				if todo_count < MAX_TODOS {
					var string new_text = input.get_text()
					if todo_count == 3 {
						cb3.set_title(new_text)
						cb3.set_hidden(false)
					}
					if todo_count == 4 {
						cb4.set_title(new_text)
						cb4.set_hidden(false)
					}
					if todo_count == 5 {
						cb5.set_title(new_text)
						cb5.set_hidden(false)
					}
				todo_count = todo_count + 1
				input.set_text("")
				grid.mark_dirty(grid.root_index())
				grid.layout(win)
				}
			}
		}
	}
}
