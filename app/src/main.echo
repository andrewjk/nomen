import System
import System/Controls

const int PAD = 16
const int WIN_W = 400
const int WIN_H = 500

// Flip layout-Y (top-left origin) to NSView-Y (bottom-left origin).
func flip_y = (int content_h, int ly, int lh, out int) {
	return content_h - ly - lh - PAD
}

pub func main = () {
	var Window win = Window.create("Echo Todo", WIN_W, WIN_H)

	// ── Todo data ──
	var string text_0 = "Learn Echo"
	var string text_1 = "Build a GUI app"
	var string text_2 = "Ship it"
	var bool done_0 = false
	var bool done_1 = false
	var bool done_2 = false
	var bool prev_0 = false
	var bool prev_1 = false
	var bool prev_2 = false

	// ── Create controls ──
	var Text title = Text.create(win)
	title.set_text("Todo List")

	var CheckBox cb0 = CheckBox.create(win)
	cb0.set_title(text_0)
	var CheckBox cb1 = CheckBox.create(win)
	cb1.set_title(text_1)
	var CheckBox cb2 = CheckBox.create(win)
	cb2.set_title(text_2)

	var TextBox input = TextBox.create(win)
	input.set_text("Type a new todo...")

	var Button add_btn = Button.create(win, "Add")

	// ── Build layout tree ──
	var Layout l = Layout()
	init_layout(ref l, 32)
	var int root = add_vstack(ref l, -1, 8)
	var int n_title = add_leaf(ref l, root, 200, 30)
	var int n_cb0 = add_leaf(ref l, root, WIN_W - PAD * 2, 24)
	var int n_cb1 = add_leaf(ref l, root, WIN_W - PAD * 2, 24)
	var int n_cb2 = add_leaf(ref l, root, WIN_W - PAD * 2, 24)
	var int n_input = add_leaf(ref l, root, WIN_W - PAD * 2 - 90, 24)
	var int n_btn = add_leaf(ref l, root, 80, 32)

	// ── Measure + arrange ──
	var int avail_w = WIN_W - PAD * 2
	var int avail_h = WIN_H - PAD * 2
	run_layout(ref l, 7, root, avail_w, avail_h)

	// ── Apply frames to native controls (flip Y for bottom-left origin) ──
	var int ch = win.content_height()
	title.set_frame(l.rx.load_int(n_title) + PAD, flip_y(ch, l.ry.load_int(n_title), l.rh.load_int(n_title)), l.rw.load_int(n_title), l.rh.load_int(n_title))
	cb0.set_frame(l.rx.load_int(n_cb0) + PAD, flip_y(ch, l.ry.load_int(n_cb0), l.rh.load_int(n_cb0)), l.rw.load_int(n_cb0), l.rh.load_int(n_cb0))
	cb1.set_frame(l.rx.load_int(n_cb1) + PAD, flip_y(ch, l.ry.load_int(n_cb1), l.rh.load_int(n_cb1)), l.rw.load_int(n_cb1), l.rh.load_int(n_cb1))
	cb2.set_frame(l.rx.load_int(n_cb2) + PAD, flip_y(ch, l.ry.load_int(n_cb2), l.rh.load_int(n_cb2)), l.rw.load_int(n_cb2), l.rh.load_int(n_cb2))
	input.set_frame(l.rx.load_int(n_input) + PAD, flip_y(ch, l.ry.load_int(n_input), l.rh.load_int(n_input)), l.rw.load_int(n_input), l.rh.load_int(n_input))
	add_btn.set_frame(l.rx.load_int(n_btn) + PAD, flip_y(ch, l.ry.load_int(n_btn), l.rh.load_int(n_btn)), l.rw.load_int(n_btn), l.rh.load_int(n_btn))

	win.show()

	// ── Event loop: poll states, manually re-layout on change ──
	while true {
		var int had_click = Window.process_events()

		// Read current checkbox states
		done_0 = cb0.is_checked()
		done_1 = cb1.is_checked()
		done_2 = cb2.is_checked()

		// If any checkbox changed, update labels and re-layout
		if done_0 != prev_0 || done_1 != prev_1 || done_2 != prev_2 {
			if done_0 != prev_0 {
				if done_0 {
					cb0.set_title("[x] " + text_0)
				} else {
					cb0.set_title(text_0)
				}
				prev_0 = done_0
			}
			if done_1 != prev_1 {
				if done_1 {
					cb1.set_title("[x] " + text_1)
				} else {
					cb1.set_title(text_1)
				}
				prev_1 = done_1
			}
			if done_2 != prev_2 {
				if done_2 {
					cb2.set_title("[x] " + text_2)
				} else {
					cb2.set_title(text_2)
				}
				prev_2 = done_2
			}

			// Re-run layout and re-apply frames
			run_layout(ref l, 7, root, avail_w, avail_h)
			ch = win.content_height()
			title.set_frame(l.rx.load_int(n_title) + PAD, flip_y(ch, l.ry.load_int(n_title), l.rh.load_int(n_title)), l.rw.load_int(n_title), l.rh.load_int(n_title))
			cb0.set_frame(l.rx.load_int(n_cb0) + PAD, flip_y(ch, l.ry.load_int(n_cb0), l.rh.load_int(n_cb0)), l.rw.load_int(n_cb0), l.rh.load_int(n_cb0))
			cb1.set_frame(l.rx.load_int(n_cb1) + PAD, flip_y(ch, l.ry.load_int(n_cb1), l.rh.load_int(n_cb1)), l.rw.load_int(n_cb1), l.rh.load_int(n_cb1))
			cb2.set_frame(l.rx.load_int(n_cb2) + PAD, flip_y(ch, l.ry.load_int(n_cb2), l.rh.load_int(n_cb2)), l.rw.load_int(n_cb2), l.rh.load_int(n_cb2))
			input.set_frame(l.rx.load_int(n_input) + PAD, flip_y(ch, l.ry.load_int(n_input), l.rh.load_int(n_input)), l.rw.load_int(n_input), l.rh.load_int(n_input))
			add_btn.set_frame(l.rx.load_int(n_btn) + PAD, flip_y(ch, l.ry.load_int(n_btn), l.rh.load_int(n_btn)), l.rw.load_int(n_btn), l.rh.load_int(n_btn))
		}

		// Hit-test the Add button
		if had_click == 1 {
			var int cx = win.click_x()
			var int cy = win.click_y()
			var int bx = l.rx.load_int(n_btn) + PAD
			var int by = l.ry.load_int(n_btn) + PAD
			var int bw = l.rw.load_int(n_btn)
			var int bh = l.rh.load_int(n_btn)
			if cx >= bx {
				if cx <= bx + bw {
					if cy >= by {
						if cy <= by + bh {
							// Add button clicked — read textbox and update title
							var string new_text = input.get_text()
							title.set_text("Add: " + new_text)
							input.set_text("")
						}
					}
				}
			}
		}
	}
}
