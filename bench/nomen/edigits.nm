import System

const ln10 = 2.3025850929940455
const two_pi = 6.283185307179586

func test_k = (int n, int k, out bool) {
	if k < 0 {
		return false
	}
	const float fk = k as float
	const float fn = n as float
	const float ln_k_fact = fk * (Math.log(fk) - 1.0) + 0.5 * Math.log(two_pi)
	const float log10_k_fact = ln_k_fact / ln10
	return log10_k_fact >= fn + 50.0
}

func binary_search = (int n, out int) {
	var a = 0
	var b = 1
	while test_k(n, b) == false {
		a = b
		b = b * 2
	}
	while b - a > 1 {
		const int m = (a + b) / 2
		if test_k(n, m) {
			b = m
		} else {
			a = m
		}
	}
	return b
}

// sum_terms(a, b) computes p/q = a! * sum_{i=a+1}^{b} 1/i!
// via a divide-and-conquer product tree so that all multiplications
// are balanced (Karatsuba-friendly) and only one final division is
// needed.  Mirrors the Rust/Go/Zig reference implementations.
func sum_terms = (int a, int b, ref BigInt out_p, ref BigInt out_q) {
	if b == a + 1 {
		out_p.set_int(1)
		out_q.set_int(b)
		return
	}
	const int mid = (a + b) / 2
	var pl = BigInt()
	var ql = BigInt()
	sum_terms(a, mid, ref pl, ref ql)
	var pr = BigInt()
	var qr = BigInt()
	sum_terms(mid, b, ref pr, ref qr)

	// p = pl * qr + pr
	var scratch = BigInt()
	var product = BigInt()
	product.mul_to(pl, qr, ref scratch)
	out_p.add_to(product, pr)

	// q = ql * qr
	out_q.mul_to(ql, qr, ref scratch)
}

// Compute 10^exp via binary exponentiation (repeated squaring).
func pow10 = (int exp, ref BigInt result, ref BigInt tmp, ref BigInt scratch) {
	result.set_int(1)
	var sq_base = BigInt()
	sq_base.set_int(10)
	var int e = exp
	while e > 0 {
		if e % 2 == 1 {
			tmp.mul_to(result, sq_base, ref scratch)
			result.copy_from(tmp)
		}
		tmp.mul_to(sq_base, sq_base, ref scratch)
		sq_base.copy_from(tmp)
		e = e / 2
	}
	sq_base.digits.destroy()
}

// Append the decimal digits of x to the chunk buffer at slots
// [digit_count, digit_count + span), low 18-digit chunk first — the same
// layout the old repeated-divide-by-10^18 loop produced, so the trim and
// print walk below is unchanged. Divide-and-conquer radix conversion (the
// strategy math/big and ibig use inside their decimal to_string, whose
// output this replaces): split x at a power of 10^18 whose limb count is
// at most half of x's, recurse into the low half then the high half. That
// turns the O(len^2) pass of single-limb divisions — a latency-bound
// serial chain, since each remainder feeds the next division — into a
// handful of balanced Knuth-D divmods.
//
// `span` is the exact number of 18-digit slots this subtree covers. The
// split powers sit on chunk boundaries (10^(18*2^h) spans exactly 2^h
// chunks), so each leaf writes its own span with zero fill above its own
// magnitude — those slots are real zero digits of the number — and the
// root's upper-bound padding at the very top is trimmed afterwards, like
// the old loop's final partial chunk.
func append_digits = (
	ref BigInt x { digits },
	int span,
	ref Buffer<int> chunks,
	ref int digit_count,
) {
	// Base case: short value — straight single-limb divmod chain by 10^18,
	// storing 18 digits per chunk (zero-padded on top), low chunk first,
	// then zero-fill the span's remaining slots.
	if x.len <= 7 {
		var one = BigInt()
		one.set_int(1)
		var q18 = BigInt()
		q18.set_u64(1000000000000000000)
		var d1 = BigInt()
		var d2 = BigInt()
		var written = 0
		while x.cmp(one) >= 0 && written < span {
			d1.div_to(x, q18, ref d2)
			var uint64 chunk = d2.get(0)
			var c = 0
			while c < 18; c += 1 {
				const int idx = digit_count + c
				if idx >= 0 && idx < chunks.cap {
					chunks.store_int(idx, (chunk % 10) as int)
				}
				chunk = chunk / 10
			}
			digit_count = digit_count + 18
			written += 1
			x.copy_from(d1)
		}
		while written < span; written += 1 {
			var c = 0
			while c < 18; c += 1 {
				const int idx = digit_count + c
				if idx >= 0 && idx < chunks.cap {
					chunks.store_int(idx, 0)
				}
			}
			digit_count = digit_count + 18
		}
		return
	}

	// Split power: the largest 10^(18*2^h) whose limb count is at most half
	// of x's, so both halves are strictly smaller than x and the quotient is
	// never zero. Squaring doubles the limb count, so the loop squares only
	// while the current rung is at most a QUARTER of x — checking halves
	// before squaring lets the squared rung reach x.len limbs, where the
	// divisor can exceed x itself (quotient 0, the low half stops shrinking
	// and the recursion never terminates). The chunk span doubles alongside.
	var p = BigInt()
	p.set_u64(1000000000000000000)
	var pt = BigInt()
	var ps = BigInt()
	var int span_low = 1
	while p.len * 4 <= x.len {
		pt.mul_to(p, p, ref ps)
		p.copy_from(pt)
		span_low = span_low + span_low
	}
	var hi = BigInt()
	var lo = BigInt()
	hi.div_to(x, p, ref lo)
	// The buffer is low-chunk-first, so the low half's slots come first.
	append_digits(ref lo, span_low, ref chunks, ref digit_count)
	append_digits(ref hi, span - span_low, ref chunks, ref digit_count)
}

pub func main = (Init init) {
	var n = 27
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	const int k = binary_search(n)

	// Compute e = sum_{i=0}^{k-1} 1/i! as a fraction p/q via product tree.
	var p = BigInt()
	var q = BigInt()
	sum_terms(0, k - 1, ref p, ref q)

	// Add the 1/0! = 1 term: (p + q) / q = p/q + 1.
	var p_plus_q = BigInt()
	p_plus_q.add_to(p, q)

	// answer = (p + q) * 10^(n-1) / q
	var tmp = BigInt()
	var scratch = BigInt()
	var power = BigInt()
	pow10(n - 1, ref power, ref tmp, ref scratch)

	var numerator = BigInt()
	numerator.mul_to(p_plus_q, power, ref scratch)

	var answer = BigInt()
	var div_rem = BigInt()
	answer.div_to(numerator, q, ref div_rem)

	// Extract digits with a divide-and-conquer radix conversion (see
	// append_digits). The chunk buffer keeps the old layout — 18 digits per
	// chunk, low chunk first, sized from n. The root span is an upper bound
	// derived from the limb count (each limb holds < 10^19.3 digits, so 20
	// per limb plus slack never under-counts); the recursion writes exactly
	// that many slots and the trim drops the padding at the top.
	var work = BigInt()
	work.copy_from(answer)
	const int span_root = (work.len * 20) / 18 + 4
	const int digit_cap = span_root * 18 + 18
	var digits = Buffer<int>()
	digits.alloc_int(digit_cap)
	var digit_count = 0

	append_digits(ref work, span_root, ref digits, ref digit_count)

	// Trim spurious leading zeros introduced by the final bulk chunk. The
	// extraction above ends with digit_count <= digit_cap, but the verifier
	// can't carry that fact through the loop — hoist the relation once so
	// the trim loads and the print walk below discharge their access
	// constraints against it (pos < digit_count <= cap).
	if digit_count <= digits.cap {
		var int top = digit_count - 1
		while top >= 0 && top < digit_count {
			if digits.load_int(top) != 0 {
				break
			}
			top -= 1
		}
		digit_count = top + 1
		// The reassignment above kills the hoisted cap fact (the verifier
		// invalidates bounds on any redefined variable), so re-establish it
		// for the print walk — digit_count only shrank, so it still holds.
		if digit_count <= digits.cap {
			// Buffer the whole output and write it once (the reference
			// implementations buffer stdout too — Rust via BufWriter, Go via
			// the buffered os.Stdout writer). Groups of 10 digits, each group
			// trailed by "\t:<digits-so-far>", like the references; the Nomen
			// format also prints the decimal point after the leading "2".
			var sb = StringBuilder()
			const string glyphs = "0123456789"
			var int pos = digit_count - 1
			var int until_next = 10
			while pos >= 0 && pos < digit_count {
				const int d = digits.load_int(pos)
				const char glyph = glyphs.at_or(d, '0')
				sb.append(glyph)
				if pos == digit_count - 1 && digit_count > 1 {
					sb.append(".")
				}
				pos -= 1
				until_next -= 1
				if until_next == 0 || pos < 0 {
					sb.append("\t:")
					sb.append_int(digit_count - 1 - pos)
					sb.append("\n")
					until_next = 10
				}
			}
			Console.write(sb.to_string())
		}
	}
}
