import System

const ln10 = 2.3025850929940455
const two_pi = 6.283185307179586

func test_k = (int n, int k, out bool) {
	if k < 0 {
		return false
	}
	var float fk = k as float
	var float fn = n as float
	var float ln_k_fact = fk * (Math.log(fk) - 1.0) + 0.5 * Math.log(two_pi)
	var float log10_k_fact = ln_k_fact / ln10
	return log10_k_fact >= fn + 50.0
}

func binary_search = (int n, out int) {
	var a = 0
	var b = 1
	while test_k(n, b) == false {
		a = b
		b = b * 2
	}
	while b - a > 1 {
		var int m = (a + b) / 2
		if test_k(n, m) {
			b = m
		} else {
			a = m
		}
	}
	return b
}

// sum_terms(a, b) computes p/q = a! * sum_{i=a+1}^{b} 1/i!
// via a divide-and-conquer product tree so that all multiplications
// are balanced (Karatsuba-friendly) and only one final division is
// needed.  Mirrors the Rust/Go/Zig reference implementations.
func sum_terms = (int a, int b, ref BigInt out_p, ref BigInt out_q) {
	if b == a + 1 {
		out_p.set_int(1)
		out_q.set_int(b)
		return
	}
	var int mid = (a + b) / 2
	var pl = BigInt()
	var ql = BigInt()
	sum_terms(a, mid, ref pl, ref ql)
	var pr = BigInt()
	var qr = BigInt()
	sum_terms(mid, b, ref pr, ref qr)

	// p = pl * qr + pr
	var scratch = BigInt()
	var product = BigInt()
	product.mul_to(pl, qr, ref scratch)
	out_p.add_to(product, pr)

	// q = ql * qr
	out_q.mul_to(ql, qr, ref scratch)

	pl.digits.destroy()
	ql.digits.destroy()
	pr.digits.destroy()
	qr.digits.destroy()
	scratch.digits.destroy()
	product.digits.destroy()
}

// Compute 10^exp via binary exponentiation (repeated squaring).
func pow10 = (int exp, ref BigInt result, ref BigInt tmp, ref BigInt scratch) {
	result.set_int(1)
	var sq_base = BigInt()
	sq_base.set_int(10)
	var int e = exp
	while e > 0 {
		if e % 2 == 1 {
			tmp.mul_to(result, sq_base, ref scratch)
			result.copy_from(tmp)
		}
		tmp.mul_to(sq_base, sq_base, ref scratch)
		sq_base.copy_from(tmp)
		e = e / 2
	}
	sq_base.digits.destroy()
}

pub func main = (Init init) {
	var n = 27
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	var int k = binary_search(n)

	// Compute e = sum_{i=0}^{k-1} 1/i! as a fraction p/q via product tree.
	var p = BigInt()
	var q = BigInt()
	sum_terms(0, k - 1, ref p, ref q)

	// Add the 1/0! = 1 term: (p + q) / q = p/q + 1.
	var p_plus_q = BigInt()
	p_plus_q.add_to(p, q)

	// answer = (p + q) * 10^(n-1) / q
	var tmp = BigInt()
	var scratch = BigInt()
	var power = BigInt()
	pow10(n - 1, ref power, ref tmp, ref scratch)

	var numerator = BigInt()
	numerator.mul_to(p_plus_q, power, ref scratch)

	var answer = BigInt()
	var div_rem = BigInt()
	answer.div_to(numerator, q, ref div_rem)

	// Extract digits from answer using in-place bulk divmod by 10^18.
	var one = BigInt()
	one.set_int(1)
	var work = BigInt()
	work.copy_from(answer)
	var digits = Buffer<int>()
	digits.alloc_int(5020)
	var digit_count = 0
	var q_e18 = BigInt()
	q_e18.set_u64(1000000000000000000)

	while work.cmp(one) >= 0 {
		work.div_to(work, q_e18, ref div_rem)
		var uint64 chunk = div_rem.get(0)
		var c = 0
		while c < 18 {
			var int idx = digit_count + c
			// `idx = digit_count + c` is a sum of two runtime variables the
			// verifier can't relate to `digits.cap` (5020), so guard the
			// store explicitly. `digits.cap` is a pub property on Buffer.
			if idx >= 0 && idx < digits.cap {
				digits.store_int(idx, (chunk % 10) as int)
			}
			chunk = chunk / 10
			c = c + 1
		}
		digit_count = digit_count + 18
	}

	// Trim spurious leading zeros introduced by the final bulk chunk.
	while digit_count > 1 {
		if digits.load_int(digit_count - 1) != 0 {
			break
		}
		digit_count = digit_count - 1
	}

	var int pos = digit_count - 1
	while pos >= 0 {
		Console.write(digits.load_int(pos).to_string())
		if pos == digit_count - 1 && digit_count > 1 {
			Console.write(".")
		}
		pos = pos - 1
		if (digit_count - 1 - pos) % 10 == 0 && pos >= 0 {
			Console.write("\t:")
			Console.write((digit_count - 1 - pos).to_string())
			Console.write("\n")
		}
	}
	if (digit_count - 1 - pos) % 10 != 0 {
		Console.write("\t:")
		Console.write(digit_count.to_string())
	}
	Console.write("\n")
}
