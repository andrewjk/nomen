import System

// json-serde benchmark — mirrors the Go/Zig versions: read a GeoJSON document,
// parse it into a tree of JsonNode, and serialize it back. Repeats the
// parse+serialize n times.
//
// Usage: json-serde [sample.json] [n]
// The input defaults to bench/sample.json. Unlike Go/Zig this does NOT
// md5-hash the output (see bench/README.md); it prints the serialized length
// as a verifiable checksum instead.

pub func main = (Init init) {
	var filename = "bench/sample.json"
	if init.argc > 1 {
		filename = init.args.at(1)
	}
	var n = 10
	if init.argc > 2 {
		n = parse_int(init.args.at(2))
	}

	var f = File()
	f.open(filename, "r")
	const string text = f.readAll()
	f.close()

	// Parse once and serialize, like the Go version's first pass.
	var tree = JsonTree()
	const int root = Json.parse(text, ref tree)
	Console.write(Json.stringify(ref tree, root).length.to_string())
	Console.write("\n")

	// Re-parse and re-serialize n times, accumulating the serialized length.
	// The tree pool is reset per iteration (no per-node malloc/free).
	var total = 0
	var i = 0
	while i < n {
		const int r = Json.parse(text, ref tree)
		total = total + Json.stringify(ref tree, r).length
		i = i + 1
	}
	Console.write(total.to_string())
	Console.write("\n")
}
