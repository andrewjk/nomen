import System

func nsieve = (int n) {
	if n < 3 {
		Console.write("Primes up to \{n} 0\n")
		return
	}
	// Bit-packed sieve using 64-bit slots (64 candidates per int). The
	// store_or_int / load_int accessors are inlined by the codegen to single
	// instructions; bit-packing shrinks the working set 64× so the flag array
	// fits in L2/L3 cache (for n=10M this is ~1.25 MB instead of 80 MB).
	// count = 1 accounts for the only even prime (2); the outer loop then
	// walks only odd candidates, and the inner marking loop starts at i*i
	// (smaller odd composites were already marked by smaller primes) and
	// steps by 2*i to hit only odd multiples.
	const int slot_count = (n + 63) / 64
	var flags = Buffer<int>()
	flags.alloc_int(slot_count)

	var count = 1
	var i = 3
	while i < n {
		const int slot = i >> 6
		const int bit = 1 << (i & 63)
		// `slot = i >> 6` is bounded by `(n-1) >> 6 < slot_count == flags.cap`,
		// but the verifier can't propagate that through the shift, so guard
		// explicitly against `flags.cap` (a pub property on Buffer). The
		// `slot >= 0` half is needed because the constraint is a strict &&
		// of both halves (`i >= 0 && i < self.cap`).
		if slot >= 0 && slot < flags.cap {
			if (flags.load_int(slot) & bit) == 0 {
				count += 1
				if i * i < n {
					var int j = i * i
					const int step = i * 2
					while j < n {
						const int j_slot = j >> 6
						if j_slot >= 0 && j_slot < flags.cap {
							flags.store_or_int(j_slot, 1 << (j & 63))
						}
						j = j + step
					}
				}
			}
		}
		i = i + 2
	}
	Console.write("Primes up to \{n} \{count}\n")
}

pub func main = (Init init) {
	var n = 4
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}

	nsieve(10000 << n)
	nsieve(10000 << (n - 1))
	nsieve(10000 << (n - 2))
}
