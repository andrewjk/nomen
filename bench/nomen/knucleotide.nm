import System

// knucleotide benchmark (single-threaded port of the Go version).
// Reads a FASTA file, extracts the sequence under the >THREE header,
// packs each base into 2 bits, and counts k-nucleotide sequences.
// Note: avoids string concatenation (unreliable in loops), writing
// output piece by piece instead.

func base_code = (int c, out int) {
	return ((c >> 1) & 3)
}

func nt = (int code, out string) {
	if code == 0 {
		return "A"
	}
	if code == 1 {
		return "C"
	}
	if code == 2 {
		return "T"
	}
	return "G"
}

// write the nucleotides of a packed key, left to right
func write_nucleotides = (int key, int k) {
	var j = 0
	while j < k; j += 1 {
		const int code = (key >> (2 * (k - 1 - j))) & 3
		Console.write(nt(code))
	}
}

// write a value (already scaled by 1000) as whole.frac with 3 decimals
func write_number = (int val) {
	const int whole = val / 1000
	const int frac = val % 1000
	Console.write(whole.to_string())
	Console.write(".")
	if frac < 100 {
		Console.write("0")
	}
	if frac < 10 {
		Console.write("0")
	}
	Console.write(frac.to_string())
}

// pack a nucleotide string into a key
func pack = (string s, out int) {
	var key = 0
	var i = 0
	const int len = s.length
	while i < len; i += 1 {
		key = (key << 2) | (((s.at(i) as int) >> 1) & 3)
	}
	return key
}

func count_seq = (ref Buffer<int> data, int n, int target, int k, out int) {
	// `data` is sized to `n` by the caller; guard once so the inner
	// loads verify via transitive bound propagation
	// (`j < k <= cap ⇒ j < cap`). The `i + k - 1` access below uses an
	// additional per-iteration guard because the verifier can't relate
	// `i + k - 1` (variable offset) to `data.cap`.
	if k <= data.cap && n <= data.cap {
		const int mask = (1 << (2 * k)) - 1
		var key = 0
		var j = 0
		while j < k; j += 1 {
			key = (key << 2) | data.load_int(j)
		}
		var total = 0
		if key == target {
			total += 1
		}
		var i = 1
		const int end = n - k
		while i <= end; i += 1 {
			const int next = i + k - 1
			if next >= 0 && next < data.cap {
				key = ((key << 2) | data.load_int(next)) & mask
			}
			if key == target {
				total += 1
			}
		}
		return total
	}
	return 0
}

func write_freq = (ref Buffer<int> data, int n, int k) {
	const int limit = 1 << (2 * k)
	var freq = Buffer<int>()
	freq.alloc_int(limit)

	// Guard the data accesses once: `k <= data.cap` covers `j < k`, and
	// `n <= data.cap` covers the sliding window's `i + k - 1` (with a
	// per-iteration guard since the verifier can't fold `i + k - 1`).
	if k <= data.cap && n <= data.cap {
		if n >= k {
			const int mask = limit - 1
			var key = 0
			var j = 0
			while j < k; j += 1 {
				key = (key << 2) | data.load_int(j)
			}
			if key >= 0 && key < freq.cap {
				freq.store_int(key, freq.load_int(key) + 1)
			}
			var i = 1
			const int end = n - k
			while i <= end; i += 1 {
				const int next = i + k - 1
				if next >= 0 && next < data.cap {
					key = ((key << 2) | data.load_int(next)) & mask
				}
				if key >= 0 && key < freq.cap {
					freq.store_int(key, freq.load_int(key) + 1)
				}
			}
		}
	}

	var keys = Buffer<int>()
	var counts = Buffer<int>()
	keys.alloc_int(limit)
	counts.alloc_int(limit)
	var found = 0
	// Hoist the cap check once: `freq.cap`, `keys.cap`, `counts.cap` were
	// all just set to `limit`, but the verifier can't see that fact
	// symbolically, so establish it explicitly. Then `kk < limit <= cap`
	// propagates transitively to the inner accesses.
	if limit <= freq.cap && limit <= keys.cap && limit <= counts.cap {
		var kk = 0
		while kk < limit; kk += 1 {
			const int c = freq.load_int(kk)
			if c > 0 {
				if found >= 0 && found < keys.cap && found < counts.cap {
					keys.store_int(found, kk)
					counts.store_int(found, c)
				}
				found += 1
			}
		}
	}

	var a = 0
	while a < found; a += 1 {
		var int best = a
		var int b = a + 1
		while b < found; b += 1 {
			if b >= 0 && b < counts.cap && best >= 0 && best < counts.cap {
				if counts.load_int(b) > counts.load_int(best) {
					best = b
				}
			}
		}
		if best != a {
			if a >= 0 && a < keys.cap && a < counts.cap && best >= 0 && best < keys.cap && best < counts.cap {
				const int tk = keys.load_int(a)
				const int tc = counts.load_int(a)
				keys.store_int(a, keys.load_int(best))
				counts.store_int(a, counts.load_int(best))
				keys.store_int(best, tk)
				counts.store_int(best, tc)
			}
		}
	}

	var int sum = n - k + 1
	if sum < 1 {
		sum = 1
	}
	var idx = 0
	while idx < found; idx += 1 {
		if idx >= 0 && idx < keys.cap && idx < counts.cap {
			const int code = keys.load_int(idx)
			const int c = counts.load_int(idx)
			const int pct = (c * 100000 + sum / 2) / sum
			write_nucleotides(code, k)
			Console.write(" ")
			write_number(pct)
			Console.write("\n")
		}
	}
}

func write_count = (ref Buffer<int> data, int n, string query) {
	const int k = query.length
	const int target = pack(query)
	const int c = count_seq(ref data, n, target, k)
	Console.write(c.to_string())
	Console.write("\t")
	Console.write(query)
	Console.write("\n")
}

pub func main = (Init init) {
	var filename = "25000_in"
	if init.argc > 1 {
		filename = init.args.at(1)
	}

	var f = File()
	f.open(filename, "r")
	const string text = f.readAll()
	f.close()

	var data = Buffer<int>()
	const int text_len = text.length
	data.alloc_int(text_len)
	var n = 0

	var i = 0
	var started = 0
	while i < text_len {
		const int c = text.at(i) as int
		if started == 1 {
			if c != 10 {
				if c != 13 {
					if n >= 0 && n < data.cap {
						data.store_int(n, base_code(c))
					}
					n += 1
				}
			}
			i += 1
		} else {
			var matched = 0
			if c == 62 {
				if i + 5 < text_len {
					if (text.at(i + 1) as int) == 84 {
						if (text.at(i + 2) as int) == 72 {
							if (text.at(i + 3) as int) == 82 {
								if (text.at(i + 4) as int) == 69 {
									if (text.at(i + 5) as int) == 69 {
										matched = 1
									}
								}
							}
						}
					}
				}
			}
			if matched == 1 {
				i += 6
				while i < text_len; i += 1 {
					if (text.at(i) as int) == 10 {
						i += 1
						break
					}
				}
				started = 1
			} else {
				i += 1
			}
		}
	}

	write_freq(ref data, n, 1)
	Console.write("\n")
	write_freq(ref data, n, 2)
	Console.write("\n")
	write_count(ref data, n, "GGT")
	write_count(ref data, n, "GGTA")
	write_count(ref data, n, "GGTATT")
	write_count(ref data, n, "GGTATTTTAATT")
	write_count(ref data, n, "GGTATTTTAATTTATAGT")
}
