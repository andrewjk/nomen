import System

func mbrot = (float cr, float ci, out int) {
	var zr = 0.0
	var zi = 0.0
	var tr = 0.0
	var ti = 0.0
	var outer = 0
	while outer < 10 {
		var inner = 0
		while inner < 5 {
			zi = (zr + zr) * zi + ci
			zr = tr - ti + cr
			tr = zr * zr
			ti = zi * zi
			inner = inner + 1
		}
		if tr + ti > 4.0 {
			return 0
		}
		outer = outer + 1
	}
	return 1
}

pub func main = (Init init) {
	var n = 200
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	const int size = (n + 7) / 8 * 8
	const int chunk_size = size / 8
	const float inv = 2.0 / (size as float)

	var checksum = 0
	var y = 0
	while y < size {
		const float ci = (y as float) * inv - 1.0
		var x = 0
		while x < chunk_size {
			var byte_val = 0
			var bit = 0
			while bit < 8 {
				const int xi = x * 8 + bit
				const float cr = (xi as float) * inv - 1.5
				const int r = mbrot(cr, ci)
				if r == 1 {
					byte_val = byte_val + (128 >> bit)
				}
				bit = bit + 1
			}
			checksum = checksum + byte_val
			x = x + 1
		}
		y = y + 1
	}

	Console.write("checksum \{checksum}\n")
}
