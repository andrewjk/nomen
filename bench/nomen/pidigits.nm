import System

pub func main = (Init init) {
	var n = 2000
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	var digits_printed = 0

	var k = BigInt(1)
	var n1 = BigInt(4)
	var n2 = BigInt(3)
	var d = BigInt(1)
	var one = BigInt(1)
	var two = BigInt(2)
	var ten = BigInt(10)
	var u = BigInt(0)
	var v = BigInt(0)
	var w = BigInt(0)
	var k2 = BigInt(0)
	var tmp = BigInt(0)
	var rem = BigInt(0)

	while true {
		u.div_to(n1, d, ref rem)
		v.div_to(n2, d, ref rem)

		if u.cmp(v) == 0 {
			Console.write(u.to_digit().to_string())
			digits_printed += 1

			if digits_printed >= n {
				Console.write("\t:\{digits_printed}")
				break
			}

			n1.mul_to(n1, ten, ref rem)
			n2.mul_to(n2, ten, ref rem)
			tmp.mul_to(u, d, ref rem)
			tmp.mul_to(tmp, ten, ref rem)
			n1.sub_to(n1, tmp)
			n2.sub_to(n2, tmp)
		} else {
			k2.mul_to(k, two, ref rem)
			tmp.sub_to(k2, one)
			u.mul_to(tmp, n1, ref rem)
			v.mul_to(n2, two, ref rem)
			tmp.sub_to(k, one)
			w.mul_to(tmp, n1, ref rem)
			n1.add_to(u, v)
			tmp.add_to(k, two)
			u.mul_to(tmp, n2, ref rem)
			n2.add_to(w, u)
			tmp.add_to(k2, one)
			d.mul_to(tmp, d, ref rem)
			k.add_to(k, one)
		}
	}
}
