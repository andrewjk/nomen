import System

mv struct TreeNode {
	var Box<TreeNode>? left = null
	var Box<TreeNode>? right = null
}

func create_tree = (int depth, out TreeNode) {
	if depth > 1 {
		const TreeNode left = create_tree(depth - 1)
		const TreeNode right = create_tree(depth - 1)
		var node = TreeNode()
		node.left = Box<TreeNode>(mv left)
		node.right = Box<TreeNode>(mv right)
		return node
	}
	var node = TreeNode()
	node.left = Box<TreeNode>(TreeNode())
	node.right = Box<TreeNode>(TreeNode())
	return node
}

func check_node = (ref Box<TreeNode>? node, out int) {
	if node == null {
		return 0
	}
	var sum = 1
	if node.left != null {
		sum = sum + check_node(ref node.left)
	}
	if node.right != null {
		sum = sum + check_node(ref node.right)
	}
	return sum
}

func check_tree = (mv TreeNode node, out int) {
	var boxed = Box<TreeNode>(mv node)
	return check_node(ref boxed)
}

pub func main = (Init init) {
	var n = 10
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	const min_depth = 4
	var int max_depth = n
	if min_depth + 2 > max_depth {
		max_depth = min_depth + 2
	}

	const TreeNode stretch_tree = create_tree(max_depth + 1)
	Console.write("stretch tree of depth \{max_depth + 1}\t check: \{check_tree(mv stretch_tree)}\n")

	const TreeNode long_lived_tree = create_tree(max_depth)

	var int depth = min_depth
	while depth <= max_depth {
		const int iterations = 1 << (max_depth - depth + min_depth)
		var sum = 0
		var i = 0
		while i < iterations; i += 1 {
			sum = sum + check_tree(create_tree(depth))
		}
		Console.write("\{iterations}\t trees of depth \{depth}\t check: \{sum}\n")
		depth = depth + 2
	}

	Console.write("long lived tree of depth \{max_depth}\t check: \{check_tree(mv long_lived_tree)}\n")
}
