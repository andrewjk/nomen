import System

class MerkleNode {
	var hash = 0
	var value = 0
	var has_hash = false
	var has_value = false
	mov MerkleNode? left = null
	mov MerkleNode? right = null
}

func make_merkle = (int depth, out MerkleNode) {
	if depth <= 0 {
		var node = MerkleNode()
		node.value = 1
		node.has_value = true
		return node
	}
	var MerkleNode left = make_merkle(depth - 1)
	var MerkleNode right = make_merkle(depth - 1)
	var node = MerkleNode()
	node.left = left
	node.right = right
	return node
}

func cal_hash = (ref MerkleNode node) {
	if node.has_hash {
		return
	}
	if node.has_value {
		node.hash = node.value
		node.has_hash = true
		return
	}
	if node.left != null {
		cal_hash(ref node.left)
	}
	if node.right != null {
		cal_hash(ref node.right)
	}
	var left_hash = 0
	if node.left != null {
		left_hash = node.left.hash
	}
	var right_hash = 0
	if node.right != null {
		right_hash = node.right.hash
	}
	node.hash = left_hash + right_hash
	node.has_hash = true
}

func check_merkle = (MerkleNode node, out int) {
	if !node.has_hash {
		return 0
	}
	if node.has_value {
		return 1
	}
	var left_ok = 1
	var right_ok = 1
	if node.left != null {
		left_ok = check_merkle(node.left)
	}
	if node.right != null {
		right_ok = check_merkle(node.right)
	}
	if left_ok == 1 && right_ok == 1 {
		return 1
	}
	return 0
}

pub func main = (Init init) {
	var n = 5
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	var min_depth = 4
	var int max_depth = n
	if min_depth + 2 > max_depth {
		max_depth = min_depth + 2
	}

	var int stretch_depth = max_depth + 1
	var MerkleNode stretch_tree = make_merkle(stretch_depth)
	cal_hash(ref stretch_tree)
	Console.write("stretch tree of depth \{stretch_depth}\t root hash: \{stretch_tree.hash} check: \{check_merkle(stretch_tree)}\n")

	var MerkleNode long_lived_tree = make_merkle(max_depth)

	var int depth = min_depth
	while depth <= max_depth {
		var int iterations = 1 << (max_depth - depth + min_depth)
		var sum = 0
		var i = 1
		while i <= iterations {
			var MerkleNode tree = make_merkle(depth)
			cal_hash(ref tree)
			sum = sum + tree.hash
			i = i + 1
		}
		Console.write("\{iterations}\t trees of depth \{depth}\t root hash sum: \{sum}\n")
		depth = depth + 2
	}

	cal_hash(ref long_lived_tree)
	Console.write("long lived tree of depth \{max_depth}\t root hash: \{long_lived_tree.hash} check: \{check_merkle(long_lived_tree)}\n")
}
