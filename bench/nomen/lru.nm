import System

// O(1) LRU cache: a doubly-linked list (arena-backed flat arrays indexed by
// stable node ids) paired with a Map<int,int> (key -> node id). Mirrors the
// reference implementations (Go container/list + map, Zig LinkedList +
// HashMap): move_to_end and eviction are O(1) instead of the O(n) shift the
// order-array version paid on every access.

struct LRU {
	var size = 0
	var keys = Map<int, int>()
	var nkeys = Buffer<int>()
	var nvals = Buffer<int>()
	var prevs = Buffer<int>()
	var nexts = Buffer<int>()
	var int head = -1
	var int tail = -1
	var count = 0

	func setup = (ref self, int sz) {
		self.size = sz
		self.nkeys.alloc_int(sz)
		self.nvals.alloc_int(sz)
		self.prevs.alloc_int(sz)
		self.nexts.alloc_int(sz)
	}

	func unlink = (ref self, int id) {
		if id >= 0 && id < self.prevs.cap && id < self.nexts.cap {
			const int p = self.prevs.load_int(id)
			const int n = self.nexts.load_int(id)
			if p >= 0 && p < self.nexts.cap {
				self.nexts.store_int(p, n)
			} else {
				self.head = n
			}
			if n >= 0 && n < self.prevs.cap {
				self.prevs.store_int(n, p)
			} else {
				self.tail = p
			}
		}
	}

	func link_tail = (ref self, int id) {
		if id >= 0 && id < self.prevs.cap && id < self.nexts.cap {
			self.prevs.store_int(id, self.tail)
			self.nexts.store_int(id, -1)
			const int t = self.tail
			if t >= 0 && t < self.nexts.cap {
				self.nexts.store_int(t, id)
			} else {
				self.head = id
			}
			self.tail = id
		}
	}

	func put = (ref self, int key, int value) {
		if self.keys.has(key) {
			const int id = self.keys.get(key)
			if id >= 0 && id < self.nvals.cap {
				self.nvals.store_int(id, value)
			}
			self.unlink(id)
			self.link_tail(id)
		} else {
			if self.count >= self.size {
				const int id = self.head
				if id >= 0 && id < self.nkeys.cap {
					const int old_key = self.nkeys.load_int(id)
					self.keys.remove(old_key)
					self.unlink(id)
					if id < self.nvals.cap {
						self.nkeys.store_int(id, key)
						self.nvals.store_int(id, value)
					}
					self.link_tail(id)
					self.keys.set(key, id)
				}
			} else {
				const int id = self.count
				self.count += 1
				if id >= 0 && id < self.nkeys.cap && id < self.nvals.cap {
					self.nkeys.store_int(id, key)
					self.nvals.store_int(id, value)
				}
				self.link_tail(id)
				self.keys.set(key, id)
			}
		}
	}

	func get = (ref self, int key, out int) {
		if self.keys.has(key) {
			const int id = self.keys.get(key)
			self.unlink(id)
			self.link_tail(id)
			if id >= 0 && id < self.nvals.cap {
				return self.nvals.load_int(id)
			}
		}
		return -1
	}
}

pub func main = (Init init) {
	var size = 100
	if init.argc > 1 {
		size = parse_int(init.args.at(1))
	}
	var n = 10000
	if init.argc > 2 {
		n = parse_int(init.args.at(2))
	}

	const int M = size * 10
	var rng0_state = 0
	var rng1_state = 1

	var lru = LRU()
	lru.setup(size)

	var hit = 0
	var missed = 0

	var i = 0
	while i < n; i += 1 {
		rng0_state = (1103515245 * rng0_state + 12345) & 2147483647
		const int n0 = rng0_state % M

		lru.put(n0, n0)

		rng1_state = (1103515245 * rng1_state + 12345) & 2147483647
		const int n1 = rng1_state % M

		if lru.get(n1) >= 0 {
			hit += 1
		} else {
			missed += 1
		}
	}

	Console.write("\{hit}\n")
	Console.write("\{missed}\n")
}
