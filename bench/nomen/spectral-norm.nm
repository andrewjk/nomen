import System

func eval_a_times_u<T> = (ref Buffer<T> au, ref Buffer<T> u, int n, bool transpose) {
	// `au` and `u` are sized to `n` by the caller, but that fact doesn't
	// propagate through `ref` parameters — guard once so the inner loops'
	// `i < n` / `j < n` bounds imply `i < au.cap` / `j < u.cap` via
	// transitive bound propagation (`i < n <= cap ⇒ i < cap`).
	if n <= au.cap && n <= u.cap {
		var i = 0
		while i < n; i += 1 {
			var a = 0.0
			var j = 0
			// eval_a's denominator follows an additive recurrence along j:
			//   denom(0)   = i*(i+1)/2 + i + 1     (transpose=false)
			//               i*(i+1)/2 + 1         (transpose=true, since +j+1 with j=0)
			//   denom(j+1) = denom(j) + i + j + 1 (transpose=false)
			//               denom(j) + i + j + 2 (transpose=true)
			// This avoids the per-element integer multiply and divide.
			var int denom = i * (i + 1) / 2
			if transpose {
				denom += 1
			} else {
				denom += i + 1
			}
			while j < n; j += 1 {
				a = a + (1.0 / (denom as float)) * u.load_float(j)
				if transpose {
					denom += i + j + 2
				} else {
					denom += i + j + 1
				}
			}
			au.store_float(i, a)
		}
	}
}

func eval_ata_times_u<T> = (ref Buffer<T> atau, ref Buffer<T> u, ref Buffer<T> scratch, int n) {
	eval_a_times_u(ref scratch, ref u, n, false)
	eval_a_times_u(ref atau, ref scratch, n, true)
}

pub func main = (Init init) {
	var n = 100
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}

	var u = Buffer<float>()
	var v = Buffer<float>()
	var scratch = Buffer<float>()
	u.alloc_float(n)
	v.alloc_float(n)
	scratch.alloc_float(n)

	// The buffers were just allocated to `n`, but the verifier can't see
	// that cap == n (the alloc call returns a numeric cap to callers, not a
	// symbolic fact). Hoist the equivalence once so the inner `i < n` loops
	// discharge against `u.cap` / `v.cap` without per-iteration guards.
	if n <= u.cap && n <= v.cap {
		var i = 0
		while i < n; i += 1 {
			u.store_float(i, 1.0)
			v.store_float(i, 1.0)
		}

		i = 0
		while i < 10; i += 1 {
			eval_ata_times_u(ref v, ref u, ref scratch, n)
			eval_ata_times_u(ref u, ref v, ref scratch, n)
		}

		var vbv = 0.0
		var vv = 0.0
		i = 0
		while i < n {
			vbv = vbv + u.load_float(i) * v.load_float(i)
			vv = vv + v.load_float(i) * v.load_float(i)
			i = i + 1
		}

		const float result = Math.sqrt(vbv / vv)
		Console.write(result.to_string())
		Console.write("\n")
	}
}
