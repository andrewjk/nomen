import System

const float ln10 = 2.3025850929940455
const float two_pi = 6.283185307179586

func test_k = (int n, int k, out bool) {
	if k < 0 {
		return false
	}
	var float fk = k as float
	var float fn = n as float
	var float ln_k_fact = fk * (Math.log(fk) - 1.0) + 0.5 * Math.log(two_pi)
	var float log10_k_fact = ln_k_fact / ln10
	return log10_k_fact >= fn + 50.0
}

func binary_search = (int n, out int) {
	var int a = 0
	var int b = 1
	while test_k(n, b) == false {
		a = b
		b = b * 2
	}
	while b - a > 1 {
		var int m = (a + b) / 2
		if test_k(n, m) {
			b = m
		} else {
			a = m
		}
	}
	return b
}

pub func main = (Init init) {
	var int n = 27
	if init.argc > 1 {
		n = parse_int(init.args.at(1))
	}
	var int k = binary_search(n)

	var BigInt tmp = BigInt()
	var BigInt scratch = BigInt()
	var BigInt one = BigInt()
	one = one.new(1)

	// Use extra precision: compute with n+10 digits, then truncate
	var int precision = n + 10

	// Compute 10^(precision-1) via binary exponentiation: O(log precision) multiplies.
	var BigInt power = BigInt()
	power = power.new(1)
	var BigInt sq_base = BigInt()
	sq_base = sq_base.new(10)
	var int exp = precision - 1
	while exp > 0 {
		if exp % 2 == 1 {
			tmp.mul_to(power, sq_base, scratch)
			power.copy_from(tmp)
		}
		tmp.mul_to(sq_base, sq_base, scratch)
		sq_base.copy_from(tmp)
		exp = exp / 2
	}

	// e = sum_{i=0}^{k-1} 1/i!
	// answer = sum_{i=0}^{k-1} 10^(precision-1) / i!
	var BigInt answer = BigInt()
	answer.copy_from(power)
	var BigInt term = BigInt()
	term.copy_from(power)

	var int i = 1
	while i <= k - 1 {
		var BigInt ii = BigInt()
		ii = ii.new(i)
		var BigInt rem = BigInt()
		var BigInt newterm = BigInt()
		newterm = newterm.div(term, ii, rem)
		term.copy_from(newterm)

		tmp.add_to(answer, term)
		answer.copy_from(tmp)

		if term.cmp(one) < 0 {
			break
		}
		i = i + 1
	}

	// Truncate to n digits: divide by 10^(precision - n).
	var int trim = precision - n
	var BigInt divisor = BigInt()
	divisor = divisor.new(1)
	sq_base = sq_base.new(10)
	exp = trim
	while exp > 0 {
		if exp % 2 == 1 {
			tmp.mul_to(divisor, sq_base, scratch)
			divisor.copy_from(tmp)
		}
		tmp.mul_to(sq_base, sq_base, scratch)
		sq_base.copy_from(tmp)
		exp = exp / 2
	}
	var BigInt trim_rem = BigInt()
	var BigInt trimmed = BigInt()
	trimmed = trimmed.div(answer, divisor, trim_rem)

	// Extract digits from trimmed answer using bulk divmod by 10^18.
	// Each iteration pulls 18 decimal digits in one long division instead
	// of one digit per division. The digits buffer holds n digits plus up
	// to 18 leading-zero padding from the final chunk.
	var BigInt result = BigInt()
	result.copy_from(trimmed)
	var BigInt q_e18 = BigInt()
	q_e18 = q_e18.new(1000000000000000000)
	var BigInt rem = BigInt()
	var Buffer<int> digits = Buffer<int>()
	digits.alloc_int(5020)
	var int digit_count = 0

	while result.cmp(one) >= 0 {
		var BigInt qq = BigInt()
		qq = qq.div(result, q_e18, rem)

		// rem < 10^18, fits in one uint64 limb.
		var uint64 chunk = rem.get(0)
		var int c = 0
		while c < 18 {
			digits.store_int(digit_count + c, (chunk % 10) as int)
			chunk = chunk / 10
			c = c + 1
		}
		digit_count = digit_count + 18

		result.copy_from(qq)
	}

	// Trim spurious leading zeros introduced by the final bulk chunk.
	while digit_count > 1 {
		if digits.load_int(digit_count - 1) != 0 {
			break
		}
		digit_count = digit_count - 1
	}

	var int pos = digit_count - 1
	while pos >= 0 {
		Console.write(digits.load_int(pos).to_string())
		if pos == digit_count - 1 && digit_count > 1 {
			Console.write(".")
		}
		pos = pos - 1
		if (digit_count - 1 - pos) % 10 == 0 && pos >= 0 {
			Console.write("\t:")
			Console.write((digit_count - 1 - pos).to_string())
			Console.write("\n")
		}
	}
	if (digit_count - 1 - pos) % 10 != 0 {
		Console.write("\t:")
		Console.write(digit_count.to_string())
	}
	Console.write("\n")
}
