import BigInt
import Console
import int
import Stringable

pub func main = () {
    var int n = 100
    var int digits_printed = 0

    var BigInt k = BigInt()
    var BigInt n1 = BigInt()
    var BigInt n2 = BigInt()
    var BigInt d = BigInt()
    var BigInt one = BigInt()
    var BigInt two = BigInt()
    var BigInt ten = BigInt()
    var BigInt u = BigInt()
    var BigInt v = BigInt()
    var BigInt w = BigInt()
    var BigInt k2 = BigInt()
    var BigInt tmp = BigInt()
    var BigInt tmp2 = BigInt()
    var BigInt rem = BigInt()

    k = k.new(1)
    n1 = n1.new(4)
    n2 = n2.new(3)
    d = d.new(1)
    one = one.new(1)
    two = two.new(2)
    ten = ten.new(10)
    u = u.new(0)
    v = v.new(0)
    w = w.new(0)
    k2 = k2.new(0)
    tmp = tmp.new(0)
    tmp2 = tmp2.new(0)
    rem = rem.new(0)

    while true {
        u = u.div(n1, d, rem)
        v = v.div(n2, d, rem)

        if u.cmp(v) == 0 {
            Console.write(u.to_digit().to_string())
            digits_printed = digits_printed + 1

            if digits_printed >= n {
                Console.write("\t:{digits_printed}")
                break
            }

            tmp.mul_to(u, d)
            tmp2.mul_to(tmp, ten)
            tmp.mul_to(n1, ten)
            n1.sub_to(tmp, tmp2)
            tmp.mul_to(n2, ten)
            n2.sub_to(tmp, tmp2)
        } else {
            k2.mul_to(k, two)
            tmp.sub_to(k2, one)
            u.mul_to(tmp, n1)
            v.mul_to(n2, two)
            tmp.sub_to(k, one)
            w.mul_to(tmp, n1)
            tmp.add_to(u, v)
            n1.copy_from(tmp)
            tmp.add_to(k, two)
            u.mul_to(tmp, n2)
            tmp.add_to(w, u)
            n2.copy_from(tmp)
            tmp2.add_to(k2, one)
            d.mul_to(tmp2, d)
            tmp.add_to(k, one)
            k.copy_from(tmp)
        }
    }
}
