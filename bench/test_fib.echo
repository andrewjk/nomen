import System

pub func main = (Init init) {
  var length = 30
  if init.argc > 1 {
    const larg = parse_int(init.args.at(1))
    if larg > 0 {
        length = larg
    }
  }
  var a = 0
  var b = 0
  var sum =0
  var result = Array.with(0, length)
  for i of 0..length {
    switch {
      case i == 0 {
        result.set(i, a)
      }
      case i == 1 {
        result.set(i, b)
      }
      else {
        sum = a + b
        a = b
        b = sum
        result.set(i, sum)
      }
    }
  }

  Console.write("Fibonacci sequence to \{length} positions:\n")
  for num of result {
    Console.write("\{num} ")
  }
}