/**
 * A growable, ordered list of values (`push`/`pop`/`at`)
 **/
pub mv struct List<T>: Viewable {
	var length = 0
	var items = Buffer<T>()

	pub func push = (ref self, mv T value) {
		self.reserve(1)
		self.items.store(self.length, value)
		self.length += 1
	}

	// Capacity for `extra` more elements without reallocation: the exact
	// growth policy `push` uses (double from 4, so repeated single pushes
	// amortize). Returns the resulting capacity. Splitting it out of `push`
	// is what makes the compiler's in-place push lowering possible: the
	// destination slot for a `push(parse(line))` argument must exist before
	// the argument call runs, so the backend reserves first and constructs
	// the callee's result directly into `items.data[length]` (docs/GOOSE.md
	// #4). Sound for extra=1 by the same proof as push's old inline growth:
	// length + 1 > cap grows to exactly the capacity push would have grown
	// to.
	internal func reserve = (ref self, int extra: extra >= 0, out int) {
		if self.length + extra <= self.items.cap {
			return self.items.cap
		}
		var int new_cap = 4
		var int old_cap = self.items.cap
		if old_cap >= 4 {
			new_cap = old_cap * 2
		}
		while new_cap < self.length + extra; new_cap *= 2 { }
		self.items.grow(new_cap)
		return self.items.cap
	}

	pub func pop = (ref self, mv out T) {
		if self.length <= 0 {
			return self.items.move(0)
		}
		var int idx = self.length - 1
		self.length = idx
		return self.items.move(idx)
	}

	pub inline func at = (self, int i: i >= 0 && i < self.length, out T) {
		return self.items.load(i)
	}

	// Bounds-checked access: `fallback` when i is outside [0, self.length) —
	// for indices that can't be proven at compile time and out-of-range is an
	// expected case.
	pub func at_or = (self, int i, T fallback, out T) {
		if i >= 0 && i < self.length {
			return self.at(i)
		}
		return fallback
	}

	// Bounds-checked access that traps when i is outside [0, self.length) —
	// for indices that can't be proven at compile time and out-of-range is a
	// bug, not a case.
	pub func at_or_panic = (self, int i, out T) {
		if i >= 0 && i < self.length {
			return self.at(i)
		}
		panic("index out of range")
	}

	// A non-mv `view T` over [start, end). Delegates to the backing Buffer's
	// #arch slice primitive — no #arch code here. Borrows from self.
	pub func slice = (self, int start: start >= 0, int end: end >= start, out view T) {
		return self.items.slice(start, end)
	}

	pub func set = (ref self, int i: i >= 0 && i < self.length, mv T value) {
		self.items.replace(i, value)
	}

	// Bounds-checked write that traps when i is outside [0, self.length) —
	// for indices that can't be proven at compile time (cross-module calls
	// can never discharge `set`'s parameter constraint) and out-of-range is
	// a bug, not a case.
	pub func set_or_panic = (ref self, int i, mv T value) {
		if i >= 0 && i < self.length {
			self.set(i, value)
			return
		}
		panic("index out of range")
	}

	// Address of element `i` (library-only): the ELEMENT BORROW primitive —
	// `ref T x = list.at(i)` (docs/HANDLERS.md Stage 4, dynamic-tree
	// dispatch) lowers to this, binding the alias to the slot itself rather
	// than to a bitwise copy. The pointer is valid while the list is
	// exclusively borrowed and not resized; a `ref self` call on the list
	// invalidates the borrow through the ordinary borrow-invalidation
	// rules. The length constraint is the caller's proof obligation — the
	// handler desugar's synthesized loops satisfy it from the loop
	// condition, exactly like `.at`.
	pub func slot_ptr = (ref self, int i: i >= 0 && i < self.length, out ptr T) {
		return self.items.slot_ptr(i)
	}

	// Bounds-checked removal that traps when i is outside [0, self.length) —
	// same contract as at_or_panic/set_or_panic, for indices that can't be
	// proven at compile time. The element is moved out (later elements
	// backward-shift into place) and returned: the caller owns it, so its
	// resources are reclaimed when the binding's scope ends — binding the
	// result in a nested block is the way to free an owning element at a
	// chosen point (its #destroy runs at the block's closing brace).
	pub func remove_at_or_panic = (ref self, int i, mv out T) {
		if i < 0 || i >= self.length {
			panic("index out of range")
		}
		var T v = self.items.move(i)
		var int last = self.length - 1
		var int j = i
		while j < last; j += 1 {
			self.items.shift(j, j + 1)
		}
		self.length -= 1
		return v
	}

	// A deep copy: a fresh List<T> with an independent copy of every element.
	// For mv element types (strings, mv value structs) each slot in the
	// copy owns its own heap data (Buffer deep-copies on store), so the source
	// and the copy share nothing. Not available for class/trait element types
	// (the copy would share the stored instances — the checker rejects it).
	// The element is bound to a local before push — the monomorphized body is
	// never re-checked, so it can't rely on check-time call-arg hoisting for
	// struct element types.
	pub func copy = (self, out List<T>) {
		var dst = List<T>()
		var i = 0
		while i < self.length {
			var T v = self.at(i)
			dst.push(v)
			i += 1
		}
		return dst
	}
}
