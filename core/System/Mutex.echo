// Mutex — pthread-backed lock for shared mutable state.
//
// Default stance in Echo is "no shared mutable state" — communicate by moving
// Sendable values (or via Channel<T>). Mutex exists for when you genuinely
// need shared mutability. See ASYNC.md.

pub class Mutex : Sendable {
	pub var uint64 handle = 0

	pub func #init = (self) {
		```
		#arch: c
		#scope: file
		#include <pthread.h>
		```
		```
		#arch: c
		self->handle = (unsigned long long)malloc(sizeof(pthread_mutex_t));
		pthread_mutex_init((pthread_mutex_t *)self->handle, NULL);
		```
	}

	pub func lock = (self) {
		```
		#arch: c
		pthread_mutex_lock((pthread_mutex_t *)self->handle);
		```
	}

	pub func unlock = (self) {
		```
		#arch: c
		pthread_mutex_unlock((pthread_mutex_t *)self->handle);
		```
	}

	pub func #destroy = () {
		```
		#arch: c
		if (self->handle) {
			pthread_mutex_destroy((pthread_mutex_t *)self->handle);
			free((void *)self->handle);
			self->handle = 0;
		}
		```
	}
}
