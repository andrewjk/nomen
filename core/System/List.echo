import Buffer

pub struct List<T> {
    var int length = 0
    var Buffer items = Buffer()

    pub func push = (ref self, mov T value) {
        if self.length >= self.items.cap {
            var int new_cap = 4
            var int old_cap = self.items.cap
            if old_cap >= 4 {
                new_cap = old_cap * 2
            }
            self.items.grow_int(new_cap)
        }
        self.items.store_int(self.length, value)
        self.length = self.length + 1
    }

	pub func pop = (ref self, mov out T) {
		if self.length <= 0 {
			return 0
		}
		var int idx = self.length - 1
		self.length = idx
		return self.items.move_int(idx)
	}

    pub func at = (self, int i: i >= 0 && i < self.length, out T) {
        return self.items.load_int(i)
    }

	pub func set = (ref self, int i: i >= 0 && i < self.length, mov T value) {
		var int v = value
		self.items.replace_int(i, v)
	}
}
