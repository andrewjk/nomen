import Buffer

pub struct List<T> {
    var int length = 0
    var Buffer items = Buffer()

    pub func push = (ref self, T value) {
        if self.length >= self.items.get_cap() {
            var int new_cap = 4
            var int old_cap = self.items.get_cap()
            if old_cap >= 4 {
                new_cap = old_cap * 2
            }
            self.items.grow_int(new_cap)
        }
        self.items.store_int(self.length, value)
        self.length = self.length + 1
    }

    pub func pop = (ref self, out T) {
        self.length = self.length - 1
        return self.items.load_int(self.length)
    }
}
