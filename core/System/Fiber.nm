// Fiber — a stackful coroutine (ASYNC.md Phase 1). Fibers multiplex
// over the worker pool's threads: a parked fiber frees its worker instead of
// blocking it, so thousands of waiting tasks cost stacks (~64 KB each), not
// threads (~MB each).
//
// `Fiber(fn(args)).start()` mirrors `Thread(fn(args)).start()` — same eager
// arg packing into a task closure, same future, same Task<T> handle — but
// the wrapped call runs on a fiber stack under the fiber scheduler. While
// it waits (Task.result/wait, Channel.receive), the fiber parks and the
// worker moves on; `Fiber.yield()` cooperatively hands the worker to the
// next runnable fiber.
//
// Like Thread, a Fiber construction is a real value: it can be stored and
// started later (`var f = Fiber(work(n))`, then `f.start()` or
// `f.start_on(buf)`), and destroying an unstarted Fiber is a programming
// error that #destroy reports and aborts on (must-start — the library
// pattern from ASYNC.md).
//
// `Fiber(fn(args)).start_on(buf)` runs the fiber on a caller-provided
// fixed-size array stack (>= 16 KB) — the embedded/no-heap path.
//
// `Fiber.set_cooperative(true)` (before the first spawn) runs fibers on the
// calling thread and never starts worker threads — a cooperative,
// single-threaded runtime for bare-metal targets.
//
// The constructor and `.start_on(buf)` are compiler-special-cased (they
// need the per-site spawn/trampoline machinery and the buffer's compile-time
// byte size); `.start()` is a regular method over the runtime seam — it
// reads the packed handles from the instance's fields and drives the
// scheduler. The runtime (scheduler, context switch) lives in the build's
// emitted companion C — see build_fiber_spawn.

/**
 * A stackful coroutine: lightweight, cooperatively scheduled, parks instead of blocking
 **/
pub class Fiber<T> : Sendable, Spawnable<T> {
	// The construction hook (see Thread.nm): the deferred-call special form.
	#spawn = () {
	}

	// The packed task closure (a `struct nomen_closure *`); owned by this
	// value until start/start_on/nursery.start transfers it to the runtime.
	pub var uint64 task = 0
	// Result-slot / cancel-flag / future handles for the (single) launch.
	pub var uint64 result_slot = 0
	pub var uint64 cancel_flag = 0
	pub var uint64 future = 0
	// Must-start flag: set by .start() / .start_on(buf) / nursery.start.
	pub var started = false
	// LEXICAL NURSERY CAPTURE (ASYNC_PLAN phase 1): the tracking slots of the
	// `async` block that lexically encloses the CONSTRUCTION, or 0 when the
	// construction is outside any block. `.start()` registers the future
	// through these stored pointers — registration follows the scope that
	// created the deferred call, not the one that happens to start it. See
	// Thread.nm's matching fields.
	pub var uint64 nursery_futures = 0
	pub var uint64 nursery_count = 0
	pub var uint64 nursery_cap = 0

	// Start the deferred call on the fiber scheduler and yield the Task<T>
	// handle. Same shape as Thread.start: consume the machinery, register
	// with the construction-time nursery (if captured), transfer the handles
	// out of the instance (started; #destroy no-ops), return the handle.
	// While the fiber waits, it parks and frees its worker instead of
	// blocking it.
	pub func start = (ref self, move out Task<T>) {
		```
		#arch: c
		struct nomen_future *_f = (struct nomen_future *)self->future;
		_f->refs = self->nursery_futures ? 3 : 2;
		__nomen_fiber_spawn((struct nomen_closure *)self->task, _f);
		if (self->nursery_futures) {
			__nomen_nursery_track((void **)self->nursery_futures, (int *)self->nursery_count, (int *)self->nursery_cap, _f);
		}
		```
		```
		#arch: aarch64
		// x19 = self. f = self->future (#32); nursery_futures at #48.
		ldr x0, [x19, #32]
		ldr x1, [x19, #48]
		mov w2, #2
		cbz x1, .Lnomen_fstart_refs
		mov w2, #3
		.Lnomen_fstart_refs:
		str w2, [x0, #116]
		// __nomen_fiber_spawn(self->task, f)
		ldr x0, [x19, #8]
		ldr x1, [x19, #32]
		bl ___nomen_fiber_spawn
		// if (self->nursery_futures) __nomen_nursery_track(futures, count, cap, f)
		ldr x0, [x19, #48]
		cbz x0, .Lnomen_fstart_notrack
		ldr x1, [x19, #56]
		ldr x2, [x19, #64]
		ldr x3, [x19, #32]
		bl ___nomen_nursery_track
		.Lnomen_fstart_notrack:
		```
		var t = Task<T>()
		t.result_slot = self.result_slot
		t.cancel_flag = self.cancel_flag
		t.future = self.future
		// Transfer the handles out of the instance: the runtime owns
		// everything now, and #destroy must not touch (or must-start-abort).
		self.task = 0
		self.future = 0
		self.result_slot = 0
		self.cancel_flag = 0
		self.started = true
		return t
	}

	// Run the deferred call fire-and-forget (the Spawnable daemon role).
	// The fiber is launched exactly like start, but the handle is dropped
	// immediately: the future's refs are released as the discarded Task is
	// reclaimed, and the fiber completes into the void — nothing joins it.
	pub func detach = (ref self) {
		self.start()
	}

	// Destroying an unstarted Fiber is a programming error (the wrapped
	// call would silently never run) — report it and abort. A started
	// Fiber owns nothing: the launch transferred the task closure, result
	// slot, cancel flag, and future to the runtime, and cleared the fields.
	pub func #destroy = () {
		```
		#arch: c
		if (!self->started) {
			__nomen_spawn_must_start_abort();
		}
		if (self->future) {
			__nomen_future_release((struct nomen_future *)self->future);
			self->future = 0;
			self->result_slot = 0;
			self->cancel_flag = 0;
		}
		```
		```
		#arch: aarch64
		// if (!self->started) __nomen_spawn_must_start_abort()
		ldrb w0, [x19, #40]
		cbnz w0, .Lfb_started
		bl ___nomen_spawn_must_start_abort
		.Lfb_started:
		// if (self->future) { release it (an unstarted task's future is
		// unshared — refs == 1 — so this tears down slot + flag + future);
		// zero the fields }
		ldr x0, [x19, #32]
		cbz x0, .Lfb_done
		bl ___nomen_future_release
		str xzr, [x19, #32]
		str xzr, [x19, #16]
		str xzr, [x19, #24]
		.Lfb_done:
		```
	}

	// Hand the worker to the next runnable fiber. No-op outside a fiber.
	pub func yield = () {
		```
		#arch: c
		__nomen_fiber_yield();
		```
		```
		#arch: aarch64
		bl ___nomen_fiber_yield
		```
	}

	// Is the calling code running inside a fiber? True when Fiber.yield or
	// fiber parking would take effect.
	pub func is_fiber = (out bool) {
		```
		#arch: c
		return __nomen_fiber_is_active();
		```
		```
		#arch: aarch64
		bl ___nomen_fiber_is_active
		```
	}

	// Run fibers on the calling thread and never start worker threads. Must
	// be called before the first fiber spawn; intended for single-threaded
	// (bare-metal) targets. In cooperative mode a fiber that parks on an
	// event only another thread could fire will never resume.
	pub func set_cooperative = (bool on) {
		```
		#arch: c
		__nomen_fiber_set_cooperative(on ? 1 : 0);
		```
		```
		#arch: aarch64
		bl ___nomen_fiber_set_cooperative
		```
	}
}
