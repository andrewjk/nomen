/**
 * A double-precision (64-bit) floating-point number
 **/
pub struct float: Stringable {
	pub func to_string = (self, out string) {
		```
		#arch: c
		int length = snprintf(NULL, 0, "%f", self);
		char* str = malloc(length + 1);
		snprintf(str, length + 1, "%f", self);
		return str;
		```
		```
		#arch: aarch64
		sub sp, sp, #128
		str x0, [sp, #0]
		str x1, [sp, #8]
		str x2, [sp, #16]
		str x3, [sp, #24]
		str d0, [sp, #64]
		mov x0, xzr
		mov x1, xzr
		adr x2, .Lfmt_float_f
		fmov d0, x19
		bl _snprintf
		add x0, x0, #1
		str x0, [sp, #64]
		bl _malloc
		str x0, [sp, #72]
		ldr x0, [sp, #72]
		ldr x1, [sp, #64]
		adr x2, .Lfmt_float_f
		fmov d0, x19
		bl _snprintf
		ldr x0, [sp, #72]
		add sp, sp, #128
		b .Lend_float_to_string
		.Lfmt_float_f: .asciz "%f"
		.p2align 2
		.Lend_float_to_string:
		```
	}
}
