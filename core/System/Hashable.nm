/**
 * A trait for values that can be hashed to an unsigned integer. A struct that
 * conforms to `Hashable` and does not define its own `hash` method gets one
 * bound from the reflection default below (`#self` becomes the struct's name,
 * the `#for` walk unrolls over `META.info(#self).fields`, combining each field
 * into `acc * 31 + value`): scalar fields (int/bool/char) cast to `uint`, and
 * `Hashable` struct fields call their own `hash`. A field with neither shape
 * (a `float`, say) is a per-field compile error in the generated body; a
 * hand-written method always wins.
 *
 * The derivation is attribute-configured: a field marked `@hash_ignore` is
 * skipped by the walk, so identity-only fields (a cache slot, a stamp) don't
 * perturb the hash. A field's own `hash` may consult its attributes the same
 * way.
 **/
pub trait Hashable {
	/**
	 * A hash of the value. The default combines the hashes of every field not marked
	 * `@hash_ignore`.
	 **/
	func hash = (self, out uint) {
		var uint acc = 0
		#for field of META.info(#self).fields {
			if !field.has_attr("hash_ignore") {
				if field.is_scalar {
					acc = acc * 31 + (field.get(self) as uint)
				} else {
					acc = acc * 31 + field.get(self).hash()
				}
			}
		}
		return acc
	}
}
