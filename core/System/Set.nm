/**
 * An ordered set of unique values (`add`/`has`/`get`/`remove`). Elements must
 * be `Hashable` (hashed to a `uint` via `value.hash()`) and `Equatable`
 * (compared with `==`).
 *
 * The capacity is always a power of two (initial 8, doubling on rehash), so
 * slot indexing is a mask (`hash & (cap - 1)`) — correct for negative hashes
 * too (two's-complement `&` already lands in `[0, cap)`).
 *
 * Each slot carries its value's hash (truncated to 32 bits) in a parallel
 * `hashes` buffer. Probes compare the stored hash before the value itself
 * (the Swiss-table short-circuit — the `==` only runs on a hash match, and a
 * false match still falls through to `==`, so truncation costs nothing);
 * rehash re-inserts hash-free, reading the stored word instead of calling
 * `value.hash()` again.
 **/
pub mv struct Set<T: Hashable + Equatable> {
	var length = 0
	var slots = Buffer<T>()
	var used = Buffer<int>()
	var hashes = Buffer<int>()

	pub func add = (ref self, mv T value) {
		var int cap = self.slots.cap
		if cap == 0 {
			cap = self.slots.alloc(8)
			self.used.alloc_u32(8)
			self.hashes.alloc_u32(8)
		}
		if self.length * 4 >= cap * 3 {
			self.rehash(cap * 2)
			cap = self.slots.cap
		}
		var uint32 h = value.hash() as uint32
		var int idx = self.find_slot(value, h, cap)
		if self.used.load_u32(idx) == 0 {
			self.used.store_u32(idx, 1)
			self.slots.store(idx, value)
			self.hashes.store_u32(idx, h)
			self.length += 1
		}
	}

	pub func has = (self, T value, out bool) {
		var int cap = self.slots.cap
		if cap == 0 {
			return false
		}
		var int idx = self.find_slot(value, value.hash() as uint32, cap)
		return self.used.load_u32(idx) != 0
	}

	pub func get = (self, T key, out T) {
		var int cap = self.slots.cap
		if cap == 0 {
			return 0
		}
		var int idx = self.find_slot(key, key.hash() as uint32, cap)
		if self.used.load_u32(idx) == 0 {
			return 0
		}
		return self.slots.load(idx)
	}

	// Membership lookup with a fallback value: `fallback` when the value is
	// not in the set (one probe instead of the `has` + `get` pair).
	pub func get_or = (self, T key, T fallback, out T) {
		var int cap = self.slots.cap
		if cap == 0 {
			return fallback
		}
		var int idx = self.find_slot(key, key.hash() as uint32, cap)
		if self.used.load_u32(idx) == 0 {
			return fallback
		}
		return self.slots.load(idx)
	}

	// Membership lookup that traps when the value is not in the set.
	pub func get_or_panic = (self, T key, out T) {
		var int cap = self.slots.cap
		if cap == 0 {
			panic("value not found in set")
		}
		var int idx = self.find_slot(key, key.hash() as uint32, cap)
		if self.used.load_u32(idx) == 0 {
			panic("value not found in set")
		}
		return self.slots.load(idx)
	}

	pub func remove = (ref self, T value) {
		var int cap = self.slots.cap
		if cap == 0 {
			return
		}
		var int idx = self.find_slot(value, value.hash() as uint32, cap)
		if self.used.load_u32(idx) == 0 {
			return
		}
		// Backward-shift deletion for linear probing. `gap` is the empty slot
		// walking forward through the cluster; `k` scans ahead of it. An entry
		// at k shifts into the gap only if the gap still lies within its valid
		// probe range ([home, k) cyclically); otherwise the entry stays put and
		// we keep scanning, because a later entry may still belong behind the
		// gap. This is the subtle point: k advances independently of the gap,
		// so entries past a non-moveable one are not stranded behind an empty
		// slot (which would make find_slot miss them). No tombstones, so
		// find_slot/get/has/add are unchanged, and the cost is the local cluster
		// length — not a full O(cap) rehash on every delete. `home` reads the
		// stored hash word (no re-hash per shifted entry), and the word moves
		// with the entry — find_slot's hash short-circuit trusts it.
		var int gap = idx
		var int k = idx
		while true {
			k += 1
			if k >= cap {
				k = 0
			}
			if self.used.load_u32(k) == 0 {
				break
			}
			var int home = (self.hashes.load_u32(k) as int) & (cap - 1)
			var int dgap = gap - home
			if dgap < 0 {
				dgap = dgap + cap
			}
			var int dk = k - home
			if dk < 0 {
				dk = dk + cap
			}
			if dgap < dk {
				// shift_T (not store_T): transfers the entry wholesale and
				// reclaims the displaced slot's value — store_T would strdup a
				// fresh copy into gap while stranding the source slot's
				// pointer at the vacated slot (leaked once used.store marks it
				// empty; the buffer destroy skips unused slots).
				self.slots.shift(gap, k)
				self.hashes.store_u32(gap, self.hashes.load_u32(k))
				self.used.store_u32(gap, 1)
				gap = k
			}
		}
		self.used.store_u32(gap, 0)
		self.length = self.length - 1
	}

	// An independent copy: a fresh Set whose member slabs are fresh (`slots`
	// deep-copied per element, `used`/`hashes` copied word by word), with the
	// same length and entries. The u32-word buffers are copied through their
	// own primitives — `Buffer.copy` is T_SIZE-aware (8-byte loads for
	// `int`), which would read past a 4-byte-per-slot `alloc_u32` slab. Not
	// available for class/trait elements (the member routes to ClassBuffer,
	// which has no copy — the checker rejects the call; the shape is also
	// unreachable today since `T: Hashable + Equatable` cannot be a trait
	// without trait-conformance syntax).
	pub func copy = (self, out Set<T>) {
		var dst = Set<T>()
		dst.slots = self.slots.copy()
		dst.used.alloc_u32(self.slots.cap)
		dst.hashes.alloc_u32(self.slots.cap)
		var i = 0
		while i < self.slots.cap; i += 1 {
			dst.used.store_u32(i, self.used.load_u32(i))
			dst.hashes.store_u32(i, self.hashes.load_u32(i))
		}
		dst.length = self.length
		return dst
	}

	func find_slot = (self, T value, uint32 h, int cap, out int: out >= 0 && out < cap) {
		// cap is a power of two: `hash mod cap` via a mask, non-negative
		// for any hash — no adjustment needed.
		var int idx = (h as int) & (cap - 1)
		while self.used.load_u32(idx) != 0 {
			// The stored-hash word short-circuits the value compare: a probed
			// slot whose hash differs (every step of a collision walk past
			// the home slot) skips the value load and `==`. A hash match
			// still falls through to `==`, so the 32-bit truncation costs
			// nothing.
			if self.hashes.load_u32(idx) == h && self.slots.load(idx) == value {
				return idx
			}
			idx += 1
			if idx >= cap {
				idx = 0
			}
		}
		return idx
	}

	// Rehash hash-free: the stored per-slot hash words move with the entries,
	// so no `value.hash()` runs here and the insertion probe needs no value
	// compares (values arrive unique — they came from a valid set). The old
	// form re-inserted via `self.add(mv v)`, re-hashing every value and
	// re-comparing values on every probed slot.
	func rehash = (ref self, int new_cap) {
		var Buffer<T> old_slots = mv self.slots swap Buffer<T>()
		var Buffer<int> old_used = mv self.used swap Buffer<int>()
		var Buffer<int> old_hashes = mv self.hashes swap Buffer<int>()
		var int old_cap = old_slots.cap

		self.slots.alloc(new_cap)
		self.used.alloc_u32(new_cap)
		self.hashes.alloc_u32(new_cap)
		self.length = 0

		var i = 0
		while i < old_cap; i += 1 {
			if old_used.load_u32(i) != 0 {
				// move_T (not load_T) relinquishes the old slot, so each value
				// is owned by exactly one buffer (the new self) afterwards.
				// load_T would leave the old slot referencing the same class
				// pointer — a double-free when old_slots is destroyed. The
				// result is bound to a local so a mv-element copy (e.g. a
				// `Buffer<string>` slot, which store_T strdup's) is freed here
				// once the new buffer has made its own copy — passing it inline
				// would orphan the move_T result.
				var T v = old_slots.move(i)
				var uint32 h = old_hashes.load_u32(i)
				var int idx = (h as int) & (new_cap - 1)
				while self.used.load_u32(idx) != 0 {
					idx += 1
					if idx >= new_cap {
						idx = 0
					}
				}
				self.used.store_u32(idx, 1)
				self.slots.store(idx, v)
				self.hashes.store_u32(idx, h)
				self.length += 1
			}
		}
	}
}
