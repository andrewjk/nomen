// Mutex — pthread-backed lock for shared mutable state.
//
// Default stance in Nomen is "no shared mutable state" — communicate by moving
// Sendable values (or via Channel<T>). Mutex exists for when you genuinely
// need shared mutability. See ASYNC.md.
//
// A fiber that would block on a contended lock parks instead of blocking its
// worker (both models), and unlock wakes the parked fibers. Cancellation
// while waiting never returns without the lock — a waiter keeps waiting and
// observes the cancel flag at its next checkpoint after acquiring — so a
// matching unlock is always sound.

// Mutex is an OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 3 — the shape
// menu): the single field is an opaque handle, so the value is movable and
// its `#destroy` closes what the handle names. Moving a Mutex transfers the
// handle; there is no aliasing copy to misuse. Sharing one across tasks
// rides the checked region borrows (`async { }`) — the lock/unlock methods
// take the receiver bare (struct receivers travel by address), so a locked
// section mutates the kernel object the handle names, never the binding.

/**
 * A pthread-backed mutual-exclusion lock for protecting shared mutable state
 **/
pub mv struct Mutex {
	pub var uint64 handle = 0

	pub func #init = (self) {
		// The constructor's `self` is the INLINE instance (a local value in the
		// C lowering — methods take the pointer form, the ctor does not), so the
		// C body uses the `.` accessor; the aarch64 body writes through x19 =
		// &instance as always.
	```
	#arch: c
	self.handle = (unsigned long long)__nomen_mutex_create();
	```
	```
	#arch: aarch64
	bl ___nomen_mutex_create
	str x0, [x19, #8]
	```
	}

	pub func lock = (self) {
	```
	#arch: c
	// Fibers park instead of blocking the worker (both models); other
	// contexts take the pthread lock directly.
	__nomen_mutex_lock((void *)self->handle);
	```
	```
	#arch: aarch64
	ldr x0, [x19, #8]
	bl ___nomen_mutex_lock
	```
	}

	pub func unlock = (self) {
	```
	#arch: c
	__nomen_mutex_unlock_wake((void *)self->handle);
	```
	```
	#arch: aarch64
	ldr x0, [x19, #8]
	bl ___nomen_mutex_unlock_wake
	```
	}

	pub func #destroy = () {
	```
	#arch: c
	if (self->handle) {
		__nomen_mutex_dispose((void *)self->handle);
		self->handle = 0;
	}
	```
	```
	#arch: aarch64
	ldr x0, [x19, #8]
	cbz x0, .Lmutex_destroy_end
	bl ___nomen_mutex_dispose
	str xzr, [x19, #8]
	.Lmutex_destroy_end:
	```
	}
}
