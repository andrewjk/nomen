// Mutex — pthread-backed lock for shared mutable state.
//
// Default stance in Nomen is "no shared mutable state" — communicate by moving
// Sendable values (or via Channel<T>). Mutex exists for when you genuinely
// need shared mutability. See ASYNC.md.

pub class Mutex : Sendable {
	pub var uint64 handle = 0

	pub func #init = (self) {
		```
		#arch: c
		#scope: file
		#include <pthread.h>
		```
		```
		#arch: c
		self->handle = (unsigned long long)malloc(sizeof(pthread_mutex_t));
		pthread_mutex_init((pthread_mutex_t *)self->handle, NULL);
		```
		```
		#arch: aarch64
		mov x0, #64
		bl _malloc
		str x0, [x19, #8]
		mov x1, #0
		bl _pthread_mutex_init
		```
	}

	pub func lock = (self) {
		```
		#arch: c
		pthread_mutex_lock((pthread_mutex_t *)self->handle);
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		bl _pthread_mutex_lock
		```
	}

	pub func unlock = (self) {
		```
		#arch: c
		pthread_mutex_unlock((pthread_mutex_t *)self->handle);
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		bl _pthread_mutex_unlock
		```
	}

	pub func #destroy = () {
		```
		#arch: c
		if (self->handle) {
			pthread_mutex_destroy((pthread_mutex_t *)self->handle);
			free((void *)self->handle);
			self->handle = 0;
		}
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		cbz x0, .Lmutex_destroy_end
		bl _pthread_mutex_destroy
		ldr x0, [x19, #8]
		bl _free
		str xzr, [x19, #8]
		.Lmutex_destroy_end:
		```
	}
}
