/**
 * A single character
 **/
pub struct char: Stringable, Hashable, Equatable {
	pub func hash = (self, out uint) {
		return self as uint
	}

	pub func to_string = (self, move out string) {
		```
		#arch: c
		int length = snprintf(NULL, 0, "%c", self);
		char* str = malloc(length + 1);
		snprintf(str, length + 1, "%c", self);
		return str;
		```
		```
		#arch: aarch64
		sub sp, sp, #128
		str x0, [sp, #0]
		str x1, [sp, #8]
		str x2, [sp, #16]
		str x3, [sp, #24]
		mov x0, xzr
		mov x1, xzr
		adr x2, .Lfmt_char_c
		mov x3, x19
		bl _snprintf
		add x0, x0, #1
		str x0, [sp, #64]
		bl _malloc
		str x0, [sp, #72]
		ldr x0, [sp, #72]
		ldr x1, [sp, #64]
		adr x2, .Lfmt_char_c
		mov x3, x19
		bl _snprintf
		mov x1, x0
		ldr x0, [sp, #72]
		add sp, sp, #128
		b .Lend_char_to_string
		.Lfmt_char_c: .asciz "%c"
		.p2align 2
		.Lend_char_to_string:
		```
	}

	// ASCII digit: '0'-'9'. Non-ASCII bytes are false.
	pub func is_digit = (self, out bool) {
		var int code = self as int
		return code >= 48 && code <= 57
	}

	// ASCII letter: 'A'-'Z' or 'a'-'z'. Non-ASCII bytes are false.
	pub func is_alpha = (self, out bool) {
		var int code = self as int
		return (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
	}

	// ASCII letter or digit.
	pub func is_alphanumeric = (self, out bool) {
		return self.is_alpha() || self.is_digit()
	}

	// ASCII whitespace: tab, LF, VT, FF, CR, space. Unicode spaces are
	// false — byte-oriented callers trim with this and pass multibyte
	// sequences through untouched.
	pub func is_ascii_space = (self, out bool) {
		var int code = self as int
		return (code >= 9 && code <= 13) || code == 32
	}
}
