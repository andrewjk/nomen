/**
 * A single character
 **/
pub struct char: Stringable, Hashable, Equatable {
	/**
	 * A hash of the character, so it can be a `Map` key or `Set` element.
	 **/
	pub func hash = (self, out uint) {
		return self as uint
	}

	/**
	 * A one-character string holding this character.
	 **/
	pub func to_string = (self, mv out string) {
		#if META.arch == "c" {
			#raw {
				int length = snprintf(NULL, 0, "%c", self);
				char* str = malloc(length + 1);
				snprintf(str, length + 1, "%c", self);
				// Fat-string ABI: snprintf already counted the bytes.
				return (nomen_string){ str, length };
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				sub sp, sp, #128
				str x0, [sp, #0]
				str x1, [sp, #8]
				str x2, [sp, #16]
				str x3, [sp, #24]
				mov x0, xzr
				mov x1, xzr
				adr x2, .Lfmt_char_c
				mov x3, x19
				bl _snprintf
				add x0, x0, #1
				str x0, [sp, #64]
				bl _malloc
				str x0, [sp, #72]
				ldr x0, [sp, #72]
				ldr x1, [sp, #64]
				adr x2, .Lfmt_char_c
				mov x3, x19
				bl _snprintf
				mov x1, x0
				ldr x0, [sp, #72]
				add sp, sp, #128
				b .Lend_char_to_string
				.Lfmt_char_c: .asciz "%c"
				.p2align 2
				.Lend_char_to_string:
			}
		}
	}

	/**
	 * Whether this is an ASCII digit, '0' to '9'. Non-ASCII bytes are false.
	 **/
	pub func is_digit = (self, out bool) {
		var int code = self as int
		return code >= 48 && code <= 57
	}

	/**
	 * Whether this is an ASCII letter, 'A' to 'Z' or 'a' to 'z'. Non-ASCII bytes are false.
	 **/
	pub func is_alpha = (self, out bool) {
		var int code = self as int
		return (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
	}

	/**
	 * Whether this is an ASCII letter or digit.
	 **/
	pub func is_alphanumeric = (self, out bool) {
		return self.is_alpha() || self.is_digit()
	}

	/**
	 * Whether this is ASCII whitespace: space, tab, CR, LF, VT or FF. Unicode spaces are
	 * false.
	 **/
	// Byte-oriented callers trim with this and pass multibyte sequences through untouched.
	pub func is_ascii_space = (self, out bool) {
		var int code = self as int
		return (code >= 9 && code <= 13) || code == 32
	}
}
