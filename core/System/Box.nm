// Box<T> (STRUCT_PLAN_3 B2) — an owning pointer to a heap-allocated T: the
// cycle-breaking and stable-address shape for owning structs.
//
//   owning struct Node {
//       var int value
//       var Box<Node>? next
//   }
//
// A Box is represented as ONE POINTER at runtime (a compiler-generated
// wrapper class holding the value inline): `Box<T>?` is the natural null
// slot (B6's null-pointer lowering), construction mallocs the wrapper and
// moves the value in, and destroy reclaims the pointee. Field and method
// access THROUGH a box is transparent — the checker rewrites `box.field`
// to `box.value.field` — so the wrapper never leaks into user code.
//
// `T` is a value struct. (Boxing a class is pointless — classes are already
// references.) Boxing takes ownership: the constructor moves the value in.

/**
 * An owning pointer to a heap-allocated value — the cycle-breaking shape
 **/
pub class Box<T> {
	// The wrapped value. Access through the box is transparent: the checker
	// rewrites `box.f` to `box.__value.f`, so this field never appears in
	// user code (the `__` prefix keeps it out of every legal field name).
	// `move` spelling: boxing TAKES OWNERSHIP of the pointee.
	move T __value
}
