/**
 * A 16-bit unsigned integer
 **/
pub struct uint16: Stringable, Hashable, Equatable {
	pub func hash = (self, out uint) {
		```
		#arch: c
		return (unsigned long)self;
		```
		```
		#arch: aarch64
		mov x0, x19
		```
	}

	pub func to_string = (self, mov out string) {
		```
		#arch: c
		int length = snprintf(NULL, 0, "%u", self);
		char* str = malloc(length + 1);
		snprintf(str, length + 1, "%u", self);
		return str;
		```
		```
		#arch: aarch64
		sub sp, sp, #128
		str x0, [sp, #0]
		str x1, [sp, #8]
		str x2, [sp, #16]
		str x3, [sp, #24]
		mov x0, xzr
		mov x1, xzr
		adr x2, .Lfmt_uint16_u
		mov x3, x19
		bl _snprintf
		add x0, x0, #1
		str x0, [sp, #64]
		bl _malloc
		str x0, [sp, #72]
		ldr x0, [sp, #72]
		ldr x1, [sp, #64]
		adr x2, .Lfmt_uint16_u
		mov x3, x19
		bl _snprintf
		mov x1, x0
		ldr x0, [sp, #72]
		add sp, sp, #128
		b .Lend_uint16_to_string
		.Lfmt_uint16_u: .asciz "%u"
		.p2align 2
		.Lend_uint16_to_string:
		```
	}
}
