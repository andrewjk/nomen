import Buffer

// Arena-backed singly-linked list. Values and next-links live in flat Buffers,
// so there is a single owner and cleanup is a flat free -- no recursive pointer
// chasing, no borrow lifetimes. Node identifiers are stable int indices
// (read `count` before `add`); -1 means "no node" / "end".
// The `add` mutator is void: capturing the return of a `ref self` method on a
// forward-referenced struct currently fails type resolution. Returning nothing
// sidesteps that.
pub struct LinkedList<T> {
	var Buffer values = Buffer()
	var Buffer nexts = Buffer()
	var int head = -1
	var int count = 0

	pub func add = (ref self, T value) {
		var int idx = self.count
		self.values.grow_int(idx + 1)
		var int v = value
		self.values.store_int(idx, v)
		self.nexts.grow_int(idx + 1)
		self.nexts.store_int(idx, -1)
		self.count = self.count + 1
		if self.head == -1 {
			self.head = idx
		}
	}

	pub func set_next = (ref self, int idx, int next) {
		self.nexts.store_int(idx, next)
	}

	pub func next = (self, int idx, out int) {
		return self.nexts.load_int(idx)
	}

	pub func value = (self, int idx, out T) {
		return self.values.load_int(idx)
	}

	pub func length = (self, out int) {
		return self.count
	}
}
