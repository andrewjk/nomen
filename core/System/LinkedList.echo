import Buffer

// Arena-backed doubly-linked list. Values and next/prev links live in flat
// Buffers, so there is a single owner and cleanup is a flat free — no recursive
// pointer chasing, no borrow lifetimes. Node identifiers are stable int indices
// (read `count` before `add`); -1 means "no node" / "end".
pub struct LinkedList<T>: Enumerable {
	var Buffer values = Buffer()
	var Buffer nexts = Buffer()
	var Buffer prevs = Buffer()
	var int head = -1
	var int count = 0

	pub func add = (ref self, mov T value) {
		var int idx = self.count
		self.values.grow_int(idx + 1)
		var int v = value
		self.values.store_int(idx, v)
		self.nexts.grow_int(idx + 1)
		self.nexts.store_int(idx, -1)
		self.prevs.grow_int(idx + 1)
		self.prevs.store_int(idx, -1)
		self.count = self.count + 1
		if self.head == -1 {
			self.head = idx
		}
	}

	pub func set_next = (ref self, int idx, int next) {
		self.nexts.store_int(idx, next)
		if next >= 0 && next < self.prevs.cap {
			self.prevs.store_int(next, idx)
		}
	}

	pub func set_previous = (ref self, int idx, int prev) {
		self.prevs.store_int(idx, prev)
		if prev >= 0 && prev < self.nexts.cap {
			self.nexts.store_int(prev, idx)
		}
	}

	pub func next_at = (self, int idx, out int) {
		return self.nexts.load_int(idx)
	}

	pub func previous_at = (self, int idx, out int) {
		return self.prevs.load_int(idx)
	}

	pub func first = (self: self.count > 0, out T) {
		return self.values.load_int(0)
	}

	pub func at = (self, int idx: idx >= 0 && idx < self.count, out T) {
		return self.values.load_int(idx)
	}

	pub func length = (self, out int) {
		return self.count
	}
}
