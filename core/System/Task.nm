// Task runtime — thread-pool-backed execution primitive.
//
// Spawned tasks run on a shared worker pool. The pool starts at a
// configurable size (default 4, via Task.set_pool_size before the first
// spawn) and grows on demand up to 64 workers when every worker is busy,
// preventing deadlocks from nested spawns. The pool drains and joins all
// workers at process exit; Task.shutdown_pool does this explicitly.
//
// The pool infrastructure (types, worker loop, submit, shutdown, cancel
// thread-local) lives in build_spawn_node and is emitted as file-scope C
// on the first spawn — not in Task's own methods — so that Task can be
// generic without duplicating the pool per instantiation.
//
// See ASYNC.md for the design.

/**
 * A handle to an asynchronously-running computation, backed by a shared thread pool
 **/
pub class Task<T> : Sendable {
	pub var uint64 handle = 0
	pub var done = false
	pub var uint64 result_slot = 0
	pub var uint64 cancel_flag = 0
	pub var uint64 future = 0

	// Block until the task finishes. Idempotent — calling twice is safe, and
	// a Task captured from a nursery spawn can be waited on here AND joined
	// by the nursery at block exit (both wait on the same shared future).
	pub func wait = (ref self) {
		```
		#arch: c
		if (self->future) {
			__nomen_future_wait((struct nomen_future *)self->future);
		} else if (self->handle && !self->done) {
			void *ret;
			pthread_join((pthread_t)self->handle, &ret);
			self->handle = 0;
			self->done = 1;
		}
		```
		```
		#arch: aarch64
		// if (self->future) goto wait_future
		ldr x0, [x19, #40]
		cbz x0, .Lwait_handle
		bl ___nomen_future_wait
		b .Lwait_done
		.Lwait_handle:
		// else if (self->handle && !self->done)
		ldr x0, [x19, #8]
		cbz x0, .Lwait_done
		ldrb w1, [x19, #16]
		cbnz w1, .Lwait_done
		// pthread_join((pthread_t)self->handle, &ret)
		sub sp, sp, #16
		mov x1, sp
		bl _pthread_join
		add sp, sp, #16
		// self->handle = 0; self->done = 1
		str xzr, [x19, #8]
		mov w0, #1
		strb w0, [x19, #16]
		.Lwait_done:
		```
	}

	// Block until the task finishes, then return its result as T. The spawn
	// build phase allocates a heap slot (owned by the future) sized to hold
	// the full return value — including the 16-byte fat-string pair — and the
	// trampoline writes the function's return value there before exiting.
	// The result is MOVED OUT: the slot is zeroed as the value leaves, and
	// `mov out T` marks the caller as the owner. Call it once; a second call
	// returns the zero value. For tasks with no return value (void
	// functions), returns the zero value.
	pub func result = (ref self, mov out T) {
		```
		#arch: c
		if (self->future) {
			__nomen_future_wait((struct nomen_future *)self->future);
		} else if (self->handle && !self->done) {
			void *ret;
			pthread_join((pthread_t)self->handle, &ret);
			self->handle = 0;
			self->done = 1;
		}
		T _r = *(T *)self->result_slot;
		memset((void *)self->result_slot, 0, sizeof(T));
		return _r;
		```
		```
		#arch: aarch64
		// Wait for completion (same as wait method)
		ldr x0, [x19, #40]
		cbz x0, .Lresult_handle
		bl ___nomen_future_wait
		b .Lresult_read
		.Lresult_handle:
		ldr x0, [x19, #8]
		cbz x0, .Lresult_read
		ldrb w1, [x19, #16]
		cbnz w1, .Lresult_read
		sub sp, sp, #16
		mov x1, sp
		bl _pthread_join
		add sp, sp, #16
		str xzr, [x19, #8]
		mov w0, #1
		strb w0, [x19, #16]
		.Lresult_read:
		// The result cell is always 16 bytes (see the spawn build phase):
		// load the full pair — a fat string returns (ptr, len) in x0/x1, a
		// scalar returns its word in x0 — then zero the cell (the value is
		// moved out; a second call observes the zero).
		ldr x8, [x19, #24]
		ldr x0, [x8]
		ldr x1, [x8, #8]
		stp xzr, xzr, [x8]
		```
	}

	// Block until the task finishes, then return its result as a uint64.
	// Convenience for the common case; same as result() for uint64 tasks.
	pub func result_uint64 = (ref self, out uint64) {
		```
		#arch: c
		if (self->future) {
			__nomen_future_wait((struct nomen_future *)self->future);
		} else if (self->handle && !self->done) {
			void *ret;
			pthread_join((pthread_t)self->handle, &ret);
			self->handle = 0;
			self->done = 1;
		}
		return *(unsigned long long *)self->result_slot;
		```
		```
		#arch: aarch64
		// Wait for completion
		ldr x0, [x19, #40]
		cbz x0, .Lru64_handle
		bl ___nomen_future_wait
		b .Lru64_read
		.Lru64_handle:
		ldr x0, [x19, #8]
		cbz x0, .Lru64_read
		ldrb w1, [x19, #16]
		cbnz w1, .Lru64_read
		sub sp, sp, #16
		mov x1, sp
		bl _pthread_join
		add sp, sp, #16
		str xzr, [x19, #8]
		mov w0, #1
		strb w0, [x19, #16]
		.Lru64_read:
		// return *(unsigned long long *)self->result_slot
		ldr x0, [x19, #24]
		ldr x0, [x0]
		```
	}

	// Request that the task stop. Cooperative — the task observes this via
	// `Task.current_cancelled()` at its own checkpoints. No preemption.
	pub func cancel = (ref self) {
		```
		#arch: c
		if (self->cancel_flag) {
			*(unsigned long long *)self->cancel_flag = 1;
		}
		```
		```
		#arch: aarch64
		// if (self->cancel_flag) *(self->cancel_flag) = 1
		ldr x0, [x19, #32]
		cbz x0, .Lcancel_done
		mov x1, #1
		str x1, [x0]
		.Lcancel_done:
		```
	}

	// Has the currently-running task been asked to cancel? Returns false
	// when called from outside any spawned task (e.g. main thread).
	pub func current_cancelled = (out bool) {
		```
		#arch: c
		return __nomen_current_cancel_flag && *__nomen_current_cancel_flag;
		```
		```
		#arch: aarch64_use_c
		return __nomen_current_cancel_flag && *__nomen_current_cancel_flag;
		```
	}

	// Configure the worker pool size. Must be called before the first spawn
	// — once the pool is initialized (lazily on first submit), the initial
	// size is fixed (the pool still grows on demand up to 64 workers when
	// every worker is busy). No-op if called after init (silent; check the
	// return value to detect). Returns 1 if the size was set, 0 otherwise.
	pub func set_pool_size = (int n, out int) {
		```
		#arch: c
		if (__nomen_pool_init || n <= 0) return 0;
		__nomen_pool_size = n;
		return 1;
		```
		```
		#arch: aarch64
		// x0 = n (first arg)
		// if (__nomen_pool_init || n <= 0) return 0
		adrp x1, ___nomen_pool_init@PAGE
		add x1, x1, ___nomen_pool_init@PAGEOFF
		ldr w2, [x1]
		cbnz w2, .Lsps_zero
		cmp x0, #0
		b.le .Lsps_zero
		// __nomen_pool_size = n
		adrp x1, ___nomen_pool_size@PAGE
		add x1, x1, ___nomen_pool_size@PAGEOFF
		str w0, [x1]
		mov x0, #1
		b .Lsps_done
		.Lsps_zero:
		mov x0, #0
		.Lsps_done:
		```
	}

	// Shut the worker pool down: drain the queue, join every worker, and
	// free the pool. Runs automatically at process exit (registered via
	// atexit on first submit), so outstanding fire-and-forget tasks always
	// complete before exit. Call explicitly to join all outstanding tasks
	// before continuing; the pool re-initializes on the next spawn.
	// Do NOT call from a spawned task (a worker joining its coworkers
	// deadlocks).
	pub func shutdown_pool = () {
		```
		#arch: c
		__nomen_pool_shutdown();
		```
		```
		#arch: aarch64
		bl ___nomen_pool_shutdown
		```
	}

	// Release this handle's reference to the future. The future owns the
	// result slot and cancel flag; it (and they) are freed only when the
	// last reference — this handle, the running trampoline, or a tracking
	// nursery — is released. A string result that was never consumed
	// (`result()` zeroes the slot when it moves the value out) is freed
	// here, before the future releases the cell. The Task instance itself
	// is freed by the auto-free pass after #destroy returns.
	pub func #destroy = () {
		```
		#arch: c
		if (self->future) {
		#if T_NEEDS_STRDUP
			// T is the fat nomen_string here (the guard is 0 for every other
			// T, and the preprocessor removes this region before parsing).
			if (self->result_slot) {
				T _s = *(T *)self->result_slot;
				if (_s.ptr) free(_s.ptr);
			}
		#endif
			__nomen_future_release((struct nomen_future *)self->future);
			self->future = 0;
			self->result_slot = 0;
			self->cancel_flag = 0;
		}
		```
		```
		#arch: aarch64
		// if (self->future) { free an unconsumed string result; release; zero fields }
		ldr x0, [x19, #40]
		cbz x0, .Ldestroy_done
		// An unconsumed string result: the cell still holds (ptr, len) —
		// result() zeroes it when it moves the value out. The T_FAT dispatch
		// folds to a constant branch after monomorphization.
		ldr x8, [x19, #24]
		mov x0, #T_FAT
		cmp x0, #0
		b.eq .Ldestroy_nofree
		cbz x8, .Ldestroy_nofree
		ldr x0, [x8]
		cbz x0, .Ldestroy_nofree
		bl _free
		.Ldestroy_nofree:
		ldr x0, [x19, #40]
		bl ___nomen_future_release
		str xzr, [x19, #40]
		str xzr, [x19, #24]
		str xzr, [x19, #32]
		.Ldestroy_done:
		```
	}
}
