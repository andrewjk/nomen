import Buffer

// Arena-backed binary tree. Values and left/right child indices live in flat
// Buffers, so there is a single owner and cleanup is a flat free -- no
// recursive pointer chasing, no borrow lifetimes. Node identifiers are stable
// int indices (read `count` before `add`); -1 means "no child".
// The `add` mutator is void for the same reason as LinkedList.add.
pub struct Tree<T> {
	var Buffer values = Buffer()
	var Buffer lefts = Buffer()
	var Buffer rights = Buffer()
	var int count = 0

	pub func add = (ref self, T value) {
		var int idx = self.count
		self.values.grow_int(idx + 1)
		var int v = value
		self.values.store_int(idx, v)
		self.lefts.grow_int(idx + 1)
		self.lefts.store_int(idx, -1)
		self.rights.grow_int(idx + 1)
		self.rights.store_int(idx, -1)
		self.count = self.count + 1
	}

	pub func set_left = (ref self, int idx, int left) {
		self.lefts.store_int(idx, left)
	}

	pub func set_right = (ref self, int idx, int right) {
		self.rights.store_int(idx, right)
	}

	pub func left = (self, int idx, out int) {
		return self.lefts.load_int(idx)
	}

	pub func right = (self, int idx, out int) {
		return self.rights.load_int(idx)
	}

	pub func value = (self, int idx, out T) {
		return self.values.load_int(idx)
	}

	pub func count_nodes = (self, int idx, out int) {
		if idx == -1 {
			return 0
		}
		return 1 + self.count_nodes(self.left(idx)) + self.count_nodes(self.right(idx))
	}

	pub func length = (self, out int) {
		return self.count
	}
}
