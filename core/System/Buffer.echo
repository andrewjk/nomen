// TODO: make Buffer generic (Buffer<T>) if we need more element types later
pub struct Buffer {
    var uint64 data = 0
    var int cap = 0

    func alloc = (ref self, int size) {
        ```
        #arch: c
        self->cap = size;
        self->data = (unsigned long long)(unsigned int*)calloc(size, sizeof(unsigned int));
        ```
        ```
        #arch: aarch64
        str x1, [x19, #16]
        mov x0, x1
        mov x1, #4
        bl _calloc
        str x0, [x19, #8]
        ```
    }

    func grow = (ref self, int needed) {
        ```
        #arch: c
        if (self->cap >= needed) return;
        int new_cap = self->cap;
        if (new_cap == 0) new_cap = 8;
        while (new_cap < needed) new_cap *= 2;
        self->data = (unsigned long long)(unsigned int*)realloc((unsigned int*)(unsigned long long)self->data, new_cap * sizeof(unsigned int));
        memset((unsigned int*)(unsigned long long)self->data + self->cap, 0, (new_cap - self->cap) * sizeof(unsigned int));
        self->cap = new_cap;
        ```
        ```
        #arch: aarch64
        ldr x2, [x19, #16]
        cmp x2, x1
        b.ge .Lbuffer_grow_end
        mov x3, #8
        cmp x2, #0
        csel x3, x3, x2, eq
        cmp x3, x1
        b.ge .Lbuffer_grow_got
        .Lbuffer_grow_loop:
        lsl x3, x3, #1
        cmp x3, x1
        b.lt .Lbuffer_grow_loop
        .Lbuffer_grow_got:
        sub sp, sp, #16
        str x2, [sp, #0]
        str x3, [sp, #8]
        ldr x0, [x19, #8]
        lsl x1, x3, #2
        bl _realloc
        str x0, [x19, #8]
        ldr x2, [sp, #0]
        ldr x3, [sp, #8]
        add sp, sp, #16
        str x3, [x19, #16]
        add x0, x0, x2, lsl #2
        mov x1, #0
        sub x2, x3, x2
        lsl x2, x2, #2
        bl _memset
        .Lbuffer_grow_end:
        ```
    }

    func zero = (ref self, int len) {
        ```
        #arch: c
        memset((unsigned int*)(unsigned long long)self->data, 0, len * sizeof(unsigned int));
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x2, x1, #2
        mov x1, #0
        bl _memset
        ```
    }

    inline func load = (self, int i: i >= 0, out uint32) {
        ```
        #arch: c
        return ((unsigned int*)(unsigned long long)self->data)[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x1, x1, #2
        add x0, x0, x1
        ldr w0, [x0]
        and x0, x0, #0xFFFFFFFF
        b .return_Buffer_load
        ```
        return 0 as uint32
    }

    inline func store = (ref self, int i: i >= 0, uint32 val) {
        ```
        #arch: c
        ((unsigned int*)(unsigned long long)self->data)[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #2
        add x0, x0, x3
        str w2, [x0]
        ```
    }

    inline func store_or = (ref self, int i: i >= 0, uint32 val) {
        ```
        #arch: c
        ((unsigned int*)(unsigned long long)self->data)[i] |= val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #2
        add x0, x0, x3
        ldr w3, [x0]
        orr w3, w3, w2
        str w3, [x0]
        ```
    }

    func alloc_int = (ref self, int size) {
        ```
        #arch: c
        self->cap = size;
        self->data = (unsigned long long)(long*)calloc(size, sizeof(long));
        ```
        ```
        #arch: aarch64
        str x1, [x19, #16]
        mov x0, x1
        mov x1, #8
        bl _calloc
        str x0, [x19, #8]
        ```
    }

    func grow_int = (ref self, int needed) {
        ```
        #arch: c
        if (self->cap >= needed) return;
        int new_cap = self->cap;
        if (new_cap == 0) new_cap = 4;
        while (new_cap < needed) new_cap *= 2;
        self->data = (unsigned long long)(long*)realloc((long*)(unsigned long long)self->data, new_cap * sizeof(long));
        memset((long*)(unsigned long long)self->data + self->cap, 0, (new_cap - self->cap) * sizeof(long));
        self->cap = new_cap;
        ```
        ```
        #arch: aarch64
        ldr x2, [x19, #16]
        cmp x2, x1
        b.ge .Lbuffer_grow_int_end
        mov x3, #4
        cmp x2, #0
        csel x3, x3, x2, eq
        cmp x3, x1
        b.ge .Lbuffer_grow_int_got
        .Lbuffer_grow_int_loop:
        lsl x3, x3, #1
        cmp x3, x1
        b.lt .Lbuffer_grow_int_loop
        .Lbuffer_grow_int_got:
        sub sp, sp, #16
        str x2, [sp, #0]
        str x3, [sp, #8]
        ldr x0, [x19, #8]
        lsl x1, x3, #3
        bl _realloc
        str x0, [x19, #8]
        ldr x2, [sp, #0]
        ldr x3, [sp, #8]
        add sp, sp, #16
        str x3, [x19, #16]
        add x0, x0, x2, lsl #3
        mov x1, #0
        sub x2, x3, x2
        lsl x2, x2, #3
        bl _memset
        .Lbuffer_grow_int_end:
        ```
    }

    inline func load_int = (self, int i: i >= 0, out int) {
        ```
        #arch: c
        return ((long*)(unsigned long long)self->data)[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x1, x1, #3
        add x0, x0, x1
        ldr x0, [x0]
        b .return_Buffer_load_int
        ```
        return 0
    }

    inline func store_int = (ref self, int i: i >= 0, int val) {
        ```
        #arch: c
        ((long*)(unsigned long long)self->data)[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x0, x0, x3
        str x2, [x0]
        ```
    }

    inline func get_cap = (self, out int) {
        ```
        #arch: c
        return self->cap;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #16]
        b .return_Buffer_get_cap
        ```
        return 0
    }

    inline func zero_int = (ref self, int len) {
        ```
        #arch: c
        memset((long*)(unsigned long long)self->data, 0, len * sizeof(long));
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x2, x1, #3
        mov x1, #0
        bl _memset
        ```
    }

    inline func store_or_int = (ref self, int i: i >= 0, int val) {
        ```
        #arch: c
        ((long*)(unsigned long long)self->data)[i] |= val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x0, x0, x3
        ldr x3, [x0]
        orr x3, x3, x2
        str x3, [x0]
        ```
    }

    func alloc_float = (ref self, int size) {
        ```
        #arch: c
        self->cap = size;
        self->data = (unsigned long long)(double*)calloc(size, sizeof(double));
        ```
        ```
        #arch: aarch64
        str x1, [x19, #16]
        mov x0, x1
        mov x1, #8
        bl _calloc
        str x0, [x19, #8]
        ```
    }

    inline func load_float = (self, int i: i >= 0, out float) {
        ```
        #arch: c
        return ((double*)(unsigned long long)self->data)[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x1, x1, #3
        add x0, x0, x1
        ldr x0, [x0]
        b .return_Buffer_load_float
        ```
        return 0.0
    }

    inline func store_float = (ref self, int i: i >= 0, float val) {
        ```
        #arch: c
        ((double*)(unsigned long long)self->data)[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x0, x0, x3
        str x2, [x0]
        ```
    }

    func #destroy = () {
        ```
        #arch: c
        if (self->data) free((unsigned int*)(unsigned long long)self->data);
        self->data = 0;
        self->cap = 0;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        cbz x0, .Lbuffer_destroy_end
        bl _free
        .Lbuffer_destroy_end:
        str xzr, [x19, #8]
        str xzr, [x19, #16]
        ```
    }
}
