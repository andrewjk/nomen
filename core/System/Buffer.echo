// TODO: make Buffer generic (Buffer<T>) if we need more element types later
pub struct Buffer {
    var uint64 data = 0
    var int cap = 0
    var int has_class_refs = 0
    var uint64 destroy_fn = 0

    func alloc = (ref self, int size, out int: out >= size) {
        ```
        #arch: c
        self->cap = size;
        self->data = (unsigned long long)(unsigned int*)calloc(size, sizeof(unsigned int));
        return self->cap;
        ```
        ```
        #arch: aarch64
        str x1, [x19, #16]
        mov x0, x1
        mov x1, #4
        bl _calloc
        str x0, [x19, #8]
        ldr x0, [x19, #16]
        ```
    }

    func grow = (ref self, int needed, out int: out >= needed) {
        ```
        #arch: c
        if (self->cap >= needed) return self->cap;
        int new_cap = self->cap;
        if (new_cap == 0) new_cap = 8;
        while (new_cap < needed) new_cap *= 2;
        self->data = (unsigned long long)(unsigned int*)realloc((unsigned int*)(unsigned long long)self->data, new_cap * sizeof(unsigned int));
        memset((unsigned int*)(unsigned long long)self->data + self->cap, 0, (new_cap - self->cap) * sizeof(unsigned int));
        self->cap = new_cap;
        return self->cap;
        ```
        ```
        #arch: aarch64
        ldr x2, [x19, #16]
        cmp x2, x1
        b.ge .Lbuffer_grow_end
        mov x3, #8
        cmp x2, #0
        csel x3, x3, x2, eq
        cmp x3, x1
        b.ge .Lbuffer_grow_got
        .Lbuffer_grow_loop:
        lsl x3, x3, #1
        cmp x3, x1
        b.lt .Lbuffer_grow_loop
        .Lbuffer_grow_got:
        sub sp, sp, #16
        str x2, [sp, #0]
        str x3, [sp, #8]
        ldr x0, [x19, #8]
        lsl x1, x3, #2
        bl _realloc
        str x0, [x19, #8]
        ldr x2, [sp, #0]
        ldr x3, [sp, #8]
        add sp, sp, #16
        str x3, [x19, #16]
        add x0, x0, x2, lsl #2
        mov x1, #0
        sub x2, x3, x2
        lsl x2, x2, #2
        bl _memset
        .Lbuffer_grow_end:
        ldr x0, [x19, #16]
        ```
    }

    func zero = (ref self, int len) {
        ```
        #arch: c
        memset((unsigned int*)(unsigned long long)self->data, 0, len * sizeof(unsigned int));
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x2, x1, #2
        mov x1, #0
        bl _memset
        ```
    }

    inline func load = (self, int i: i >= 0 && i < self.cap, out uint32) {
        ```
        #arch: c
        return ((unsigned int*)(unsigned long long)self->data)[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x1, x1, #2
        add x0, x0, x1
        ldr w0, [x0]
        and x0, x0, #0xFFFFFFFF
        b .return_Buffer_load
        ```
        return 0 as uint32
    }

    inline func store = (ref self, int i: i >= 0 && i < self.cap, uint32 val) {
        ```
        #arch: c
        ((unsigned int*)(unsigned long long)self->data)[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #2
        add x0, x0, x3
        str w2, [x0]
        ```
    }

    inline func store_or = (ref self, int i: i >= 0 && i < self.cap, uint32 val) {
        ```
        #arch: c
        ((unsigned int*)(unsigned long long)self->data)[i] |= val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #2
        add x0, x0, x3
        ldr w3, [x0]
        orr w3, w3, w2
        str w3, [x0]
        ```
    }

    func alloc_int = (ref self, int size, out int: out >= size) {
        ```
        #arch: c
        self->cap = size;
        self->data = (unsigned long long)(long*)calloc(size, sizeof(long));
        return self->cap;
        ```
        ```
        #arch: aarch64
        str x1, [x19, #16]
        mov x0, x1
        mov x1, #8
        bl _calloc
        str x0, [x19, #8]
        ldr x0, [x19, #16]
        ```
    }

    func grow_int = (ref self, int needed, out int: out >= needed) {
        ```
        #arch: c
        if (self->cap >= needed) return self->cap;
        int new_cap = self->cap;
        if (new_cap == 0) new_cap = 4;
        while (new_cap < needed) new_cap *= 2;
        self->data = (unsigned long long)(long*)realloc((long*)(unsigned long long)self->data, new_cap * sizeof(long));
        memset((long*)(unsigned long long)self->data + self->cap, 0, (new_cap - self->cap) * sizeof(long));
        self->cap = new_cap;
        return self->cap;
        ```
        ```
        #arch: aarch64
        ldr x2, [x19, #16]
        cmp x2, x1
        b.ge .Lbuffer_grow_int_end
        mov x3, #4
        cmp x2, #0
        csel x3, x3, x2, eq
        cmp x3, x1
        b.ge .Lbuffer_grow_int_got
        .Lbuffer_grow_int_loop:
        lsl x3, x3, #1
        cmp x3, x1
        b.lt .Lbuffer_grow_int_loop
        .Lbuffer_grow_int_got:
        sub sp, sp, #16
        str x2, [sp, #0]
        str x3, [sp, #8]
        ldr x0, [x19, #8]
        lsl x1, x3, #3
        bl _realloc
        str x0, [x19, #8]
        ldr x2, [sp, #0]
        ldr x3, [sp, #8]
        add sp, sp, #16
        str x3, [x19, #16]
        add x0, x0, x2, lsl #3
        mov x1, #0
        sub x2, x3, x2
        lsl x2, x2, #3
        bl _memset
        .Lbuffer_grow_int_end:
        ldr x0, [x19, #16]
        ```
    }

    inline func load_int = (self, int i: i >= 0 && i < self.cap, out int) {
        ```
        #arch: c
        return ((long*)(unsigned long long)self->data)[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x1, x1, #3
        add x0, x0, x1
        ldr x0, [x0]
        b .return_Buffer_load_int
        ```
        return 0
    }

    inline func store_int = (ref self, int i: i >= 0 && i < self.cap, int val) {
        ```
        #arch: c
        ((long*)(unsigned long long)self->data)[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x0, x0, x3
        str x2, [x0]
        ```
    }

    // Move a value out of a slot: return it and clear the slot to 0. This is
    // the ownership-extracting primitive (used by e.g. List.pop) — unlike
    // load_int (a borrow read), it relinquishes the slot so the buffer no
    // longer owns the value.
    inline func move_int = (ref self, int i: i >= 0 && i < self.cap, out int) {
        ```
        #arch: c
        long *slots = (long*)(unsigned long long)self->data;
        long val = slots[i];
        slots[i] = 0;
        return val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x3, x0, x3
        ldr x0, [x3]
        str xzr, [x3]
        ```
    }

    // Store into a slot, freeing the previous value when the buffer holds
    // owned class pointers (has_class_refs). For non-class buffers this is a
    // plain store, so it is safe to use anywhere store_int would be.
    func replace_int = (ref self, int i: i >= 0 && i < self.cap, int val) {
        ```
        #arch: c
        long *slots = (long*)(unsigned long long)self->data;
        if (self->has_class_refs && slots[i]) free((void*)slots[i]);
        slots[i] = val;
        ```
        ```
        #arch: aarch64
        stp x20, x21, [sp, #-16]!
        mov x20, x2
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x21, x0, x3
        ldr x0, [x19, #24]
        cbz x0, .Lbuffer_replace_store
        ldr x0, [x21]
        cbz x0, .Lbuffer_replace_store
        bl _free
        .Lbuffer_replace_store:
        str x20, [x21]
        ldp x20, x21, [sp], #16
        ```
    }

    inline func zero_int = (ref self, int len) {
        ```
        #arch: c
        memset((long*)(unsigned long long)self->data, 0, len * sizeof(long));
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x2, x1, #3
        mov x1, #0
        bl _memset
        ```
    }

    inline func store_or_int = (ref self, int i: i >= 0 && i < self.cap, int val) {
        ```
        #arch: c
        ((long*)(unsigned long long)self->data)[i] |= val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x0, x0, x3
        ldr x3, [x0]
        orr x3, x3, x2
        str x3, [x0]
        ```
    }

    func alloc_float = (ref self, int size, out int: out >= size) {
        ```
        #arch: c
        self->cap = size;
        self->data = (unsigned long long)(double*)calloc(size, sizeof(double));
        return self->cap;
        ```
        ```
        #arch: aarch64
        str x1, [x19, #16]
        mov x0, x1
        mov x1, #8
        bl _calloc
        str x0, [x19, #8]
        ldr x0, [x19, #16]
        ```
    }

    inline func load_float = (self, int i: i >= 0 && i < self.cap, out float) {
        ```
        #arch: c
        return ((double*)(unsigned long long)self->data)[i];
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x1, x1, #3
        add x0, x0, x1
        ldr x0, [x0]
        b .return_Buffer_load_float
        ```
        return 0.0
    }

    inline func store_float = (ref self, int i: i >= 0 && i < self.cap, float val) {
        ```
        #arch: c
        ((double*)(unsigned long long)self->data)[i] = val;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #8]
        lsl x3, x1, #3
        add x0, x0, x3
        str x2, [x0]
        ```
    }

    func #destroy = () {
        ```
        #arch: c
        if (self->has_class_refs && self->data) {
            long *slots = (long*)(unsigned long long)self->data;
            for (int i = 0; i < self->cap; i++) {
                if (slots[i]) {
                    if (self->destroy_fn) {
                        ((void(*)(void*))(unsigned long long)self->destroy_fn)((void*)slots[i]);
                    }
                    free((void*)slots[i]);
                }
            }
        }
        if (self->data) free((unsigned int*)(unsigned long long)self->data);
        self->data = 0;
        self->cap = 0;
        self->has_class_refs = 0;
        self->destroy_fn = 0;
        ```
        ```
        #arch: aarch64
        ldr x0, [x19, #24]
        cbz x0, .Lbuffer_destroy_no_refs
        ldr x0, [x19, #8]
        cbz x0, .Lbuffer_destroy_no_refs
        stp x20, x21, [sp, #-16]!
        str x22, [sp, #-16]!
        mov x20, x0
        ldr x21, [x19, #16]
        mov x22, #0
        .Lbuffer_free_ref_loop:
        cmp x22, x21
        b.ge .Lbuffer_free_ref_done
        ldr x0, [x20, x22, lsl #3]
        cbz x0, .Lbuffer_free_ref_skip
        ldr x9, [x19, #32]
        cbz x9, .Lbuffer_free_ref_nofn
        blr x9
        ldr x0, [x20, x22, lsl #3]
        .Lbuffer_free_ref_nofn:
        bl _free
        .Lbuffer_free_ref_skip:
        add x22, x22, #1
        b .Lbuffer_free_ref_loop
        .Lbuffer_free_ref_done:
        ldr x22, [sp], #16
        ldp x20, x21, [sp], #16
        .Lbuffer_destroy_no_refs:
        ldr x0, [x19, #8]
        cbz x0, .Lbuffer_destroy_end
        bl _free
        .Lbuffer_destroy_end:
        str xzr, [x19, #8]
        str xzr, [x19, #16]
        str xzr, [x19, #24]
        str xzr, [x19, #32]
        ```
    }
}
