/**
 * Mathematical helper functions
 **/
pub struct Math {
	pub func power = (int base, int exp, out int) {
		var result = 1
		var i = 0
		while i < exp; i += 1 {
			result = result * base
		}
		return result
	}

	// Square root — stays an inline raw body, deliberately (see
	// CORE_RAW.md): the single-fsqrt splice is load-bearing on aarch64,
	// where a real call both scalarizes the loop SLP shapes and exposes a
	// latent stale-x0 spill in scalar float-tree emission (FOLLOWUP.md).
	inline func sqrt = (float x, out float) {
		```
		#arch: c
		return sqrt(x);
		```
		```
		#arch: aarch64
		fmov d0, x0
		fsqrt d0, d0
		fmov x0, d0
		```
	}

	// libm natural logarithm — extern.
	extern func log = (float x, out float)
}
