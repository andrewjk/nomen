// Buffer<T>: a flat buffer of value slots of type T. The value counterpart to
// ClassBuffer<T>: no per-element freeing, store_int unconstrained. When T is a
// class, the monomorphizer rewrites a Buffer<T> field to ClassBuffer<T>.
//
// `internal`: its low-level slot primitives are unsafe to drive directly
// (e.g. `store_T` assumes a fresh slot and leaks on overwrite), so the type is
// hidden from user code until a sound public surface exists. Containers in this
// library reach it through `internal` visibility.

/**
 * A flat, low-level buffer of value slots of type T — the backing store for arrays and collections
 **/
internal struct Buffer<T> {
	var uint64 data = 0
	var cap = 0

	// Allocation / sizing primitives are `unsafe` Nomen single-sourced for
	// both backends. They run once per container op (never per element), so
	// the aarch64 inline-method ABI cost that keeps the per-limb load/store
	// primitives raw (see BigInt.nm) doesn't apply here.
	func alloc = (ref self, int size, out int: out >= size) {
		self.cap = size
		self.data = calloc(size, 4)
		return self.cap
	}

	func grow = (ref self, int needed, out int: out >= needed) {
		if self.cap >= needed {
			return self.cap
		}
		var int new_cap = self.cap
		if new_cap == 0 {
			new_cap = 8
		}
		while new_cap < needed; new_cap *= 2 {}
		self.data = realloc(self.data, new_cap * 4)
		memset(self.data + self.cap * 4, 0, (new_cap - self.cap) * 4)
		self.cap = new_cap
		return self.cap
	}

	func zero = (ref self, int len) {
		memset(self.data, 0, len * 4)
	}

	inline func load = (self, int i: i >= 0 && i < self.cap, out uint32) {
		```
		#arch: c
		return ((unsigned int*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #2
		add x0, x0, x1
		ldr w0, [x0]
		and x0, x0, #0xFFFFFFFF
		```
	}

	inline func store = (ref self, int i: i >= 0 && i < self.cap, uint32 val) {
		```
		#arch: c
		((unsigned int*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #2
		add x0, x0, x3
		str w2, [x0]
		```
	}

	inline func store_or = (ref self, int i: i >= 0 && i < self.cap, uint32 val) {
		```
		#arch: c
		((unsigned int*)(unsigned long long)self->data)[i] |= val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #2
		add x0, x0, x3
		ldr w3, [x0]
		orr w3, w3, w2
		str w3, [x0]
		```
	}

	func alloc_int = (ref self, int size, out int: out >= size) {
		self.cap = size
		self.data = calloc(size, 8)
		return self.cap
	}

	func grow_int = (ref self, int needed, out int: out >= needed) {
		if self.cap >= needed {
			return self.cap
		}
		var int new_cap = self.cap
		if new_cap == 0 {
			new_cap = 4
		}
		while new_cap < needed; new_cap *= 2 {}
		self.data = realloc(self.data, new_cap * 8)
		memset(self.data + self.cap * 8, 0, (new_cap - self.cap) * 8)
		self.cap = new_cap
		return self.cap
	}

	inline func load_int = (self, int i: i >= 0 && i < self.cap, out int) {
		```
		#arch: c
		return ((long*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #3
		add x0, x0, x1
		ldr x0, [x0]
		```
	}

	inline func store_int = (ref self, int i: i >= 0 && i < self.cap, int val) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	// Move a value out of a slot: return it and clear the slot to 0. This is
	// the ownership-extracting primitive (used by e.g. List.pop) — unlike
	// load_int (a borrow read), it relinquishes the slot so the buffer no
	// longer owns the value.
	inline func move_int = (ref self, int i: i >= 0 && i < self.cap, out int) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		long val = slots[i];
		slots[i] = 0;
		return val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x3, x0, x3
		ldr x0, [x3]
		str xzr, [x3]
		```
	}

	// Store into a slot, freeing the previous value when the buffer holds
	// owned class pointers (has_class_refs). For non-class buffers this is a
	// plain store, so it is safe to use anywhere store_int would be.
	inline func replace_int = (ref self, int i: i >= 0 && i < self.cap, int val) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	inline func zero_int = (ref self, int len) {
		memset(self.data, 0, len * 8)
	}

	// T_SIZE-aware primitives for value-struct elements. Slab is sized in
	// multiples of T_SIZE; load/store use memcpy so multi-word structs work
	// correctly. Classes route to ClassBuffer<T> (per-element destroy), so T
	// reaching here is always a value type (primitive or struct).

	func alloc_T = (ref self, int size, out int: out >= size) {
		self.cap = size
		self.data = calloc(size, T_SIZE)
		return self.cap
	}

	func grow_T = (ref self, int needed, out int: out >= needed) {
		if self.cap >= needed {
			return self.cap
		}
		var int new_cap = self.cap
		if new_cap == 0 {
			new_cap = 4
		}
		while new_cap < needed; new_cap *= 2 {}
		self.data = realloc(self.data, new_cap * T_SIZE)
		memset(self.data + self.cap * T_SIZE, 0, (new_cap - self.cap) * T_SIZE)
		self.cap = new_cap
		return self.cap
	}

	// `inline` splices the (width-folded at monomorphization) raw body at
	// call sites — the load/store pair behind every container `.at`/`set` is
	// the hottest path in data-heavy code, and the naked-inline path keeps it
	// to a handful of instructions with no call overhead.
	inline func load_T = (self, int i: i >= 0 && i < self.cap, out T) {
		```
		#arch: c
		return ((T*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		// x19 = self, x1 = i, x8 = return buf for structs
		ldr x0, [x19, #8]
		mov x3, #T_SIZE
		madd x1, x1, x3, xzr
		add x0, x0, x1
		cmp x3, #8
		b.gt .Lbuffer_load_T_copy
		// Width-matched load (zero-extends) — an 8-byte ldr on a sub-8
		// element would read past the slab's end and leave garbage in the
		// upper bits.
		cmp x3, #1
		b.eq .Lbuffer_load_T_1
		cmp x3, #2
		b.eq .Lbuffer_load_T_2
		cmp x3, #4
		b.eq .Lbuffer_load_T_4
		ldr x0, [x0]
		b .Lbuffer_load_T_end
		.Lbuffer_load_T_1:
		ldrb w0, [x0]
		b .Lbuffer_load_T_end
		.Lbuffer_load_T_2:
		ldrh w0, [x0]
		b .Lbuffer_load_T_end
		.Lbuffer_load_T_4:
		ldr w0, [x0]
		b .Lbuffer_load_T_end
		.Lbuffer_load_T_copy:
		mov x1, x0
		mov x0, x8
		mov x2, x3
		bl _memcpy
		.Lbuffer_load_T_end:
		```
	}

	// Store `val` into slot `i`, which MUST be fresh (calloc'd, or zeroed by
	// move_T). For an owning T (string, or a struct with string fields) the
	// specialised body deep-copies the incoming value but does NOT free the
	// slot's previous occupant — a second `store_T` at an occupied index
	// leaks it. To overwrite a live slot use replace_T (frees the displaced
	// value) — this is the primitive every container's `set` uses.
	inline func store_T = (ref self, int i: i >= 0 && i < self.cap, T val) {
		```
		#arch: c
		((T*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		// x19 = self, x1 = i, x2 = val (value if T_SIZE<=8, address if struct)
		ldr x0, [x19, #8]
		mov x3, #T_SIZE
		madd x1, x1, x3, xzr
		add x0, x0, x1
		cmp x3, #8
		b.gt .Lbuffer_store_T_copy
		// Sub-8 element types must use a width-matched store: an 8-byte str
		// would clobber the following slots (and run past the slab's end).
		cmp x3, #1
		b.eq .Lbuffer_store_T_1
		cmp x3, #2
		b.eq .Lbuffer_store_T_2
		cmp x3, #4
		b.eq .Lbuffer_store_T_4
		str x2, [x0]
		b .Lbuffer_store_T_end
		.Lbuffer_store_T_1:
		strb w2, [x0]
		b .Lbuffer_store_T_end
		.Lbuffer_store_T_2:
		strh w2, [x0]
		b .Lbuffer_store_T_end
		.Lbuffer_store_T_4:
		str w2, [x0]
		b .Lbuffer_store_T_end
		.Lbuffer_store_T_copy:
		mov x1, x2
		mov x2, x3
		bl _memcpy
		.Lbuffer_store_T_end:
		```
	}

	// Move a value out of a T_SIZE-sized slot: return it and zero the slot so the
	// buffer no longer holds a (possibly owning) copy. Declared `move out T` so
	// the result is treated as OWNED by the borrow checker — the slot is
	// relinquished, so the caller is the sole remaining owner. The value
	// counterpart of ClassBuffer.move_int — used by List.pop for any value T.
	inline func move_T = (ref self, int i: i >= 0 && i < self.cap, move out T) {
		```
		#arch: c
		T* _slots = (T*)(unsigned long long)self->data;
		T _tmp = _slots[i];
		memset((void*)&_slots[i], 0, T_SIZE);
		return _tmp;
		```
		```
		#arch: aarch64
		// x19 = self, x1 = i, x8 = return buf when T_SIZE > 8
		ldr x4, [x19, #8]
		mov x3, #T_SIZE
		madd x5, x1, x3, xzr
		add x5, x4, x5
		cmp x3, #8
		b.gt .Lbuffer_move_T_copy
		// Width-matched load + zero-clear: an 8-byte access on a sub-8
		// element would zero the following slots and run past the slab.
		cmp x3, #1
		b.eq .Lbuffer_move_T_1
		cmp x3, #2
		b.eq .Lbuffer_move_T_2
		cmp x3, #4
		b.eq .Lbuffer_move_T_4
		ldr x0, [x5]
		str xzr, [x5]
		b .Lbuffer_move_T_end
		.Lbuffer_move_T_1:
		ldrb w0, [x5]
		strb wzr, [x5]
		b .Lbuffer_move_T_end
		.Lbuffer_move_T_2:
		ldrh w0, [x5]
		strh wzr, [x5]
		b .Lbuffer_move_T_end
		.Lbuffer_move_T_4:
		ldr w0, [x5]
		str wzr, [x5]
		b .Lbuffer_move_T_end
		.Lbuffer_move_T_copy:
		mov x0, x8
		mov x1, x5
		mov x2, x3
		stp x5, x3, [sp, #-16]!
		bl _memcpy
		ldp x5, x3, [sp], #16
		mov x0, x5
		mov x1, #0
		mov x2, x3
		bl _memset
		mov x0, x8
		.Lbuffer_move_T_end:
		```
	}

	// Apply `f` to slot `i` in place: the safe way to do a load→modify→store
	// round-trip on a live slot. `f` receives the current value as a borrow
	// (by value) and returns the replacement; the primitive itself handles
	// ownership — the displaced value is freed, and a returned field that
	// aliases the slot's own copy (the round-trip case) is kept, not freed or
	// re-copied. Unlike store_T this never leaks on overwrite, and unlike
	// replace_T it is safe to derive the new value from the old one. The
	// returned struct's owning fields must be fresh, null, or identical to
	// the corresponding input fields (no cross-field aliasing). For owning
	// elements (string / structs with string fields) the build phase replaces
	// this body with a specialized one (see owning_buffer_specialize.ts);
	// this raw form is correct for trivially-copyable elements only. NOT
	// `inline`: the body calls through the fn pointer, so splicing the raw
	// block into a caller would bypass the per-element specializations.
	func modify_T = (ref self, int i: i >= 0 && i < self.cap, func (T, out T) f) {
		```
		#arch: c
		((T*)(unsigned long long)self->data)[i] = f(((T*)(unsigned long long)self->data)[i]);
		```
		```
		#arch: aarch64
		// x19 = self, x1 = i, x2 = f. Scalar elements round-trip through x0
		// (width-matched); larger trivially-copyable structs pass the slot
		// address and an sret pointer (x8) — the fn writes the replacement
		// straight into the slot from a stack-stage copy of the old value.
		stp x20, x21, [sp, #-16]!
		stp x22, x23, [sp, #-16]!
		mov x22, x2
		ldr x9, [x19, #8]
		mov x3, #T_SIZE
		madd x20, x1, x3, xzr
		add x20, x20, x9
		cmp x3, #8
		b.gt .Lbuffer_modify_T_big
		cmp x3, #1
		b.eq .Lbuffer_modify_T_ld1
		cmp x3, #2
		b.eq .Lbuffer_modify_T_ld2
		cmp x3, #4
		b.eq .Lbuffer_modify_T_ld4
		ldr x0, [x20]
		b .Lbuffer_modify_T_call
		.Lbuffer_modify_T_ld1:
		ldrb w0, [x20]
		b .Lbuffer_modify_T_call
		.Lbuffer_modify_T_ld2:
		ldrh w0, [x20]
		b .Lbuffer_modify_T_call
		.Lbuffer_modify_T_ld4:
		ldr w0, [x20]
		.Lbuffer_modify_T_call:
		blr x22
		cmp x3, #1
		b.eq .Lbuffer_modify_T_st1
		cmp x3, #2
		b.eq .Lbuffer_modify_T_st2
		cmp x3, #4
		b.eq .Lbuffer_modify_T_st4
		str x0, [x20]
		b .Lbuffer_modify_T_end
		.Lbuffer_modify_T_st1:
		strb w0, [x20]
		b .Lbuffer_modify_T_end
		.Lbuffer_modify_T_st2:
		strh w0, [x20]
		b .Lbuffer_modify_T_end
		.Lbuffer_modify_T_st4:
		str w0, [x20]
		b .Lbuffer_modify_T_end
		.Lbuffer_modify_T_big:
		add x23, x3, #15
		bic x23, x23, #15
		sub sp, sp, x23
		mov x0, sp
		mov x1, x20
		mov x2, x3
		bl _memcpy
		mov x0, sp
		mov x8, x20
		blr x22
		add sp, sp, x23
		.Lbuffer_modify_T_end:
		ldp x22, x23, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// Store into a T_SIZE-sized slot, overwriting the previous value. For
	// trivially-destructible value structs this is a plain overwrite. For
	// owning value structs (with string fields), the build phase replaces this
	// body with a specialised version that calls T_destroy on the old slot
	// value, then deep-copies (strdup per string field). See
	// owning_buffer_specialize.ts (both backends). ClassBuffer.replace_T
	// destroys+frees class slots soundly.
	inline func replace_T = (ref self, int i: i >= 0 && i < self.cap, T val) {
		```
		#arch: c
		((T*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		// x19 = self, x1 = i, x2 = val (value if T_SIZE<=8, address if struct)
		ldr x0, [x19, #8]
		mov x3, #T_SIZE
		madd x1, x1, x3, xzr
		add x0, x0, x1
		cmp x3, #8
		b.gt .Lbuffer_replace_T_copy
		// Width-matched store: an 8-byte str on a sub-8 element would
		// clobber the following slots and run past the slab's end.
		cmp x3, #1
		b.eq .Lbuffer_replace_T_1
		cmp x3, #2
		b.eq .Lbuffer_replace_T_2
		cmp x3, #4
		b.eq .Lbuffer_replace_T_4
		str x2, [x0]
		b .Lbuffer_replace_T_end
		.Lbuffer_replace_T_1:
		strb w2, [x0]
		b .Lbuffer_replace_T_end
		.Lbuffer_replace_T_2:
		strh w2, [x0]
		b .Lbuffer_replace_T_end
		.Lbuffer_replace_T_4:
		str w2, [x0]
		b .Lbuffer_replace_T_end
		.Lbuffer_replace_T_copy:
		mov x1, x2
		mov x2, x3
		bl _memcpy
		.Lbuffer_replace_T_end:
		```
	}

	// Move slot src into slot dst: overwrite dst with src's bytes and zero
	// src, so exactly ONE slot owns the value afterwards. The
	// ownership-transferring primitive behind backward-shift deletion
	// (Map/Set.remove) — unlike store_T, which gives the slot its own deep
	// copy and leaves the source slot intact, a shift transfers the source's
	// heap pointers wholesale. For owning elements (string / value structs
	// with string fields) the build replaces this body with a specialized
	// version that also reclaims dst's previous value first (see
	// owning_buffer_specialize.ts); this raw form is correct for
	// trivially-destructible elements only.
	inline func shift_T = (ref self, int dst: dst >= 0 && dst < self.cap, int src: src >= 0 && src < self.cap) {
		```
		#arch: c
		T* _slots = (T*)(unsigned long long)self->data;
		if (dst != src) {
			_slots[dst] = _slots[src];
			memset((void*)&_slots[src], 0, T_SIZE);
		}
		```
		```
		#arch: aarch64
		// x19 = self, x1 = dst, x2 = src
		ldr x4, [x19, #8]
		mov x3, #T_SIZE
		madd x5, x1, x3, x4
		madd x6, x2, x3, x4
		cmp x5, x6
		b.eq .Lbuffer_shift_T_end
		cmp x3, #8
		b.gt .Lbuffer_shift_T_copy
		// Width-matched move: an 8-byte access on a sub-8 element would
		// clobber the following slot (and run past the slab's end).
		cmp x3, #1
		b.eq .Lbuffer_shift_T_1
		cmp x3, #2
		b.eq .Lbuffer_shift_T_2
		cmp x3, #4
		b.eq .Lbuffer_shift_T_4
		ldr x7, [x6]
		str x7, [x5]
		str xzr, [x6]
		b .Lbuffer_shift_T_end
		.Lbuffer_shift_T_1:
		ldrb w7, [x6]
		strb w7, [x5]
		strb wzr, [x6]
		b .Lbuffer_shift_T_end
		.Lbuffer_shift_T_2:
		ldrh w7, [x6]
		strh w7, [x5]
		strh wzr, [x6]
		b .Lbuffer_shift_T_end
		.Lbuffer_shift_T_4:
		ldr w7, [x6]
		str w7, [x5]
		str wzr, [x6]
		b .Lbuffer_shift_T_end
		.Lbuffer_shift_T_copy:
		mov x0, x5
		mov x1, x6
		mov x2, x3
		stp x5, x6, [sp, #-16]!
		bl _memcpy
		ldp x5, x6, [sp], #16
		mov x0, x6
		mov x1, #0
		mov x2, x3
		bl _memset
		.Lbuffer_shift_T_end:
		```
	}

	// A non-owning (ptr, len) slice [start, end) over this buffer's element
	// storage, returned as a `view T`. It borrows from self: it may not outlive
	// self's scope and is invalidated if self is reassigned. This is the single
	// primitive every other slice (Array<T>, List<T>, user containers) builds
	// on — higher layers just `return self.items.slice(start, end)`.
	func slice = (self, int start: start >= 0, int end: end >= start, out view T) {
		```
		#arch: c
		nomen_view _r;
		_r.ptr = (void*)((T*)(unsigned long long)self->data + start);
		_r.len = (long)(end - start);
		return _r;
		```
		```
		#arch: aarch64
		// x19 = self (Buffer struct ptr), x1 = start, x2 = end.
		// self->data lives at [x19, #8]. Return (ptr, len) in x0/x1.
		ldr x0, [x19, #8]
		mov x3, #T_SIZE
		madd x0, x1, x3, x0
		sub x1, x2, x1
		```
	}

	inline func zero_T = (ref self, int len) {
		memset(self.data, 0, len * T_SIZE)
	}

	inline func store_or_int = (ref self, int i: i >= 0 && i < self.cap, int val) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] |= val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		ldr x3, [x0]
		orr x3, x3, x2
		str x3, [x0]
		```
	}

	func alloc_float = (ref self, int size, out int: out >= size) {
		self.cap = size
		self.data = calloc(size, 8)
		return self.cap
	}

	inline func load_float = (self, int i: i >= 0 && i < self.cap, out float) {
		```
		#arch: c
		return ((double*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #3
		add x0, x0, x1
		ldr x0, [x0]
		```
	}

	inline func store_float = (ref self, int i: i >= 0 && i < self.cap, float val) {
		```
		#arch: c
		((double*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	func #destroy = () {
		if self.data != 0 {
			free(self.data)
		}
		self.data = 0
		self.cap = 0
	}
}
