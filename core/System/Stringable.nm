/**
 * A trait for values that can be converted to a string via `to_string`
 *
 * The default body is a REFLECTION DERIVATION (the derive migration): a
 * struct that conforms and does not write its own `to_string` gets the
 * default bound per conformer — `#self` becomes the struct's name and the
 * `#for` walk unrolls over its fields, rendering `Name(field=value, ...)`
 * exactly like the old hardcoded derive. A field whose type has no
 * `to_string` is a per-field compile error in the generated body; a
 * hand-written method always wins.
 **/
pub trait Stringable {
	/**
	 * The value as text. The default renders `Name(field=value, ...)`.
	 **/
	func to_string = (self, out string) {
		var s = META.info(#self).name + "("
		var first = true
		#for field of META.info(#self).fields {
			if !first {
				s = s + ", "
			}
			first = false
			s = s + field.name + "=" + field.get(self).to_string()
		}
		return s + ")"
	}
}
