// Random — a small, fast pseudo-random generator (splitmix64).
//
// Splitmix64 steps a 64-bit state by the golden ratio, then runs two
// multiply-xor rounds. Streams from nearby seeds are fully decorrelated
// (each seed is its own stream), so `Random()` — seeded from the wall
// clock — is safe to construct repeatedly in quick succession (e.g. one
// per spawned task, all starting within the same microsecond).
//
// Not cryptographically secure; `below`/`range` have slight modulo bias
// for very large bounds.
//
//	var Random rng = Random()
//	var uint64 roll = rng.below(6)          // 0..5
//	var uint64 ms = rng.range(1000, 10000)  // 1000..10000, inclusive
//

// Random is an OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 3 — the shape
// menu): bindings mv instead of alias. The state is a bare uint64, so the
// value is freely movable (and trivially copyable in principle — `mv`
// is the uniform spelling for the launch/IO primitives; a `ref Random`
// parameter is the read-only borrow that keeps one stream per binding).

/**
 * A fast pseudo-random number generator (splitmix64). `Random()` seeds itself from the
 * clock, so generators created back to back still give independent streams; pass a seed
 * for a reproducible sequence. Not cryptographically secure.
 *
 * ```
 * var rng = Random()
 * const roll = rng.below(6) + 1
 * const delay = rng.range(1000, 10000)
 * ```
 **/
pub mv struct Random {
	/**
	 * The generator's 64-bit state.
	 **/
	// Seeded from the wall clock by the no-arg constructor, or an explicit seed for
	// reproducible sequences.
	pub var uint64 state = 0

	/**
	 * A generator seeded from the clock.
	 **/
	// Wall clock nanoseconds since the epoch.
	pub func #init = (ref self) {
		self.state = Time.now_ns()
	}

	/**
	 * A generator seeded with `seed`: the same seed always gives the same sequence.
	 **/
	pub func #init = (ref self, uint64 seed) {
		self.state = seed
	}

	/**
	 * The next pseudo-random 64-bit value.
	 **/
	// splitmix64: golden-ratio step, then two multiply-xor rounds. Pure Nomen — the
	// 64-bit arithmetic, bitwise operators, and hex literals all lower directly; the
	// aarch64 64-bit arithmetic folds (PERF_PLAN item 15) keep the emission within a
	// few instructions of a hand-written `#arch` body.
	pub func next = (ref self {}, out uint64) {
		self.state = self.state + 0x9E3779B97F4A7C15
		var uint64 z = self.state
		z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
		z = (z ^ (z >> 27)) * 0x94D049BB133111EB
		return z ^ (z >> 31)
	}

	/**
	 * A pseudo-random value in `[0, bound)`. A `bound` of 0 gives 0. Very large bounds have
	 * a slight bias.
	 **/
	pub func below = (ref self {}, uint64 bound, out uint64) {
		if bound == 0 {
			return 0
		}
		return self.next() % bound
	}

	/**
	 * A pseudo-random value in `[lo, hi]`, both ends included. Gives `lo` when `hi <= lo`.
	 **/
	pub func range = (ref self {}, uint64 lo, uint64 hi, out uint64) {
		if hi <= lo {
			return lo
		}
		return lo + self.below(hi - lo + 1)
	}
}
