// Marker trait for containers that can be borrowed as a non-owning `view T`
// slice via a `slice(start, end, out view T)` method. Conforming types
// implement slice — almost always by delegating to an internal Buffer's slice
// (`return self.items.slice(start, end)`), so no #arch code is needed in user
// types. The resulting view supports `.length` and `.at(i)`; the element type
// is the one named in the view (e.g. `view User`).
//
// Generic trait conformance is now parsed and checked by the compiler
// (`trait Foo<T>` + `struct C: Foo<ConcreteType>`), so a type MAY parameterise
// the trait and name its element type: `pub struct UserList: Viewable<User>`.
// `Viewable` itself stays a plain marker today — the core `Array<T>` and
// `List<T>` conformers and the SPEC examples all use the bare `: Viewable`
// form, and migrating them to `: Viewable<Elem>` is a separate library/spec
// change. The slice method is still declared with its concrete element view:
//
//   pub struct UserList: Viewable {
//       var Buffer<User> items = Buffer<User>()
//       pub func slice = (self, int start, int end, out view User) {
//           return self.items.slice(start, end)
//       }
//   }
/**
 * A trait for containers that can be borrowed as a non-owning `view T` slice
 **/
pub trait Viewable {
}
