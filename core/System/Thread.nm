// Thread — a task running on the shared worker pool (CLOSURE.md
// Phase 3b). `Thread(fn(args))` constructs a Thread value: the arguments are
// evaluated eagerly and packed into a task closure (a heap closure
// descriptor over the pooled-args environment — the same ABI every lambda
// lowers to); `.start()` submits that closure to the worker pool and yields
// a `Task<T>` handle; `.detach()` runs it as an unjoinable daemon.
//
// Because the construction is a real value, it can be STORED and started
// later:
//
//     var t = Thread(work(n))
//     ...later...
//     var Task<uint64> handle = t.start()
//
// The pool starts at a configurable size (default 4, via Task.set_pool_size
// before the first spawn) and grows on demand up to 64 workers when every
// worker is busy, preventing deadlocks from nested spawns. The pool drains
// and joins all workers at process exit; Task.shutdown_pool does this
// explicitly.
//
// The pool infrastructure (types, worker loop, submit, shutdown, cancel
// thread-local) lives in build_spawn_node and is emitted as file-scope C
// on the first spawn — not in Thread's own methods — so that Thread can be
// generic without duplicating the pool per instantiation. The construction
// (`Thread(fn(args))`, the deferred-call special form) is compiler-emitted;
// `.start()` / `.detach()` are regular methods over the runtime seam.
//
// MUST-START: a Thread value that is destroyed without ever being started
// is a programming error — #destroy reports it and aborts. start/detach
// (and nursery.start) transfer ownership of the packed task out of the
// value, so a started Thread destroys as a no-op.
//
// See ASYNC.md for the design.

// The launch surface's return type (ASYNC_PLAN phase 6: the dependency is
// declared by the library file, not inferred from user-source tokens).
import Task

/**
 * A deferred function call, startable on the shared worker pool
 **/
pub class Thread<T> : Sendable, Spawnable<T> {
	// The construction hook (ASYNC_PLAN phase 3): declares this class's
	// construction as the deferred-call special form — the single argument
	// is a call (args packed eagerly, call deferred) or a zero-arg function
	// value. The compiler matches this member, never the class name; the
	// construction itself is compiler-generated (pack the args, allocate the
	// future machinery, build the instance), so the body is a declaration.
	#spawn = () {
	}

	// The packed task closure (a `struct nomen_closure *`); owned by this
	// value until start/detach/nursery.start transfers it to the runtime.
	pub var uint64 task = 0
	// Result-slot / cancel-flag / future handles for the (single) launch.
	pub var uint64 result_slot = 0
	pub var uint64 cancel_flag = 0
	pub var uint64 future = 0
	// Must-start flag: set by .start() / .detach() / nursery.start.
	pub var started = false
	// LEXICAL NURSERY CAPTURE (ASYNC_PLAN phase 1): the tracking slots of the
	// `async` block that lexically encloses the CONSTRUCTION, or 0 when the
	// construction is outside any block. `.start()` registers the future
	// through these stored pointers, so registration follows the scope that
	// created the deferred call — not the one that happens to start it — and
	// works through an indirect receiver. The pointers address the block's
	// own futures list slots (the block cannot exit until every registered
	// task has finished, so a started-before-exit task never registers into
	// dead storage).
	pub var uint64 nursery_futures = 0
	pub var uint64 nursery_count = 0
	pub var uint64 nursery_cap = 0

	// Start the deferred call on the shared worker pool and yield the
	// Task<T> handle. Consumes the instance's launch machinery (submit, then
	// register with the construction-time nursery, if any) and zeroes the
	// fields, so #destroy becomes a no-op afterwards. The future's refs
	// account for the trampoline, the returned handle, and the nursery (when
	// captured).
	pub func start = (ref self, move out Task<T>) {
		```
		#arch: c
		struct nomen_future *_f = (struct nomen_future *)self->future;
		_f->refs = self->nursery_futures ? 3 : 2;
		__nomen_pool_submit((struct nomen_closure *)self->task);
		if (self->nursery_futures) {
			__nomen_nursery_track((void **)self->nursery_futures, (int *)self->nursery_count, (int *)self->nursery_cap, _f);
		}
		```
		```
		#arch: aarch64
		// x19 = self. f = self->future (#32); nursery_futures at #48.
		ldr x0, [x19, #32]
		ldr x1, [x19, #48]
		mov w2, #2
		cbz x1, .Lnomen_start_refs
		mov w2, #3
		.Lnomen_start_refs:
		str w2, [x0, #116]
		// __nomen_pool_submit(self->task)
		ldr x0, [x19, #8]
		bl ___nomen_pool_submit
		// if (self->nursery_futures) __nomen_nursery_track(futures, count, cap, f)
		ldr x0, [x19, #48]
		cbz x0, .Lnomen_start_notrack
		ldr x1, [x19, #56]
		ldr x2, [x19, #64]
		ldr x3, [x19, #32]
		bl ___nomen_nursery_track
		.Lnomen_start_notrack:
		```
		// The handle is a fresh heap Task built through the internal #init;
		// the caller owns it (a discarded statement form is reclaimed at
		// scope exit, releasing its refs share).
		var t = Task<T>()
		t.result_slot = self.result_slot
		t.cancel_flag = self.cancel_flag
		t.future = self.future
		// Transfer the handles out of the instance: the runtime owns
		// everything now, and #destroy must not touch (or must-start-abort).
		self.task = 0
		self.future = 0
		self.result_slot = 0
		self.cancel_flag = 0
		self.started = true
		return t
	}

	// Run the deferred call on a dedicated detached pthread — the daemon
	// form. Never a pool worker, never joined; process exit kills it
	// mid-execution BY DESIGN. The unused future (a Thread always carries
	// the full machinery) is released — first detaching the closure from it,
	// so the daemon runner owns the closure now.
	pub func detach = (ref self) {
		```
		#arch: c
		struct nomen_future *_uf = (struct nomen_future *)self->future;
		if (_uf) {
			_uf->owner_args = NULL;
			__nomen_future_release(_uf);
		}
		__nomen_task_detach((struct nomen_closure *)self->task);
		```
		```
		#arch: aarch64
		// if (self->future) { owner_args = NULL; release it }
		ldr x0, [x19, #32]
		cbz x0, .Lnomen_detach_nofut
		str xzr, [x0, #136]
		bl ___nomen_future_release
		.Lnomen_detach_nofut:
		// __nomen_task_detach(self->task)
		ldr x0, [x19, #8]
		bl ___nomen_task_detach
		```
		self.task = 0
		self.future = 0
		self.result_slot = 0
		self.cancel_flag = 0
		self.started = true
	}

	// Destroying an unstarted Thread is a programming error (the wrapped
	// call would silently never run) — report it and abort. A started
	// Thread owns nothing: the launch transferred the task closure, result
	// slot, cancel flag, and future to the runtime, and cleared the fields.
	pub func #destroy = () {
		```
		#arch: c
		if (!self->started) {
			__nomen_spawn_must_start_abort();
		}
		if (self->future) {
			__nomen_future_release((struct nomen_future *)self->future);
			self->future = 0;
			self->result_slot = 0;
			self->cancel_flag = 0;
		}
		```
		```
		#arch: aarch64
		// if (!self->started) __nomen_spawn_must_start_abort()
		ldrb w0, [x19, #40]
		cbnz w0, .Lthr_started
		bl ___nomen_spawn_must_start_abort
		.Lthr_started:
		// if (self->future) { release it (an unstarted task's future is
		// unshared — refs == 1 — so this tears down slot + flag + future);
		// zero the fields }
		ldr x0, [x19, #32]
		cbz x0, .Lthr_done
		bl ___nomen_future_release
		str xzr, [x19, #32]
		str xzr, [x19, #16]
		str xzr, [x19, #24]
		.Lthr_done:
		```
	}
}
