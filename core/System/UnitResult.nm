/**
 * The outcome of a fallible operation that returns nothing on success: `.ok` or `.fail(err)`.
 * It is what a function declared `out ! E` returns (also `out ! E1, E2` or
 * `out ! [.notfound]`), and is handled like `Result`: `match`, or postfix `!` to propagate.
 * A bare `return` or falling off the end is success.
 **/
// UnitResult is the type behind the `out ! E` form (ERRORS_PLAN). It behaves
// exactly like `Result` with a payload-less success case — bare returns and
// fall-through are success, `return .case` / an error value is a failure — so
// matching, checked-discard, the `error` gate, and postfix `!` all reuse the
// Result machinery.
pub checked enum UnitResult<E> {
	case ok
	case fail(E err)
}
