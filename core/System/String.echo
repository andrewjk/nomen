
pub struct string: Stringable {
    pub func to_string = (self, out string) {
        ```
        #arch: c
        return self;
        ```
        ```
        #arch: aarch64
        mov x0, x19
        ```
    }

    pub func length = (self, out int) {
        ```
        #arch: c
        return strlen(self);
        ```
        ```
        #arch: aarch64
        mov x0, x19
        bl _strlen
        b .return_string_length
        ```
        return 0
    }
}
