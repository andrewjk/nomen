/**
 * A context menu shown when the user right-clicks a control
 *
 * Add items with `add_item`, `attach` the menu to a control, then respond to choices with
 * `on_item_select` (reading which with `selected_item`) or poll `clicked_item` each frame.
 * macOS only.
 **/
// Right-clicking an attached control shows the menu natively — AppKit runs its
// own modal tracking loop, so the manual event loop is untouched. Each item
// carries a tag (its index) and a shared target whose action records the tag in
// a C global; `clicked_item` polls it (edge-triggered: the read resets it to
// -1, "none"), and `on_item_select` is the registered form — the drain consumes
// the selection, the handler reads it through `selected_item`. iOS presentation
// differs (UIContextMenu- Interaction needs a scene-attached view — see
// GUI_PLAN Tier 2; the iOS blocks are TODO stubs).
pub mv struct Menu: Control {
	/**
	 * The native platform handle for this control (internal; 0 until it is created).
	 **/
	var uint64 handle = 0

	/**
	 * An empty context menu. Add items, then `attach` it to a control.
	 **/
	// File-scope helper: the shared item target. The action records the
	// clicked item's tag (shared — one Menu per process, like List's row
	// storage).
	pub func #init = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw("file") {
				static long g_menu_last_tag = -1;
				static id g_menu_target = 0;

				static void nomen_menu_item_action(id self, SEL cmd, id sender) {
					(void)self; (void)cmd;
					g_menu_last_tag = ((long(*)(id, SEL))objc_msgSend)(sender, sel_registerName("tag"));
				}

				static id nomen_menu_target(void) {
					Class Mt = objc_getClass("NomenMenuTarget");
					if (!Mt) {
						Mt = objc_allocateClassPair(objc_getClass("NSObject"), "NomenMenuTarget", 0);
						if (Mt) {
							class_addMethod(Mt, sel_registerName("nomenMenuItemAction:"),
								(IMP)nomen_menu_item_action, "v@:@");
							objc_registerClassPair(Mt);
						}
					}
					if (!g_menu_target) {
						g_menu_target = ((id(*)(id, SEL))objc_msgSend)(Mt, sel_registerName("new"));
					}
					return g_menu_target;
				}

				// Edge-triggered read: the poll consumes the tag (resets to -1).
				long nomen_menu_last_tag(void) {
					long tag = g_menu_last_tag;
					g_menu_last_tag = -1;
					return tag;
				}

				// The on_item_select drain's consume-and-stash: the drain consumes
				// the selected tag exactly like the poll, and STASHES it for the
				// handler body to read through Menu.selected_item (the drain runs
				// first in its pump arm, so the stash is fresh when the handler
				// body runs).
				long g_menu_selected_tag = -1;
				unsigned char nomen_menu_take_select(void) {
					long tag = nomen_menu_last_tag();
					if (tag < 0) return 0;
					g_menu_selected_tag = tag;
					return 1;
				}
				long nomen_menu_selected_tag(void) {
					return g_menu_selected_tag;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c", "file") {
				static long g_menu_last_tag = -1;
				static id g_menu_target = 0;

				static void nomen_menu_item_action(id self, SEL cmd, id sender) {
					(void)self; (void)cmd;
					g_menu_last_tag = ((long(*)(id, SEL))objc_msgSend)(sender, sel_registerName("tag"));
				}

				static id nomen_menu_target(void) {
					Class Mt = objc_getClass("NomenMenuTarget");
					if (!Mt) {
						Mt = objc_allocateClassPair(objc_getClass("NSObject"), "NomenMenuTarget", 0);
						if (Mt) {
							class_addMethod(Mt, sel_registerName("nomenMenuItemAction:"),
								(IMP)nomen_menu_item_action, "v@:@");
							objc_registerClassPair(Mt);
						}
					}
					if (!g_menu_target) {
						g_menu_target = ((id(*)(id, SEL))objc_msgSend)(Mt, sel_registerName("new"));
					}
					return g_menu_target;
				}

				// Edge-triggered read: the poll consumes the tag (resets to -1).
				long nomen_menu_last_tag(void) {
					long tag = g_menu_last_tag;
					g_menu_last_tag = -1;
					return tag;
				}

				// The on_item_select drain's consume-and-stash (see the c twin
				// above).
				long g_menu_selected_tag = -1;
				unsigned char nomen_menu_take_select(void) {
					long tag = nomen_menu_last_tag();
					if (tag < 0) return 0;
					g_menu_selected_tag = tag;
					return 1;
				}
				long nomen_menu_selected_tag(void) {
					return g_menu_selected_tag;
				}
			}
		}
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id menu = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSMenu"), sel_registerName("alloc")),
					sel_registerName("init"));
				self.handle = (uint64_t)menu;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id menu = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSMenu"), sel_registerName("alloc")),
					sel_registerName("init"));
				self->handle = (uint64_t)menu;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS — UIContextMenuInteraction needs a scene-attached view
				 * (see GUI_PLAN Tier 2; defer). */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * Add a clickable item. Its number (reported by `clicked_item` and `selected_item`) is
	 * its position in the menu, counting separators.
	 **/
	pub func add_item = (self, string title) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id menu = (id)self->handle;
				long tag = ((long(*)(id, SEL))objc_msgSend)(menu, sel_registerName("numberOfItems"));
				id item = ((id(*)(id, SEL, id, SEL, id))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSMenuItem"), sel_registerName("alloc")),
					sel_registerName("initWithTitle:action:keyEquivalent:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
					sel_registerName("nomenMenuItemAction:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
				((void(*)(id, SEL, long))objc_msgSend)(item, sel_registerName("setTag:"), tag);
				((void(*)(id, SEL, id))objc_msgSend)(item, sel_registerName("setTarget:"), nomen_menu_target());
				((void(*)(id, SEL, id))objc_msgSend)(menu, sel_registerName("addItem:"), item);
				((void(*)(id, SEL))objc_msgSend)(item, sel_registerName("release"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id menu = (id)self->handle;
				long tag = ((long(*)(id, SEL))objc_msgSend)(menu, sel_registerName("numberOfItems"));
				id item = ((id(*)(id, SEL, id, SEL, id))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSMenuItem"), sel_registerName("alloc")),
					sel_registerName("initWithTitle:action:keyEquivalent:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
					sel_registerName("nomenMenuItemAction:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
				((void(*)(id, SEL, long))objc_msgSend)(item, sel_registerName("setTag:"), tag);
				((void(*)(id, SEL, id))objc_msgSend)(item, sel_registerName("setTarget:"), nomen_menu_target());
				((void(*)(id, SEL, id))objc_msgSend)(menu, sel_registerName("addItem:"), item);
				((void(*)(id, SEL))objc_msgSend)(item, sel_registerName("release"));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * Add a separator line. It takes up a position too.
	 **/
	pub func add_separator = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id sep = ((id(*)(id, SEL))objc_msgSend)(
					(id)objc_getClass("NSMenuItem"), sel_registerName("separatorItem"));
				((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("addItem:"), sep);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id sep = ((id(*)(id, SEL))objc_msgSend)(
					(id)objc_getClass("NSMenuItem"), sel_registerName("separatorItem"));
				((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("addItem:"), sep);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * Show this menu when the control with native handle `handle` is right-clicked.
	 **/
	pub func attach = (self, uint64 handle) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, id))objc_msgSend)((id)handle, sel_registerName("setMenu:"), (id)self->handle);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, id))objc_msgSend)((id)handle, sel_registerName("setMenu:"), (id)self->handle);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * The number of entries, separators included.
	 **/
	pub func item_count = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("numberOfItems"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("numberOfItems"));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				return 0;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				return 0;
			}
		}
	}

	/**
	 * The number of the item clicked since the last call, or -1 if none was. Each click is
	 * reported once.
	 **/
	pub func clicked_item = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				extern long nomen_menu_last_tag(void);
				long tag = nomen_menu_last_tag();
				return (int)tag;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				extern long nomen_menu_last_tag(void);
				long tag = nomen_menu_last_tag();
				return (int)tag;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				return -1;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				return -1;
			}
		}
	}

	/**
	 * Handler hook behind `on_item_select`: whether an item was chosen since the last poll.
	 * Read which with `selected_item()`. Use either the handler or `clicked_item`, not
	 * both.
	 **/
	// The on_item_select desugar's drain (docs/HANDLERS.md): the synthesized
	// pump arm polls this per frame. The selection is CONSUMED by the drain
	// — like the poll, one record has one consumer, so a selection fires an
	// arm exactly once — and the consumed tag is stashed for the handler
	// body, which reads it through selected_item. The poll and the drain
	// share one record: a selection consumed by one never reaches the other.
	pub func take_item_select = (self, out bool) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				extern unsigned char nomen_menu_take_select(void);
				return nomen_menu_take_select();
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				extern unsigned char nomen_menu_take_select(void);
				return nomen_menu_take_select();
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				return false;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				return false;
			}
		}
	}

	/**
	 * The item the `on_item_select` handler is reporting (-1 before the first choice).
	 **/
	// The tag the last take_item_select consumed (-1 before the first
	// selection) — the handler body's payload getter. The control-scoped
	// analog of the dispatch-window getters (win.click_x() et al): the
	// record is the menu's own, so the payload rides the menu, not the
	// window.
	pub func selected_item = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				extern long nomen_menu_selected_tag(void);
				return (int)nomen_menu_selected_tag();
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				extern long nomen_menu_selected_tag(void);
				return (int)nomen_menu_selected_tag();
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				return -1;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				return -1;
			}
		}
	}

	/**
	 * Place the control at (`x`, `y`) with the given size, in points. Layout containers
	 * call this for you (`Control` conformance).
	 **/
	// ── Control trait conformance ──
	// A menu is not laid out: it has no frame of its own (it presents at the
	// cursor under the attached control's right-click).
	pub func set_frame = (ref self {}, int x, int y, int width, int height) {
		// No-op: the menu presents at the cursor.
	}

	/**
	 * The control's natural size given unlimited space (`Control` conformance).
	 **/
	pub func intrinsic_size = (self, out Size) {
		var s = Size()
		return s
	}

	/**
	 * The size the control wants, within `constraints` (`Control` conformance).
	 **/
	pub func measure = (self, BoxConstraints constraints, out Size) {
		var s = Size()
		return s
	}

	func #destroy = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}
}
