/**
 * A number field with stepper nudges — TextBox + Stepper composed
 *
 * PURE COMPOSITION (GUI_PLAN Tier 3 "reachable earlier"): no new native
 * control, no drawing — a TextBox for the text and a Stepper for the
 * nudges, wired side by side into the caller's grid (the box fills the
 * row, the stepper takes its intrinsic width).
 *
 * `set_value` drives both controls: the stepper holds the value, the text
 * mirrors it (whole values as ints, fractions via the float's %f
 * rendering). Stepper clicks update the stepper — but free-typed text is
 * NOT parsed back in v1 (no string→float round-trip yet), so editing the
 * text only changes the display until the next nudge. Hit-test the box and
 * stepper through their handles (fields read like every control's
 * `handle`).
 **/
pub mv struct NumberInput {
	var TextBox box
	var Stepper step

	pub func #init = (self, Window window) {
		self.box = TextBox(window)
		self.step = Stepper(window)
	}

	// The stepper's range and nudge size.
	pub func set_range = (ref self, float min, float max, float increment) {
		self.step.set_min(min)
		self.step.set_max(max)
		self.step.set_increment(increment)
	}

	// Drive BOTH controls: the stepper holds the value, the text mirrors it
	// (the float's %f rendering).
	pub func set_value = (ref self, float v) {
		self.step.set_value(v)
		var text = v.to_string()
		self.box.set_text(text)
	}

	// The current value (the stepper's — typed text is not parsed back in
	// v1; the next nudge overwrites the text).
	pub func value = (self, out float) {
		return self.step.value()
	}

	// Wire the pair into the caller's grid under `parent`: an hstack with
	// the box filling the row and the stepper at its intrinsic width.
	// Hit-testing works through the usual grid.contains on the fields'
	// handles.
	pub func add_to = (ref self, ref Container grid, int parent, int span) {
		var int hs = grid.add_hstack(parent, 6, span)
		grid.add_to(hs, self.box.handle, 0, 24, 1, 1)
		grid.add_to_intrinsic(hs, self.step.handle, 1)
	}
}
