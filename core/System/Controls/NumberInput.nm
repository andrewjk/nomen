/**
 * A number field with up/down arrows beside it
 *
 * Set the range with `set_range`, add it to your grid with `add_to`, and read it with
 * `value`. Typed text isn't read back yet; only the arrows and `set_value` change the
 * value.
 **/
// PURE COMPOSITION (GUI_PLAN Tier 3 "reachable earlier"): no new native
// control, no drawing — a TextBox for the text and a Stepper for the nudges,
// wired side by side into the caller's grid (the box fills the row, the stepper
// takes its intrinsic width).
//
// `set_value` drives both controls: the stepper holds the value, the text
// mirrors it (whole values as ints, fractions via the float's %f rendering).
// Stepper clicks update the stepper — but free-typed text is NOT parsed back in
// v1 (no string→float round-trip yet), so editing the text only changes the
// display until the next nudge. Hit-test the box and stepper through their
// handles (fields read like every control's `handle`).
pub mv struct NumberInput {
	/**
	 * The text field half.
	 **/
	mv TextBox box
	/**
	 * The stepper half.
	 **/
	mv Stepper step

	/**
	 * A number field with a stepper beside it, in `window`.
	 **/
	pub func #init = (ref self, Window window) {
		self.box = TextBox(window)
		self.step = Stepper(window)
	}

	/**
	 * Set the lowest and highest values and how much each stepper click changes the value.
	 **/
	pub func set_range = (ref self {}, float min, float max, float increment) {
		self.step.set_min(min)
		self.step.set_max(max)
		self.step.set_increment(increment)
	}

	/**
	 * Set the value, updating both the stepper and the text.
	 **/
	// Drive BOTH controls: the stepper holds the value, the text mirrors it
	// (the float's %f rendering).
	pub func set_value = (ref self {}, float v) {
		self.step.set_value(v)
		var text = v.to_string()
		self.box.set_text(text)
	}

	/**
	 * The current value. Text typed into the field isn't read back yet; the next stepper
	 * click overwrites it.
	 **/
	pub func value = (self, out float) {
		return self.step.value()
	}

	/**
	 * Add the field and stepper to `grid` under `parent`, as a row with the field filling
	 * the width and the stepper at its natural size.
	 **/
	// Wire the pair into the caller's grid under `parent`: an hstack with
	// the box filling the row and the stepper at its intrinsic width.
	// Hit-testing works through the usual grid.contains on the fields'
	// handles.
	pub func add_to = (ref self {}, ref Container grid { aligns, cols, dirty, dirty_idx, gaps, grows, h_kinds, h_vals, handles, kinds, measured_count, mh, mw, pads, pars, prh, prw, prx, pry, rh, rw, rx, ry, shrinks, spans, w_kinds, w_vals }, int parent, int span) {
		var int hs = grid.add_hstack(parent, 6, span)
		grid.add_to(hs, self.box.handle, 0, 24, 1, 1)
		grid.add_to_intrinsic(hs, self.step.handle, 1)
	}
}
