/**
 * An editable text field with a dropdown of completions (NSComboBox)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * Items live in the combo box's own internal list (no data source); the
 * text is polled per frame like every other control (stringValue), and
 * `selected_index` reports -1 once the user edits the text freely.
 * macOS-only (NSComboBox has no iOS counterpart — see GUI_PLAN Tier 2; the
 * iOS blocks are TODO stubs).
 **/
pub mv struct ComboBox : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id cb = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSComboBox"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 26));
		((void(*)(id, SEL, BOOL))objc_msgSend)(cb, sel_registerName("setCompletes:"), 1);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), cb);
		// NSComboBox sends its action on USER selection (list pick or
		// Return) — arm it so on_select drains fire.
		extern void nomen_control_arm_selects(unsigned long long);
		nomen_control_arm_selects((unsigned long long)cb);
		self.handle = (uint64_t)cb;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id cb = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSComboBox"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 26));
		((void(*)(id, SEL, BOOL))objc_msgSend)(cb, sel_registerName("setCompletes:"), 1);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), cb);
		extern void nomen_control_arm_selects(unsigned long long) __asm__("nomen_control_arm_selects");
		nomen_control_arm_selects((unsigned long long)cb);
		self->handle = (uint64_t)cb;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS — no NSComboBox counterpart (compose a UITextField +
		 * picker; see GUI_PLAN Tier 2; defer). */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

