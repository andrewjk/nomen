	// The on_select desugar's drain (docs/HANDLERS.md): true when the user
	// selected a list entry (or pressed Return) since the last drain — the
	// record is consumed. User-driven only: AppKit sends the combo's action
	// for user selections, not programmatic ones. The handler body reads
	// the item through selected_index().
	pub func take_select = (self, out bool) {
		```
		#arch: c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
	}

