	/**
	 * The index of the selected list item, or -1 when none is (typing in the field clears
	 * the selection; `set_text` does not).
	 **/
	pub func selected_index = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("indexOfSelectedItem"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				return (int)((long(*)(id, SEL))objc_msgSend)(
