	// A fresh copy of item `index`'s text (mv — the caller owns it).
	pub func item = (self, int index, out string) {
		```
		#arch: c
		#platform: macos
		id value = ((id(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("itemObjectValueAtIndex:"), (long)index);
		if (!value) return (nomen_string){ strdup(""), 0 };
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(value, sel_registerName("UTF8String"));
		if (!cstr) return (nomen_string){ strdup(""), 0 };
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id value = ((id(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("itemObjectValueAtIndex:"), (long)index);
		if (!value) return (nomen_string){ strdup(""), 0 };
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(value, sel_registerName("UTF8String"));
		if (!cstr) return (nomen_string){ strdup(""), 0 };
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
	}

