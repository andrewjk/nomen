	// The selected item's index, polled; -1 = no selection. (User free-typing
	// clears it; a programmatic set_text does not.)
	pub func selected_index = (self, out int) {
		```
		#arch: c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("indexOfSelectedItem"));
		```
