			(id)self->handle, sel_registerName("stringValue"));
		if (!str) return (nomen_string){ strdup(""), 0 };
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(str, sel_registerName("UTF8String"));
		if (!cstr) return (nomen_string){ strdup(""), 0 };
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
