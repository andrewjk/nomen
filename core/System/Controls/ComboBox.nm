/**
 * A text field with a drop-down list of suggestions
 *
 * Fill the list with `add_item`. The user can pick an item or type anything; read the text
 * with `get_text`, and the picked item with `selected_index` (-1 after free typing).
 * Respond to picks with `on_select`. macOS only.
 **/
// Items live in the combo box's own internal list (no data source); the text is
// polled per frame like every other control (stringValue), and `selected_index`
// reports -1 once the user edits the text freely. macOS-only (NSComboBox has no
// iOS counterpart — see GUI_PLAN Tier 2; the iOS blocks are TODO stubs).
pub mv struct ComboBox: Control {
	/**
	 * The control's native handle: pass it to `Container` methods such as `add` to lay the
	 * control out, and to `contains` to hit-test it (0 until the control is created).
	 **/
	var uint64 handle = 0

	/**
	 * An empty combo box in `window`: a text field with a drop-down list of suggestions.
	 **/
	pub func #init = (self, Window window) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id cb = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSComboBox"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 26));
				((void(*)(id, SEL, BOOL))objc_msgSend)(cb, sel_registerName("setCompletes:"), 1);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), cb);
				// NSComboBox sends its action on USER selection (list pick or
				// Return) — arm it so on_select drains fire.
				extern void nomen_control_arm_selects(unsigned long long);
				nomen_control_arm_selects((unsigned long long)cb);
				self.handle = (uint64_t)cb;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id cb = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSComboBox"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 26));
				((void(*)(id, SEL, BOOL))objc_msgSend)(cb, sel_registerName("setCompletes:"), 1);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), cb);
				extern void nomen_control_arm_selects(unsigned long long) __asm__("nomen_control_arm_selects");
				nomen_control_arm_selects((unsigned long long)cb);
				self->handle = (uint64_t)cb;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS — no NSComboBox counterpart (compose a UITextField +
				 * picker; see GUI_PLAN Tier 2; defer). */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * Place the control at (`x`, `y`) with the given size, in points. Layout containers
	 * call this for you (`Control` conformance).
	 **/
	pub func set_frame = (ref self {}, int x, int y, int width, int height) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
