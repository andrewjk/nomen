		((void(*)(id, SEL, id))objc_msgSend)(
			item, sel_registerName("setLabel:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id item = ((id(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
		((void(*)(id, SEL, id))objc_msgSend)(
			item, sel_registerName("setLabel:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

