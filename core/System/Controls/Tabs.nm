	// The on_select desugar's drain (docs/HANDLERS.md): true when the
	// selected tab changed since the last drain — user clicks AND
	// programmatic set_selected (the delegate observes both; a
	// pre-selection in #init therefore fires on the first frame). The
	// handler body reads the page through selected_index().
	pub func take_select = (self, out bool) {
		```
		#arch: c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
