	pub func selected_index = (self, out int) {
		```
		#arch: c
		#platform: macos
		id item = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("selectedTabViewItem"));
		if (!item) return 0;
		return (int)((long(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("indexOfTabViewItem:"), item);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id item = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("selectedTabViewItem"));
		if (!item) return 0;
		return (int)((long(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("indexOfTabViewItem:"), item);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
