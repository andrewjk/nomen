/**
 * Pages of controls with a tab bar to switch between them
 *
 * The number of pages is set when it is created. Label tabs with `set_label`, and put
 * controls on a page with `content_window(index)` as their window and a grid of the page's
 * own. Switching pages is handled for you. macOS only.
 **/
// The page count is fixed at construction. Each page hosts controls on its own
// view: `content_window(index)` hands back a Window-shaped value whose
// `contentView` is the page view itself (NomenTabPageView answers
// `-contentView` with `self` — the Scrollable trick), so control constructors
// and `Container.layout` target a page unchanged. NSTabView sizes page views to
// its content area, so the engine's y-flip against `content_height()` (the page
// height) is the existing math. Page switching is native; laid-out frames stay
// valid across switches. iOS has no NSTabView counterpart (UITabBarController
// is app-level chrome — see GUI_PLAN Tier 2; defer with TODO stubs).
pub mv struct Tabs: Control {
	/**
	 * The native platform handle for this control (internal; 0 until it is created).
	 **/
	var uint64 handle = 0

	/**
	 * A tab view in `window` with `count` pages. Label them with `set_label`.
	 **/
	// File-scope helper: the page view class. It answers `-contentView` with
	// `self` so Window-expecting constructors add their controls to the page
	// view (registered once, like NomenResizeDelegate).
	pub func #init = (self, Window window, int count) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw("file") {
				static id nomen_tab_content_view(id self, SEL cmd) {
					(void)cmd;
					return self;
				}
				static id nomen_tab_page_class(void) {
					Class Pv = objc_getClass("NomenTabPageView");
					if (!Pv) {
						Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenTabPageView", 0);
						if (Pv) {
							class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_tab_content_view, "@@:");
							objc_registerClassPair(Pv);
						}
					}
					return Pv;
				}

				// The shared tab-view delegate: reports every tab switch — user
				// clicks AND programmatic selectTabViewItem — by pushing the tab
				// view's handle into the shared selection record (the on_select
				// feed; the ring lives in Control.nm next to the click ring).
				static void nomen_tab_did_select(id self, SEL cmd, id tv, id item) {
					(void)self; (void)cmd; (void)item;
					extern void nomen_select_push(unsigned long long);
					nomen_select_push((unsigned long long)(void *)tv);
				}
				static id g_tab_delegate = 0;
				static id nomen_tab_delegate(void) {
					Class Td = objc_getClass("NomenTabsDelegate");
					if (!Td) {
						Td = objc_allocateClassPair(objc_getClass("NSObject"), "NomenTabsDelegate", 0);
						if (Td) {
							class_addMethod(Td, sel_registerName("tabView:didSelectTabViewItem:"),
								(IMP)nomen_tab_did_select, "v@:@@");
							objc_registerClassPair(Td);
						}
					}
					if (!g_tab_delegate) {
						g_tab_delegate = ((id(*)(id, SEL))objc_msgSend)(Td, sel_registerName("new"));
					}
					return g_tab_delegate;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c", "file") {
				static id nomen_tab_content_view(id self, SEL cmd) {
					(void)cmd;
					return self;
				}
				static id nomen_tab_page_class(void) {
					Class Pv = objc_getClass("NomenTabPageView");
					if (!Pv) {
						Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenTabPageView", 0);
						if (Pv) {
							class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_tab_content_view, "@@:");
							objc_registerClassPair(Pv);
						}
					}
					return Pv;
				}

				// The shared tab-view delegate (see the c twin above).
				static void nomen_tab_did_select(id self, SEL cmd, id tv, id item) {
					(void)self; (void)cmd; (void)item;
					extern void nomen_select_push(unsigned long long);
					nomen_select_push((unsigned long long)(void *)tv);
				}
				static id g_tab_delegate = 0;
				static id nomen_tab_delegate(void) {
					Class Td = objc_getClass("NomenTabsDelegate");
					if (!Td) {
						Td = objc_allocateClassPair(objc_getClass("NSObject"), "NomenTabsDelegate", 0);
						if (Td) {
							class_addMethod(Td, sel_registerName("tabView:didSelectTabViewItem:"),
								(IMP)nomen_tab_did_select, "v@:@@");
							objc_registerClassPair(Td);
						}
					}
					if (!g_tab_delegate) {
						g_tab_delegate = ((id(*)(id, SEL))objc_msgSend)(Td, sel_registerName("new"));
					}
					return g_tab_delegate;
				}
			}
		}
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabView"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 200));
				for (long i = 0; i < (long)count; i++) {
					id item = ((id(*)(id, SEL, id))objc_msgSend)(
						((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabViewItem"), sel_registerName("alloc")),
						sel_registerName("initWithIdentifier:"), (id)0);
					id page = ((id(*)(id, SEL, CGRect))objc_msgSend)(
						((id(*)(id, SEL))objc_msgSend)(nomen_tab_page_class(), sel_registerName("alloc")),
						sel_registerName("initWithFrame:"),
						((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 0, 0));
					((void(*)(id, SEL, id))objc_msgSend)(
						item, sel_registerName("setLabel:"),
						((id(*)(id, SEL, const char*))objc_msgSend)(
							(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
					((void(*)(id, SEL, id))objc_msgSend)(item, sel_registerName("setView:"), page);
					((void(*)(id, SEL))objc_msgSend)(page, sel_registerName("release"));
					((void(*)(id, SEL, id))objc_msgSend)(tv, sel_registerName("addTabViewItem:"), item);
					((void(*)(id, SEL))objc_msgSend)(item, sel_registerName("release"));
				}
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), tv);
				((void(*)(id, SEL, id))objc_msgSend)(
					tv, sel_registerName("setDelegate:"), nomen_tab_delegate());
				self.handle = (uint64_t)tv;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabView"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 200));
				for (long i = 0; i < (long)count; i++) {
					id item = ((id(*)(id, SEL, id))objc_msgSend)(
						((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabViewItem"), sel_registerName("alloc")),
						sel_registerName("initWithIdentifier:"), (id)0);
					id page = ((id(*)(id, SEL, CGRect))objc_msgSend)(
						((id(*)(id, SEL))objc_msgSend)(nomen_tab_page_class(), sel_registerName("alloc")),
						sel_registerName("initWithFrame:"),
						((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 0, 0));
					((void(*)(id, SEL, id))objc_msgSend)(
						item, sel_registerName("setLabel:"),
						((id(*)(id, SEL, const char*))objc_msgSend)(
							(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
					((void(*)(id, SEL, id))objc_msgSend)(item, sel_registerName("setView:"), page);
					((void(*)(id, SEL))objc_msgSend)(page, sel_registerName("release"));
					((void(*)(id, SEL, id))objc_msgSend)(tv, sel_registerName("addTabViewItem:"), item);
					((void(*)(id, SEL))objc_msgSend)(item, sel_registerName("release"));
				}
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), tv);
				((void(*)(id, SEL, id))objc_msgSend)(
					tv, sel_registerName("setDelegate:"), nomen_tab_delegate());
				self->handle = (uint64_t)tv;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS — no NSTabView counterpart (UITabBarController is
				 * app-level chrome, not an embeddable control; see GUI_PLAN Tier 2;
				 * defer). */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * A `Window` handle for page `index`: pass it to control constructors and
	 * `Container.layout` to put controls on that page. Keep the tab view alive at least as
	 * long as the handle.
	 **/
	// The value retains the page view (+1), so its scope-exit `#destroy` releases its
	// OWN reference and the Tabs' stays balanced.
	pub func content_window = (self, int index, out Window) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id item = ((id(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
				id page = ((id(*)(id, SEL))objc_msgSend)(item, sel_registerName("view"));
				extern void *_Window_traits[];
				struct Window w;
				w._vt = (void *)&_Window_traits;
				w.handle = (uint64_t)page;
				((id(*)(id, SEL))objc_msgSend)(page, sel_registerName("retain"));
				return w;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id item = ((id(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
				id page = ((id(*)(id, SEL))objc_msgSend)(item, sel_registerName("view"));
				extern void *Window_traits;
				struct Window w;
				w._vt = (void *)&Window_traits;
				w.handle = (uint64_t)page;
				((id(*)(id, SEL))objc_msgSend)(page, sel_registerName("retain"));
				return w;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				{
					extern void *_Window_traits[];
					struct Window w;
					w._vt = (void *)&_Window_traits;
					w.handle = 0;
					return w;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				{
					extern void *Window_traits;
					struct Window w;
					w._vt = (void *)&Window_traits;
					w.handle = 0;
					return w;
				}
			}
		}
	}

	/**
	 * Set the label of tab `index`.
	 **/
	pub func set_label = (self, int index, string title) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id item = ((id(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
				((void(*)(id, SEL, id))objc_msgSend)(
					item, sel_registerName("setLabel:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id item = ((id(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
				((void(*)(id, SEL, id))objc_msgSend)(
					item, sel_registerName("setLabel:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * Show page `index`.
	 **/
	pub func set_selected = (self, int index) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("selectTabViewItemAtIndex:"), (long)index);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("selectTabViewItemAtIndex:"), (long)index);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * The index of the page showing.
	 **/
	pub func selected_index = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id item = ((id(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("selectedTabViewItem"));
				if (!item) return 0;
				return (int)((long(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("indexOfTabViewItem:"), item);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id item = ((id(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("selectedTabViewItem"));
