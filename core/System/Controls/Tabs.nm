/**
 * A container of pages with a clickable tab bar (NSTabView)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * The page count is fixed at construction. Each page hosts controls on its
 * own view: `content_window(index)` hands back a Window-shaped value whose
 * `contentView` is the page view itself (NomenTabPageView answers
 * `-contentView` with `self` — the Scrollable trick), so control
 * constructors and `Container.layout` target a page unchanged. NSTabView
 * sizes page views to its content area, so the engine's y-flip against
 * `content_height()` (the page height) is the existing math. Page switching
 * is native; laid-out frames stay valid across switches. iOS has no
 * NSTabView counterpart (UITabBarController is app-level chrome — see
 * GUI_PLAN Tier 2; defer with TODO stubs).
 **/
pub mv struct Tabs : Control {
	var uint64 handle = 0

	// File-scope helper: the page view class. It answers `-contentView` with
	// `self` so Window-expecting constructors add their controls to the page
	// view (registered once, like NomenResizeDelegate).
	pub func #init = (self, Window window, int count) {
		```
		#arch: c
		#platform: macos
		#scope: file
		static id nomen_tab_content_view(id self, SEL cmd) {
			(void)cmd;
			return self;
		}
		static id nomen_tab_page_class(void) {
			Class Pv = objc_getClass("NomenTabPageView");
			if (!Pv) {
				Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenTabPageView", 0);
				if (Pv) {
					class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_tab_content_view, "@@:");
					objc_registerClassPair(Pv);
				}
			}
			return Pv;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		#scope: file
		static id nomen_tab_content_view(id self, SEL cmd) {
			(void)cmd;
			return self;
		}
		static id nomen_tab_page_class(void) {
			Class Pv = objc_getClass("NomenTabPageView");
			if (!Pv) {
				Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenTabPageView", 0);
				if (Pv) {
					class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_tab_content_view, "@@:");
					objc_registerClassPair(Pv);
				}
			}
			return Pv;
		}
		```
		```
		#arch: c
		#platform: macos
		id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 200));
		for (long i = 0; i < (long)count; i++) {
			id item = ((id(*)(id, SEL, id))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabViewItem"), sel_registerName("alloc")),
				sel_registerName("initWithIdentifier:"), (id)0);
			id page = ((id(*)(id, SEL, CGRect))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)(nomen_tab_page_class(), sel_registerName("alloc")),
				sel_registerName("initWithFrame:"),
				((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 0, 0));
			((void(*)(id, SEL, id))objc_msgSend)(
				item, sel_registerName("setLabel:"),
				((id(*)(id, SEL, const char*))objc_msgSend)(
					(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
			((void(*)(id, SEL, id))objc_msgSend)(item, sel_registerName("setView:"), page);
			((void(*)(id, SEL))objc_msgSend)(page, sel_registerName("release"));
			((void(*)(id, SEL, id))objc_msgSend)(tv, sel_registerName("addTabViewItem:"), item);
			((void(*)(id, SEL))objc_msgSend)(item, sel_registerName("release"));
		}
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), tv);
		self.handle = (uint64_t)tv;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 200));
		for (long i = 0; i < (long)count; i++) {
			id item = ((id(*)(id, SEL, id))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTabViewItem"), sel_registerName("alloc")),
				sel_registerName("initWithIdentifier:"), (id)0);
			id page = ((id(*)(id, SEL, CGRect))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)(nomen_tab_page_class(), sel_registerName("alloc")),
				sel_registerName("initWithFrame:"),
				((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 0, 0));
			((void(*)(id, SEL, id))objc_msgSend)(
				item, sel_registerName("setLabel:"),
				((id(*)(id, SEL, const char*))objc_msgSend)(
					(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
			((void(*)(id, SEL, id))objc_msgSend)(item, sel_registerName("setView:"), page);
			((void(*)(id, SEL))objc_msgSend)(page, sel_registerName("release"));
			((void(*)(id, SEL, id))objc_msgSend)(tv, sel_registerName("addTabViewItem:"), item);
			((void(*)(id, SEL))objc_msgSend)(item, sel_registerName("release"));
		}
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), tv);
		self->handle = (uint64_t)tv;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS — no NSTabView counterpart (UITabBarController is
		 * app-level chrome, not an embeddable control; see GUI_PLAN Tier 2;
		 * defer). */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	// A Window-shaped handle to page `index`'s view: pass it to control
	// constructors and `Container.layout` to host controls on that page. The
	// value retains the page view (+1), so its scope-exit `#destroy` releases
	// its OWN reference and the Tabs' stays balanced — keep the Tabs alive at
	// least as long as the returned value.
	pub func content_window = (self, int index, out Window) {
		```
		#arch: c
		#platform: macos
		id item = ((id(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
		id page = ((id(*)(id, SEL))objc_msgSend)(item, sel_registerName("view"));
		extern void *_Window_traits[];
		struct Window w;
		w._vt = (void *)&_Window_traits;
		w.handle = (uint64_t)page;
		((id(*)(id, SEL))objc_msgSend)(page, sel_registerName("retain"));
		return w;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id item = ((id(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("tabViewItemAtIndex:"), (long)index);
		id page = ((id(*)(id, SEL))objc_msgSend)(item, sel_registerName("view"));
		extern void *Window_traits;
		struct Window w;
		w._vt = (void *)&Window_traits;
		w.handle = (uint64_t)page;
		((id(*)(id, SEL))objc_msgSend)(page, sel_registerName("retain"));
		return w;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		{
			extern void *_Window_traits[];
			struct Window w;
			w._vt = (void *)&_Window_traits;
			w.handle = 0;
			return w;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		{
			extern void *Window_traits;
			struct Window w;
			w._vt = (void *)&Window_traits;
			w.handle = 0;
			return w;
		}
		```
	}

	pub func set_label = (self, int index, string title) {
		```
		#arch: c
