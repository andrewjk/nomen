/**
 * An indeterminate spinning activity indicator
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * On macOS this is the same NSProgressIndicator as `Progress`, styled as a
 * spinner; on iOS it is the distinct UIActivityIndicatorView. `spinning` is
 * tracked at the Nomen level (NSProgressIndicator has no isSpinning getter),
 * so `is_spinning` reads true exactly between start() and stop().
 **/
pub mv struct Spinner : Control {
	var uint64 handle = 0
	var bool spinning = false

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id spin = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSProgressIndicator"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 22, 22));
		((void(*)(id, SEL, long))objc_msgSend)(
			spin, sel_registerName("setStyle:"), 1); // NSProgressIndicatorSpinningStyle = 1
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			spin, sel_registerName("setControlSize:"), 1); // NSControlSizeSmall = 1
		((void(*)(id, SEL, BOOL))objc_msgSend)(spin, sel_registerName("setIndeterminate:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(spin, sel_registerName("setUsesThreadedAnimation:"), 1);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), spin);
		self.handle = (uint64_t)spin;
		self.spinning = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id spin = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSProgressIndicator"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 22, 22));
		((void(*)(id, SEL, long))objc_msgSend)(
			spin, sel_registerName("setStyle:"), 1); // NSProgressIndicatorSpinningStyle = 1
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			spin, sel_registerName("setControlSize:"), 1); // NSControlSizeSmall = 1
		((void(*)(id, SEL, BOOL))objc_msgSend)(spin, sel_registerName("setIndeterminate:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(spin, sel_registerName("setUsesThreadedAnimation:"), 1);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), spin);
		self->handle = (uint64_t)spin;
		self->spinning = 0;
		```
		```
		#arch: c
		#platform: ios
		id spin = ((id(*)(id, SEL, long, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIActivityIndicatorView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			100, // UIActivityIndicatorViewStyleMedium = 100
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 20, 20));
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), spin);
		self.handle = (uint64_t)spin;
		self.spinning = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id spin = ((id(*)(id, SEL, long, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIActivityIndicatorView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			100, // UIActivityIndicatorViewStyleMedium = 100
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 20, 20));
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), spin);
		self->handle = (uint64_t)spin;
		self->spinning = 0;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	pub func start = (ref self) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("startAnimation:"), (id)0);
		self->spinning = 1;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("startAnimation:"), (id)0);
		self->spinning = 1;
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("startAnimating"));
		self->spinning = 1;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("startAnimating"));
		self->spinning = 1;
		```
	}

	pub func stop = (ref self) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("stopAnimation:"), (id)0);
		self->spinning = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("stopAnimation:"), (id)0);
		self->spinning = 0;
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("stopAnimating"));
		self->spinning = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("stopAnimating"));
		self->spinning = 0;
		```
	}

	pub func is_spinning = (self, out bool) {
		return self.spinning
	}

	pub func set_hidden = (self, bool hidden) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
	}

	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("stopAnimation:"), (id)0);
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("stopAnimation:"), (id)0);
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("stopAnimating"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("stopAnimating"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
	}
}
