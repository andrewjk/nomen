	// ── The App run loop (see App.nm) ──

	// Register the layout root for Window.run: the root Container's layout
	// re-runs on start, on every live-resize delegate tick, and on each
	// frame where the content rect changed. The grid must outlive the run
	// (an app field — registration stores its address). Call from
	// App.start; also arms the resize delegate's target pair.
	pub func set_content = (ref self, ref Container grid) {
		```
		#arch: c
		#platform: macos
		#scope: file
		static void *nomen_run_root_grid = 0;
		static void *nomen_run_root_win = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		#scope: file
		static void *nomen_run_root_grid = 0;
		static void *nomen_run_root_win = 0;
		```
		```
		#arch: c
		#platform: macos
		extern void nomen_set_resize_target(void *, void *);
		nomen_run_root_grid = (void *)grid;
