	// Resize the window's content area to width x height (displayed). The
	// programmatic stand-in for a user drag: it fires the same
	// windowDidResize: notifications (and the Container resize delegate), so
	// tests can exercise resize relayout headlessly.
	pub func set_size = (self, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, double, double))objc_msgSend)(
			(id)self->handle, sel_registerName("setContentSize:"), (double)width, (double)height);
		```
