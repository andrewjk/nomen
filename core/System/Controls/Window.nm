// Text-INPUT edge drain: true when the control's text changed since the
// last drain for this handle (the field editor writes through to the
// control's stringValue while typing, so each keystroke is one edge).
// Last-seen text is tracked per handle.
pub func nomen_control_take_input = (uint64 handle, out bool) {
	```
	#arch: c
	#platform: macos
	#scope: file
	struct nomen_input_seen {
		void *handle;
		char *last;
	};
	static struct nomen_input_seen nomen_input_seen[32];
	static int nomen_input_seen_count = 0;
	```
	```
	#arch: c
	#platform: macos
	struct nomen_input_seen *e = 0;
	for (int i = 0; i < nomen_input_seen_count; i++) {
		if (nomen_input_seen[i].handle == (void *)handle) {
			e = &nomen_input_seen[i];
			break;
		}
	}
	if (!e && nomen_input_seen_count < 32) {
		e = &nomen_input_seen[nomen_input_seen_count++];
		e->handle = (void *)handle;
		e->last = 0;
	}
	if (!e) return 0;
	// stringValue returns the live text (the field editor writes through to
	// it while typing); UTF8String goes through the returned NSString.
	id s = ((id(*)(id, SEL))objc_msgSend)((id)handle, sel_registerName("stringValue"));
	const char *cur = ((const char *(*)(id, SEL))objc_msgSend)(s, sel_registerName("UTF8String"));
	// First sight of a handle: record the baseline silently — no edge.
	if (!e->last) {
		e->last = strdup(cur);
		return 0;
	}
	int changed = strcmp(e->last, cur) != 0;
	if (changed) {
		free(e->last);
		e->last = strdup(cur);
	}
	return changed;
