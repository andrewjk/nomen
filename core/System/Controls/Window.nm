	// Returns the x coordinate (in the window's content view) of the most
	// recent mouse-down (left or right). The pump (process_events) captures
	// the coordinates when the event is handled, so drag/move events that
	// follow in the same batch cannot make them stale. Call after
	// process_events returned 1 or 2 (-1 before any click was ever seen).
	pub func click_x = (self, out int) {
		```
		#arch: c
		#platform: macos
		return nomen_last_click_x;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		return nomen_last_click_x;
		```
		```
		#arch: c
		#platform: ios
		return -1;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		return -1;
		```
	}

