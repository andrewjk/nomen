	#arch: c
	#platform: ios
	return 0;
	```
	```
	#arch: aarch64_use_c
	#platform: ios
	return 0;
	```
}

// Focus EDGE drain: true when `handle` GAINED first-responder status this
// frame. Pure snapshot compare — no state update, so any number of
// focus/blur arms can poll the same frame in any order.
pub func nomen_control_take_focus = (uint64 handle, out bool) {
	```
	#arch: c
	#platform: macos
	#scope: file
	extern unsigned long long nomen_focus_prev;
	extern unsigned long long nomen_focus_cur;
	extern void *nomen_focus_window;
	static id nomen_focus_responder(void *win);
	```
	```
	#arch: c
	#platform: macos
	int known = nomen_focus_window != 0;
	id fr = known ? nomen_focus_responder(nomen_focus_window) : 0;
	int gained =
		known && ((unsigned long long)(void *)fr == handle) && (nomen_focus_prev != handle);
	return gained;
	```
	```
	#arch: aarch64_use_c
	#platform: macos
	#scope: file
	extern unsigned long long nomen_focus_prev;
	extern unsigned long long nomen_focus_cur;
