	// One framework relayout pass: the registered root Container, then every
	// registered Scrollable's document dance (`first` drives its one-time
	// scroll_to_top), then every registered pane root's layout (tabs pages /
	// split panes re-frame when THIS pass frames their host view — the app
	// cannot know the moment, so registration hands the timing here).
	func relayout = (self, int first) {
		```
		#arch: c
