	// Process pending events without blocking. Returns 1 if a left-mouse-down
	// was among the events (i.e. a click happened), 2 if a right-mouse-down
	// was, 0 otherwise. This lets a manual event loop detect clicks (and
	// right-clicks) for hit-testing without target/action. The click's
	// coordinates are captured here (see click_x/click_y). Also runs the run
	// loop briefly to process Apple Events (e.g. dock Quit).
	pub func process_events = (out int) {
		```
		#arch: c
		#platform: macos
		#scope: file
		// The most recent mouse-down (NSLeftMouseDown = 1 or NSRightMouseDown = 3)
		// among the events the latest process_events call pumped, in the event
		// window's content coordinates (top-left origin). Written by the pump;
		// read by click_x/click_y. click_x/click_y deliberately do NOT read the
		// live currentEvent: any event after the click in the same batch (a
		// mouse-move, drag, or key) would make the coordinates stale or missing,
		// so hit-tests would intermittently miss.
		static int nomen_last_click_x = -1;
		static int nomen_last_click_y = -1;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		#scope: file
		// The most recent mouse-down (NSLeftMouseDown = 1 or NSRightMouseDown = 3)
		// among the events the latest process_events call pumped, in the event
		// window's content coordinates (top-left origin). Written by the pump;
		// read by click_x/click_y. click_x/click_y deliberately do NOT read the
		// live currentEvent: any event after the click in the same batch (a
		// mouse-move, drag, or key) would make the coordinates stale or missing,
		// so hit-tests would intermittently miss.
		static int nomen_last_click_x = -1;
		static int nomen_last_click_y = -1;
		```
		```
		#arch: c
		#platform: macos
		// A manual event loop has no autorelease pool of its own: AppKit
		// autoreleases objects on every pump (events, strings, cell caches)
		// and without a pool they accumulate for the process lifetime — the
		// loop leaked tens of MB per second and a busy window eventually
		// died. One pool per pump; the returned had_click is a plain int.
		id pool = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSAutoreleasePool"), sel_registerName("alloc")),
			sel_registerName("init"));
		id app = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSApplication"), sel_registerName("sharedApplication"));
		id distant_past = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSDate"), sel_registerName("distantPast"));
		id default_mode = ((id(*)(id, SEL, const char*))objc_msgSend)(
			(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "kCFRunLoopDefaultMode");
		int had_click = 0;
		while (1) {
			id event = ((id(*)(id, SEL, unsigned long long, id, id, BOOL))objc_msgSend)(
				app, sel_registerName("nextEventMatchingMask:untilDate:inMode:dequeue:"),
				0xFFFFFFFFFFFFFFFFULL, // NSEventMaskAny
				distant_past,          // untilDate — returns immediately if no events
				default_mode,          // inMode
				1);                    // dequeue
			if (!event) break;
			((void(*)(id, SEL, id))objc_msgSend)(app, sel_registerName("sendEvent:"), event);
			long type = ((long(*)(id, SEL))objc_msgSend)(event, sel_registerName("type"));
			// A mouse-down: record where it landed. locationInWindow is in the
			// event's own window's coordinates (bottom-left origin); flip y
			// against that window's content height to match the layout's
			// top-left origin.
			if (type == 1 || type == 3) {
				id evwin = ((id(*)(id, SEL))objc_msgSend)(event, sel_registerName("window"));
				id cv = ((id(*)(id, SEL))objc_msgSend)(evwin, sel_registerName("contentView"));
				CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
				CGPoint loc = ((CGPoint(*)(id, SEL))objc_msgSend)(event, sel_registerName("locationInWindow"));
				nomen_last_click_x = (int)loc.x;
				nomen_last_click_y = (int)(frame.size.height - loc.y);
			}
			if (type == 1) had_click = 1; // NSLeftMouseDown = 1
			if (type == 3) had_click = 2; // NSRightMouseDown = 3 (reported as 2)
		}
		// Process run loop sources (Apple Events, timers) so that dock Quit
		// and other system interactions work without NSApplication.run().
		CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, 1);
		int result = had_click;
		((void(*)(id, SEL))objc_msgSend)(pool, sel_registerName("drain"));
		return result;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		// A manual event loop has no autorelease pool of its own: AppKit
		// autoreleases objects on every pump (events, strings, cell caches)
		// and without a pool they accumulate for the process lifetime — the
		// loop leaked tens of MB per second and a busy window eventually
		// died. One pool per pump; the returned had_click is a plain int.
		id pool = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSAutoreleasePool"), sel_registerName("alloc")),
			sel_registerName("init"));
		id app = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSApplication"), sel_registerName("sharedApplication"));
		id distant_past = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSDate"), sel_registerName("distantPast"));
		id default_mode = ((id(*)(id, SEL, const char*))objc_msgSend)(
			(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "kCFRunLoopDefaultMode");
		int had_click = 0;
		while (1) {
			id event = ((id(*)(id, SEL, unsigned long long, id, id, BOOL))objc_msgSend)(
				app, sel_registerName("nextEventMatchingMask:untilDate:inMode:dequeue:"),
				0xFFFFFFFFFFFFFFFFULL, // NSEventMaskAny
				distant_past,          // untilDate — returns immediately if no events
				default_mode,          // inMode
				1);                    // dequeue
			if (!event) break;
			((void(*)(id, SEL, id))objc_msgSend)(app, sel_registerName("sendEvent:"), event);
			long type = ((long(*)(id, SEL))objc_msgSend)(event, sel_registerName("type"));
			// A mouse-down: record where it landed. locationInWindow is in the
			// event's own window's coordinates (bottom-left origin); flip y
			// against that window's content height to match the layout's
			// top-left origin.
			if (type == 1 || type == 3) {
				id evwin = ((id(*)(id, SEL))objc_msgSend)(event, sel_registerName("window"));
				id cv = ((id(*)(id, SEL))objc_msgSend)(evwin, sel_registerName("contentView"));
				CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
				CGPoint loc = ((CGPoint(*)(id, SEL))objc_msgSend)(event, sel_registerName("locationInWindow"));
				nomen_last_click_x = (int)loc.x;
				nomen_last_click_y = (int)(frame.size.height - loc.y);
			}
			if (type == 1) had_click = 1; // NSLeftMouseDown = 1
			if (type == 3) had_click = 2; // NSRightMouseDown = 3 (reported as 2)
		}
		// Process run loop sources (Apple Events, timers) so that dock Quit
		// and other system interactions work without NSApplication.run().
		CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, 1);
		int result = had_click;
		((void(*)(id, SEL))objc_msgSend)(pool, sel_registerName("drain"));
		return result;
		```
		```
		#arch: c
		#platform: ios
		return 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		return 0;
		```
	}

