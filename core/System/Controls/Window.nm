	// Process pending events without blocking. Returns 1 if a left-mouse-down
	// was among the events (i.e. a click happened), 2 if a right-mouse-down
	// was, 0 otherwise. This lets a manual event loop detect clicks (and
	// right-clicks) for hit-testing without target/action. The click's
	// coordinates are captured here (see click_x/click_y), and the click's
	// button kind is stamped for the drains (nomen_last_click_kind —
	// Container.take_right_click reads it). Also runs the run
	// loop briefly to process Apple Events (e.g. dock Quit).
	pub func process_events = (out int) {
		```
		#arch: c
		#platform: macos
		#scope: file
		// The most recent mouse-down (NSLeftMouseDown = 1 or NSRightMouseDown = 3)
		// among the events the latest process_events call pumped, in the event
		// window's content coordinates (top-left origin). Written by the pump;
		// read by click_x/click_y. click_x/click_y deliberately do NOT read the
		// live currentEvent: any event after the click in the same batch (a
		// mouse-move, drag, or key) would make the coordinates stale or missing,
		// so hit-tests would intermittently miss.
		static int nomen_last_click_x = -1;
		static int nomen_last_click_y = -1;
		// The same record's button kind (0 none / 1 left / 2 right), stamped
		// by every pump — a quiet pump stamps 0, so the edge expires with
		// the frame. External linkage (NOT static, unlike the coordinates):
		// Container's take_right_click drain externs it from another TU —
		// the focus snapshot's sharing pattern (nomen_window_focus_poll).
		int nomen_last_click_kind = 0;
		// The full mouse-down record for THIS pump (the exhaustive input
		// surface — every button, not just left/right): 1-based button
		// number (0 = no mouse-down this frame), AppKit clickCount, and the
		// device-independent modifier flags (Command = 0x100000, Option =
		// 0x80000, Control = 0x40000, Shift = 0x20000). Zeroed by every
		// pump, so the edge expires with the frame. External linkage:
		// Container.take_mouse_down externs the button from another TU.
		int nomen_last_click_button = 0;
		int nomen_last_click_count = 0;
		int nomen_last_click_modifiers = 0;
		// Scroll-wheel deltas accumulated across this pump's events
		// (trackpads emit many small events per frame; momentum counts).
		// Zeroed by every pump. External linkage: Scrollable.take_scroll
		// externs them from another TU.
		double nomen_scroll_dx_acc = 0.0;
		double nomen_scroll_dy_acc = 0.0;
		// The keyboard record for THIS pump: the hardware keycode of the
		// last key-down (NSEventTypeKeyDown = 10) and key-up (type 11),
		// -1 = none this frame; the modifiers at key-down; and whether the
		// key-down was an auto-repeat (a held key). Zeroed by every pump.
		// External linkage: Container.take_key_down / take_key_up extern
		// them from another TU. Text entry does NOT flow here (the field
		// editor feeds TextBox.on_input) — this record is for shortcuts and
		// raw key handling.
		int nomen_last_key_code = -1;
		int nomen_last_key_modifiers = 0;
		int nomen_last_key_repeat = 0;
		int nomen_last_key_up_code = -1;
		// The pointer-MOVE record for THIS pump (NSEventTypeMouseMoved = 5,
		// plus the dragged variants 6/7/26 while a button is held): the last
		// seen position, -1 = no move this frame. Zeroed by every pump.
		// External linkage: Container.take_mouse_move externs it. Requires
		// setAcceptsMouseMovedEvents (armed by every pump below) — without
		// it AppKit delivers no move events at all.
		int nomen_last_mouse_move_x = -1;
		int nomen_last_mouse_move_y = -1;
		// Frame time: the pump's wall-clock interval, persisted across
		// pumps (NOT zeroed — the first frame reports 0). Read by win.dt().
		double nomen_last_pump_time = 0.0;
		double nomen_last_dt_ms = 0.0;
		// The window-resize record for THIS frame, stamped by Window.run's
		// resize detection (not by the pump). External linkage:
		// Container.take_resize externs the edge from another TU; the size
		// getters (resize_width/resize_height) are Window methods reading
		// these directly.
		int nomen_last_resized = 0;
		int nomen_last_resize_w = 0;
		int nomen_last_resize_h = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		#scope: file
		// The most recent mouse-down (NSLeftMouseDown = 1 or NSRightMouseDown = 3)
		// among the events the latest process_events call pumped, in the event
		// window's content coordinates (top-left origin). Written by the pump;
		// read by click_x/click_y. click_x/click_y deliberately do NOT read the
		// live currentEvent: any event after the click in the same batch (a
		// mouse-move, drag, or key) would make the coordinates stale or missing,
		// so hit-tests would intermittently miss.
		static int nomen_last_click_x = -1;
		static int nomen_last_click_y = -1;
		// The same record's button kind (0 none / 1 left / 2 right), stamped
		// by every pump — a quiet pump stamps 0, so the edge expires with
		// the frame. External linkage (NOT static, unlike the coordinates):
		// Container's take_right_click drain externs it from another TU —
		// the focus snapshot's sharing pattern (nomen_window_focus_poll).
		int nomen_last_click_kind = 0;
		// The full mouse-down record for THIS pump (the exhaustive input
		// surface — every button, not just left/right): 1-based button
		// number (0 = no mouse-down this frame), AppKit clickCount, and the
		// device-independent modifier flags (Command = 0x100000, Option =
		// 0x80000, Control = 0x40000, Shift = 0x20000). Zeroed by every
		// pump, so the edge expires with the frame. External linkage:
		// Container.take_mouse_down externs the button from another TU.
		int nomen_last_click_button = 0;
		int nomen_last_click_count = 0;
		int nomen_last_click_modifiers = 0;
		// Scroll-wheel deltas accumulated across this pump's events
		// (trackpads emit many small events per frame; momentum counts).
		// Zeroed by every pump. External linkage: Scrollable.take_scroll
		// externs them from another TU.
		double nomen_scroll_dx_acc = 0.0;
		double nomen_scroll_dy_acc = 0.0;
		// The keyboard record for THIS pump: the hardware keycode of the
		// last key-down (NSEventTypeKeyDown = 10) and key-up (type 11),
		// -1 = none this frame; the modifiers at key-down; and whether the
		// key-down was an auto-repeat (a held key). Zeroed by every pump.
		// External linkage: Container.take_key_down / take_key_up extern
		// them from another TU. Text entry does NOT flow here (the field
		// editor feeds TextBox.on_input) — this record is for shortcuts and
		// raw key handling.
		int nomen_last_key_code = -1;
		int nomen_last_key_modifiers = 0;
		int nomen_last_key_repeat = 0;
		int nomen_last_key_up_code = -1;
		// The pointer-MOVE record for THIS pump (NSEventTypeMouseMoved = 5,
		// plus the dragged variants 6/7/26 while a button is held): the last
		// seen position, -1 = no move this frame. Zeroed by every pump.
		// External linkage: Container.take_mouse_move externs it. Requires
		// setAcceptsMouseMovedEvents (armed by every pump below) — without
		// it AppKit delivers no move events at all.
		int nomen_last_mouse_move_x = -1;
		int nomen_last_mouse_move_y = -1;
		// Frame time: the pump's wall-clock interval, persisted across
		// pumps (NOT zeroed — the first frame reports 0). Read by win.dt().
		double nomen_last_pump_time = 0.0;
		double nomen_last_dt_ms = 0.0;
		// The window-resize record for THIS frame, stamped by Window.run's
		// resize detection (not by the pump). External linkage:
		// Container.take_resize externs the edge from another TU; the size
		// getters (resize_width/resize_height) are Window methods reading
		// these directly.
		int nomen_last_resized = 0;
		int nomen_last_resize_w = 0;
		int nomen_last_resize_h = 0;
		```
		```
		#arch: c
		#platform: macos
		// A manual event loop has no autorelease pool of its own: AppKit
		// autoreleases objects on every pump (events, strings, cell caches)
		// and without a pool they accumulate for the process lifetime — the
		// loop leaked tens of MB per second and a busy window eventually
		// died. One pool per pump; the returned had_click is a plain int.
		id pool = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSAutoreleasePool"), sel_registerName("alloc")),
			sel_registerName("init"));
		id app = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSApplication"), sel_registerName("sharedApplication"));
		id distant_past = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSDate"), sel_registerName("distantPast"));
		id default_mode = ((id(*)(id, SEL, const char*))objc_msgSend)(
			(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "kCFRunLoopDefaultMode");
		int had_click = 0;
		// This pump's mouse record: zeroed first, so a quiet pump expires
		// the previous frame's edge — the getters and drains read these,
		// and 0 means "no mouse-down / no scroll this frame".
		nomen_last_click_button = 0;
		nomen_last_click_count = 0;
		nomen_last_click_modifiers = 0;
		nomen_scroll_dx_acc = 0.0;
		nomen_scroll_dy_acc = 0.0;
		nomen_last_key_code = -1;
		nomen_last_key_modifiers = 0;
		nomen_last_key_repeat = 0;
		nomen_last_key_up_code = -1;
		nomen_last_mouse_move_x = -1;
		nomen_last_mouse_move_y = -1;
		while (1) {
			id event = ((id(*)(id, SEL, unsigned long long, id, id, BOOL))objc_msgSend)(
				app, sel_registerName("nextEventMatchingMask:untilDate:inMode:dequeue:"),
				0xFFFFFFFFFFFFFFFFULL, // NSEventMaskAny
				distant_past,          // untilDate — returns immediately if no events
				default_mode,          // inMode
				1);                    // dequeue
			if (!event) break;
			((void(*)(id, SEL, id))objc_msgSend)(app, sel_registerName("sendEvent:"), event);
			long type = ((long(*)(id, SEL))objc_msgSend)(event, sel_registerName("type"));
			// A mouse-down (left = 1, right = 3, other/middle/extra = 25):
			// record where it landed and which button. locationInWindow is
			// in the event's own window's coordinates (bottom-left origin);
			// flip y against that window's content height to match the
			// layout's top-left origin. buttonNumber is 0-based (0 left, 1
			// right, 2 middle, 3+ extras) — stored 1-based to match
			// FrameEvents.click's 1 = left / 2 = right contract. clickCount
			// gives double/triple clicks; modifierFlags are masked to the
			// device-independent bits.
			if (type == 1 || type == 3 || type == 25) {
				id evwin = ((id(*)(id, SEL))objc_msgSend)(event, sel_registerName("window"));
				id cv = ((id(*)(id, SEL))objc_msgSend)(evwin, sel_registerName("contentView"));
				CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
				CGPoint loc = ((CGPoint(*)(id, SEL))objc_msgSend)(event, sel_registerName("locationInWindow"));
				nomen_last_click_x = (int)loc.x;
				nomen_last_click_y = (int)(frame.size.height - loc.y);
				nomen_last_click_button = (int)(((long(*)(id, SEL))objc_msgSend)(event, sel_registerName("buttonNumber"))) + 1;
				nomen_last_click_count = (int)((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("clickCount"));
				nomen_last_click_modifiers = (int)(((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("modifierFlags")) & 0xFFF00000ULL);
			}
			// A scroll-wheel event (NSEventTypeScrollWheel = 22): accumulate
			// the deltas for this frame. AppKit deltaY is positive scrolling
			// up/away from the user; deltaX is positive scrolling right.
			if (type == 22) {
				nomen_scroll_dy_acc += ((double(*)(id, SEL))objc_msgSend)(event, sel_registerName("deltaY"));
				nomen_scroll_dx_acc += ((double(*)(id, SEL))objc_msgSend)(event, sel_registerName("deltaX"));
			}
			// A key-down (NSEventTypeKeyDown = 10): record the hardware
			// keycode (Space = 49, Return = 36, Delete = 51, Esc = 53,
			// arrows = 123–126, letters a…z = 0–25), the modifiers, and
			// whether this is an auto-repeat (a held key — filter it for
			// first-press-only shortcuts).
			if (type == 10) {
				nomen_last_key_code = (int)((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("keyCode"));
				nomen_last_key_modifiers = (int)(((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("modifierFlags")) & 0xFFF00000ULL);
				nomen_last_key_repeat = ((BOOL(*)(id, SEL))objc_msgSend)(event, sel_registerName("isARepeat")) ? 1 : 0;
			}
			// A key-up (NSEventTypeKeyUp = 11): press-and-hold handling.
			if (type == 11) {
				nomen_last_key_up_code = (int)((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("keyCode"));
			}
			// A pointer move (NSMouseMoved = 5; the dragged variants 6/7/26
			// while a button is held): record where the pointer is now.
			if (type == 5 || type == 6 || type == 7 || type == 26) {
				id evwin = ((id(*)(id, SEL))objc_msgSend)(event, sel_registerName("window"));
				id cv = ((id(*)(id, SEL))objc_msgSend)(evwin, sel_registerName("contentView"));
				CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
				CGPoint loc = ((CGPoint(*)(id, SEL))objc_msgSend)(event, sel_registerName("locationInWindow"));
				nomen_last_mouse_move_x = (int)loc.x;
				nomen_last_mouse_move_y = (int)(frame.size.height - loc.y);
			}
			if (type == 1) had_click = 1; // NSLeftMouseDown = 1
			if (type == 3) had_click = 2; // NSRightMouseDown = 3 (reported as 2)
		}
		// Process run loop sources (Apple Events, timers) so that dock Quit
		// and other system interactions work without NSApplication.run().
		CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, 1);
		// Frame time: the interval since the previous pump (0 on the first).
		double now = CFAbsoluteTimeGetCurrent();
		if (nomen_last_pump_time != 0.0) {
			nomen_last_dt_ms = (now - nomen_last_pump_time) * 1000.0;
		}
		nomen_last_pump_time = now;
		int result = had_click;
		// Stamp the kind for the drains (Container.take_right_click reads
		// it in the handle_events pass that follows this pump).
		nomen_last_click_kind = had_click;
		((void(*)(id, SEL))objc_msgSend)(pool, sel_registerName("drain"));
		return result;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		// A manual event loop has no autorelease pool of its own: AppKit
		// autoreleases objects on every pump (events, strings, cell caches)
		// and without a pool they accumulate for the process lifetime — the
		// loop leaked tens of MB per second and a busy window eventually
		// died. One pool per pump; the returned had_click is a plain int.
		id pool = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSAutoreleasePool"), sel_registerName("alloc")),
			sel_registerName("init"));
		id app = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSApplication"), sel_registerName("sharedApplication"));
		id distant_past = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSDate"), sel_registerName("distantPast"));
		id default_mode = ((id(*)(id, SEL, const char*))objc_msgSend)(
			(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "kCFRunLoopDefaultMode");
		int had_click = 0;
		// This pump's mouse record: zeroed first, so a quiet pump expires
		// the previous frame's edge — the getters and drains read these,
		// and 0 means "no mouse-down / no scroll this frame".
		nomen_last_click_button = 0;
		nomen_last_click_count = 0;
		nomen_last_click_modifiers = 0;
		nomen_scroll_dx_acc = 0.0;
		nomen_scroll_dy_acc = 0.0;
		nomen_last_key_code = -1;
		nomen_last_key_modifiers = 0;
		nomen_last_key_repeat = 0;
		nomen_last_key_up_code = -1;
		nomen_last_mouse_move_x = -1;
		nomen_last_mouse_move_y = -1;
		while (1) {
			id event = ((id(*)(id, SEL, unsigned long long, id, id, BOOL))objc_msgSend)(
				app, sel_registerName("nextEventMatchingMask:untilDate:inMode:dequeue:"),
				0xFFFFFFFFFFFFFFFFULL, // NSEventMaskAny
				distant_past,          // untilDate — returns immediately if no events
				default_mode,          // inMode
				1);                    // dequeue
			if (!event) break;
			((void(*)(id, SEL, id))objc_msgSend)(app, sel_registerName("sendEvent:"), event);
			long type = ((long(*)(id, SEL))objc_msgSend)(event, sel_registerName("type"));
			// A mouse-down (left = 1, right = 3, other/middle/extra = 25):
			// record where it landed and which button. locationInWindow is
			// in the event's own window's coordinates (bottom-left origin);
			// flip y against that window's content height to match the
			// layout's top-left origin. buttonNumber is 0-based (0 left, 1
			// right, 2 middle, 3+ extras) — stored 1-based to match
			// FrameEvents.click's 1 = left / 2 = right contract. clickCount
			// gives double/triple clicks; modifierFlags are masked to the
			// device-independent bits.
			if (type == 1 || type == 3 || type == 25) {
				id evwin = ((id(*)(id, SEL))objc_msgSend)(event, sel_registerName("window"));
				id cv = ((id(*)(id, SEL))objc_msgSend)(evwin, sel_registerName("contentView"));
				CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
				CGPoint loc = ((CGPoint(*)(id, SEL))objc_msgSend)(event, sel_registerName("locationInWindow"));
				nomen_last_click_x = (int)loc.x;
				nomen_last_click_y = (int)(frame.size.height - loc.y);
				nomen_last_click_button = (int)(((long(*)(id, SEL))objc_msgSend)(event, sel_registerName("buttonNumber"))) + 1;
				nomen_last_click_count = (int)((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("clickCount"));
				nomen_last_click_modifiers = (int)(((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("modifierFlags")) & 0xFFF00000ULL);
			}
			// A scroll-wheel event (NSEventTypeScrollWheel = 22): accumulate
			// the deltas for this frame. AppKit deltaY is positive scrolling
			// up/away from the user; deltaX is positive scrolling right.
			if (type == 22) {
				nomen_scroll_dy_acc += ((double(*)(id, SEL))objc_msgSend)(event, sel_registerName("deltaY"));
				nomen_scroll_dx_acc += ((double(*)(id, SEL))objc_msgSend)(event, sel_registerName("deltaX"));
			}
			// A key-down (NSEventTypeKeyDown = 10): record the hardware
			// keycode (Space = 49, Return = 36, Delete = 51, Esc = 53,
			// arrows = 123–126, letters a…z = 0–25), the modifiers, and
			// whether this is an auto-repeat (a held key — filter it for
			// first-press-only shortcuts).
			if (type == 10) {
				nomen_last_key_code = (int)((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("keyCode"));
				nomen_last_key_modifiers = (int)(((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("modifierFlags")) & 0xFFF00000ULL);
				nomen_last_key_repeat = ((BOOL(*)(id, SEL))objc_msgSend)(event, sel_registerName("isARepeat")) ? 1 : 0;
			}
			// A key-up (NSEventTypeKeyUp = 11): press-and-hold handling.
			if (type == 11) {
				nomen_last_key_up_code = (int)((unsigned long(*)(id, SEL))objc_msgSend)(event, sel_registerName("keyCode"));
			}
			// A pointer move (NSMouseMoved = 5; the dragged variants 6/7/26
			// while a button is held): record where the pointer is now.
			if (type == 5 || type == 6 || type == 7 || type == 26) {
				id evwin = ((id(*)(id, SEL))objc_msgSend)(event, sel_registerName("window"));
				id cv = ((id(*)(id, SEL))objc_msgSend)(evwin, sel_registerName("contentView"));
				CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
				CGPoint loc = ((CGPoint(*)(id, SEL))objc_msgSend)(event, sel_registerName("locationInWindow"));
				nomen_last_mouse_move_x = (int)loc.x;
				nomen_last_mouse_move_y = (int)(frame.size.height - loc.y);
			}
			if (type == 1) had_click = 1; // NSLeftMouseDown = 1
			if (type == 3) had_click = 2; // NSRightMouseDown = 3 (reported as 2)
		}
		// Process run loop sources (Apple Events, timers) so that dock Quit
		// and other system interactions work without NSApplication.run().
		CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, 1);
		// Frame time: the interval since the previous pump (0 on the first).
		double now = CFAbsoluteTimeGetCurrent();
		if (nomen_last_pump_time != 0.0) {
			nomen_last_dt_ms = (now - nomen_last_pump_time) * 1000.0;
		}
		nomen_last_pump_time = now;
		int result = had_click;
		// Stamp the kind for the drains (Container.take_right_click reads
		// it in the handle_events pass that follows this pump).
		nomen_last_click_kind = had_click;
		((void(*)(id, SEL))objc_msgSend)(pool, sel_registerName("drain"));
		return result;
		```
