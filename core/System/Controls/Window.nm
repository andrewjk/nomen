	// ── Registered click handlers ──
	//
	// Retired with the handler desugar (docs/HANDLERS.md): registrations are
	// now `self.<field>.on_click(func () { ... })` — the checker hoists the
	// closure into a hidden method on the app and checks the site into a
	// dispatch arm on the app's synthesized `handle_clicks`, which the run
	// loop calls before `frame`. The window keeps only the ARMING primitive
	// the arms call: arming is idempotent per handle (an armed-set in C), so
	// an arm's per-frame call is a no-op after the first dispatch.

	// Run the app: the framework owns everything from here until the window
	// closes. Order: `app.start` (the app registers its layout roots and its
	// click handlers while in final storage), the pre-show layout pass,
	// `show`, the post-show pass (the toolbar settles the content rect only
	// after show; this pass also performs the one-time scroll_to_top), then
	// the loop — pump events, detect resizes (framework relayout already
	// applied), drain the app's registered click handlers (its
	// `handle_clicks` — the on_click desugar's dispatch), and hand the app a
	// FrameEvents each frame. The app is consumed: it is destroyed when the
	// loop exits (controls release, buffers free).
	pub func run = (ref self, mv App app) {
		app.start(ref self)
		Container.arm_resize_delegate(self)
		self.relayout(0)
		self.show()
		self.relayout(1)
		var int prev_w = self.content_width()
		var int prev_h = self.content_height()
		var FrameEvents ev = FrameEvents()
		while self.is_visible() {
			ev.click = Window.process_events()
			ev.click_x = self.click_x()
			ev.click_y = self.click_y()
			ev.resized = false
			var int cur_w = self.content_width()
			var int cur_h = self.content_height()
			if cur_w != prev_w {
				ev.resized = true
			}
			if cur_h != prev_h {
				ev.resized = true
			}
			if ev.resized {
				prev_w = cur_w
				prev_h = cur_h
				ev.width = cur_w
				ev.height = cur_h
				self.relayout(0)
			}
			// Registered handlers drain the click ring before the app frame —
			// the app's synthesized `handle_clicks` override (the on_click
			// desugar); conformers without registrations inherit the trait's
			// empty default. Each arm drains only its own registered handle.
			app.handle_clicks(ref self)
			app.frame(ref self, ev)
		}
	}

	// ── Control trait conformance ──
	// The window is the layout root: it measures to its content-view size and
	// applies a frame to the native NSWindow/UIWindow.

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var s = Size()
		s.width = self.content_width()
		s.height = self.content_height()
		return s
	}

	pub func intrinsic_size = (self, out Size) {
		var s = Size()
		s.width = self.content_width()
		s.height = self.content_height()
		return s
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		// NSWindow has no plain `setFrame:` (that is NSView's) — the window
		// API takes the display flag.
		((void(*)(id, SEL, CGRect, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:display:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height),
			1);
		```
		```
		#arch: aarch64_use_c
