pub func nomen_window_clicks_init = (uint64 handle) {
	```
	#arch: c
	#platform: macos
	#scope: file
	// The armed set: handles this process already armed (a desugar dispatch
	// arm re-calls per frame; re-arming would stack recognizers).
	static unsigned long long nomen_armed_handles[128];
	static int nomen_armed_count = 0;
	// The shared gesture target (one class pair per process; the handler
	// reads the gesture's view — the Nomen handle — and pushes the same
	// ring the button family's target/action uses).
	static void nomen_view_click_gesture(id self, SEL cmd, id gesture) {
		(void)self; (void)cmd;
		id view = ((id(*)(id, SEL))objc_msgSend)(gesture, sel_registerName("view"));
		nomen_click_push((unsigned long long)(void *)view);
	}
	static void nomen_window_click_arm(unsigned long long handle) {
		for (int i = 0; i < nomen_armed_count; i++) {
			if (nomen_armed_handles[i] == handle) return;
		}
		if (nomen_armed_count < 128) nomen_armed_handles[nomen_armed_count++] = handle;
		Class Tc = objc_getClass("NomenViewClickTarget");
		if (!Tc) {
			Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenViewClickTarget", 0);
			if (Tc) {
				class_addMethod(Tc, sel_registerName("viewClickGesture:"), (IMP)nomen_view_click_gesture, "v@:@");
				objc_registerClassPair(Tc);
			}
		}
		if (!Tc) return;
		id target = ((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
		id rec = ((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSClickGestureRecognizer"), sel_registerName("alloc"));
		rec = ((id(*)(id, SEL, id, SEL))objc_msgSend)(
			rec, sel_registerName("initWithTarget:action:"), (id)target, sel_registerName("viewClickGesture:"));
		((void(*)(id, SEL, id))objc_msgSend)((id)handle, sel_registerName("addGestureRecognizer:"), (id)rec);
	}
	```
	```
	#arch: c
	#platform: macos
	nomen_window_click_arm(handle);
