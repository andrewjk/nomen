	// Run the app: the framework owns everything from here until the window
	// closes. Order: `app.start` (the app registers its layout roots and its
	// click handlers while in final storage), the pre-show layout pass,
	// `show`, the post-show pass (the toolbar settles the content rect only
	// after show; this pass also performs the one-time scroll_to_top), then
	// the loop — pump events, detect resizes (framework relayout already
	// applied), drain the app's registered handlers (its synthesized
	// `handle_events` pump — the control-event desugars), and hand the app
	// a FrameEvents each frame.
	// The app is consumed: it is destroyed when the loop exits (controls
	// release, buffers free).
	pub func run = (ref self, mv App app) {
		app.start(ref self)
		Container.arm_resize_delegate(self)
		self.arm_mouse_moves()
		self.relayout(0)
		self.show()
		self.relayout(1)
		var int prev_w = self.content_width()
		var int prev_h = self.content_height()
		var ev = FrameEvents()
		while self.is_visible() {
			// Close interception: the delegate refused the native close and
			// set the pending flag; consult the app. Accept → forced close
			// (bypasses the delegate); decline → window stays, flag cleared.
			if self.close_pending() {
				if app.close_requested(ref self) {
					self.close()
				}
				self.clear_close_pending()
			}
			// An accepted close above releases the native window mid-frame;
			// skip the rest of this iteration (the while re-checks and
			// exits).
			if self.is_visible() {
				ev.click = Window.process_events()
				ev.click_x = self.click_x()
				ev.click_y = self.click_y()
				ev.mouse_button = self.mouse_button()
				ev.mouse_click_count = self.mouse_click_count()
				ev.mouse_modifiers = self.mouse_modifiers()
				ev.scroll_dx = self.scroll_dx()
				ev.scroll_dy = self.scroll_dy()
				ev.key_code = self.key_code()
				ev.key_modifiers = self.key_modifiers()
				ev.key_repeat = self.key_repeat()
				ev.key_up_code = self.key_up_code()
				ev.mouse_x = self.mouse_x()
				ev.mouse_y = self.mouse_y()
				ev.dt = self.dt()
				ev.resized = false
				self.stamp_resize(false, 0, 0)
				var int cur_w = self.content_width()
				var int cur_h = self.content_height()
				if cur_w != prev_w {
					ev.resized = true
				}
				if cur_h != prev_h {
					ev.resized = true
				}
				if ev.resized {
					prev_w = cur_w
					prev_h = cur_h
					ev.width = cur_w
					ev.height = cur_h
					self.stamp_resize(true, cur_w, cur_h)
					self.relayout(0)
				}
				// The window refreshes the per-frame event sources (the
				// first-responder snapshot feeds the focus/blur drains), then the
				// app's synthesized `handle_events` pump drains registered
				// handlers — conformers without registrations inherit the
				// trait's empty default. One arm per registered control.
				nomen_window_focus_poll(self.handle)
				app.handle_events(ref self)
				app.frame(ref self, ev)
			}
		}
	}

	// ── Control trait conformance ──
	// The window is the layout root: it measures to its content-view size and
	// applies a frame to the native NSWindow/UIWindow.

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var s = Size()
		s.width = self.content_width()
		s.height = self.content_height()
		return s
	}

	pub func intrinsic_size = (self, out Size) {
		var s = Size()
		s.width = self.content_width()
		s.height = self.content_height()
		return s
	}

