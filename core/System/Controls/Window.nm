// Arm click recording on a registered view. NSButton-family controls are
// armed at construction (nomen_control_arm_clicks) and already push to the
// ring; this re-arms those harmlessly and covers every OTHER view through
// an NSClickGestureRecognizer whose handler records the recognized view —
// the Nomen handle — into the same ring. Idempotent per handle (the armed
// set below — a desugar dispatch arm calls this every frame, and a fresh
// recognizer per call would accumulate); the recognizer target class is
// still built once per process.
// ── Registered control events (focus / blur / input) ──
//
// The desugar's control-carried events beyond clicks (docs/HANDLERS.md):
// `self.<field>.on_focus / on_blur / on_input(func () { ... })`. The
// window is the focus authority, so the snapshot lives here: the
// synthesized focus dispatcher calls `nomen_window_focus_poll` ONCE per
// frame (prev/cur first responder — the field editor maps back to the
// editing control), then each arm is a pure snapshot compare via
// `nomen_control_take_focus` / `take_blur` — order-independent across
// arms, and both sides of a handoff (A's blur, B's focus) fire in the
// same frame. Input edges are per-control text compares
// (`nomen_control_take_input`): the field editor writes through to the
// control's stringValue while typing, so each keystroke is one edge.

// Refresh the focus snapshot (prev/cur first responder of `window`).
// Idempotent per frame; the synthesized focus dispatcher calls it once
// before the arms.
pub func nomen_window_focus_poll = (uint64 window) {
	```
	#arch: c
	#platform: macos
	#scope: file
	// Shared with the take_focus / take_blur drains (same TU): the snapshot
	// has external linkage and ONE definition (here); the drains declare it
	// extern.
	unsigned long long nomen_focus_prev = 0;
	unsigned long long nomen_focus_cur = 0;
	void *nomen_focus_window = 0;
	static id nomen_focus_responder(void *win) {
		id fr = ((id(*)(id, SEL))objc_msgSend)((id)win, sel_registerName("firstResponder"));
		// While a text control is being edited, the first responder is the
		// window's FIELD EDITOR — map it back to the editing control (the
		// editor's delegate) so focus edges name the control.
		if (((BOOL(*)(id, SEL, id))objc_msgSend)(fr, sel_registerName("isKindOfClass:"), (id)objc_getClass("NSTextView"))) {
			id d = ((id(*)(id, SEL))objc_msgSend)(fr, sel_registerName("delegate"));
			if (d) fr = d;
		}
		return fr;
	}
	```
	```
	#arch: aarch64_use_c
	#platform: macos
	#scope: file
	unsigned long long nomen_focus_prev = 0;
	unsigned long long nomen_focus_cur = 0;
	void *nomen_focus_window = 0;
	static id nomen_focus_responder(void *win) {
		id fr = ((id(*)(id, SEL))objc_msgSend)((id)win, sel_registerName("firstResponder"));
		if (((BOOL(*)(id, SEL, id))objc_msgSend)(fr, sel_registerName("isKindOfClass:"), (id)objc_getClass("NSTextView"))) {
			id d = ((id(*)(id, SEL))objc_msgSend)(fr, sel_registerName("delegate"));
			if (d) fr = d;
		}
		return fr;
	}
	```
	```
	#arch: c
	#platform: macos
	void *win = (void *)window;
	id fr = nomen_focus_responder(win);
	if (nomen_focus_window != win) {
		// A different window took the snapshot: re-baseline (no edge).
		nomen_focus_window = win;
		nomen_focus_cur = (unsigned long long)(void *)fr;
		nomen_focus_prev = nomen_focus_cur;
	} else {
		nomen_focus_prev = nomen_focus_cur;
		nomen_focus_cur = (unsigned long long)(void *)fr;
	}
	```
	```
	#arch: aarch64_use_c
	#platform: macos
	void *win = (void *)window;
	id fr = nomen_focus_responder(win);
	if (nomen_focus_window != win) {
		nomen_focus_window = win;
		nomen_focus_cur = (unsigned long long)(void *)fr;
		nomen_focus_prev = nomen_focus_cur;
	} else {
		nomen_focus_prev = nomen_focus_cur;
		nomen_focus_cur = (unsigned long long)(void *)fr;
	}
	```
	```
	#arch: c
	#platform: ios
	/* TODO: iOS (first responder via UITextField delegates) */
	```
	```
	#arch: aarch64_use_c
	#platform: ios
