	// Append a node under `parent` (its `add_item`-order index, or -1 for a
	// top-level item) and reload.
	pub func add_item = (self, string text, int parent) {
		```
		#arch: c
		#platform: macos
		nomen_tree_append(text.ptr, (long)parent);
		((void(*)(id, SEL))objc_msgSend)((id)self->tree, sel_registerName("reloadData"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		nomen_tree_append(text.ptr, (long)parent);
		((void(*)(id, SEL))objc_msgSend)((id)self->tree, sel_registerName("reloadData"));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
