		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	// Expand or collapse the branch at node `index`.
	pub func set_expanded = (self, int index, bool expanded) {
		```
		#arch: c
		#platform: macos
		if (index < 0 || (long)index >= g_tree_count) return;
		((void(*)(id, SEL, id, BOOL))objc_msgSend)(
			(id)self->tree, sel_registerName("expandItem:expandChildren:"),
			nomen_tree_item((long)index), expanded ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (index < 0 || (long)index >= g_tree_count) return;
		((void(*)(id, SEL, id, BOOL))objc_msgSend)(
			(id)self->tree, sel_registerName("expandItem:expandChildren:"),
			nomen_tree_item((long)index), expanded ? 1 : 0);
		```
