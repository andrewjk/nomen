// Layout geometry types for the Nomen `core/System/Controls` UI layer.
//
// These are the pure-data types that flow through the layout engine: a parent
// hands each child a `BoxConstraints` (min/max per axis) during the measure
// phase, each child reports a `Size` back, and the engine assigns each node a
// `Frame` (x, y, width, height) during the arrange phase. `Insets` are the
// padding subtracted from a container's content rect. The `LayoutLength` /
// `Alignment` enums describe how a child sits in its parent (see `LayoutParams`).
//
// The measure/arrange math is independent of the storage representation — these
// flat structs are the trait-based `Container : Control` design's data model,
// but the same types work with the handle-based v1 container.

const MAX_DIM = 2147483647

// ── Geometry ──

/**
 * A 2D size (width and height)
 **/
pub struct Size {
	pub var width = 0
	pub var height = 0
}

/**
 * A rectangle (x, y, width, height) — a control's assigned position and size
 **/
pub struct Frame {
	pub var x = 0
	pub var y = 0
	pub var width = 0
	pub var height = 0
}

/**
 * Per-edge padding (top, right, bottom, left)
 **/
pub struct Insets {
	pub var top = 0
	pub var right = 0
	pub var bottom = 0
	pub var left = 0
}

// ── Constraints (flow DOWN) ──

/**
 * Min/max size bounds a parent passes to a child during the layout measure phase
 **/
pub struct BoxConstraints {
	pub var min_width = 0
	pub var min_height = 0
	pub var int max_width = MAX_DIM
	pub var int max_height = MAX_DIM

	pub func tighten_width = (self, int min, int max, out BoxConstraints) {
		var BoxConstraints c = self
		c.min_width = self.min_width
		if min > c.min_width { c.min_width = min }
		c.max_width = self.max_width
		if max < c.max_width { c.max_width = max }
		return c
	}

	pub func tighten_height = (self, int min, int max, out BoxConstraints) {
		var BoxConstraints c = self
		c.min_height = self.min_height
		if min > c.min_height { c.min_height = min }
		c.max_height = self.max_height
		if max < c.max_height { c.max_height = max }
		return c
	}

	pub func clamp_width = (self, int value, out int) {
		if value < self.min_width { return self.min_width }
		if value > self.max_width { return self.max_width }
		return value
	}

	pub func clamp_height = (self, int value, out int) {
		if value < self.min_height { return self.min_height }
		if value > self.max_height { return self.max_height }
		return value
	}

	pub func is_width_bounded = (self, out bool) {
		return self.max_width < MAX_DIM
	}

	pub func is_height_bounded = (self, out bool) {
		return self.max_height < MAX_DIM
	}
}

// `LayoutLength`, `Alignment`, `LayoutParams`, and `DEFAULT_PARAMS` live in
// `LayoutParams.nm`. They're split out so a module that only needs the
// per-child length model (e.g. `Container.nm`) can pull them in without also
// dragging `Size`/`Frame`/`Insets`/`BoxConstraints` along — `Size` and `Frame`
// collide with macOS `MacTypes.h` typedefs once any Cocoa-using module
// (Window, Controls) is in the build.
