/**
 * A horizontal value picker over a min/max range (poll per frame)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * Continuous control: read `value` each frame in the manual event loop.
 **/
pub mv struct Slider: Control {
	var uint64 handle = 0

	pub func #init = (self, Window window, float min, float max) {
		```
		#arch: c
		#platform: macos
		id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSlider"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 24));
		((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMinValue:"), min);
		((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMaxValue:"), max);
		((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setDoubleValue:"), min);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), sl);
		self.handle = (uint64_t)sl;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSlider"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 24));
		((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMinValue:"), min);
		((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMaxValue:"), max);
		((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setDoubleValue:"), min);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), sl);
		self->handle = (uint64_t)sl;
		```
		```
		#arch: c
		#platform: ios
		id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISlider"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 32));
		((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMinimumValue:"), (float)min);
		((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMaximumValue:"), (float)max);
		((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setValue:"), (float)min);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), sl);
		self.handle = (uint64_t)sl;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISlider"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 32));
		((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMinimumValue:"), (float)min);
		((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMaximumValue:"), (float)max);
		((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setValue:"), (float)min);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), sl);
		self->handle = (uint64_t)sl;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

