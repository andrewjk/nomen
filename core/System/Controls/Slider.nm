/**
 * A horizontal value picker over a min/max range (poll per frame)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * Continuous control: read `value` each frame in the manual event loop.
 **/
pub mv struct Slider: Control {
	/**
	 * The native platform handle for this control (internal; 0 until it is created).
	 **/
	var uint64 handle = 0

	/**
	 * A slider in `window` ranging from `min` to `max`.
	 **/
	pub func #init = (self, Window window, float min, float max) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSlider"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 24));
				((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMinValue:"), min);
				((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMaxValue:"), max);
				((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setDoubleValue:"), min);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), sl);
				self.handle = (uint64_t)sl;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSlider"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 24));
				((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMinValue:"), min);
				((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setMaxValue:"), max);
				((void(*)(id, SEL, double))objc_msgSend)(sl, sel_registerName("setDoubleValue:"), min);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), sl);
				self->handle = (uint64_t)sl;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISlider"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 32));
				((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMinimumValue:"), (float)min);
				((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMaximumValue:"), (float)max);
				((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setValue:"), (float)min);
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), sl);
				self.handle = (uint64_t)sl;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				id sl = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISlider"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 120, 32));
				((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMinimumValue:"), (float)min);
				((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setMaximumValue:"), (float)max);
				((void(*)(id, SEL, float))objc_msgSend)(sl, sel_registerName("setValue:"), (float)min);
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), sl);
				self->handle = (uint64_t)sl;
			}
		}
	}

	/**
	 * Place the control at (`x`, `y`) with the given size, in points. Layout containers
	 * call this for you (`Control` conformance).
	 **/
	pub func set_frame = (ref self {}, int x, int y, int width, int height) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
	}

	/**
	 * Set the lowest value.
	 **/
	pub func set_min = (self, float min) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, double))objc_msgSend)(
					(id)self->handle, sel_registerName("setMinValue:"), min);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, double))objc_msgSend)(
					(id)self->handle, sel_registerName("setMinValue:"), min);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, float))objc_msgSend)(
					(id)self->handle, sel_registerName("setMinimumValue:"), (float)min);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, float))objc_msgSend)(
					(id)self->handle, sel_registerName("setMinimumValue:"), (float)min);
			}
		}
	}

	/**
	 * Set the highest value.
	 **/
	pub func set_max = (self, float max) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, double))objc_msgSend)(
					(id)self->handle, sel_registerName("setMaxValue:"), max);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, double))objc_msgSend)(
					(id)self->handle, sel_registerName("setMaxValue:"), max);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, float))objc_msgSend)(
					(id)self->handle, sel_registerName("setMaximumValue:"), (float)max);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, float))objc_msgSend)(
					(id)self->handle, sel_registerName("setMaximumValue:"), (float)max);
			}
		}
	}

	/**
	 * Move the slider to `value`.
	 **/
	pub func set_value = (self, float value) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, double))objc_msgSend)(
					(id)self->handle, sel_registerName("setDoubleValue:"), value);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, double))objc_msgSend)(
					(id)self->handle, sel_registerName("setDoubleValue:"), value);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, float))objc_msgSend)(
					(id)self->handle, sel_registerName("setValue:"), (float)value);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, float))objc_msgSend)(
					(id)self->handle, sel_registerName("setValue:"), (float)value);
			}
		}
	}

	/**
	 * The slider's current value.
	 **/
	pub func value = (self, out float) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				return ((double(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("doubleValue"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				return ((double(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("doubleValue"));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				return (double)((float(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("value"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				return (double)((float(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("value"));
			}
		}
	}

	/**
	 * Show or hide the control.
	 **/
	pub func set_hidden = (self, bool hidden) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
	}

	/**
	 * The control's natural size given unlimited space (`Control` conformance).
	 **/
	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	/**
	 * The size the control wants, within `constraints` (`Control` conformance).
	 **/
	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
	}
}
