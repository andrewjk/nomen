/**
 * A determinate progress bar (with an indeterminate flag)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * Continuous control: the value is normalized 0..1 and polled per frame.
 * For the spinning variant (macOS styles the SAME control differently, iOS
 * uses a distinct class) see `Spinner`.
 **/
pub mv struct Progress : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id bar = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSProgressIndicator"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 20));
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			bar, sel_registerName("setControlSize:"), 1); // NSControlSizeSmall = 1
		// NSProgressIndicator defaults to indeterminate; a progress BAR starts
		// determinate with a normalized 0..1 range (the Spinner is the
		// indeterminate variant).
		((void(*)(id, SEL, BOOL))objc_msgSend)(bar, sel_registerName("setIndeterminate:"), 0);
		((void(*)(id, SEL, double))objc_msgSend)(bar, sel_registerName("setMinValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(bar, sel_registerName("setMaxValue:"), 1.0);
		((void(*)(id, SEL, double))objc_msgSend)(bar, sel_registerName("setDoubleValue:"), 0.0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), bar);
		self.handle = (uint64_t)bar;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id bar = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSProgressIndicator"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 20));
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			bar, sel_registerName("setControlSize:"), 1); // NSControlSizeSmall = 1
		// NSProgressIndicator defaults to indeterminate; a progress BAR starts
		// determinate with a normalized 0..1 range (the Spinner is the
		// indeterminate variant).
		((void(*)(id, SEL, BOOL))objc_msgSend)(bar, sel_registerName("setIndeterminate:"), 0);
		((void(*)(id, SEL, double))objc_msgSend)(bar, sel_registerName("setMinValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(bar, sel_registerName("setMaxValue:"), 1.0);
		((void(*)(id, SEL, double))objc_msgSend)(bar, sel_registerName("setDoubleValue:"), 0.0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), bar);
		self->handle = (uint64_t)bar;
		```
		```
		#arch: c
		#platform: ios
		id bar = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIProgressView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 6));
		((void(*)(id, SEL, float))objc_msgSend)(bar, sel_registerName("setProgress:"), 0.0f);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), bar);
		self.handle = (uint64_t)bar;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id bar = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIProgressView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 6));
		((void(*)(id, SEL, float))objc_msgSend)(bar, sel_registerName("setProgress:"), 0.0f);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), bar);
		self->handle = (uint64_t)bar;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	// The filled fraction, 0..1. iOS stores a float (32-bit); the value is
	// therefore only float32-exact there (0.25, 0.5, … are).
	pub func set_value = (self, float value) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, double))objc_msgSend)(
			(id)self->handle, sel_registerName("setDoubleValue:"), value);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, double))objc_msgSend)(
			(id)self->handle, sel_registerName("setDoubleValue:"), value);
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, float))objc_msgSend)(
			(id)self->handle, sel_registerName("setProgress:"), (float)value);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, float))objc_msgSend)(
			(id)self->handle, sel_registerName("setProgress:"), (float)value);
		```
	}

	pub func value = (self, out float) {
		```
		#arch: c
		#platform: macos
		return ((double(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("doubleValue"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		return ((double(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("doubleValue"));
		```
		```
		#arch: c
		#platform: ios
		return (double)((float(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("progress"));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		return (double)((float(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("progress"));
		```
	}

	// Switch between the determinate bar and the barber-pole. Determinate
	// values are kept across the switch; an indeterminate bar animates on
	// its own (no per-frame pump needed).
	pub func set_indeterminate = (self, bool indeterminate) {
		```
		#arch: c
		#platform: macos
		NSProgressIndicator *bar = (NSProgressIndicator *)self->handle;
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			bar, sel_registerName("setIndeterminate:"), indeterminate ? 1 : 0);
		if (indeterminate) {
			((void(*)(id, SEL, BOOL))objc_msgSend)(bar, sel_registerName("setUsesThreadedAnimation:"), 1);
			((void(*)(id, SEL, id))objc_msgSend)(bar, sel_registerName("startAnimation:"), (id)0);
		} else {
			((void(*)(id, SEL, id))objc_msgSend)(bar, sel_registerName("stopAnimation:"), (id)0);
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		NSProgressIndicator *bar = (NSProgressIndicator *)self->handle;
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			bar, sel_registerName("setIndeterminate:"), indeterminate ? 1 : 0);
		if (indeterminate) {
			((void(*)(id, SEL, BOOL))objc_msgSend)(bar, sel_registerName("setUsesThreadedAnimation:"), 1);
			((void(*)(id, SEL, id))objc_msgSend)(bar, sel_registerName("startAnimation:"), (id)0);
		} else {
			((void(*)(id, SEL, id))objc_msgSend)(bar, sel_registerName("stopAnimation:"), (id)0);
		}
		```
		```
		#arch: c
		#platform: ios
		// UIProgressView has no indeterminate mode — the flag is accepted and
		// ignored (iOS apps use a Spinner for unknown-length work).
		(void)indeterminate;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		// UIProgressView has no indeterminate mode — the flag is accepted and
		// ignored (iOS apps use a Spinner for unknown-length work).
		(void)indeterminate;
		```
	}

	pub func is_indeterminate = (self, out bool) {
		```
		#arch: c
		#platform: macos
		BOOL flag = ((BOOL(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("isIndeterminate"));
		return flag ? 1 : 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		BOOL flag = ((BOOL(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("isIndeterminate"));
		return flag ? 1 : 0;
		```
		```
		#arch: c
		#platform: ios
		return 0; // UIProgressView is always determinate
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		return 0; // UIProgressView is always determinate
		```
	}

	pub func set_hidden = (self, bool hidden) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
