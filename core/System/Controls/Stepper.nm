/**
 * A pair of up/down arrows that walk a numeric range
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * Pair with a TextBox for the "number input" composition (gpui-kit's
 * number-input is exactly that pairing).
 **/
pub mv struct Stepper: Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id step = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSStepper"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 20, 24));
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMinValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMaxValue:"), 100.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setIncrement:"), 1.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setDoubleValue:"), 0.0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), step);
		self.handle = (uint64_t)step;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id step = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSStepper"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 20, 24));
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMinValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMaxValue:"), 100.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setIncrement:"), 1.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setDoubleValue:"), 0.0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), step);
		self->handle = (uint64_t)step;
		```
		```
		#arch: c
		#platform: ios
		id step = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIStepper"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 94, 29));
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMinimumValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMaximumValue:"), 100.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setStepValue:"), 1.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setValue:"), 0.0);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), step);
		self.handle = (uint64_t)step;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id step = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIStepper"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 94, 29));
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMinimumValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setMaximumValue:"), 100.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setStepValue:"), 1.0);
		((void(*)(id, SEL, double))objc_msgSend)(step, sel_registerName("setValue:"), 0.0);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), step);
		self->handle = (uint64_t)step;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

