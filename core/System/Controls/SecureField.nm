/**
 * A password field that hides what the user types
 *
 * Read it with `get_text`, and respond to Return with `on_submit`.
 **/
// A distinct native class on both platforms (NSSecureTextField is NOT
// NSTextField), so it lands as its own control rather than a TextBox mode.
pub mv struct SecureField: Control {
	/**
	 * The native platform handle for this control (internal; 0 until it is created).
	 **/
	var uint64 handle = 0

	/**
	 * An empty password field in `window`: typed characters are hidden.
	 **/
	pub func #init = (self, Window window) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id field = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSecureTextField"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 24));
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setEditable:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setSelectable:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setBordered:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setBezeled:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setDrawsBackground:"), 1);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), field);
				// NSTextField (the secure subclass) sends its action on the USER
				// commit (Return) — arm it so on_submit drains fire.
				extern void nomen_control_arm_submits(unsigned long long);
				nomen_control_arm_submits((unsigned long long)field);
				self.handle = (uint64_t)field;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id field = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSecureTextField"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 24));
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setEditable:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setSelectable:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setBordered:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setBezeled:"), 1);
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setDrawsBackground:"), 1);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), field);
				extern void nomen_control_arm_submits(unsigned long long) __asm__("nomen_control_arm_submits");
				nomen_control_arm_submits((unsigned long long)field);
				self->handle = (uint64_t)field;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				id field = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UITextField"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 30));
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setBorderStyle:"), 1); // UITextBorderStyleRoundedRect = 1
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setSecureTextEntry:"), 1);
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), field);
				self.handle = (uint64_t)field;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				id field = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UITextField"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 30));
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setBorderStyle:"), 1); // UITextBorderStyleRoundedRect = 1
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					field, sel_registerName("setSecureTextEntry:"), 1);
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), field);
				self->handle = (uint64_t)field;
			}
		}
	}

	/**
	 * Place the control at (`x`, `y`) with the given size, in points. Layout containers
	 * call this for you (`Control` conformance).
	 **/
	pub func set_frame = (ref self {}, int x, int y, int width, int height) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
	}

	/**
	 * Replace the control's text.
	 **/
	pub func set_text = (self, string text) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setStringValue:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setStringValue:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setText:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setText:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
	}

	/**
	 * Set the hint text shown while the field is empty.
	 **/
	pub func set_placeholder = (self, string text) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setPlaceholderString:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setPlaceholderString:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setPlaceholder:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, id))objc_msgSend)(
					(id)self->handle, sel_registerName("setPlaceholder:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
			}
		}
	}

	/**
	 * The control's current text.
	 **/
	pub func get_text = (self, out string) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id str = ((id(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("stringValue"));
				const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
					str, sel_registerName("UTF8String"));
				return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id str = ((id(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("stringValue"));
				const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
					str, sel_registerName("UTF8String"));
				return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				id str = ((id(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("text"));
				const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
					str, sel_registerName("UTF8String"));
				return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				id str = ((id(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("text"));
				const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
					str, sel_registerName("UTF8String"));
				return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
			}
		}
	}

	/**
	 * Handler hook behind `on_submit`: whether the user pressed Return in the field since
	 * the last poll. Read the text with `get_text()`.
	 **/
	// The on_submit desugar's drain (docs/HANDLERS.md tier 2): true when
	// the user committed this field (Return) since the last drain — the
	// record is consumed, one commit fires an arm exactly once.
	// User-driven only. The handler body reads the committed text through
	// get_text().
	pub func take_submit = (self, out bool) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				extern long nomen_submit_take(unsigned long long);
				return (long)nomen_submit_take((unsigned long long)self->handle);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				extern long nomen_submit_take(unsigned long long);
				return (long)nomen_submit_take((unsigned long long)self->handle);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				return false;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				return false;
			}
		}
	}

	/**
	 * The control's natural size given unlimited space (`Control` conformance).
	 **/
	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	/**
	 * The size the control wants, within `constraints` (`Control` conformance).
	 **/
	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
	}
}
