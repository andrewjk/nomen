/**
 * An on/off switch, for settings
 *
 * Read it with `is_checked`. Use a `CheckBox` for things like tasks and a `Switch` for
 * preferences.
 **/
pub mv struct Switch: Control {
	/**
	 * The native platform handle for this control (internal; 0 until it is created).
	 **/
	var uint64 handle = 0

	/**
	 * An off switch in `window`.
	 **/
	pub func #init = (self, Window window) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id sw = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSwitch"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 40, 22));
				((void(*)(id, SEL, long))objc_msgSend)(
					sw, sel_registerName("setState:"), 0); // NSControlStateValueOff = 0
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), sw);
				self.handle = (uint64_t)sw;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id sw = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSwitch"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 40, 22));
				((void(*)(id, SEL, long))objc_msgSend)(
					sw, sel_registerName("setState:"), 0); // NSControlStateValueOff = 0
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), sw);
				self->handle = (uint64_t)sw;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				id sw = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISwitch"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 51, 31));
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), sw);
				self.handle = (uint64_t)sw;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				id sw = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISwitch"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 51, 31));
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), sw);
				self->handle = (uint64_t)sw;
			}
		}
	}

	/**
	 * Place the control at (`x`, `y`) with the given size, in points. Layout containers
	 * call this for you (`Control` conformance).
	 **/
	pub func set_frame = (ref self {}, int x, int y, int width, int height) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
	}

	/**
	 * Check or uncheck the control.
	 **/
	pub func set_checked = (self, bool checked) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setState:"),
					checked ? 1 : 0); // NSControlStateValueOn = 1, Off = 0
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setState:"),
					checked ? 1 : 0); // NSControlStateValueOn = 1, Off = 0
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setOn:"), checked ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setOn:"), checked ? 1 : 0);
			}
		}
	}

	/**
	 * Whether the control is checked.
	 **/
	pub func is_checked = (self, out bool) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				long state = ((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("state"));
				return state == 1; // NSControlStateValueOn = 1
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				long state = ((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("state"));
				return state == 1; // NSControlStateValueOn = 1
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				BOOL on = ((BOOL(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("isOn"));
				return on ? 1 : 0;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				BOOL on = ((BOOL(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("isOn"));
				return on ? 1 : 0;
			}
		}
	}

	/**
	 * Show or hide the control.
	 **/
	pub func set_hidden = (self, bool hidden) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
	}

	/**
	 * The control's natural size given unlimited space (`Control` conformance).
	 **/
	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	/**
	 * The size the control wants, within `constraints` (`Control` conformance).
	 **/
	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
	}
}
