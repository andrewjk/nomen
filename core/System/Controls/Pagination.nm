/**
 * A page picker: "<" and ">" buttons around up to five numbered page buttons
 *
 * Add it to your grid with `add_to`. Read the current page with `page`, or respond to page
 * changes with `on_page_change`; for that, call `tick` from `App.frame` each frame.
 **/
// PURE COMPOSITION (GUI_PLAN Tier 3 "reachable earlier"): no new native
// control, no drawing — a row of Buttons wired into the caller's grid. The page
// count is fixed at construction (1..5; spare buttons are hidden and skipped by
// the layout's hidden-leaf pass). The composite is its own HANDLER HOST
// (docs/HANDLERS.md Stage 2): #init registers a handler per button and the arms
// keep `current` up to date — the run loop forwards into whatever app field
// hosts the pagination. Changes the app cares about travel UP via the id
// up-call (Stage 3): `on_page_change(id)` enrolls interest, the mutators raise
// the pending flag, and the app forwards itself down once per frame —
// `pag.tick(ref self, ref win)` — for the callback into its `run_handler`.
// Value polling (`page`) remains for apps that don't need the event. Handles
// (`prev_handle`/ `next_handle`/`page_handle`) remain for coordinate
// hit-testing.
pub mv struct Pagination {
	/**
	 * The "<" button.
	 **/
	mv Button prev
	/**
	 * The ">" button.
	 **/
	mv Button next
	/**
	 * The page 1 button.
	 **/
	mv Button b0
	/**
	 * The page 2 button.
	 **/
	mv Button b1
	/**
	 * The page 3 button.
	 **/
	mv Button b2
	/**
	 * The page 4 button.
	 **/
	mv Button b3
	/**
	 * The page 5 button.
	 **/
	mv Button b4
	/**
	 * The number of pages (internal).
	 **/
	var pages = 1
	/**
	 * The current page (internal; read it with `page()`).
	 **/
	var current = 0
	/**
	 * The handler id from `on_page_change`, or -1 (internal).
	 **/
	// The up-call plumbing: the dispatch id the app enrolled (—1 = none)
	// and whether a page change is waiting for the next tick.
	var int page_change_id = -1
	/**
	 * Whether a page change is waiting to be reported (internal).
	 **/
	var page_change_pending = false

	/**
	 * A page picker in `window` with `pages` numbered buttons (1 to 5) between "<" and ">".
	 **/
	pub func #init = (ref self, Window window, int pages: pages > 0 && pages <= 5) {
		self.prev = Button(window, "<")
		self.next = Button(window, ">")
		self.b0 = Button(window, "1")
		self.b1 = Button(window, "2")
		self.b2 = Button(window, "3")
		self.b3 = Button(window, "4")
		self.b4 = Button(window, "5")
		self.pages = pages
		// Spare page buttons stay hidden (the layout skips hidden leaves).
		if pages <= 4 {
			self.b4.set_hidden(true)
		}
		if pages <= 3 {
			self.b3.set_hidden(true)
		}
		if pages <= 2 {
			self.b2.set_hidden(true)
		}
		if pages <= 1 {
			self.b1.set_hidden(true)
		}
		// The row self-drives: one registered handler per button (hidden
		// spares can never be clicked). The closures hoist to hidden methods
		// on Pagination and run with `ref self` — the app's dispatch
		// forwards into the field that hosts the row. No polls to starve.
		self.prev.on_click(func() { self.prev() })
		self.next.on_click(func() { self.next() })
		self.b0.on_click(func() { self.select(0) })
		self.b1.on_click(func() { self.select(1) })
		self.b2.on_click(func() { self.select(2) })
		self.b3.on_click(func() { self.select(3) })
		self.b4.on_click(func() { self.select(4) })
	}

	/**
	 * Add the row of buttons to `grid` under `parent`, spanning `span` cells.
	 **/
	pub func add_to = (ref self {}, ref Container grid { aligns, cols, dirty, dirty_idx, gaps, grows, h_kinds, h_vals, handles, kinds, measured_count, mh, mw, pads, pars, prh, prw, prx, pry, rh, rw, rx, ry, shrinks, spans, w_kinds, w_vals }, int parent, int span) {
		var int hs = grid.add_hstack(parent, 6, span)
		grid.add_to_intrinsic(hs, self.prev.handle, 1)
		grid.add_to_intrinsic(hs, self.b0.handle, 1)
		grid.add_to_intrinsic(hs, self.b1.handle, 1)
		grid.add_to_intrinsic(hs, self.b2.handle, 1)
		grid.add_to_intrinsic(hs, self.b3.handle, 1)
		grid.add_to_intrinsic(hs, self.b4.handle, 1)
		grid.add_to_intrinsic(hs, self.next.handle, 1)
	}

	/**
	 * The native handle of the "<" button, for hit-testing.
	 **/
	pub func prev_handle = (self, out uint64) {
		return self.prev.handle
	}

	/**
	 * The native handle of the ">" button, for hit-testing.
	 **/
	pub func next_handle = (self, out uint64) {
		return self.next.handle
	}

	/**
	 * The native handle of page button `index` (0 if there is none), for hit-testing.
	 **/
	pub func page_handle = (self, int index, out uint64) {
		if index == 0 { return self.b0.handle }
		if index == 1 { return self.b1.handle }
		if index == 2 { return self.b2.handle }
		if index == 3 { return self.b3.handle }
		if index == 4 { return self.b4.handle }
		return 0
	}

	/**
	 * The current page, counting from 0.
	 **/
	pub func page = (self, out int) {
		return self.current
	}

	/**
	 * Go to page `index` (clamped to the pages there are).
	 **/
	pub func select = (ref self {}, int index) {
		var int i = index
		if i < 0 { i = 0 }
		if i > self.pages - 1 { i = self.pages - 1 }
		self.current = i
		self.page_change_pending = true
	}

	/**
	 * Go to the next page, if there is one.
	 **/
	pub func next = (ref self {}) {
		if self.current < self.pages - 1 {
			self.current += 1
			self.page_change_pending = true
		}
	}

	/**
	 * Go to the previous page, if there is one.
	 **/
	pub func prev = (ref self {}) {
		if self.current > 0 {
			self.current -= 1
			self.page_change_pending = true
		}
	}

	/**
	 * Run a handler when the page changes: write `pag.on_page_change(func () { ... })` and
	 * the compiler passes the handler's id here. The app must call `tick` each frame.
	 **/
	pub func on_page_change = (ref self {}, int id) {
		self.page_change_id = id
	}

	/**
	 * Report a pending page change to `owner`'s handler. Call it once per frame from
	 * `App.frame`: `self.pag.tick(ref self, ref win)`.
	 **/
	pub func tick = (ref self {}, ref App owner, ref Window win {}) {
		if self.page_change_pending && self.page_change_id >= 0 {
			owner.run_handler(self.page_change_id, ref win)
		}
		self.page_change_pending = false
	}
}
