/**
 * A dropdown choice control (NSPopUpButton)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * macOS-first: the items live in the native menu, so `selected_index` is
 * polled after each event batch. iOS needs a picker or action sheet and
 * defers (TODO stubs below; see GUI_PLAN Tier 1 #9).
 **/
pub mv struct Select : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id pop = ((id(*)(id, SEL, CGRect, BOOL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSPopUpButton"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:pullsDown:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 140, 26),
			0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), pop);
		// NSPopUpButton sends its action on USER selection only — arm it so
		// on_select drains fire (programmatic selection stays silent).
		extern void nomen_control_arm_selects(unsigned long long);
		nomen_control_arm_selects((unsigned long long)pop);
		self.handle = (uint64_t)pop;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id pop = ((id(*)(id, SEL, CGRect, BOOL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSPopUpButton"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:pullsDown:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 140, 26),
			0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), pop);
		extern void nomen_control_arm_selects(unsigned long long) __asm__("nomen_control_arm_selects");
		nomen_control_arm_selects((unsigned long long)pop);
		self->handle = (uint64_t)pop;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS — needs a picker or action sheet presentation (see
		 * GUI_PLAN Tier 1 #9; defer the iOS block). */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS — needs a picker or action sheet presentation (see
		 * GUI_PLAN Tier 1 #9; defer the iOS block). */
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	// Append a choice to the menu. The first item added becomes selected.
	pub func add_item = (self, string title) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("addItemWithTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("addItemWithTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	pub func clear_items = (self) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("removeAllItems"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("removeAllItems"));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	pub func select_index = (self, int index) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("selectItemAtIndex:"), (long)index);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("selectItemAtIndex:"), (long)index);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	// The selected item's position, or -1 when nothing is selected.
	pub func selected_index = (self, out int) {
		```
		#arch: c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("indexOfSelectedItem"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("indexOfSelectedItem"));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return -1;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return -1;
		```
	}

	// The on_select desugar's drain (docs/HANDLERS.md): true when the user
	// selected an item since the last drain (the record is consumed).
	// User-driven only — AppKit sends the popup's action for user picks,
	// not for programmatic ones. The handler body reads the item through
	// selected_index().
	pub func take_select = (self, out bool) {
		```
		#arch: c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
	}

	pub func count = (self, out int) {
		```
		#arch: c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("numberOfItems"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("numberOfItems"));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
	}

	pub func set_hidden = (self, bool hidden) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}
}
