/**
 * A browsable date picker (year/month/day)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * The value travels as epoch seconds (UTC) — an absolute time, so the
 * platform's display timezone is irrelevant to the round trip. The default
 * macOS style is TextFieldAndStepper (a compact one-line picker): the
 * ClockAndCalendar style renders as a ~148px-tall inline calendar on modern
 * macOS, which no row-height layout can host. A browsable calendar GRID as a
 * layout widget is Tier 3; this is the native picker.
 **/
pub mv struct DatePicker: Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id dp = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSDatePicker"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 140, 32));
		((void(*)(id, SEL, long))objc_msgSend)(
			dp, sel_registerName("setDatePickerStyle:"), 0); // NSDatePickerStyleTextFieldAndStepper = 0
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			dp, sel_registerName("setDatePickerElements:"), 0x1cUL); // Year|Month|Day
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), dp);
		self.handle = (uint64_t)dp;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id dp = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSDatePicker"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 140, 32));
		((void(*)(id, SEL, long))objc_msgSend)(
			dp, sel_registerName("setDatePickerStyle:"), 0); // NSDatePickerStyleTextFieldAndStepper = 0
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			dp, sel_registerName("setDatePickerElements:"), 0x1cUL); // Year|Month|Day
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), dp);
		self->handle = (uint64_t)dp;
		```
		```
		#arch: c
		#platform: ios
		id dp = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIDatePicker"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 120));
		((void(*)(id, SEL, long))objc_msgSend)(
			dp, sel_registerName("setDatePickerMode:"), 1); // UIDatePickerModeDate = 1
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), dp);
		self.handle = (uint64_t)dp;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id dp = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIDatePicker"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 120));
		((void(*)(id, SEL, long))objc_msgSend)(
			dp, sel_registerName("setDatePickerMode:"), 1); // UIDatePickerModeDate = 1
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), dp);
		self->handle = (uint64_t)dp;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	// Set the picker to an absolute time (epoch seconds, UTC).
	pub func set_time = (self, int64 seconds) {
		```
		#arch: c
		#platform: macos
		id date = ((id(*)(id, SEL, double))objc_msgSend)(
			(id)objc_getClass("NSDate"), sel_registerName("dateWithTimeIntervalSince1970:"), (double)seconds);
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setDateValue:"), date);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id date = ((id(*)(id, SEL, double))objc_msgSend)(
			(id)objc_getClass("NSDate"), sel_registerName("dateWithTimeIntervalSince1970:"), (double)seconds);
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setDateValue:"), date);
		```
		```
		#arch: c
		#platform: ios
		id date = ((id(*)(id, SEL, double))objc_msgSend)(
			(id)objc_getClass("NSDate"), sel_registerName("dateWithTimeIntervalSince1970:"), (double)seconds);
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setDate:"), date);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id date = ((id(*)(id, SEL, double))objc_msgSend)(
			(id)objc_getClass("NSDate"), sel_registerName("dateWithTimeIntervalSince1970:"), (double)seconds);
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setDate:"), date);
		```
	}

	// The picker's current value as epoch seconds (UTC).
	pub func time = (self, out int64) {
		```
		#arch: c
		#platform: macos
		id date = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("dateValue"));
		double since = ((double(*)(id, SEL))objc_msgSend)(
			date, sel_registerName("timeIntervalSince1970"));
		return (long long)since;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id date = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("dateValue"));
		double since = ((double(*)(id, SEL))objc_msgSend)(
			date, sel_registerName("timeIntervalSince1970"));
		return (long long)since;
		```
		```
		#arch: c
		#platform: ios
		id date = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("date"));
		double since = ((double(*)(id, SEL))objc_msgSend)(
			date, sel_registerName("timeIntervalSince1970"));
		return (long long)since;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id date = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("date"));
		double since = ((double(*)(id, SEL))objc_msgSend)(
			date, sel_registerName("timeIntervalSince1970"));
		return (long long)since;
		```
	}

	pub func set_hidden = (self, bool hidden) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
	}

	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
	}
}
