		```
		```
		#arch: c
		#platform: ios
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("selectedSegmentIndex"));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("selectedSegmentIndex"));
		```
	}

	// The on_select desugar's drain (docs/HANDLERS.md): true when the user
	// clicked a segment since the last drain (the record is consumed).
	// User-driven only — AppKit sends the control's action for user clicks,
	// not for programmatic setSelectedSegment. The handler body reads the
	// segment through selected_index().
	pub func take_select = (self, out bool) {
		```
		#arch: c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->handle);
		```
		```
		#arch: c
		#platform: ios
		return 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		return 0;
		```
	}

