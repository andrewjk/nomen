/**
 * A row of buttons where exactly one is selected
 *
 * The number of segments is set when it is created. Label them with `set_label`, and read
 * the selection with `selected_index` or respond to it with `on_select`.
 **/
// The segment count is fixed at construction; labels and the selection are
// set/poll per frame like every other control.
pub mv struct Segmented: Control {
	/**
	 * The control's native handle: pass it to `Container` methods such as `add` to lay the
	 * control out, and to `contains` to hit-test it (0 until the control is created).
	 **/
	var uint64 handle = 0

	/**
	 * A segmented control with `count` segments in `window`. Label them with `set_label`.
	 **/
	pub func #init = (self, Window window, int count) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSegmentedControl"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 24));
				((void(*)(id, SEL, long))objc_msgSend)(
					seg, sel_registerName("setSegmentCount:"), (long)count);
				((void(*)(id, SEL, long))objc_msgSend)(
					seg, sel_registerName("setSelectedSegment:"), 0);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), seg);
				// NSSegmentedControl sends its action on USER segment clicks — arm
				// it so on_select drains fire (programmatic setSelectedSegment
				// stays silent).
				extern void nomen_control_arm_selects(unsigned long long);
				nomen_control_arm_selects((unsigned long long)seg);
				self.handle = (uint64_t)seg;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSegmentedControl"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 24));
				((void(*)(id, SEL, long))objc_msgSend)(
					seg, sel_registerName("setSegmentCount:"), (long)count);
				((void(*)(id, SEL, long))objc_msgSend)(
					seg, sel_registerName("setSelectedSegment:"), 0);
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), seg);
				extern void nomen_control_arm_selects(unsigned long long) __asm__("nomen_control_arm_selects");
				nomen_control_arm_selects((unsigned long long)seg);
				self->handle = (uint64_t)seg;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISegmentedControl"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 32));
				// UISegmentedControl grows by insertion (no setSegmentCount:); fill it
				// with empty titled segments so indices line up with the macOS API.
				for (long i = 0; i < (long)count; i++) {
					((void(*)(id, SEL, id, long, BOOL))objc_msgSend)(
						seg, sel_registerName("insertSegmentWithTitle:atIndex:animated:"),
						((id(*)(id, SEL, const char*))objc_msgSend)(
							(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""),
						i, 0);
				}
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), seg);
				self.handle = (uint64_t)seg;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISegmentedControl"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 32));
				// UISegmentedControl grows by insertion (no setSegmentCount:); fill it
				// with empty titled segments so indices line up with the macOS API.
				for (long i = 0; i < (long)count; i++) {
					((void(*)(id, SEL, id, long, BOOL))objc_msgSend)(
						seg, sel_registerName("insertSegmentWithTitle:atIndex:animated:"),
						((id(*)(id, SEL, const char*))objc_msgSend)(
							(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""),
						i, 0);
				}
				id parentView = ((id(*)(id, SEL))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)window->handle, sel_registerName("rootViewController")),
					sel_registerName("view"));
				((void(*)(id, SEL, id))objc_msgSend)(
					parentView, sel_registerName("addSubview:"), seg);
				self->handle = (uint64_t)seg;
			}
		}
	}

	/**
	 * Place the control at (`x`, `y`) with the given size, in points. Layout containers
	 * call this for you (`Control` conformance).
	 **/
	pub func set_frame = (ref self {}, int x, int y, int width, int height) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, CGRect))objc_msgSend)(
					(id)self->handle, sel_registerName("setFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
			}
		}
	}

	/**
	 * Set the label of segment `index`.
	 **/
	pub func set_label = (self, int index, string title) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, id, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setLabel:forSegment:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
					(long)index);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, id, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setLabel:forSegment:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
					(long)index);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, id, unsigned long))objc_msgSend)(
					(id)self->handle, sel_registerName("setTitle:forSegmentAtIndex:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
					(unsigned long)index);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, id, unsigned long))objc_msgSend)(
					(id)self->handle, sel_registerName("setTitle:forSegmentAtIndex:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
					(unsigned long)index);
			}
		}
	}

	/**
	 * Select segment `index`.
	 **/
	pub func set_selected = (self, int index) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setSelectedSegment:"), (long)index);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setSelectedSegment:"), (long)index);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setSelectedSegmentIndex:"), (long)index);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, long))objc_msgSend)(
					(id)self->handle, sel_registerName("setSelectedSegmentIndex:"), (long)index);
			}
		}
	}

	/**
	 * The selected segment's index, or -1 when none is selected.
	 **/
	pub func selected_index = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("selectedSegment"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("selectedSegment"));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("selectedSegmentIndex"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("selectedSegmentIndex"));
			}
		}
	}

	/**
	 * Handler hook behind `on_select`: whether the selection changed since the last poll.
	 * Read the new selection from the control.
	 **/
	// The on_select desugar's drain (docs/HANDLERS.md): true when the user
	// clicked a segment since the last drain (the record is consumed).
	// User-driven only — AppKit sends the control's action for user clicks,
	// not for programmatic setSelectedSegment. The handler body reads the
	// segment through selected_index().
	pub func take_select = (self, out bool) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				extern long nomen_select_take(unsigned long long);
				return (long)nomen_select_take((unsigned long long)self->handle);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				extern long nomen_select_take(unsigned long long);
				return (long)nomen_select_take((unsigned long long)self->handle);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				return 0;
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				return 0;
			}
		}
	}

	/**
	 * The number of segments.
	 **/
	pub func count = (self, out int) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("segmentCount"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("segmentCount"));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("numberOfSegments"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				return (int)((long(*)(id, SEL))objc_msgSend)(
					(id)self->handle, sel_registerName("numberOfSegments"));
			}
		}
	}

	/**
	 * Show or hide the control.
	 **/
	pub func set_hidden = (self, bool hidden) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				((void(*)(id, SEL, BOOL))objc_msgSend)(
					(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
			}
		}
	}

	/**
	 * The control's natural size given unlimited space (`Control` conformance).
	 **/
	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	/**
	 * The size the control wants, within `constraints` (`Control` conformance).
	 **/
	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = (self) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				if (self->handle) {
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
					((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
					self->handle = 0;
				}
			}
		}
	}
}
