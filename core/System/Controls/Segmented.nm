		```
	}

	// The selected segment's index, or -1 when nothing is selected.
	pub func selected_index = (self, out int) {
		```
		#arch: c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("selectedSegment"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
