/**
 * A row of mutually exclusive segment buttons
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * The segment count is fixed at construction; labels and the selection are
 * set/poll per frame like every other control.
 **/
pub mv struct Segmented : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window, int count) {
		```
		#arch: c
		#platform: macos
		id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSegmentedControl"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 24));
		((void(*)(id, SEL, long))objc_msgSend)(
			seg, sel_registerName("setSegmentCount:"), (long)count);
		((void(*)(id, SEL, long))objc_msgSend)(
			seg, sel_registerName("setSelectedSegment:"), 0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), seg);
		// NSSegmentedControl sends its action on USER segment clicks — arm
		// it so on_select drains fire (programmatic setSelectedSegment
		// stays silent).
		extern void nomen_control_arm_selects(unsigned long long);
		nomen_control_arm_selects((unsigned long long)seg);
		self.handle = (uint64_t)seg;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSegmentedControl"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 24));
		((void(*)(id, SEL, long))objc_msgSend)(
			seg, sel_registerName("setSegmentCount:"), (long)count);
		((void(*)(id, SEL, long))objc_msgSend)(
			seg, sel_registerName("setSelectedSegment:"), 0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), seg);
		extern void nomen_control_arm_selects(unsigned long long) __asm__("nomen_control_arm_selects");
		nomen_control_arm_selects((unsigned long long)seg);
		self->handle = (uint64_t)seg;
		```
		```
		#arch: c
		#platform: ios
		id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISegmentedControl"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 32));
		// UISegmentedControl grows by insertion (no setSegmentCount:); fill it
		// with empty titled segments so indices line up with the macOS API.
		for (long i = 0; i < (long)count; i++) {
			((void(*)(id, SEL, id, long, BOOL))objc_msgSend)(
				seg, sel_registerName("insertSegmentWithTitle:atIndex:animated:"),
				((id(*)(id, SEL, const char*))objc_msgSend)(
					(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""),
				i, 0);
		}
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), seg);
		self.handle = (uint64_t)seg;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id seg = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UISegmentedControl"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 32));
		// UISegmentedControl grows by insertion (no setSegmentCount:); fill it
		// with empty titled segments so indices line up with the macOS API.
		for (long i = 0; i < (long)count; i++) {
			((void(*)(id, SEL, id, long, BOOL))objc_msgSend)(
				seg, sel_registerName("insertSegmentWithTitle:atIndex:animated:"),
				((id(*)(id, SEL, const char*))objc_msgSend)(
					(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""),
				i, 0);
		}
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), seg);
		self->handle = (uint64_t)seg;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	pub func set_label = (self, int index, string title) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setLabel:forSegment:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			(long)index);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setLabel:forSegment:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			(long)index);
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, id, unsigned long))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:forSegmentAtIndex:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			(unsigned long)index);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, id, unsigned long))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:forSegmentAtIndex:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			(unsigned long)index);
		```
	}

	pub func set_selected = (self, int index) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setSelectedSegment:"), (long)index);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setSelectedSegment:"), (long)index);
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setSelectedSegmentIndex:"), (long)index);
