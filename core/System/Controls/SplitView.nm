	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

