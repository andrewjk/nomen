	/**
	 * Move divider number `divider` to `position` points: for a vertical split, the left
	 * edge of the pane after it, measured from the left.
	 **/
	pub func set_position = (ref self {}, float position, int divider) {
		#if META.arch == "c" && META.platform == "macos" {
