/**
 * Side-by-side or stacked panes with draggable dividers between them
 *
 * The number of panes and the direction are set when it is created. Put controls in a pane
 * with `content_window(index)` as their window and a grid of the pane's own, registered
 * with `grid.set_pane(...)` so it is laid out again when the panes resize. Move a divider
 * with `set_position`. macOS only.
 **/
// The pane count and divider orientation are fixed at construction. Each pane
// hosts controls on its own view: `content_window(index)` hands back a
// Window-shaped value whose `contentView` is the pane view itself (the
// `-contentView`-answers-self trick — see Scrollable), so control constructors
// and `Container.layout` target a pane unchanged. NSSplitView owns the pane
// geometry: when the split view is framed (or the user drags a divider) AppKit
// resizes the pane views synchronously, so re-run the pane layouts after
// re-framing — registrable pane roots (`Container.set_pane`) put that on the
// run loop. A shared delegate holds every divider at its current position
// across re-frames (the AppKit default re-divides panes equally), so a
// programmatic divider position set with `set_position` (read with `position`)
// stays put. iOS defers to UISplitViewController (a view-controller-level type
// — see GUI_PLAN Tier 2; the iOS blocks are TODO stubs).
pub mv struct SplitView: Control {
	/**
	 * The control's native handle: pass it to `Container` methods such as `add` to lay the
	 * control out, and to `contains` to hit-test it (0 until the control is created).
	 **/
	var uint64 handle = 0

	/**
	 * A split view in `window` with `count` resizable panes, side by side when `vertical`
	 * is set and stacked otherwise.
	 **/
	// File-scope helper: the pane view class (answers `-contentView` with
	// `self`; registered once, like NomenResizeDelegate).
	pub func #init = (self, Window window, int count: count > 0, bool vertical) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw("file") {
				static id nomen_pane_content_view(id self, SEL cmd) {
					(void)cmd;
					return self;
				}
				static id nomen_pane_class(void) {
					Class Pv = objc_getClass("NomenSplitPaneView");
					if (!Pv) {
						Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenSplitPaneView", 0);
						if (Pv) {
							class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_pane_content_view, "@@:");
							objc_registerClassPair(Pv);
						}
					}
					return Pv;
				}

				// The delegate's resize-subviews hook: keep every divider at its
				// CURRENT position — panes 0..n-2 keep their sizes, the LAST pane
				// absorbs the delta. Without it NSSplitView's default adjustSubviews
				// re-divides the panes equally on every re-frame (window resizes
				// included), so a programmatic set_position drifts back; with it the
				// divider is pinned where the app left it. One shared delegate
				// serves every split view: the hook derives everything from the
				// passed view. AXIS NOTE: isVertical YES means the DIVIDER is
				// vertical, so the panes sit side by side and advance along X
				// (left|right); a horizontal split stacks along Y. Kept sizes are
				// clamped to the room left in the bounds, so the frames always
				// tile exactly (AppKit validates the tiling and warns when a
				// delegate leaves the panes out of bounds or overlapping).
				static void nomen_split_resize_panes(id self, SEL cmd, id sv, NSSize oldSize) {
					(void)self; (void)cmd; (void)oldSize;
					id subviews = ((id(*)(id, SEL))objc_msgSend)(sv, sel_registerName("subviews"));
					long n = ((long(*)(id, SEL))objc_msgSend)(subviews, sel_registerName("count"));
					if (n < 1) return;
					CGRect bounds = ((CGRect(*)(id, SEL))objc_msgSend)(sv, sel_registerName("bounds"));
					BOOL vertical = ((BOOL(*)(id, SEL))objc_msgSend)(sv, sel_registerName("isVertical"));
					double thickness = ((double(*)(id, SEL))objc_msgSend)(sv, sel_registerName("dividerThickness"));
					// Panes advance along `extent` and every pane spans `cross`.
					double extent = vertical ? bounds.size.width : bounds.size.height;
					double cross = vertical ? bounds.size.height : bounds.size.width;
					double cursor = 0;
					for (long i = 0; i < n; i++) {
						id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
							subviews, sel_registerName("objectAtIndex:"), (unsigned long)i);
						CGRect f = ((CGRect(*)(id, SEL))objc_msgSend)(pane, sel_registerName("frame"));
						double size;
						if (i < n - 1) {
							size = vertical ? f.size.width : f.size.height;
							// Clamp: later panes keep at least their dividers' room,
							// so the kept sizes can never overflow the bounds.
							double room = extent - cursor - (n - 1 - i) * thickness;
							if (size > room) size = room;
						} else {
							size = extent - cursor;
						}
						if (size < 0) size = 0;
						CGRect nf = vertical
							? CGRectMake(cursor, 0, size, cross)
							: CGRectMake(0, cursor, cross, size);
						((void(*)(id, SEL, CGRect))objc_msgSend)(pane, sel_registerName("setFrame:"), nf);
						cursor += size + thickness;
					}
				}
				static id g_split_delegate = 0;
				static id nomen_split_delegate(void) {
					Class Sd = objc_getClass("NomenSplitDelegate");
					if (!Sd) {
						Sd = objc_allocateClassPair(objc_getClass("NSObject"), "NomenSplitDelegate", 0);
						if (Sd) {
							class_addMethod(Sd, sel_registerName("splitView:resizeSubviewsWithOldSize:"),
								(IMP)nomen_split_resize_panes, "v@:@@{NSSize=dd}");
							objc_registerClassPair(Sd);
						}
					}
					if (!g_split_delegate) {
						g_split_delegate = ((id(*)(id, SEL))objc_msgSend)(Sd, sel_registerName("new"));
					}
					return g_split_delegate;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c", "file") {
				static id nomen_pane_content_view(id self, SEL cmd) {
					(void)cmd;
					return self;
				}
				static id nomen_pane_class(void) {
					Class Pv = objc_getClass("NomenSplitPaneView");
					if (!Pv) {
						Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenSplitPaneView", 0);
						if (Pv) {
							class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_pane_content_view, "@@:");
							objc_registerClassPair(Pv);
						}
					}
					return Pv;
				}

				// The delegate's resize-subviews hook (see the c twin above — note
				// the axis: isVertical YES means panes advance along X).
				static void nomen_split_resize_panes(id self, SEL cmd, id sv, NSSize oldSize) {
					(void)self; (void)cmd; (void)oldSize;
					id subviews = ((id(*)(id, SEL))objc_msgSend)(sv, sel_registerName("subviews"));
					long n = ((long(*)(id, SEL))objc_msgSend)(subviews, sel_registerName("count"));
					if (n < 1) return;
					CGRect bounds = ((CGRect(*)(id, SEL))objc_msgSend)(sv, sel_registerName("bounds"));
					BOOL vertical = ((BOOL(*)(id, SEL))objc_msgSend)(sv, sel_registerName("isVertical"));
					double thickness = ((double(*)(id, SEL))objc_msgSend)(sv, sel_registerName("dividerThickness"));
					// Panes advance along `extent` and every pane spans `cross`.
					double extent = vertical ? bounds.size.width : bounds.size.height;
					double cross = vertical ? bounds.size.height : bounds.size.width;
					double cursor = 0;
					for (long i = 0; i < n; i++) {
						id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
							subviews, sel_registerName("objectAtIndex:"), (unsigned long)i);
						CGRect f = ((CGRect(*)(id, SEL))objc_msgSend)(pane, sel_registerName("frame"));
						double size;
						if (i < n - 1) {
							size = vertical ? f.size.width : f.size.height;
							// Clamp: later panes keep at least their dividers' room,
							// so the kept sizes can never overflow the bounds.
							double room = extent - cursor - (n - 1 - i) * thickness;
							if (size > room) size = room;
						} else {
							size = extent - cursor;
						}
						if (size < 0) size = 0;
						CGRect nf = vertical
							? CGRectMake(cursor, 0, size, cross)
							: CGRectMake(0, cursor, cross, size);
						((void(*)(id, SEL, CGRect))objc_msgSend)(pane, sel_registerName("setFrame:"), nf);
						cursor += size + thickness;
					}
				}
				static id g_split_delegate = 0;
				static id nomen_split_delegate(void) {
					Class Sd = objc_getClass("NomenSplitDelegate");
					if (!Sd) {
						Sd = objc_allocateClassPair(objc_getClass("NSObject"), "NomenSplitDelegate", 0);
						if (Sd) {
							class_addMethod(Sd, sel_registerName("splitView:resizeSubviewsWithOldSize:"),
								(IMP)nomen_split_resize_panes, "v@:@@{NSSize=dd}");
							objc_registerClassPair(Sd);
						}
					}
					if (!g_split_delegate) {
						g_split_delegate = ((id(*)(id, SEL))objc_msgSend)(Sd, sel_registerName("new"));
					}
					return g_split_delegate;
				}
			}
		}
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id sv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSplitView"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 160));
				((void(*)(id, SEL, BOOL))objc_msgSend)(sv, sel_registerName("setVertical:"), vertical ? 1 : 0);
				for (long i = 0; i < (long)count; i++) {
					id pane = ((id(*)(id, SEL, CGRect))objc_msgSend)(
						((id(*)(id, SEL))objc_msgSend)(nomen_pane_class(), sel_registerName("alloc")),
						sel_registerName("initWithFrame:"),
						((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 10, 10));
					((void(*)(id, SEL, id))objc_msgSend)(sv, sel_registerName("addSubview:"), pane);
				}
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), sv);
				// Hold the dividers across re-frames (see the delegate above): the
				// pane pass (Container.set_pane / Window.relayout) can then rely on
				// the pane frames AppKit just adjusted, and a set_position pin holds
				// without the app re-pinning on every resize.
				((void(*)(id, SEL, id))objc_msgSend)(
					sv, sel_registerName("setDelegate:"), nomen_split_delegate());
				self.handle = (uint64_t)sv;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id sv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSplitView"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 160));
				((void(*)(id, SEL, BOOL))objc_msgSend)(sv, sel_registerName("setVertical:"), vertical ? 1 : 0);
				for (long i = 0; i < (long)count; i++) {
					id pane = ((id(*)(id, SEL, CGRect))objc_msgSend)(
						((id(*)(id, SEL))objc_msgSend)(nomen_pane_class(), sel_registerName("alloc")),
						sel_registerName("initWithFrame:"),
						((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 10, 10));
					((void(*)(id, SEL, id))objc_msgSend)(sv, sel_registerName("addSubview:"), pane);
				}
				id contentView = ((id(*)(id, SEL))objc_msgSend)(
					(id)window->handle, sel_registerName("contentView"));
				((void(*)(id, SEL, id))objc_msgSend)(
					contentView, sel_registerName("addSubview:"), sv);
				((void(*)(id, SEL, id))objc_msgSend)(
					sv, sel_registerName("setDelegate:"), nomen_split_delegate());
				self->handle = (uint64_t)sv;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS — UISplitViewController is view-controller-level, not an
				 * embeddable control (see GUI_PLAN Tier 2; defer). */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * A `Window` handle for pane `index`: pass it to control constructors and
	 * `Container.layout` to put controls in that pane. Keep the split view alive at least
	 * as long as the handle.
	 **/
	// The value retains the pane view (+1), so its scope-exit `#destroy` releases its
	// OWN reference and the SplitView's stays balanced.
	pub func content_window = (self, int index, out Window) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				id subviews = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("subviews"));
				id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
					subviews, sel_registerName("objectAtIndex:"), (unsigned long)index);
				extern void *_Window_traits[];
				struct Window w;
				w._vt = (void *)&_Window_traits;
				w.handle = (uint64_t)pane;
				((id(*)(id, SEL))objc_msgSend)(pane, sel_registerName("retain"));
				return w;
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				id subviews = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("subviews"));
				id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
					subviews, sel_registerName("objectAtIndex:"), (unsigned long)index);
				extern void *Window_traits;
				struct Window w;
				w._vt = (void *)&Window_traits;
				w.handle = (uint64_t)pane;
				((id(*)(id, SEL))objc_msgSend)(pane, sel_registerName("retain"));
				return w;
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
				{
					extern void *_Window_traits[];
					struct Window w;
					w._vt = (void *)&_Window_traits;
					w.handle = 0;
					return w;
				}
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
				{
					extern void *Window_traits;
					struct Window w;
					w._vt = (void *)&Window_traits;
					w.handle = 0;
					return w;
				}
			}
		}
	}

