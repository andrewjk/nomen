/**
 * A resizable multi-pane container (NSSplitView)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * The pane count and divider orientation are fixed at construction. Each
 * pane hosts controls on its own view: `content_window(index)` hands back a
 * Window-shaped value whose `contentView` is the pane view itself (the
 * `-contentView`-answers-self trick — see Scrollable), so control
 * constructors and `Container.layout` target a pane unchanged. NSSplitView
 * owns the pane geometry: when the split view is framed (or the user drags
 * a divider) AppKit resizes the pane views synchronously, so re-run the
 * pane layouts after re-framing — registrable pane roots
 * (`Container.set_pane`) put that on the run loop. A shared delegate holds
 * every divider at its current position across re-frames (the AppKit
 * default re-divides panes equally), so a programmatic divider position set
 * with `set_position` (read with `position`) stays put. iOS defers to
 * UISplitViewController (a view-controller-level type — see GUI_PLAN
 * Tier 2; the iOS blocks are TODO stubs).
 **/
pub mv struct SplitView : Control {
	var uint64 handle = 0

	// File-scope helper: the pane view class (answers `-contentView` with
	// `self`; registered once, like NomenResizeDelegate).
	pub func #init = (self, Window window, int count: count > 0, bool vertical) {
		```
		#arch: c
		#platform: macos
		#scope: file
		static id nomen_pane_content_view(id self, SEL cmd) {
			(void)cmd;
			return self;
		}
		static id nomen_pane_class(void) {
			Class Pv = objc_getClass("NomenSplitPaneView");
			if (!Pv) {
				Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenSplitPaneView", 0);
				if (Pv) {
					class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_pane_content_view, "@@:");
					objc_registerClassPair(Pv);
				}
			}
			return Pv;
		}

		// The delegate's resize-subviews hook: keep every divider at its
		// CURRENT position — panes 0..n-2 keep their sizes, the LAST pane
		// absorbs the delta. Without it NSSplitView's default adjustSubviews
		// re-divides the panes equally on every re-frame (window resizes
		// included), so a programmatic set_position drifts back; with it the
		// divider is pinned where the app left it. One shared delegate
		// serves every split view: the hook derives everything from the
		// passed view.
		static void nomen_split_resize_panes(id self, SEL cmd, id sv, NSSize oldSize) {
			(void)self; (void)cmd; (void)oldSize;
			id subviews = ((id(*)(id, SEL))objc_msgSend)(sv, sel_registerName("subviews"));
			long n = ((long(*)(id, SEL))objc_msgSend)(subviews, sel_registerName("count"));
			if (n < 1) return;
			CGRect bounds = ((CGRect(*)(id, SEL))objc_msgSend)(sv, sel_registerName("bounds"));
			BOOL vertical = ((BOOL(*)(id, SEL))objc_msgSend)(sv, sel_registerName("isVertical"));
			double thickness = ((double(*)(id, SEL))objc_msgSend)(sv, sel_registerName("dividerThickness"));
			double cross = vertical ? bounds.size.width : bounds.size.height;
			double extent = vertical ? bounds.size.height : bounds.size.width;
			double cursor = 0;
			for (long i = 0; i < n; i++) {
				id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
					subviews, sel_registerName("objectAtIndex:"), (unsigned long)i);
				CGRect f = ((CGRect(*)(id, SEL))objc_msgSend)(pane, sel_registerName("frame"));
				double size = (i < n - 1)
					? (vertical ? f.size.height : f.size.width)
					: (extent - cursor);
				CGRect nf = vertical ? CGRectMake(0, cursor, cross, size)
					: CGRectMake(cursor, 0, size, cross);
				((void(*)(id, SEL, CGRect))objc_msgSend)(pane, sel_registerName("setFrame:"), nf);
				cursor = (vertical ? nf.origin.y + nf.size.height : nf.origin.x + nf.size.width)
					+ thickness;
			}
		}
		static id g_split_delegate = 0;
		static id nomen_split_delegate(void) {
			Class Sd = objc_getClass("NomenSplitDelegate");
			if (!Sd) {
				Sd = objc_allocateClassPair(objc_getClass("NSObject"), "NomenSplitDelegate", 0);
				if (Sd) {
					class_addMethod(Sd, sel_registerName("splitView:resizeSubviewsWithOldSize:"),
						(IMP)nomen_split_resize_panes, "v@:@@{NSSize=dd}");
					objc_registerClassPair(Sd);
				}
			}
			if (!g_split_delegate) {
				g_split_delegate = ((id(*)(id, SEL))objc_msgSend)(Sd, sel_registerName("new"));
			}
			return g_split_delegate;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		#scope: file
		static id nomen_pane_content_view(id self, SEL cmd) {
			(void)cmd;
			return self;
		}
		static id nomen_pane_class(void) {
			Class Pv = objc_getClass("NomenSplitPaneView");
			if (!Pv) {
				Pv = objc_allocateClassPair(objc_getClass("NSView"), "NomenSplitPaneView", 0);
				if (Pv) {
					class_addMethod(Pv, sel_registerName("contentView"), (IMP)nomen_pane_content_view, "@@:");
					objc_registerClassPair(Pv);
				}
			}
			return Pv;
		}

		// The delegate's resize-subviews hook (see the c twin above).
		static void nomen_split_resize_panes(id self, SEL cmd, id sv, NSSize oldSize) {
			(void)self; (void)cmd; (void)oldSize;
			id subviews = ((id(*)(id, SEL))objc_msgSend)(sv, sel_registerName("subviews"));
			long n = ((long(*)(id, SEL))objc_msgSend)(subviews, sel_registerName("count"));
			if (n < 1) return;
			CGRect bounds = ((CGRect(*)(id, SEL))objc_msgSend)(sv, sel_registerName("bounds"));
			BOOL vertical = ((BOOL(*)(id, SEL))objc_msgSend)(sv, sel_registerName("isVertical"));
			double thickness = ((double(*)(id, SEL))objc_msgSend)(sv, sel_registerName("dividerThickness"));
			double cross = vertical ? bounds.size.width : bounds.size.height;
			double extent = vertical ? bounds.size.height : bounds.size.width;
			double cursor = 0;
			for (long i = 0; i < n; i++) {
				id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
					subviews, sel_registerName("objectAtIndex:"), (unsigned long)i);
				CGRect f = ((CGRect(*)(id, SEL))objc_msgSend)(pane, sel_registerName("frame"));
				double size = (i < n - 1)
					? (vertical ? f.size.height : f.size.width)
					: (extent - cursor);
				CGRect nf = vertical ? CGRectMake(0, cursor, cross, size)
					: CGRectMake(cursor, 0, size, cross);
				((void(*)(id, SEL, CGRect))objc_msgSend)(pane, sel_registerName("setFrame:"), nf);
				cursor = (vertical ? nf.origin.y + nf.size.height : nf.origin.x + nf.size.width)
					+ thickness;
			}
		}
		static id g_split_delegate = 0;
		static id nomen_split_delegate(void) {
			Class Sd = objc_getClass("NomenSplitDelegate");
			if (!Sd) {
				Sd = objc_allocateClassPair(objc_getClass("NSObject"), "NomenSplitDelegate", 0);
				if (Sd) {
					class_addMethod(Sd, sel_registerName("splitView:resizeSubviewsWithOldSize:"),
						(IMP)nomen_split_resize_panes, "v@:@@{NSSize=dd}");
					objc_registerClassPair(Sd);
				}
			}
			if (!g_split_delegate) {
				g_split_delegate = ((id(*)(id, SEL))objc_msgSend)(Sd, sel_registerName("new"));
			}
			return g_split_delegate;
		}
		```
		```
		#arch: c
		#platform: macos
		id sv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSplitView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 160));
		((void(*)(id, SEL, BOOL))objc_msgSend)(sv, sel_registerName("setVertical:"), vertical ? 1 : 0);
		for (long i = 0; i < (long)count; i++) {
			id pane = ((id(*)(id, SEL, CGRect))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)(nomen_pane_class(), sel_registerName("alloc")),
				sel_registerName("initWithFrame:"),
				((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 10, 10));
			((void(*)(id, SEL, id))objc_msgSend)(sv, sel_registerName("addSubview:"), pane);
		}
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), sv);
		// Hold the dividers across re-frames (see the delegate above): the
		// pane pass (Container.set_pane / Window.relayout) can then rely on
		// the pane frames AppKit just adjusted, and a set_position pin holds
		// without the app re-pinning on every resize.
		((void(*)(id, SEL, id))objc_msgSend)(
			sv, sel_registerName("setDelegate:"), nomen_split_delegate());
		self.handle = (uint64_t)sv;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id sv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSSplitView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 300, 160));
		((void(*)(id, SEL, BOOL))objc_msgSend)(sv, sel_registerName("setVertical:"), vertical ? 1 : 0);
		for (long i = 0; i < (long)count; i++) {
			id pane = ((id(*)(id, SEL, CGRect))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)(nomen_pane_class(), sel_registerName("alloc")),
				sel_registerName("initWithFrame:"),
				((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 10, 10));
			((void(*)(id, SEL, id))objc_msgSend)(sv, sel_registerName("addSubview:"), pane);
		}
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), sv);
		((void(*)(id, SEL, id))objc_msgSend)(
			sv, sel_registerName("setDelegate:"), nomen_split_delegate());
		self->handle = (uint64_t)sv;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS — UISplitViewController is view-controller-level, not an
		 * embeddable control (see GUI_PLAN Tier 2; defer). */
		```
