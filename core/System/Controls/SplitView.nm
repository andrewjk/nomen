	}

	// A Window-shaped handle to pane `index`'s view: pass it to control
	// constructors and `Container.layout` to host controls on that pane. The
	// value retains the pane view (+1), so its scope-exit `#destroy` releases
	// its OWN reference and the SplitView's stays balanced — keep the
	// SplitView alive at least as long as the returned value.
	pub func content_window = (self, int index, out Window) {
		```
		#arch: c
		#platform: macos
		id subviews = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("subviews"));
		id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			subviews, sel_registerName("objectAtIndex:"), (unsigned long)index);
		extern void *_Window_traits[];
		struct Window w;
		w._vt = (void *)&_Window_traits;
		w.handle = (uint64_t)pane;
		((id(*)(id, SEL))objc_msgSend)(pane, sel_registerName("retain"));
		return w;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id subviews = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("subviews"));
		id pane = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			subviews, sel_registerName("objectAtIndex:"), (unsigned long)index);
		extern void *Window_traits;
		struct Window w;
		w._vt = (void *)&Window_traits;
		w.handle = (uint64_t)pane;
		((id(*)(id, SEL))objc_msgSend)(pane, sel_registerName("retain"));
		return w;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		{
			extern void *_Window_traits[];
			struct Window w;
			w._vt = (void *)&_Window_traits;
			w.handle = 0;
			return w;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		{
			extern void *Window_traits;
			struct Window w;
			w._vt = (void *)&Window_traits;
			w.handle = 0;
			return w;
		}
		```
	}

