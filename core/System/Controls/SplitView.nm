	// Move divider `index`. For a vertical split the position is the left
	// edge of the pane after the divider, in points from the left.
	pub func set_position = (ref self, float position, int divider) {
		```
		#arch: c
		#platform: macos
		// NSSplitView manages its panes only after a layout pass (a window
		// that has been shown); give it one explicitly so the divider move
		// has real pane frames to work from, then move the divider.
		((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("adjustSubviews"));
		((void(*)(id, SEL, double, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setPosition:ofDividerAtIndex:"),
			position, (long)divider);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		// NSSplitView manages its panes only after a layout pass (a window
		// that has been shown); give it one explicitly so the divider move
		// has real pane frames to work from, then move the divider.
		((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("adjustSubviews"));
		((void(*)(id, SEL, double, long))objc_msgSend)(
			(id)self->handle, sel_registerName("setPosition:ofDividerAtIndex:"),
			position, (long)divider);
		```
