		BOOL vertical = ((BOOL(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("isVertical"));
		id first = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			subviews, sel_registerName("objectAtIndex:"), 0UL);
		CGRect frame = ((CGRect(*)(id, SEL))objc_msgSend)(first, sel_registerName("frame"));
		return vertical ? frame.size.width : frame.size.height;
		```
