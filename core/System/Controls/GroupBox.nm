/**
 * A labeled bordered box that gives forms a section frame for free
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * NSBox in its primary style with a title. macOS-only — iOS has no boxed
 * group view (TODO stubs; see GUI_PLAN Tier 1 #17).
 **/
pub mv struct GroupBox : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window, string title) {
		```
		#arch: c
		#platform: macos
		id box = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSBox"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 240, 120));
		((void(*)(id, SEL, long))objc_msgSend)(
			box, sel_registerName("setBoxType:"), 0); // NSBoxPrimary = 0
		((void(*)(id, SEL, id))objc_msgSend)(
			box, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), box);
		self.handle = (uint64_t)box;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id box = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSBox"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 240, 120));
		((void(*)(id, SEL, long))objc_msgSend)(
			box, sel_registerName("setBoxType:"), 0); // NSBoxPrimary = 0
		((void(*)(id, SEL, id))objc_msgSend)(
			box, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), box);
		self->handle = (uint64_t)box;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS — no native boxed group view (see GUI_PLAN Tier 1 #17;
		 * compose from a titled border drawn by the layout layer if needed). */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS — no native boxed group view (see GUI_PLAN Tier 1 #17;
		 * compose from a titled border drawn by the layout layer if needed). */
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	pub func set_title = (self, string title) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	pub func get_title = (self, out string) {
		```
		#arch: c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("title"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("title"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
	}

	// The NSBoxType (0 = primary/boxed) — exposes the native style for tests
	// and diagnostics.
	pub func box_type = (self, out int) {
		```
		#arch: c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("boxType"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("boxType"));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
	}

	pub func set_hidden = (self, bool hidden) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}

	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}
}
