/**
 * A read-only text label control
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is the AppKit handle, and the `#destroy` releases what it
 * names. The constructor's `self` is the inline instance (the `.` accessor);
 * methods keep the pointer form.
 *
 * The label carries NO Nomen-side text cache — sizing reads the native
 * control (`native_intrinsic`), and `set_text` is a bare receiver that only
 * mutates the native view. That keeps the struct write-once after
 * construction, which is what lets the `#handle` twin mirror it (see
 * GUI.md, "Click events" and the `#handle` note).
 **/
pub mv struct Text: Control {
	var uint64 handle = 0

	// The `#handle` hook synthesizes `NameHandle` — a copyable, non-owning
	// twin (same public bare-self methods, no destroy) so closures can
	// capture this control without moving it. See GUI.md, "Handles".
	#handle = () { }

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id label = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTextField"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(10, 10, 200, 30));
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setEditable:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setSelectable:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setBordered:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setDrawsBackground:"), 0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), label);
		self.handle = (uint64_t)label;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id label = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTextField"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(10, 10, 200, 30));
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setEditable:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setSelectable:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setBordered:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setDrawsBackground:"), 0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), label);
		self->handle = (uint64_t)label;
		```
		```
		#arch: c
		#platform: ios
		id label = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(objc_getClass("UILabel"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(10, 10, 200, 30));
		((void(*)(id, SEL, id))objc_msgSend)(
			label, sel_registerName("setText:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setUserInteractionEnabled:"), 0);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), label);
		self.handle = (uint64_t)label;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id label = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(objc_getClass("UILabel"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(10, 10, 200, 30));
		((void(*)(id, SEL, id))objc_msgSend)(
			label, sel_registerName("setText:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			label, sel_registerName("setUserInteractionEnabled:"), 0);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), label);
		self->handle = (uint64_t)label;
		```
	}

	pub func set_text = (self, string text) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setStringValue:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setStringValue:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setText:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setText:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
	}

	// The label's current text, read from the native control (the label
	// carries no Nomen-side text cache).
	pub func get_text = (self, out string) {
		```
		#arch: c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("stringValue"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("stringValue"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: c
		#platform: ios
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("text"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("text"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
	}

	// Switch the label between the regular and bold system font. Bold is for
	// section headings, so they read as headers rather than sibling labels.
	pub func set_bold = (self, bool bold) {
		```
		#arch: c
		#platform: macos
		CGFloat size = ((CGFloat(*)(id, SEL))objc_msgSend)(
			(id)objc_getClass("NSFont"), sel_registerName("systemFontSize"));
		id font = ((id(*)(id, SEL, CGFloat))objc_msgSend)(
			(id)objc_getClass("NSFont"),
			sel_registerName(bold ? "boldSystemFontOfSize:" : "systemFontOfSize:"), size);
		((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("setFont:"), font);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		CGFloat size = ((CGFloat(*)(id, SEL))objc_msgSend)(
			(id)objc_getClass("NSFont"), sel_registerName("systemFontSize"));
		id font = ((id(*)(id, SEL, CGFloat))objc_msgSend)(
			(id)objc_getClass("NSFont"),
			sel_registerName(bold ? "boldSystemFontOfSize:" : "systemFontOfSize:"), size);
		((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("setFont:"), font);
		```
		```
		#arch: c
		#platform: ios
		CGFloat size = ((CGFloat(*)(id, SEL))objc_msgSend)(
			(id)objc_getClass("UIFont"), sel_registerName("labelFontSize"));
		id font = ((id(*)(id, SEL, CGFloat))objc_msgSend)(
			(id)objc_getClass("UIFont"),
			sel_registerName(bold ? "boldSystemFontOfSize:" : "systemFontOfSize:"), size);
		((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("setFont:"), font);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		CGFloat size = ((CGFloat(*)(id, SEL))objc_msgSend)(
			(id)objc_getClass("UIFont"), sel_registerName("labelFontSize"));
		id font = ((id(*)(id, SEL, CGFloat))objc_msgSend)(
			(id)objc_getClass("UIFont"),
			sel_registerName(bold ? "boldSystemFontOfSize:" : "systemFontOfSize:"), size);
		((void(*)(id, SEL, id))objc_msgSend)((id)self->handle, sel_registerName("setFont:"), font);
		```
	}

	// ── Control trait conformance ──
	// A text control sizes to its content. v1 assumes an 8px monospace font, so a
	// line is `text.length × 8` wide and 8px tall (see GUI.md "Native control
	// refactor"). The default frame is 0,0,0,0; layout drives the real rectangle.

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
	}
}
