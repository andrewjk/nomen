/**
 * A push-button control that triggers an action when clicked
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is an AppKit handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 **/
pub mv struct Button: Control {
	var uint64 handle = 0

	// The `#handle` hook synthesizes `NameHandle` — a copyable, non-owning
	// twin (same public bare-self methods, no destroy) so closures can
	// capture this control without moving it. See GUI.md, "Handles".
	#handle = () {}

	pub func #init = (self, Window window, string title) {
		```
		#arch: c
		#platform: macos
		id btn = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSButton"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 100, 32));
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			btn, sel_registerName("setButtonType:"), 1); // NSPushInButton = 1 (momentary push)
		((void(*)(id, SEL, id))objc_msgSend)(
			btn, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), btn);
		self.handle = (uint64_t)btn;
		extern void nomen_control_arm_clicks(unsigned long long);
		nomen_control_arm_clicks((unsigned long long)btn);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id btn = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSButton"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 100, 32));
		((void(*)(id, SEL, unsigned long))objc_msgSend)(
			btn, sel_registerName("setButtonType:"), 1); // NSPushInButton = 1 (momentary push)
		((void(*)(id, SEL, id))objc_msgSend)(
			btn, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), btn);
		self->handle = (uint64_t)btn;
		extern void nomen_control_arm_clicks(unsigned long long) __asm__("nomen_control_arm_clicks");
		nomen_control_arm_clicks((unsigned long long)btn);
		```
		```
		#arch: c
		#platform: ios
		id btn = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIButton"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 100, 32));
		((void(*)(id, SEL, unsigned long, id, id))objc_msgSend)(
			btn, sel_registerName("setTitle:forState:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			0); // UIControlStateNormal = 0
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), btn);
		self.handle = (uint64_t)btn;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id btn = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UIButton"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 100, 32));
		((void(*)(id, SEL, unsigned long, id, id))objc_msgSend)(
			btn, sel_registerName("setTitle:forState:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			0); // UIControlStateNormal = 0
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), btn);
		self->handle = (uint64_t)btn;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	pub func set_title = (self, string title) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, unsigned long, id, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:forState:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			0); // UIControlStateNormal = 0
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, unsigned long, id, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setTitle:forState:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr),
			0); // UIControlStateNormal = 0
		```
	}

	// The button's current title (a fresh own string — the heap copy is the
	// returned nomen_string).
	pub func get_title = (self, out string) {
		```
		#arch: c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("title"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("title"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: c
		#platform: ios
		id str = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			(id)self->handle, sel_registerName("titleForState:"), 0UL); // UIControlStateNormal = 0
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id str = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			(id)self->handle, sel_registerName("titleForState:"), 0UL); // UIControlStateNormal = 0
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
	}

	// ── Control trait conformance ──
	// A button sizes to its native intrinsic content size (title + chrome);
	// `measure` clamps that to the box constraints. The native query goes
	// through the shared `native_intrinsic` FFI (see Container.nm), which works
	// on both backends — a per-control raw block couldn't return a `Size` from
	// the aarch64 companion (struct-name mangling) nor mutate a Nomen local.

	pub func set_hidden = (self, bool hidden) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			(id)self->handle, sel_registerName("setHidden:"), hidden ? 1 : 0);
		```
	}

	pub func is_hidden = (self, out bool) {
		```
		#arch: c
		#platform: macos
		BOOL hidden = ((BOOL(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("isHidden"));
		return hidden ? 1 : 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		BOOL hidden = ((BOOL(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("isHidden"));
		return hidden ? 1 : 0;
		```
		```
		#arch: c
		#platform: ios
		BOOL hidden = ((BOOL(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("isHidden"));
		return hidden ? 1 : 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		BOOL hidden = ((BOOL(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("isHidden"));
		return hidden ? 1 : 0;
		```
	}

	// Arm the native click action at construction (the shared target —
	// see Control.nm's nomen_control_arm_clicks) so `was_clicked` polls
	// report clicks without any hit-testing.
	pub func was_clicked = (self, out bool) {
		return nomen_control_take_click(self.handle)
	}

	// The on_click desugar's drain (docs/HANDLERS.md): the synthesized pump
	// arm polls this per frame. Same edge as was_clicked — register one way
	// or the other, never both (first consumer wins).
	pub func take_click = (self, out bool) {
		return nomen_control_take_click(self.handle)
	}

	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
	}
}
