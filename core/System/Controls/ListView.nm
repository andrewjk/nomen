		return -1;
		```
	}

	// The on_select desugar's drain (docs/HANDLERS.md): true when the
	// selected row changed since the last drain — user clicks AND
	// programmatic select_row (the delegate observes both; a pre-selection
	// in #init therefore fires on the first frame). The handler body reads
	// the row through selected_row(). The record is keyed on the table
	// view (what the delegate sees), not the scroll wrapper.
	pub func take_select = (self, out bool) {
		```
		#arch: c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->table);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		extern long nomen_select_take(unsigned long long);
		return (long)nomen_select_take((unsigned long long)self->table);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return false;
		```
	}

	// Select a row programmatically (deselects the rest).
	pub func select_row = (self, int index) {
		```
		#arch: c
		#platform: macos
		id indexes = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			(id)objc_getClass("NSIndexSet"), sel_registerName("indexSetWithIndex:"),
			index < 0 ? 0UL : (unsigned long)index);
		((void(*)(id, SEL, id, BOOL))objc_msgSend)(
			(id)self->table, sel_registerName("selectRowIndexes:byExtendingSelection:"),
			indexes, 0);
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id indexes = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			(id)objc_getClass("NSIndexSet"), sel_registerName("indexSetWithIndex:"),
			index < 0 ? 0UL : (unsigned long)index);
		((void(*)(id, SEL, id, BOOL))objc_msgSend)(
			(id)self->table, sel_registerName("selectRowIndexes:byExtendingSelection:"),
			indexes, 0);
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
