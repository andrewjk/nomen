	/**
	 * Add a row with `text` at the end.
	 **/
	pub func add_row = (self, string text) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				nomen_list_append(text.ptr);
				((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				nomen_list_append(text.ptr);
				((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
			}
		}
		#if META.arch == "c" && META.platform == "ios" {
			#raw {
				/* TODO: iOS (see #init) */
			}
		}
		#if META.arch == "aarch64" && META.platform == "ios" {
			#raw("c") {
				/* TODO: iOS (see #init) */
			}
		}
	}

	/**
	 * Replace the text of row `index`.
	 **/
	pub func set_row = (self, int index, string text) {
		#if META.arch == "c" && META.platform == "macos" {
			#raw {
				if (index < 0 || (long)index >= g_list_count) return;
				free(g_list_rows[index]);
				g_list_rows[index] = strdup(text.ptr);
				((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
			}
		}
		#if META.arch == "aarch64" && META.platform == "macos" {
			#raw("c") {
				if (index < 0 || (long)index >= g_list_count) return;
