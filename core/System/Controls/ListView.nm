	// Append a row (a NUL-terminated copy is stored) and reload.
	pub func add_row = (self, string text) {
		```
		#arch: c
		#platform: macos
		nomen_list_append(text.ptr);
		((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		nomen_list_append(text.ptr);
		((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
		```
