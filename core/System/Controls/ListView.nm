		/* TODO: iOS (see #init) */
		```
	}

	// Replace row `index`'s text and reload.
	pub func set_row = (self, int index, string text) {
		```
		#arch: c
		#platform: macos
		if (index < 0 || (long)index >= g_list_count) return;
		free(g_list_rows[index]);
		g_list_rows[index] = strdup(text.ptr);
		((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
