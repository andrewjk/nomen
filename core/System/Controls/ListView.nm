	// A fresh copy of row `index`'s text (mv — the caller owns it).
	pub func row = (self, int index, out string) {
		```
		#arch: c
		#platform: macos
		const char *text = ((index < 0 || (long)index >= g_list_count) || !g_list_rows[index])
			? "" : g_list_rows[index];
		return (nomen_string){ strdup(text), (long)strlen(text) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		const char *text = ((index < 0 || (long)index >= g_list_count) || !g_list_rows[index])
			? "" : g_list_rows[index];
		return (nomen_string){ strdup(text), (long)strlen(text) };
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
	}

	// The selected row, polled (no change callback in the manual loop);
	// -1 = no selection.
	pub func selected_row = (self, out int) {
		```
		#arch: c
		#platform: macos
		return (int)((long(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("selectedRow"));
		```
