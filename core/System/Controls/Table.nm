	// Set one cell's text and reload.
	pub func set_cell = (self, int row, int col, string text) {
		```
		#arch: c
		#platform: macos
		nomen_table_set_cell((long)row, (long)col, text.ptr);
		((void(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("reloadData"));
		```
