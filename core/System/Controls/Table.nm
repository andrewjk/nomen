		((void(*)(id, SEL, id))objc_msgSend)(tv, sel_registerName("setDataSource:"), nomen_table_delegate_class());
		((void(*)(id, SEL, id))objc_msgSend)(sv, sel_registerName("setDocumentView:"), tv);
		((void(*)(id, SEL))objc_msgSend)(tv, sel_registerName("release"));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), sv);
		self.handle = (uint64_t)sv;
		self.table = (uint64_t)((id(*)(id, SEL))objc_msgSend)(sv, sel_registerName("documentView"));
