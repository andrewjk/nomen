	// Set a column's header label (the live column title).
	pub func set_header = (self, int col, string title) {
		```
		#arch: c
		#platform: macos
		id cols = ((id(*)(id, SEL))objc_msgSend)((id)self->table, sel_registerName("tableColumns"));
		long n = ((long(*)(id, SEL))objc_msgSend)(cols, sel_registerName("count"));
		if (col < 0 || (long)col >= n) return;
		id column = ((id(*)(id, SEL, unsigned long))objc_msgSend)(
			cols, sel_registerName("objectAtIndex:"), (unsigned long)col);
		id header = ((id(*)(id, SEL))objc_msgSend)(column, sel_registerName("headerCell"));
		((void(*)(id, SEL, id))objc_msgSend)(
			header, sel_registerName("setStringValue:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), title.ptr));
		```
