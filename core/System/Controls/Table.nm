	// A fresh copy of cell (row, col)'s text (mv — the caller owns it).
	pub func cell = (self, int row, int col, out string) {
		```
		#arch: c
		#platform: macos
		const char *text = "";
		if (row >= 0 && (long)row < g_table_rows && col >= 0 && (long)col < g_table_cols) {
			const char *v = g_table_cells[(long)row * g_table_cols + (long)col];
			if (v) text = v;
		}
		return (nomen_string){ strdup(text), (long)strlen(text) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		const char *text = "";
		if (row >= 0 && (long)row < g_table_rows && col >= 0 && (long)col < g_table_cols) {
			const char *v = g_table_cells[(long)row * g_table_cols + (long)col];
			if (v) text = v;
		}
		return (nomen_string){ strdup(text), (long)strlen(text) };
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return (nomen_string){ strdup(""), 0 };
		```
	}

