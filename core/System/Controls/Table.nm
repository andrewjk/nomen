/**
 * A multi-column data table with header labels (NSTableView, view-based)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * The data-source bridge generalizes ListView's (see that file) from rows
 * to a GRID: cells live in a fixed-capacity C-global pool, addressed
 * row-major (`text[row * cols + col]`); the column count is fixed at
 * construction. Cells render through VIEW-BASED table cells
 * (`tableView:viewForTableColumn:row:` returning an NSTableCellView whose
 * identifier matches its column) so AppKit REUSES the views as rows scroll
 * — the same recycling native tables get. Headers are live column labels
 * (`set_header`). One Table per process (shared pool — the same trade
 * ListView makes). Selection is POLLED (`selected_row`), like every value
 * in the manual loop. Named `Table` with no stdlib collision (the ListView
 * `List<T>` lesson). macOS-only (no iOS counterpart for a plain embeddable
 * grid; see GUI_PLAN Tier 2 — the iOS blocks are TODO stubs).
 **/
pub mv struct Table : Control {
	var uint64 handle = 0
	var uint64 table = 0

	// File-scope helper: the cell pool (shared — one Table per process) and
	// the delegate class answering the row count and building reusable cell
	// views.
	pub func #init = (self, Window window, int cols: cols > 0) {
		```
		#arch: c
		#platform: macos
		#scope: file
		#define NOMEN_TABLE_MAX_ROWS 256
		#define NOMEN_TABLE_MAX_COLS 8
		static char *g_table_cells[NOMEN_TABLE_MAX_ROWS * NOMEN_TABLE_MAX_COLS];
		static long g_table_cols = 0;
		static long g_table_rows = 0;
		static id g_table_delegate = 0;

		// Append an empty row (cells render as "" until set_cell); returns
		// the new row index or -1 when the pool is full.
		static long nomen_table_append_row(void) {
			if (g_table_rows >= NOMEN_TABLE_MAX_ROWS) return -1;
			for (long c = 0; c < g_table_cols; c++) {
				g_table_cells[g_table_rows * g_table_cols + c] = 0;
			}
			g_table_rows += 1;
			return g_table_rows - 1;
		}

		static void nomen_table_set_cell(long row, long col, const char *text) {
			if (row < 0 || row >= g_table_rows) return;
			if (col < 0 || col >= g_table_cols) return;
			long i = row * g_table_cols + col;
			free(g_table_cells[i]);
			g_table_cells[i] = strdup(text);
		}

		static void nomen_table_remove_row(long row) {
			if (row < 0 || row >= g_table_rows) return;
			for (long c = 0; c < g_table_cols; c++) {
				free(g_table_cells[row * g_table_cols + c]);
			}
			// Shift the tail rows left (cols pointers per row).
			for (long r = row; r + 1 < g_table_rows; r++) {
				for (long c = 0; c < g_table_cols; c++) {
					g_table_cells[r * g_table_cols + c] =
						g_table_cells[(r + 1) * g_table_cols + c];
				}
			}
			g_table_rows -= 1;
		}

		static void nomen_table_clear(void) {
			for (long i = 0; i < g_table_rows * g_table_cols; i++) {
				free(g_table_cells[i]);
				g_table_cells[i] = 0;
			}
			g_table_rows = 0;
		}

		static long nomen_table_number_of_rows(id self, SEL cmd, id tv) {
			(void)self; (void)cmd; (void)tv;
			return g_table_rows;
		}

		// The view-based cell: an NSTableCellView identified by its COLUMN,
		// recycled through makeViewWithIdentifier as rows scroll (the reuse
		// ListView's cell-based rows didn't have).
		static id nomen_table_view_for_cell(id self, SEL cmd, id tv, id col, long row) {
			(void)self; (void)cmd; (void)tv;
			id cell = ((id(*)(id, SEL, id, id))objc_msgSend)(
				tv, sel_registerName("makeViewWithIdentifier:owner:"), col, g_table_delegate);
			if (!cell) {
				cell = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)(
						(id)objc_getClass("NSTableCellView"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 100, 22));
				((void(*)(id, SEL, id))objc_msgSend)(cell, sel_registerName("setIdentifier:"), col);
				id tf = ((id(*)(id, SEL, CGRect))objc_msgSend)(
					((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTextField"), sel_registerName("alloc")),
					sel_registerName("initWithFrame:"),
					((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 100, 22));
				((void(*)(id, SEL, BOOL))objc_msgSend)(tf, sel_registerName("setBezeled:"), 0);
				((void(*)(id, SEL, BOOL))objc_msgSend)(tf, sel_registerName("setDrawsBackground:"), 0);
				((void(*)(id, SEL, BOOL))objc_msgSend)(tf, sel_registerName("setEditable:"), 0);
				((void(*)(id, SEL, BOOL))objc_msgSend)(tf, sel_registerName("setSelectable:"), 0);
				((void(*)(id, SEL, long))objc_msgSend)(tf, sel_registerName("setLineBreakMode:"), 4);
				((void(*)(id, SEL, unsigned long))objc_msgSend)(tf, sel_registerName("setAutoresizingMask:"), 2UL);
				((void(*)(id, SEL, id))objc_msgSend)(cell, sel_registerName("setTextField:"), tf);
				((void(*)(id, SEL, id))objc_msgSend)(cell, sel_registerName("addSubview:"), tf);
				((void(*)(id, SEL))objc_msgSend)(tf, sel_registerName("release"));
			}
			long c = ((long(*)(id, SEL, id))objc_msgSend)(
				((id(*)(id, SEL))objc_msgSend)(tv, sel_registerName("tableColumns")),
				sel_registerName("indexOfObject:"), col);
			const char *text = "";
			if (row >= 0 && row < g_table_rows && c >= 0 && c < g_table_cols) {
				const char *cell_text = g_table_cells[row * g_table_cols + c];
				if (cell_text) text = cell_text;
			}
			id tf = ((id(*)(id, SEL))objc_msgSend)(cell, sel_registerName("textField"));
			if (tf) {
				((void(*)(id, SEL, id))objc_msgSend)(
					tf, sel_registerName("setStringValue:"),
					((id(*)(id, SEL, const char*))objc_msgSend)(
						(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text));
			}
			return cell;
		}

		static id nomen_table_delegate_class(void) {
			Class Td = objc_getClass("NomenTableBridge");
			if (!Td) {
				Td = objc_allocateClassPair(objc_getClass("NSObject"), "NomenTableBridge", 0);
				if (Td) {
					class_addMethod(Td, sel_registerName("numberOfRowsInTableView:"),
						(IMP)nomen_table_number_of_rows, "l@:@");
					class_addMethod(Td, sel_registerName("tableView:viewForTableColumn:row:"),
						(IMP)nomen_table_view_for_cell, "@@:@@@l");
					objc_registerClassPair(Td);
				}
			}
			if (!g_table_delegate) {
				g_table_delegate = ((id(*)(id, SEL))objc_msgSend)(Td, sel_registerName("new"));
			}
			return g_table_delegate;
		}
		```
