/**
 * The object `Window.run` drives: conform a struct to it to write a windowed app
 *
 * Create the controls and layout in your struct's constructor, then pass the struct to
 * `win.run(mv app)`. The window then runs everything: it calls `start` once before showing
 * itself, then every frame handles events, lays out again on resize, runs your event
 * handlers and calls `frame`.
 *
 * ```
 * mv struct Hello: App {
 * 	mv Button btn
 * 	mv Container grid
 *
 * 	pub func #init = (ref self, Window window) {
 * 		const btn = Button(window, "Click me")
 * 		var grid = VStack(8)
 * 		grid.add_intrinsic(btn.handle, 1)
 * 		self.btn = mv btn
 * 		self.grid = mv grid
 * 	}
 *
 * 	pub func start = (ref self, ref Window win {}) {
 * 		win.set_content(ref self.grid)
 * 		self.btn.on_click(func() {
 * 			self.btn.set_title("Thanks")
 * 		})
 * 	}
 * }
 *
 * pub func main = () {
 * 	var win = Window("Hello", 320, 200)
 * 	var app = Hello(win)
 * 	win.run(mv app)
 * }
 * ```
 *
 * On macOS the app keeps running after its last window closes, until the user quits from
 * the Dock or with ⌘Q; clicking the Dock icon reopens the window. To quit when the window
 * closes, call `win.quit()` from `close_requested`.
 **/
// The WinForms/Swift shape for a manual-loop toolkit: instead of pumping
// `Window.process_events` and re-checking sizes in a `while` loop, the app
// moves itself into `win.run(mv app)` and the WINDOW owns everything else — the
// event pump, the autorelease pool, resize detection, and the relayout of the
// hosted content (the root `Container` from `win.set_content` plus every
// registered Scrollable document and pane).
//
// `handle_events` and `run_handler` are default-empty; the
// `.on_<event>(closure)` desugars (docs/HANDLERS.md) synthesize the overrides
// on conformers with registrations, so user code only writes the registration.
// New control events extend the pump's arms — the App contract is fixed.
// `run_handler` is the up-call protocol (Stage 3): a composite with an enrolled
// event calls back `owner.run_handler(id, ref win)` from its `tick`.
//
// Handlers are METHODS on the app (the `ref self` receiver), so app state —
// every control field — is reachable without lambda captures (capturing a
// control MOVES it; a capture-free method reference moves nothing). The closure
// you write IS hoisted into a hidden method, and the dispatch borrow of `self`
// is taken by the run loop per frame.
pub trait App {
	/**
	 * Called once before the window is shown. Register layout roots (`win.set_content`) and
	 * event handlers (`self.btn.on_click(...)`) here.
	 **/
	func start = (ref self, ref Window win {}) {
	}

	/**
	 * Called every frame until the window closes, with that frame's input in `ev`. Poll
	 * values and react to input that no handler covers here.
	 **/
	func frame = (ref self, ref Window win {}, FrameEvents ev) {
	}

	/**
	 * Runs the app's registered event handlers each frame, before `frame`. The compiler
	 * writes this for you from your `.on_<event>` registrations; don't override it.
	 **/
	// The per-frame event pump: drains every registered control event —
	// clicks, focus/blur, text input — through arms the `.on_<event>`
	// desugar (docs/HANDLERS.md) synthesizes on conformers with
	// registrations: one hidden method per closure, one drain arm per
	// registered control, one event-source prologue per family.
	// `Window.run` calls it before `frame`. New control events are new arms
	// in this one slot — the App contract never grows with the event
	// catalog. Conformers without registrations inherit this empty default
	// (trait defaults have precedent: `Enumerable.length`).
	func handle_events = (ref self, ref Window win {}) {
	}

	/**
	 * Runs the handler with id `id` when a composite control (such as `Pagination`) reports
	 * an event. The compiler writes this for you; don't override it.
	 **/
	// The up-call protocol (docs/HANDLERS.md Stage 3): a composite the app
	// has enrolled events on calls back into this — `owner.run_handler(id,
	// ref win)` from its `tick` — one vtable hop into the desugar's
	// synthesized override, whose arms dispatch the id to the app's handler.
	// The borrow flows down per call; nothing outlives it. Default-empty,
	// like `handle_events`.
	func run_handler = (ref self, int id, ref Window win {}) {
	}

	/**
	 * Called when the user clicks the window's close button. Return false to keep the
	 * window open (to ask about unsaved changes, say). The default allows the close.
	 * `win.close()` doesn't ask.
	 **/
	func close_requested = (ref self, ref Window win {}, out bool) {
		return true
	}
}

/**
 * One frame's input, passed to `App.frame`
 *
 * Each field reports only the frame the input happened in. Coordinates are in points from
 * the window content area's top left, as `Window.click_x` and `click_y` report them; for
 * controls inside a `Scrollable`, convert them with `content_click` before hit-testing.
 **/
// Pure scalars, so the by-value parameter copies safely (no destroy).
pub mv struct FrameEvents {
	/**
	 * The mouse button pressed this frame: 0 none, 1 left, 2 right.
	 **/
	pub var click = 0
	/**
	 * The click's x in the window's content area (-1 when there was no click).
	 **/
	pub var int click_x = -1
	/**
	 * The click's y in the window's content area, from the top (-1 when there was no
	 * click).
	 **/
	pub var int click_y = -1
	/**
	 * The mouse button pressed this frame: 1 left, 2 right, 3 middle, 4 and up for extra
	 * buttons, 0 for none.
	 **/
	pub var mouse_button = 0
	/**
	 * The click count: 2 for a double-click, 3 for a triple-click.
	 **/
	pub var mouse_click_count = 0
	/**
	 * The modifier keys held at the mouse-down: Command `0x100000`, Option `0x80000`,
	 * Control `0x40000`, Shift `0x20000`.
	 **/
	pub var mouse_modifiers = 0
	/**
	 * How far the user scrolled right this frame (negative for left).
	 **/
	pub var scroll_dx = 0
	/**
	 * How far the user scrolled up (away) this frame (negative for down).
	 **/
	pub var scroll_dy = 0
	/**
	 * The hardware key code of this frame's last key-down, or -1 if none. Space is 49,
	 * Return 36, the arrows 123–126, and the letters a–z 0–25. Typed text arrives through
	 * `on_input`, not here.
	 **/
	pub var int key_code = -1
	/**
	 * The modifier keys held at the key-down (the same bits as `mouse_modifiers`).
	 **/
	pub var key_modifiers = 0
	/**
	 * Whether the key-down is an auto-repeat from a held key.
	 **/
	pub var key_repeat = false
	/**
	 * The hardware key code of this frame's last key-up, or -1 if none.
	 **/
	pub var int key_up_code = -1
	/**
	 * The pointer's x, if it moved this frame (-1 if it didn't).
	 **/
	pub var int mouse_x = -1
	/**
	 * The pointer's y, if it moved this frame (-1 if it didn't).
	 **/
	pub var int mouse_y = -1
	/**
	 * Milliseconds since the previous frame (0 on the first): the animation clock.
	 **/
	pub var dt = 0
	/**
	 * Whether the window's content area changed size since the last frame. Registered
	 * layout roots are already laid out again; lay out panes you manage yourself here.
	 **/
	pub var resized = false
	/**
	 * The content area's width, when `resized`.
	 **/
	pub var width = 0
	/**
	 * The content area's height, when `resized`.
	 **/
	pub var height = 0
}
