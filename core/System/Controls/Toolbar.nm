		```
	}

	// ── Control trait conformance ──
	// A toolbar is window chrome: the layout engine never frames it (AppKit
	// owns the layout rect and shrinks the contentView itself).
	pub func set_frame = (ref self, int x, int y, int width, int height) {
		// No-op: the NSWindow carries the toolbar's geometry.
	}

	pub func intrinsic_size = (self, out Size) {
		var s = Size()
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var s = Size()
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
