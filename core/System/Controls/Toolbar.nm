	}

	// The fixed item count.
	pub func count = (self, out int) {
		```
		#arch: c
		#platform: macos
		id items = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("items"));
		return (int)((long(*)(id, SEL))objc_msgSend)(items, sel_registerName("count"));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id items = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("items"));
		return (int)((long(*)(id, SEL))objc_msgSend)(items, sel_registerName("count"));
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		return 0;
		```
	}

	// The tag of the most recently clicked item since the last read
	// (edge-triggered; -1 = none). Poll it in the manual loop.
	pub func clicked_item = (self, out int) {
		```
		#arch: c
		#platform: macos
		extern long nomen_toolbar_last_tag(void);
		return (int)nomen_toolbar_last_tag();
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		extern long nomen_toolbar_last_tag(void);
		return (int)nomen_toolbar_last_tag();
