		id toolbar = ((id(*)(id, SEL, id))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSToolbar"), sel_registerName("alloc")),
			sel_registerName("initWithIdentifier:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "main"));
		((void(*)(id, SEL, id))objc_msgSend)(toolbar, sel_registerName("setDelegate:"), nomen_toolbar_delegate_class());
		((void(*)(id, SEL, BOOL))objc_msgSend)(toolbar, sel_registerName("setAllowsUserCustomization:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(toolbar, sel_registerName("setAutosavesConfiguration:"), 0);
		((void(*)(id, SEL, id))objc_msgSend)((id)window->handle, sel_registerName("setToolbar:"), toolbar);
