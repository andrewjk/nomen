/**
 * A titled box of labeled rows, such as a sign-in form
 *
 * Create it, add it to your grid with `add_to`, then add up to four rows with `add_row`,
 * each pairing a label with a control you own. Do this before the first layout.
 **/
// PURE COMPOSITION (GUI_PLAN Tier 3 "reachable earlier"): no new native
// control, no drawing — a GroupBox draws the framed, titled panel while a
// padded vstack of label+control rows lays out ON TOP of it: both live in a
// ZStack node of the caller's grid (same rect; the later child paints on top),
// so the whole assembly lays out in the caller's single `grid.layout(win)`
// pass.
//
// Rows are added BEFORE the first layout: `add_row` pairs one of four
// pre-created labels with a control handle the caller owns (up to 4 rows).
// Hit-test the row controls through their own handles, as everywhere else.
pub mv struct Form {
	/**
	 * The framed, titled panel behind the rows.
	 **/
	mv GroupBox box
	/**
	 * The label of row 1.
	 **/
	mv Text l0
	/**
	 * The label of row 2.
	 **/
	mv Text l1
	/**
	 * The label of row 3.
	 **/
	mv Text l2
	/**
	 * The label of row 4.
	 **/
	mv Text l3
	/**
	 * The number of rows added so far.
	 **/
	var rows = 0
	/**
	 * The grid index of the vstack holding the rows (internal; -1 before `add_to`).
	 **/
	internal var int rows_stack = -1

	/**
	 * A form titled `title` in `window`. Call `add_to`, then `add_row` for each row, before
	 * the first layout.
	 **/
	pub func #init = (ref self, Window window, string title) {
		self.box = GroupBox(window, title)
		self.l0 = Text(window)
		self.l1 = Text(window)
		self.l2 = Text(window)
		self.l3 = Text(window)
	}

	/**
	 * Add the form to `grid` under `parent`, spanning `span` cells. The panel fills the
	 * form's rect and the rows sit on top of it, inset to clear the title.
	 **/
	pub func add_to = (ref self {}, ref Container grid { aligns, cols, dirty, dirty_idx, gaps, grows, h_kinds, h_vals, handles, kinds, measured_count, mh, mw, pads, pars, prh, prw, prx, pry, rh, rw, rx, ry, shrinks, spans, w_kinds, w_vals }, int parent, int span) {
		var int zs = grid.add_zstack(parent, span)
		grid.add_to(zs, self.box.handle, 0, 0, 1, 1)
		var int blk = grid.add_block_to(zs, 24, 1)
		self.rows_stack = grid.add_vstack(blk, 8, 1)
	}

	/**
	 * Add a row with `label` on the left at its natural width and `control` (the native
	 * handle of a control you own) filling the rest, `control_h` tall. A form holds up to 4
	 * rows.
	 **/
	pub func add_row = (ref self {}, ref Container grid { aligns, cols, dirty, dirty_idx, gaps, grows, h_kinds, h_vals, handles, kinds, measured_count, mh, mw, pads, pars, prh, prw, prx, pry, rh, rw, rx, ry, shrinks, spans, w_kinds, w_vals }, string label, uint64 control, int control_h) {
		var uint64 label_handle = 0
		if self.rows == 0 {
			self.l0.set_text(label)
			label_handle = self.l0.handle
		}
		if self.rows == 1 {
			self.l1.set_text(label)
			label_handle = self.l1.handle
		}
		if self.rows == 2 {
			self.l2.set_text(label)
			label_handle = self.l2.handle
		}
		if self.rows == 3 {
			self.l3.set_text(label)
			label_handle = self.l3.handle
		}
		if self.rows > 3 {
			return
		}
		var int row = grid.add_hstack(self.rows_stack, 8, 1)
		grid.add_to_intrinsic(row, label_handle, 1)
		grid.add_to(row, control, 0, control_h, 1, 1)
		self.rows += 1
	}
}
