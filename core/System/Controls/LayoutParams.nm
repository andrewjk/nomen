// Per-child layout parameter types for the Nomen `core/System/Controls` UI
// layer. Split out of `Geometry.nm` so a module that only needs the
// length-model enums (e.g. `Container.nm`) can pull them in without also
// dragging `Size`/`Frame`/`Insets`/`BoxConstraints` along — `Size` and `Frame`
// collide with macOS `MacTypes.h` typedefs once any Cocoa-using module
// (Window, Controls) is in the build.

// ── Requested size (user-facing, on LayoutParams) ──

/**
 * How a child dimension is sized: auto (to content), fixed, percent, or fill
 **/
pub enum LayoutLength {
	case auto // size to content (intrinsic measurement)
	case fixed(int pixels) // exact size
	case percent(int numerator) // numerator/100 of available space (e.g. 50 = 50%)
	case fill // fill all available space (same as grow=1)
}

/**
 * How a child is positioned within available space (start / center / end / stretch)
 **/
pub enum Alignment {
	case start
	case center
	case end
	case stretch
}

// ── Per-child layout parameters ──

/**
 * Per-child layout preferences: requested dimensions, flex grow/shrink weights, and alignment
 **/
pub struct LayoutParams {
	pub var LayoutLength width = .auto
	pub var LayoutLength height = .auto
	pub var grow = 0 // flex weight for distributing surplus space
	pub var shrink = 0 // flex weight for distributing deficit
	pub var Alignment align_self = .stretch // cross-axis alignment override
}

// Sensible defaults so most children just work
const LayoutParams DEFAULT_PARAMS = LayoutParams() + [
	width = .auto,
	height = .auto,
	grow = 0,
	shrink = 1,
	align_self = .stretch,
]
