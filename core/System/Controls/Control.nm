// The `Control` trait is the polymorphic interface the layout engine uses to
// talk to every node in the UI tree. A control reports its desired size given a
// set of constraints (measure), applies a concrete rectangle (set_frame), and can
// report how big it would be with unbounded space (intrinsic_size).
//
// Native controls (Window, Text, …) and containers conform to it. See GUI.md
// ("The Control trait") for the contract. The measure/arrange math is the same
// regardless of storage: the handle-based `Container` applies frames directly via
// native `setFrame:` today, but a control that also conforms to `Control` can be
// driven through the trait interface (and slotted into `Array<Control>` /
// `ClassBuffer<Control>` once the container migrates).

/**
 * The polymorphic interface every UI node implements (measure / set_frame / intrinsic_size)
 **/
pub trait Control {
	// Given these constraints, report the size you want to be.
	// Must satisfy min_width ≤ result.width ≤ max_width (ditto height).
	func measure = (self, BoxConstraints constraints, out Size)

	// Apply a concrete rectangle. For native controls this calls setFrame: on the
	// platform handle. For containers this also arranges children.
	func set_frame = (ref self, int x, int y, int width, int height)

	// What size would you be with unbounded space? (Used by parents to decide
	// wrapping, scrolling, etc. Default: call measure with infinity.)
	func intrinsic_size = (self, out Size)
}

// ── Native click events (target/action) ──
//
// NSButton-family controls (Button, CheckBox, Radio, Toggle — and
// composites over them) arm a shared action target at construction; the
// action records the sender's view pointer — which IS the Nomen handle —
// into a ring queue, and `was_clicked` drains it. That is an
// edge-triggered click poll with no coordinates and no hit-testing, and it
// works for controls hosted on a Scrollable's document view. Handlers that
// need shared app state stay in `App.frame` — a capturing `on_click`
// closure is not expressible soundly (capturing a control MOVES it; see
// CLOSURE.md), so the poll form is the ownership-clean equivalent.

// Arm a control's native click action. Called by the button-family
// constructors; safe to call again (re-sets target/action).
pub func nomen_control_arm_clicks = (uint64 handle) {
	```
	#arch: c
	#platform: macos
	#scope: file
	// The shared click target: NSControl.target/action fires clickAction:
	// on the main thread; the sender's view pointer is the Nomen handle.
	static void *nomen_click_target = 0;
	// Ring queue of clicked handles (64 deep; a click that is never
	// consumed is stale, so dropping the oldest when full is fine).
	static unsigned long long nomen_click_queue[64];
	static int nomen_click_count = 0;
	static void nomen_click_push(unsigned long long h) {
		if (nomen_click_count >= 64) return;
		nomen_click_queue[nomen_click_count++] = h;
	}
	static long nomen_click_take(unsigned long long h) {
		for (int i = 0; i < nomen_click_count; i++) {
			if (nomen_click_queue[i] == h) {
				for (int j = i; j < nomen_click_count - 1; j++) {
					nomen_click_queue[j] = nomen_click_queue[j + 1];
				}
				nomen_click_count--;
				return 1;
			}
		}
		return 0;
	}
	static void nomen_click_action(id self, SEL cmd, id sender) {
		(void)self; (void)cmd;
		nomen_click_push((unsigned long long)(void *)sender);
	}
	static void nomen_click_arm(unsigned long long handle) {
		Class Tc = objc_getClass("NomenClickTarget");
		if (!Tc) {
			Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenClickTarget", 0);
			if (Tc) {
				class_addMethod(Tc, sel_registerName("clickAction:"), (IMP)nomen_click_action, "v@:@");
				objc_registerClassPair(Tc);
			}
		}
		if (!nomen_click_target && Tc) {
			nomen_click_target = (void *)((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
		}
		if (nomen_click_target) {
			id control = (id)handle;
			((void(*)(id, SEL, id))objc_msgSend)(control, sel_registerName("setTarget:"), (id)nomen_click_target);
			((void(*)(id, SEL, SEL))objc_msgSend)(control, sel_registerName("setAction:"), sel_registerName("clickAction:"));
		}
	}
	```
	```
	#arch: aarch64_use_c
	#platform: macos
	#scope: file
	static void *nomen_click_target = 0;
	static unsigned long long nomen_click_queue[64];
	static int nomen_click_count = 0;
	static void nomen_click_push(unsigned long long h) {
		if (nomen_click_count >= 64) return;
		nomen_click_queue[nomen_click_count++] = h;
	}
	static long nomen_click_take(unsigned long long h) {
		for (int i = 0; i < nomen_click_count; i++) {
			if (nomen_click_queue[i] == h) {
				for (int j = i; j < nomen_click_count - 1; j++) {
					nomen_click_queue[j] = nomen_click_queue[j + 1];
				}
				nomen_click_count--;
				return 1;
			}
		}
		return 0;
	}
	static void nomen_click_action(id self, SEL cmd, id sender) {
		(void)self; (void)cmd;
		nomen_click_push((unsigned long long)(void *)sender);
	}
	static void nomen_click_arm(unsigned long long handle) {
		Class Tc = objc_getClass("NomenClickTarget");
		if (!Tc) {
			Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenClickTarget", 0);
			if (Tc) {
				class_addMethod(Tc, sel_registerName("clickAction:"), (IMP)nomen_click_action, "v@:@");
				objc_registerClassPair(Tc);
			}
		}
		if (!nomen_click_target && Tc) {
			nomen_click_target = (void *)((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
		}
		if (nomen_click_target) {
			id control = (id)handle;
			((void(*)(id, SEL, id))objc_msgSend)(control, sel_registerName("setTarget:"), (id)nomen_click_target);
			((void(*)(id, SEL, SEL))objc_msgSend)(control, sel_registerName("setAction:"), sel_registerName("clickAction:"));
		}
	}
	```
	```
	#arch: c
	#platform: macos
	nomen_click_arm(handle);
	```
	```
