/**
 * Internal plumbing: whether the selection of the control `handle` changed since the last
 * call (each change is reported once). Read the new selection from the control itself.
 **/
// Called by the selection-family `take_select` drains — the on_select desugar's arm
// primitive. The payload is NOT stashed here: the handler body reads it through the control's
// own selected_index() / selected_row().
pub func nomen_control_take_select = (uint64 handle, out bool) {
	#if META.arch == "c" && META.platform == "macos" {
		#raw {
			extern long nomen_select_take(unsigned long long);
			return (long)nomen_select_take(handle);
		}
	}
	#if META.arch == "aarch64" && META.platform == "macos" {
		#raw("c") {
			extern long nomen_select_take(unsigned long long);
			return (long)nomen_select_take(handle);
		}
	}
	#if META.arch == "c" && META.platform == "ios" {
		#raw {
			return 0;
		}
	}
	#if META.arch == "aarch64" && META.platform == "ios" {
		#raw("c") {
			return 0;
		}
	}
}
