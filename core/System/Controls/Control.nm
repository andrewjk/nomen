}

// Drain a control's click record: true exactly once per click (the record
// is consumed). Called by the button-family `was_clicked` polls.
pub func nomen_control_take_click = (uint64 handle, out bool) {
	```
	#arch: c
	#platform: macos
	extern long nomen_click_take(unsigned long long);
	return (long)nomen_click_take(handle);
	```
	```
	#arch: aarch64_use_c
	#platform: macos
	extern long nomen_click_take(unsigned long long);
	return (long)nomen_click_take(handle);
	```
	```
	#arch: c
	#platform: ios
	return 0;
	```
	```
	#arch: aarch64_use_c
	#platform: ios
	return 0;
	```
}
