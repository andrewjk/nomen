// The `Control` trait is the polymorphic interface the layout engine uses to
// talk to every node in the UI tree. A control reports its desired size given a
// set of constraints (measure), applies a concrete rectangle (set_frame), and can
// report how big it would be with unbounded space (intrinsic_size).
//
// Native controls (Window, Text, …) and containers conform to it. See GUI.md
// ("The Control trait") for the contract. The measure/arrange math is the same
// regardless of storage: the handle-based `Container` applies frames directly via
// native `setFrame:` today, but a control that also conforms to `Control` can be
// driven through the trait interface (and slotted into `Array<Control>` /
// `HandleBuffer<Control>` once the container migrates).

/**
 * The polymorphic interface every UI node implements (measure / set_frame / intrinsic_size)
 **/
pub trait Control {
	/**
	 * The size this control wants, within `constraints`: the result must lie between their
	 * minimum and maximum on each axis.
	 **/
	func measure = (self, BoxConstraints constraints, out Size)

	/**
	 * Apply a concrete rectangle, in points. Native controls move their platform view;
	 * containers also arrange their children.
	 **/
	func set_frame = (ref self, int x, int y, int width, int height)

	/**
	 * The size this control would be with unlimited space. Parents use it to decide on
	 * wrapping, scrolling and so on.
	 **/
	func intrinsic_size = (self, out Size)
}

// ── Native click events (target/action) ──
//
// NSButton-family controls (Button, CheckBox, Radio, Toggle — and
// composites over them) arm a shared action target at construction; the
// action records the sender's view pointer — which IS the Nomen handle —
// into a ring queue, and `was_clicked` drains it. That is an
// edge-triggered click poll with no coordinates and no hit-testing, and it
// works for controls hosted on a Scrollable's document view. Handlers that
// need shared app state stay in `App.frame` — a capturing `on_click`
// closure is not expressible soundly (capturing a control MOVES it; see
// CLOSURE.md), so the poll form is the ownership-clean equivalent.

/**
 * Internal plumbing: arm the native click action for the control `handle` so `was_clicked`
 * can see its clicks. Called by the button-family constructors; safe to call again.
 **/
pub func nomen_control_arm_clicks = (uint64 handle) {
	#if META.arch == "c" && META.platform == "macos" {
		#raw("file") {
			// The shared click target: NSControl.target/action fires clickAction:
			// on the main thread; the sender's view pointer is the Nomen handle.
			static void *nomen_click_target = 0;
			// Ring queue of clicked handles (64 deep; a click that is never
			// consumed is stale, so dropping the oldest when full is fine).
			static unsigned long long nomen_click_queue[64];
			static int nomen_click_count = 0;
			static void nomen_click_push(unsigned long long h) {
				if (nomen_click_count >= 64) return;
				nomen_click_queue[nomen_click_count++] = h;
			}
			static long nomen_click_take(unsigned long long h) {
				for (int i = 0; i < nomen_click_count; i++) {
					if (nomen_click_queue[i] == h) {
						for (int j = i; j < nomen_click_count - 1; j++) {
							nomen_click_queue[j] = nomen_click_queue[j + 1];
						}
						nomen_click_count--;
						return 1;
					}
				}
				return 0;
			}
			static void nomen_click_action(id self, SEL cmd, id sender) {
				(void)self; (void)cmd;
				nomen_click_push((unsigned long long)(void *)sender);
			}
			static void nomen_click_arm(unsigned long long handle) {
				Class Tc = objc_getClass("NomenClickTarget");
				if (!Tc) {
					Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenClickTarget", 0);
					if (Tc) {
						class_addMethod(Tc, sel_registerName("clickAction:"), (IMP)nomen_click_action, "v@:@");
						objc_registerClassPair(Tc);
					}
				}
				if (!nomen_click_target && Tc) {
					nomen_click_target = (void *)((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
				}
				if (nomen_click_target) {
					id control = (id)handle;
					((void(*)(id, SEL, id))objc_msgSend)(control, sel_registerName("setTarget:"), (id)nomen_click_target);
					((void(*)(id, SEL, SEL))objc_msgSend)(control, sel_registerName("setAction:"), sel_registerName("clickAction:"));
				}
			}
		}
	}
	#if META.arch == "aarch64" && META.platform == "macos" {
		#raw("c", "file") {
			static void *nomen_click_target = 0;
			static unsigned long long nomen_click_queue[64];
			static int nomen_click_count = 0;
			static void nomen_click_push(unsigned long long h) {
				if (nomen_click_count >= 64) return;
				nomen_click_queue[nomen_click_count++] = h;
			}
			static long nomen_click_take(unsigned long long h) {
				for (int i = 0; i < nomen_click_count; i++) {
					if (nomen_click_queue[i] == h) {
						for (int j = i; j < nomen_click_count - 1; j++) {
							nomen_click_queue[j] = nomen_click_queue[j + 1];
						}
						nomen_click_count--;
						return 1;
					}
				}
				return 0;
			}
			static void nomen_click_action(id self, SEL cmd, id sender) {
				(void)self; (void)cmd;
				nomen_click_push((unsigned long long)(void *)sender);
			}
			static void nomen_click_arm(unsigned long long handle) {
				Class Tc = objc_getClass("NomenClickTarget");
				if (!Tc) {
					Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenClickTarget", 0);
					if (Tc) {
						class_addMethod(Tc, sel_registerName("clickAction:"), (IMP)nomen_click_action, "v@:@");
						objc_registerClassPair(Tc);
					}
				}
				if (!nomen_click_target && Tc) {
					nomen_click_target = (void *)((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
				}
				if (nomen_click_target) {
					id control = (id)handle;
					((void(*)(id, SEL, id))objc_msgSend)(control, sel_registerName("setTarget:"), (id)nomen_click_target);
					((void(*)(id, SEL, SEL))objc_msgSend)(control, sel_registerName("setAction:"), sel_registerName("clickAction:"));
				}
			}
		}
	}
	#if META.arch == "c" && META.platform == "macos" {
		#raw {
			nomen_click_arm(handle);
		}
	}
	#if META.arch == "aarch64" && META.platform == "macos" {
		#raw("c") {
			nomen_click_arm(handle);
		}
	}
	#if META.arch == "c" && META.platform == "ios" {
		#raw {
			/* TODO: iOS (see #init) */
		}
	}
	#if META.arch == "aarch64" && META.platform == "ios" {
		#raw("c") {
			/* TODO: iOS (see #init) */
		}
	}
}

/**
 * Internal plumbing: whether the control `handle` was clicked since the last call (each
 * click is reported once). Backs the button-family `was_clicked` polls.
 **/
pub func nomen_control_take_click = (uint64 handle, out bool) {
	#if META.arch == "c" && META.platform == "macos" {
		#raw {
			extern long nomen_click_take(unsigned long long);
			return (long)nomen_click_take(handle);
		}
	}
	#if META.arch == "aarch64" && META.platform == "macos" {
		#raw("c") {
			extern long nomen_click_take(unsigned long long);
			return (long)nomen_click_take(handle);
		}
	}
	#if META.arch == "c" && META.platform == "ios" {
		#raw {
			return 0;
		}
	}
	#if META.arch == "aarch64" && META.platform == "ios" {
		#raw("c") {
			return 0;
		}
	}
}

/**
 * Internal plumbing: arm the native selection-change action for the control `handle`
 * (`Select`, `Segmented`, `ComboBox`). Called by those constructors; safe to call again.
 **/
// The on_select plumbing for the ACTION family (NSControls whose target/action fires on a
// user-driven selection change). The DELEGATE family (Tabs, ListView, Table, OutlineView)
// pushes into the same record from its selection delegate instead. A control carries ONE
// target/action, so a control arms clicks OR selects, never both — the families are disjoint.
pub func nomen_control_arm_selects = (uint64 handle) {
	#if META.arch == "c" && META.platform == "macos" {
		#raw("file") {
			// The shared selection record: the click ring's shape, fed by both
			// families — the target's selectAction: (the sender's view pointer is
			// the Nomen handle) and the delegate family's selection callbacks
			// (nomen_select_push is EXTERNAL: Tabs/ListView/Table/OutlineView
			// delegates in other files push into this ring).
			static unsigned long long nomen_select_queue[64];
			static int nomen_select_count = 0;
			void nomen_select_push(unsigned long long h) {
				if (nomen_select_count >= 64) return;
				nomen_select_queue[nomen_select_count++] = h;
			}
			long nomen_select_take(unsigned long long h) {
				for (int i = 0; i < nomen_select_count; i++) {
					if (nomen_select_queue[i] == h) {
						for (int j = i; j < nomen_select_count - 1; j++) {
							nomen_select_queue[j] = nomen_select_queue[j + 1];
						}
						nomen_select_count--;
						return 1;
					}
				}
				return 0;
			}
			static void *nomen_select_target = 0;
			static void nomen_select_action(id self, SEL cmd, id sender) {
				(void)self; (void)cmd;
				nomen_select_push((unsigned long long)(void *)sender);
			}
			static void nomen_select_arm(unsigned long long handle) {
				Class Tc = objc_getClass("NomenSelectTarget");
				if (!Tc) {
					Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenSelectTarget", 0);
					if (Tc) {
						class_addMethod(Tc, sel_registerName("selectAction:"), (IMP)nomen_select_action, "v@:@");
						objc_registerClassPair(Tc);
					}
				}
				if (!nomen_select_target && Tc) {
					nomen_select_target = (void *)((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
				}
				if (nomen_select_target) {
					id control = (id)handle;
					((void(*)(id, SEL, id))objc_msgSend)(control, sel_registerName("setTarget:"), (id)nomen_select_target);
					((void(*)(id, SEL, SEL))objc_msgSend)(control, sel_registerName("setAction:"), sel_registerName("selectAction:"));
				}
			}
		}
	}
	#if META.arch == "c" && META.platform == "macos" {
		#raw {
			nomen_select_arm(handle);
		}
	}
	#if META.arch == "aarch64" && META.platform == "macos" {
		#raw("c", "file") {
			static unsigned long long nomen_select_queue[64];
			static int nomen_select_count = 0;
			void nomen_select_push(unsigned long long h) {
				if (nomen_select_count >= 64) return;
				nomen_select_queue[nomen_select_count++] = h;
			}
			long nomen_select_take(unsigned long long h) {
				for (int i = 0; i < nomen_select_count; i++) {
					if (nomen_select_queue[i] == h) {
						for (int j = i; j < nomen_select_count - 1; j++) {
							nomen_select_queue[j] = nomen_select_queue[j + 1];
						}
						nomen_select_count--;
						return 1;
					}
				}
				return 0;
			}
			static void *nomen_select_target = 0;
			static void nomen_select_action(id self, SEL cmd, id sender) {
				(void)self; (void)cmd;
				nomen_select_push((unsigned long long)(void *)sender);
			}
			static void nomen_select_arm(unsigned long long handle) {
				Class Tc = objc_getClass("NomenSelectTarget");
				if (!Tc) {
					Tc = objc_allocateClassPair(objc_getClass("NSObject"), "NomenSelectTarget", 0);
					if (Tc) {
						class_addMethod(Tc, sel_registerName("selectAction:"), (IMP)nomen_select_action, "v@:@");
						objc_registerClassPair(Tc);
					}
				}
				if (!nomen_select_target && Tc) {
					nomen_select_target = (void *)((id(*)(id, SEL))objc_msgSend)((id)Tc, sel_registerName("new"));
				}
				if (nomen_select_target) {
					id control = (id)handle;
					((void(*)(id, SEL, id))objc_msgSend)(control, sel_registerName("setTarget:"), (id)nomen_select_target);
					((void(*)(id, SEL, SEL))objc_msgSend)(control, sel_registerName("setAction:"), sel_registerName("selectAction:"));
				}
