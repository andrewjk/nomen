/**
 * Internal plumbing: arm the native commit (Return) action for the text field `handle`
 * (`TextBox`, `SecureField`, `SearchField`). Called by those constructors; safe to call
 * again.
 **/
// NSTextField sends its target/action exactly on the USER commit (Return), so one shared
// target serves every field: the field editor maps back to the editing control (the on_focus
// mapping), and the action's sender IS the field's handle. The record is the submit ring —
// the selection ring's shape, one entry per committed field, consumed by the field's
// take_submit drain.
pub func nomen_control_arm_submits = (uint64 handle) {
	#if META.arch == "c" && META.platform == "macos" {
		#raw("file") {
			// The shared submit record: the selection ring's shape. The commit is
			// USER-driven only (the field's action; programmatic set_string_value
			// stays silent).
			static unsigned long long nomen_submit_queue[64];
			static int nomen_submit_count = 0;
