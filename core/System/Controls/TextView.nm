/**
 * A multiline editable text surface
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * Sized explicitly by the container (`add(handle, w, h, …)`): a native text
 * view has no useful intrinsic size (it scrolls its own document), so the
 * Control-trait measure reports what the platform offers and clamps to the
 * constraints like every other leaf.
 **/
pub mv struct TextView : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTextView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 80));
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setEditable:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setSelectable:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setRichText:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			tv, sel_registerName("setUsesFindBar:"), 1);
		((void(*)(id, SEL, id))objc_msgSend)(
			tv, sel_registerName("setString:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), tv);
		self.handle = (uint64_t)tv;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSTextView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 80));
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setEditable:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setSelectable:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setRichText:"), 0);
		((void(*)(id, SEL, BOOL))objc_msgSend)(
			tv, sel_registerName("setUsesFindBar:"), 1);
		((void(*)(id, SEL, id))objc_msgSend)(
			tv, sel_registerName("setString:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), ""));
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), tv);
		self->handle = (uint64_t)tv;
		```
		```
		#arch: c
		#platform: ios
		id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UITextView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 80));
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setEditable:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setSelectable:"), 1);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), tv);
		self.handle = (uint64_t)tv;
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id tv = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("UITextView"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 200, 80));
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setEditable:"), 1);
		((void(*)(id, SEL, BOOL))objc_msgSend)(tv, sel_registerName("setSelectable:"), 1);
		id parentView = ((id(*)(id, SEL))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)(
				(id)window->handle, sel_registerName("rootViewController")),
			sel_registerName("view"));
		((void(*)(id, SEL, id))objc_msgSend)(
			parentView, sel_registerName("addSubview:"), tv);
		self->handle = (uint64_t)tv;
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
	}

	pub func set_text = (self, string text) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setString:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setString:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
		```
		#arch: c
		#platform: ios
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setText:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		((void(*)(id, SEL, id))objc_msgSend)(
			(id)self->handle, sel_registerName("setText:"),
			((id(*)(id, SEL, const char*))objc_msgSend)(
				(id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), text.ptr));
		```
	}

	pub func get_text = (self, out string) {
		```
		#arch: c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("string"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("string"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: c
		#platform: ios
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("text"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		id str = ((id(*)(id, SEL))objc_msgSend)(
			(id)self->handle, sel_registerName("text"));
		const char *cstr = ((const char*(*)(id, SEL))objc_msgSend)(
			str, sel_registerName("UTF8String"));
		return (nomen_string){ strdup(cstr), (long)strlen(cstr) };
		```
	}

	// ── Control trait conformance ──
	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		```
	}
}
