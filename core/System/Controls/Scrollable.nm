	pub func intrinsic_size = (self, out Size) {
		var [w, h] = native_intrinsic(self.handle)
		var s = Size()
		s.width = w
		s.height = h
		return s
	}

	pub func measure = (self, BoxConstraints constraints, out Size) {
		var Size s = self.intrinsic_size()
		if s.width > constraints.max_width {
			s.width = constraints.max_width
		}
		if s.width < constraints.min_width {
			s.width = constraints.min_width
		}
		if s.height > constraints.max_height {
			s.height = constraints.max_height
		}
		if s.height < constraints.min_height {
			s.height = constraints.min_height
		}
		return s
	}

	func #destroy = () {
		```
		#arch: c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		self->doc = 0;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		if (self->handle) {
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("removeFromSuperview"));
			((void(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("release"));
			self->handle = 0;
		}
		self->doc = 0;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS (see #init) */
		```
	}
}

// Translate a WINDOW-space click (top-left origin, as click_x/click_y
// return) into the scroll view's DOCUMENT coordinates, so content children
// can be hit-tested with the content grid's `contains` while scrolled. The
// visible top-left of the document moves with the scroll position (and the
// clip view's own origin), so a raw click is off by both. A free function
// (not a method): a raw-block-backed method returning a tuple fails the
// checker's destructuring — native_intrinsic's free-function shape works.
pub func content_click = (Scrollable scroll, int cx, int cy, out [int, int]) {
	```
	#arch: c
	#platform: macos
	id clip = ((id(*)(id, SEL))objc_msgSend)((id)scroll->handle, sel_registerName("contentView"));
	id win = ((id(*)(id, SEL))objc_msgSend)((id)scroll->handle, sel_registerName("window"));
	id cv = ((id(*)(id, SEL))objc_msgSend)(win, sel_registerName("contentView"));
	CGRect cv_frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
	CGRect clip_bounds = ((CGRect(*)(id, SEL))objc_msgSend)(clip, sel_registerName("bounds"));
	// The visible rect in the window's content view (bottom-left origin).
	CGRect visible = ((CGRect(*)(id, SEL, CGRect, id))objc_msgSend)(
		clip, sel_registerName("convertRect:toView:"), clip_bounds, cv);
	id doc = ((id(*)(id, SEL))objc_msgSend)((id)scroll->handle, sel_registerName("documentView"));
	CGRect doc_frame = ((CGRect(*)(id, SEL))objc_msgSend)(doc, sel_registerName("frame"));
	int visible_top = (int)(cv_frame.size.height - (visible.origin.y + visible.size.height));
	int offset = (int)(doc_frame.size.height - clip_bounds.size.height - clip_bounds.origin.y);
	if (offset < 0) offset = 0;
	struct _Tuple_int_int r;
	r._0 = cx - (int)visible.origin.x + (int)clip_bounds.origin.x;
	r._1 = cy - visible_top + offset;
	return r;
	```
	```
	#arch: aarch64_use_c
	#platform: macos
	id clip = ((id(*)(id, SEL))objc_msgSend)((id)scroll->handle, sel_registerName("contentView"));
	id win = ((id(*)(id, SEL))objc_msgSend)((id)scroll->handle, sel_registerName("window"));
	id cv = ((id(*)(id, SEL))objc_msgSend)(win, sel_registerName("contentView"));
	CGRect cv_frame = ((CGRect(*)(id, SEL))objc_msgSend)(cv, sel_registerName("frame"));
	CGRect clip_bounds = ((CGRect(*)(id, SEL))objc_msgSend)(clip, sel_registerName("bounds"));
	// The visible rect in the window's content view (bottom-left origin).
	CGRect visible = ((CGRect(*)(id, SEL, CGRect, id))objc_msgSend)(
		clip, sel_registerName("convertRect:toView:"), clip_bounds, cv);
	id doc = ((id(*)(id, SEL))objc_msgSend)((id)scroll->handle, sel_registerName("documentView"));
	CGRect doc_frame = ((CGRect(*)(id, SEL))objc_msgSend)(doc, sel_registerName("frame"));
	int visible_top = (int)(cv_frame.size.height - (visible.origin.y + visible.size.height));
	int offset = (int)(doc_frame.size.height - clip_bounds.size.height - clip_bounds.origin.y);
	if (offset < 0) offset = 0;
	struct _Tuple_int_int r;
	r._0 = cx - (int)visible.origin.x + (int)clip_bounds.origin.x;
	r._1 = cy - visible_top + offset;
	return r;
	```
	```
	#arch: c
	#platform: ios
	/* TODO: iOS (see #init) */
	{
		struct _Tuple_int_int r;
		r._0 = 0;
		r._1 = 0;
		return r;
	}
	```
	```
	#arch: aarch64_use_c
	#platform: ios
	/* TODO: iOS (see #init) */
	{
		struct _Tuple_int_int r;
		r._0 = 0;
		r._1 = 0;
		return r;
	}
	```
}
