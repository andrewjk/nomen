	pub func scroll_to_bottom = (self) {
		```
		#arch: c
		#platform: macos
		id clip = ((id(*)(id, SEL))objc_msgSend)((id)self->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, CGPoint))objc_msgSend)(
			clip, sel_registerName("scrollPoint:"),
			((CGPoint(*)(double, double))CGPointMake)(0, 0));
		```
