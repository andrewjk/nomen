/**
 * A capacity/rating display (stars, discrete or continuous fill)
 *
 * An OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 4 — the shape menu): the
 * single field is a platform handle, so the value is movable and its
 * `#destroy` releases what the handle names. The constructor's `self` is
 * the inline instance (the `.` accessor); methods keep the pointer form.
 *
 * macOS-only (NSLevelIndicator has no iOS counterpart; see GUI_PLAN
 * Tier 1 #16 — the iOS blocks are TODO stubs). Styles: 0 relevancy,
 * 1 discrete capacity, 2 continuous capacity, 3 rating (stars).
 **/
pub mv struct LevelIndicator : Control {
	var uint64 handle = 0

	pub func #init = (self, Window window) {
		```
		#arch: c
		#platform: macos
		id li = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSLevelIndicator"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 80, 22));
		((void(*)(id, SEL, long))objc_msgSend)(
			li, sel_registerName("setLevelIndicatorStyle:"), 3); // NSRatingLevelIndicatorStyle = 3
		((void(*)(id, SEL, double))objc_msgSend)(li, sel_registerName("setMinValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(li, sel_registerName("setMaxValue:"), 5.0);
		((void(*)(id, SEL, double))objc_msgSend)(li, sel_registerName("setDoubleValue:"), 0.0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), li);
		self.handle = (uint64_t)li;
		```
		```
		#arch: aarch64_use_c
		#platform: macos
		id li = ((id(*)(id, SEL, CGRect))objc_msgSend)(
			((id(*)(id, SEL))objc_msgSend)((id)objc_getClass("NSLevelIndicator"), sel_registerName("alloc")),
			sel_registerName("initWithFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)(0, 0, 80, 22));
		((void(*)(id, SEL, long))objc_msgSend)(
			li, sel_registerName("setLevelIndicatorStyle:"), 3); // NSRatingLevelIndicatorStyle = 3
		((void(*)(id, SEL, double))objc_msgSend)(li, sel_registerName("setMinValue:"), 0.0);
		((void(*)(id, SEL, double))objc_msgSend)(li, sel_registerName("setMaxValue:"), 5.0);
		((void(*)(id, SEL, double))objc_msgSend)(li, sel_registerName("setDoubleValue:"), 0.0);
		id contentView = ((id(*)(id, SEL))objc_msgSend)(
			(id)window->handle, sel_registerName("contentView"));
		((void(*)(id, SEL, id))objc_msgSend)(
			contentView, sel_registerName("addSubview:"), li);
		self->handle = (uint64_t)li;
		```
		```
		#arch: c
		#platform: ios
		/* TODO: iOS — no native level indicator (see GUI_PLAN Tier 1 #16;
		 * compose from a Button row of symbols if needed). */
		```
		```
		#arch: aarch64_use_c
		#platform: ios
		/* TODO: iOS — no native level indicator (see GUI_PLAN Tier 1 #16;
		 * compose from a Button row of symbols if needed). */
		```
	}

	pub func set_frame = (ref self, int x, int y, int width, int height) {
		```
		#arch: c
		#platform: macos
		((void(*)(id, SEL, CGRect))objc_msgSend)(
			(id)self->handle, sel_registerName("setFrame:"),
			((CGRect(*)(double, double, double, double))CGRectMake)((double)x, (double)y, (double)width, (double)height));
		```
		```
		#arch: aarch64_use_c
