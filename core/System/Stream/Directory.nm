/**
 * Helpers for working with filesystem directories.
 *
 * `Directory` is a namespace of static helpers — no instance is constructed.
 *
 *	Directory.create("scratch")
 *	const string names = Directory.list("scratch")
 *	const bool has     = Directory.exists("scratch")
 *	Directory.remove("scratch")
 **/
pub struct Directory {
	// (static) Create a directory at `path`.
	pub func create = (string path) {
		```
		#arch: c
		mkdir(path, 0777);
		```
		```
		#arch: aarch64
		mov x1, #0x1FF
		bl _mkdir
		```
	}

	// (static) Remove the (empty) directory at `path`.
	pub func remove = (string path) {
		```
		#arch: c
		rmdir(path);
		```
		```
		#arch: aarch64
		bl _rmdir
		```
	}

	// (static) Whether a directory exists at `path`.
	pub func exists = (string path, out bool) {
		```
		#arch: c
		struct stat st;
		return stat(path, &st) == 0 ? 1 : 0;
		```
		```
		#arch: aarch64
		sub sp, sp, #160
		mov x1, sp
		bl _stat
		cmp x0, #0
		cset x0, eq
		add sp, sp, #160
		b .return_Directory_exists
		```
		return false
	}

	// Returns the directory's entry names as a single newline-separated
	// string. The `.` and `..` entries are skipped. Returns an empty string
	// if the path cannot be opened.
	//
	// On macOS/iOS the entry length is read from `dirent.d_namlen`, so this
	// is currently macOS-specific aarch64 asm (the C backend is portable).
	pub func list = (string path, out string) {
		```
		#arch: c
		#scope: file
		#include <dirent.h>
		```
		```
		#arch: c
		DIR *d = opendir(path);
		if (!d) return strdup("");
		int cap = 4096;
		int len = 0;
		char *buf = (char*)malloc(cap);
		struct dirent *e;
		while ((e = readdir(d)) != NULL) {
			if (e->d_name[0] == '.' && e->d_name[1] == 0) continue;
			if (e->d_name[0] == '.' && e->d_name[1] == '.' && e->d_name[2] == 0) continue;
			int nl = (int)strlen(e->d_name);
			if (len + nl + 2 > cap) {
				while (len + nl + 2 > cap) cap *= 2;
				buf = (char*)realloc(buf, cap);
			}
			memcpy(buf + len, e->d_name, nl);
			len += nl;
			buf[len++] = '\n';
		}
		buf[len] = 0;
		closedir(d);
		return buf;
		```
		```
		#arch: aarch64
		sub sp, sp, #64
		str x0, [sp, #0]
		bl _opendir
		str x0, [sp, #8]
		cbz x0, .Ldir_list_empty
		mov x0, #4096
		bl _malloc
		str x0, [sp, #16]
		str xzr, [sp, #24]
		mov x0, #4096
		str x0, [sp, #32]
		.Ldir_list_loop:
		ldr x0, [sp, #8]
		bl _readdir
		str x0, [sp, #40]
		cbz x0, .Ldir_list_done
		ldrb w1, [x0, #21]
		cmp w1, #46
		bne .Ldir_list_keep
		ldrb w1, [x0, #22]
		cbz w1, .Ldir_list_loop
		cmp w1, #46
		bne .Ldir_list_keep
		ldrb w1, [x0, #23]
		cbz w1, .Ldir_list_loop
		.Ldir_list_keep:
		ldr x0, [sp, #40]
		ldrh w0, [x0, #18]
		str x0, [sp, #48]
		.Ldir_list_grow:
		ldr x1, [sp, #24]
		ldr x2, [sp, #48]
		add x1, x1, x2
		add x1, x1, #2
		ldr x2, [sp, #32]
		cmp x1, x2
		ble .Ldir_list_grow_ok
		lsl x2, x2, #1
		str x2, [sp, #32]
		ldr x0, [sp, #16]
		bl _realloc
		str x0, [sp, #16]
		b .Ldir_list_grow
		.Ldir_list_grow_ok:
		ldr x0, [sp, #16]
		ldr x1, [sp, #24]
		add x0, x0, x1
		ldr x1, [sp, #40]
		add x1, x1, #21
		ldr x2, [sp, #48]
		bl _memcpy
		ldr x0, [sp, #48]
		ldr x1, [sp, #24]
		add x1, x1, x0
		str x1, [sp, #24]
		ldr x0, [sp, #16]
		ldr x1, [sp, #24]
		mov w2, #10
		strb w2, [x0, x1]
		add x1, x1, #1
		str x1, [sp, #24]
		b .Ldir_list_loop
		.Ldir_list_done:
		ldr x0, [sp, #16]
		ldr x1, [sp, #24]
		strb wzr, [x0, x1]
		ldr x0, [sp, #8]
		bl _closedir
		ldr x0, [sp, #16]
		add sp, sp, #64
		b .return_Directory_list
		.Ldir_list_empty:
		adr x0, .Ldir_list_empty_str
		bl _strdup
		add sp, sp, #64
		b .return_Directory_list
		.Ldir_list_empty_str: .asciz ""
		.p2align 2
		```
		return ""
	}
}
