/**
 * A minimal HTTP/1.1 client built on Tcp.
 *
 * Plain `http://` only — no TLS (an `https://` URL cannot be served; use a
 * TLS proxy or wait for a TLS-capable transport). Construct an instance,
 * call `get`/`post`, then read the `status` field for the response's status
 * code. Fallible calls return a `Result` whose error side is an `HttpError`;
 * `status` is 0 when DNS resolution or the connection fails.
 *
 * Every wait rides Tcp's netpoller hook: inside a Fiber the request parks
 * (freeing its worker) instead of blocking — the same `Http` code scales
 * from one call to thousands of concurrent fibers. See ASYNC_PLAN.md
 * Phase 3.
 *
 * URLs may carry an explicit port (`http://host:8080/path`); the default is
 * 80 and the default path is `/`. `post` sends `body` with a
 * `Content-Type: application/x-www-form-urlencoded` header and a matching
 * `Content-Length`; only the response body (after the blank header/body
 * separator line) is returned.
 *
 *	var Http h = Http()
 *	match h.get("http://example.com/") {
 *		case .ok(body) -> Console.write(body)
 *		case .error(e) -> Console.write("request failed")
 *	}
 *	var int code = h.status
 **/
pub struct Http {
	// HTTP status code from the most recent request (e.g. 200). 0 when the
	// request failed (the `error` side of the get/post Result says why).
	pub var int status = 0

	// Internal failure code from the most recent request: 0 = success,
	// 1 = DNS resolution, 2 = socket creation, 3 = connect, 6 = send failed.
	// Mirrors Tcp's codes on the connect path; the Result-returning wrappers
	// map it to HttpError.
	var int error = 0

	// Maps the raw failure code to its HttpError case.
	func error_of = (int err, out HttpError) {
		switch {
			case err == 1 {
				return HttpError.dns
			}
			case err == 2 {
				return HttpError.socket
			}
			case err == 3 {
				return HttpError.connect
			}
			else {
				return HttpError.other
			}
		}
	}

	// Shared socket round-trip used by get/post. `method` is the request
	// method string ("GET" / "POST"); a leading 'P' selects POST semantics
	// (sends `body` and the Content-* headers). Sets self->status (0 on
	// failure) and self->error, and returns the response body (empty string
	// on failure).
	func raw_exchange = (ref self, string method, string url, string body, move out string) {
		// Parse the URL: [http://]host[:port][/path]
		var int host_start = 0
		if url.starts_with("http://") {
			host_start = 7
		}
		var int slash = url.index_of_from("/", host_start)
		var int colon = url.index_of_from(":", host_start)
		var int host_end = url.length
		if slash >= 0 {
			host_end = slash
		}
		var int name_end = host_end
		if colon >= 0 {
			if colon < host_end {
				name_end = colon
			}
		}
		var int port = 80
		if name_end != host_end {
			var string port_text = url.substring(name_end + 1, host_end)
			port = int.parse(port_text)
		}
		var string host = url.substring(host_start, name_end)
		var string path = "/"
		if slash >= 0 {
			path = url.substring(slash, url.length)
		}

		// Connect — parks a fiber while the handshake completes.
		var Tcp conn = Tcp.connect(host, port)
		if conn.fd < 0 {
			self.status = 0
			self.error = conn.error
			return ""
		}

		// Build the request head.
		var string request = method + " " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n"
		if method.starts_with("P") {
			request = request + "Content-Type: application/x-www-form-urlencoded\r\nContent-Length: \{body.length}\r\n\r\n"
		} else {
			request = request + "\r\n"
		}

		// Send — parks while the socket back-pressures.
		var bool sent = conn.send(request)
		if sent {
			if method.starts_with("P") {
				sent = conn.send(body)
			}
		}
		if !sent {
			conn.close()
			self.status = 0
			self.error = 6
			return ""
		}

		// Receive until the peer closes (how Connection: close HTTP works).
		// (Named `wire`, not `response`: the aarch64 build-global moved-set is
		// name-keyed, and a bare `return response` here would suppress the
		// return-path free of get/post's own `response` local — see the
		// FOLLOWUP.md entry.)
		var string wire = conn.recv_all()
		conn.close()

		self.error = 0
		// Status line: "HTTP/1.x NNN ..." — the code lives at bytes 9..12.
		if wire.starts_with("HTTP/") && wire.length >= 12 {
			var string code_text = wire.substring(9, 12)
			self.status = int.parse(code_text)
		} else {
			self.status = 0
		}

		// Body starts after the blank header/body separator line.
		var int sep = wire.index_of("\r\n\r\n")
		if sep >= 0 {
			return wire.substring(sep + 4, wire.length)
		}
		return wire
	}

	// Issue a GET request to `url`. `.ok(body)` with the response body and
	// `self.status` set to the response's status code, or
	// `.error(HttpError)` (`status` is 0).
	pub func get = (ref self, string url, out Result<string, HttpError>) {
		const string response = self.raw_exchange("GET", url, "")
		if self.error == 0 {
			return Result.ok(response)
		}
		return Result.error(Http.error_of(self.error))
	}

	// Issue a POST request to `url` with `body` as the payload.
	// `.ok(body)` with the response body and `self.status` set to the
	// response's status code, or `.error(HttpError)` (`status` is 0).
	pub func post = (ref self, string url, string body, out Result<string, HttpError>) {
		const string response = self.raw_exchange("POST", url, body)
		if self.error == 0 {
			return Result.ok(response)
		}
		return Result.error(Http.error_of(self.error))
	}
}
