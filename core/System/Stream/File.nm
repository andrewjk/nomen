/**
 * A file handle for reading and writing, plus static one-shot helpers.
 *
 * Open a `File` with a mode string (`"r"`, `"w"`, `"a"`, …). It is closed automatically when
 * it goes out of scope; call `close` to release it earlier. Read methods set the `eof` flag
 * when they reach the end of the file.
 *
 * Every operation that can fail returns a `Result` whose error side is a `FileError`. A
 * handle whose `open` failed (or that was closed) reports `FileError.not_open` from later
 * operations instead of crashing.
 *
 * ```
 * var w = File()
 * match w.open("notes.txt", "w") {
 *     case .ok(ok) {
 *         var _ = w.writeLine("hello")
 *         var _ = w.close()
 *     }
 *     case .fail(e) -> Console.write_line("could not open")
 * }
 *
 * var r = File()
 * var _ = r.open("notes.txt", "r")
 * match r.readLine() {
 *     case .ok(line) -> Console.write_line(line)
 *     case .fail(e) -> Console.write_line("could not read")
 * }
 * ```
 *
 * The static helpers do the open, read or write, and close in one call:
 *
 * ```
 * var _ = File.write_all("out.txt", "payload")
 * const body = File.read_all("out.txt")
 * if File.exists("out.txt") {
 *     var _ = File.delete("out.txt")
 * }
 * ```
 **/
pub mv struct File {
	/**
	 * The underlying OS file handle (internal; 0 while not open).
	 **/
	internal var uint64 handle = 0
	/**
	 * Set once a read reaches the end of the file.
	 **/
	pub var eof = false
	/**
	 * The errno of the last operation, 0 for success (internal; the methods report it as a
	 * `FileError`).
	 **/
	// errno of the last operation; 0 = success. Raw #arch bodies set it,
	// the Result-returning wrappers map it to FileError.
	internal var last_error = 0

	/**
	 * The `FileError` case for an errno value.
	 **/
	func error_of = (int err, out FileError) {
		switch {
			case err == 2 {
				return FileError.not_found
			}
			case err == 9 {
				return FileError.not_open
			}
			case err == 13 {
				return FileError.access_denied
			}
			case err == 17 {
				return FileError.already_exists
			}
			case _ {
			return FileError.other
		}
		}
	}

	/**
	 * Low-level `open`: records the errno in `last_error` instead of returning a `Result`.
	 **/
	// Open the file at `path` with a C mode string ("r", "w", "a", …).
	// Stores the handle and records errno (0 on success) in `last_error`.
	internal func raw_open = (ref self {}, string path, string mode) {
		#if META.arch == "c" {
			#raw("file") {
				#include <errno.h>
			}
		}
		#if META.arch == "c" {
			#raw {
				// Fat-string ABI: strings pass their ptr half at FFI boundaries.
				self->handle = (unsigned long long)fopen(path.ptr, mode.ptr);
				if (self->handle) {
					self->last_error = 0;
				} else {
					self->last_error = errno;
				}
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// Fat-string ABI: path = (x1, x2), mode = (x3, x4).
				mov x0, x1
				mov x1, x3
				bl _fopen
				str x0, [x19, #8]
				cbnz x0, .Lfile_open_ok
				bl ___error
				ldr w0, [x0]
				str x0, [x19, #24]
				b .Lfile_open_end
				.Lfile_open_ok:
				str xzr, [x19, #24]
				.Lfile_open_end:
			}
		}
	}

	/**
	 * Open the file at `path` with a C mode string: `"r"` read, `"w"` write (truncating),
	 * `"a"` append, and so on. `.ok(true)` on success, `.fail(FileError)` otherwise.
	 **/
	pub func open = (ref self {}, string path, string mode, out Result<bool, FileError>) {
		self.raw_open(path, mode)
		if self.last_error == 0 {
			return Result.ok(true)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `close`: records the errno in `last_error` instead of returning a `Result`.
	 **/
	// Close the handle, recording errno in `last_error` (0 on success). Also
	// performed automatically by #destroy; calling close explicitly releases
	// the resource early.
	internal func raw_close = (ref self {}) {
		#if META.arch == "c" {
			#raw {
				if (self->handle) {
					if (fclose((FILE*)(unsigned long long)self->handle)) {
						self->last_error = errno;
					} else {
						self->handle = 0;
						self->last_error = 0;
					}
				} else {
					self->last_error = 0;
				}
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				ldr x0, [x19, #8]
				cbz x0, .Lfile_close_clean
				bl _fclose
				cbnz w0, .Lfile_close_err
				str xzr, [x19, #8]
				str xzr, [x19, #24]
				b .Lfile_close_end
				.Lfile_close_err:
				bl ___error
				ldr w0, [x0]
				str x0, [x19, #24]
				b .Lfile_close_end
				.Lfile_close_clean:
				str xzr, [x19, #24]
				.Lfile_close_end:
			}
		}
	}

	/**
	 * Close the file now rather than when it goes out of scope. Closing a file that is not
	 * open (or already closed) is `.ok(true)`.
	 **/
	pub func close = (ref self {}, out Result<bool, FileError>) {
		self.raw_close()
		if self.last_error == 0 {
			return Result.ok(true)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `readAll`: sets `eof` and `last_error` instead of returning a `Result`.
	 **/
	// Declared `mv out string`: the raw body mallocs a fresh buffer and hands ownership
	// to the caller.
	internal func raw_read_all = (ref self {}, mv out string) {
		#if META.arch == "c" {
			#raw {
				FILE *f = (FILE*)(unsigned long long)self->handle;
				if (!f) { self->last_error = 9; return (nomen_string){ NULL, 0 }; }
				fseek(f, 0, SEEK_END);
				long size = ftell(f);
				fseek(f, 0, SEEK_SET);
				char *buf = (char*)malloc(size + 1);
				fread(buf, 1, size, f);
				buf[size] = 0;
				self->eof = 1;
				self->last_error = 0;
				// size bytes were read — the count is exact, no strlen.
				return (nomen_string){ buf, size };
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				ldr x0, [x19, #8]
				cbnz x0, .Lfile_read_all_go
				mov x0, #9
				str x0, [x19, #24]
				mov x0, #0
				mov x1, #0
				b .return_File_raw_read_all
				.Lfile_read_all_go:
				sub sp, sp, #16
				ldr x0, [x19, #8]
				mov x1, #0
				mov x2, #2
				bl _fseek
				ldr x0, [x19, #8]
				bl _ftell
				str x0, [sp, #0]
				ldr x0, [x19, #8]
				mov x1, #0
				mov x2, #0
				bl _fseek
				ldr x0, [sp, #0]
				add x0, x0, #1
				bl _malloc
				str x0, [sp, #8]
				ldr x0, [sp, #8]
				mov x1, #1
				ldr x2, [sp, #0]
				ldr x3, [x19, #8]
				bl _fread
				ldr x0, [sp, #8]
				ldr x1, [sp, #0]
				strb wzr, [x0, x1]
				mov w1, #1
				strb w1, [x19, #16]
				str xzr, [x19, #24]
				ldr x0, [sp, #8]
				ldr x1, [sp, #0]          // fat len half = size read
				add sp, sp, #16
				b .return_File_raw_read_all
			}
		}
		return ""
	}

	/**
	 * Read everything from the current position to the end of the file. `.ok(text)` (with
	 * `eof` set), or `.fail(FileError)`, including `not_open` when the file isn't open.
	 **/
	pub func readAll = (ref self {}, out Result<string, FileError>) {
		const string body = self.raw_read_all()
		if self.last_error == 0 {
			return Result.ok(body)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `writeAll`: records the errno in `last_error` instead of returning a
	 * `Result`.
	 **/
	internal func raw_write_all = (ref self {}, string data) {
		#if META.arch == "c" {
			#raw {
				FILE *f = (FILE*)(unsigned long long)self->handle;
				if (!f) { self->last_error = 9; return; }
				// Byte-exact write of the tracked length (fputs stopped at the
				// first embedded NUL).
				fwrite(data.ptr, 1, data.len, f);
				self->last_error = 0;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// Fat-string ABI: data = (x1 ptr, x2 len).
				ldr x3, [x19, #8]
				cbnz x3, .Lfile_write_all_go
				mov x0, #9
				str x0, [x19, #24]
				b .return_File_raw_write_all
				.Lfile_write_all_go:
				// fwrite(ptr, 1, len, f) — byte-exact (fputs truncated at NUL)
				mov x0, x1
				mov x1, #1
				bl _fwrite
				str xzr, [x19, #24]
			}
		}
	}

	/**
	 * Write `data` at the current position. `.ok(true)`, or `.fail(FileError)`, including
	 * `not_open` when the file isn't open.
	 **/
	pub func writeAll = (ref self {}, string data, out Result<bool, FileError>) {
		self.raw_write_all(data)
		if self.last_error == 0 {
			return Result.ok(true)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `readLine`: sets `eof` and `last_error` instead of returning a `Result`.
	 **/
	// The raw body mallocs a fresh buffer — `mv out string` transfers it.
	internal func raw_read_line = (ref self {}, mv out string) {
		#if META.arch == "c" {
			#raw {
				FILE *f = (FILE*)(unsigned long long)self->handle;
				if (!f) { self->last_error = 9; return (nomen_string){ NULL, 0 }; }
				int cap = 16;
				int len = 0;
				char *buf = (char*)malloc(cap);
				int c = fgetc(f);
				while (c != EOF && c != '\n') {
					if (len + 1 >= cap) {
						cap *= 2;
						buf = (char*)realloc(buf, cap);
					}
					buf[len++] = (char)c;
					c = fgetc(f);
				}
				buf[len] = 0;
				if (c == EOF) self->eof = 1;
				self->last_error = 0;
				return (nomen_string){ buf, len };
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				ldr x0, [x19, #8]
				cbnz x0, .Lfile_read_line_go
				mov x0, #9
				str x0, [x19, #24]
				mov x0, #0
				mov x1, #0
				b .return_File_raw_read_line
				.Lfile_read_line_go:
				sub sp, sp, #32
				mov x0, #16
				bl _malloc
				str x0, [sp, #0]
				mov x1, #16
				str x1, [sp, #8]
				str xzr, [sp, #16]
				ldr x0, [x19, #8]
				bl _fgetc
				str w0, [sp, #24]
				.Lfile_read_line_loop:
				ldr w0, [sp, #24]
				cmp w0, #0
				blt .Lfile_read_line_done
				cmp w0, #10
				beq .Lfile_read_line_done
				ldr x0, [sp, #16]
				add x0, x0, #1
				ldr x1, [sp, #8]
				cmp x0, x1
				ble .Lfile_read_line_store
				ldr x1, [sp, #8]
				lsl x1, x1, #1
				str x1, [sp, #8]
				ldr x0, [sp, #0]
				bl _realloc
				str x0, [sp, #0]
				.Lfile_read_line_store:
				ldr x0, [sp, #0]
				ldr x1, [sp, #16]
				ldr w2, [sp, #24]
				strb w2, [x0, x1]
				ldr x0, [sp, #16]
				add x0, x0, #1
				str x0, [sp, #16]
				ldr x0, [x19, #8]
				bl _fgetc
				str w0, [sp, #24]
				b .Lfile_read_line_loop
				.Lfile_read_line_done:
				ldr x0, [sp, #0]
				ldr x1, [sp, #16]
				strb wzr, [x0, x1]
				ldr w0, [sp, #24]
				cmp w0, #0
				bge .Lfile_read_line_ret
				mov w1, #1
				strb w1, [x19, #16]
				.Lfile_read_line_ret:
				str xzr, [x19, #24]
				ldr x0, [sp, #0]
				ldr x1, [sp, #16]         // fat len half
				add sp, sp, #32
				b .return_File_raw_read_line
			}
		}
		return ""
	}

	/**
	 * Read the next line, without its trailing newline. `.ok(text)`, with `eof` set at the
	 * end of the file, or `.fail(FileError)`.
	 **/
	pub func readLine = (ref self {}, out Result<string, FileError>) {
		const string line = self.raw_read_line()
		if self.last_error == 0 {
			return Result.ok(line)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `writeLine`: records the errno in `last_error` instead of returning a
	 * `Result`.
	 **/
	internal func raw_write_line = (ref self {}, string data) {
		#if META.arch == "c" {
			#raw {
				FILE *f = (FILE*)(unsigned long long)self->handle;
				if (!f) { self->last_error = 9; return; }
				// Byte-exact write of the tracked length (fputs stopped at the
				// first embedded NUL).
				fwrite(data.ptr, 1, data.len, f);
				fputc('\n', f);
				self->last_error = 0;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// Fat-string ABI: data = (x1 ptr, x2 len).
				ldr x3, [x19, #8]
				cbnz x3, .Lfile_write_line_go
				mov x0, #9
				str x0, [x19, #24]
				b .return_File_raw_write_line
				.Lfile_write_line_go:
				// fwrite(ptr, 1, len, f) — byte-exact (fputs truncated at NUL)
				mov x0, x1
				mov x1, #1
				bl _fwrite
				mov w0, #10
				ldr x1, [x19, #8]
				bl _fputc
				str xzr, [x19, #24]
			}
		}
	}

	/**
	 * Write `data` followed by a newline. `.ok(true)`, or `.fail(FileError)`.
	 **/
	pub func writeLine = (ref self {}, string data, out Result<bool, FileError>) {
		self.raw_write_line(data)
		if self.last_error == 0 {
			return Result.ok(true)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `readChunk`: sets `eof` and `last_error` instead of returning a `Result`.
	 **/
	// The raw body mallocs a fresh buffer — `mv out string` transfers it.
	internal func raw_read_chunk = (ref self {}, int size, mv out string) {
		#if META.arch == "c" {
			#raw {
				FILE *f = (FILE*)(unsigned long long)self->handle;
				if (!f) { self->last_error = 9; return (nomen_string){ NULL, 0 }; }
				char *buf = (char*)malloc(size + 1);
				long n = fread(buf, 1, size, f);
				buf[n] = 0;
				if (n < size) self->eof = 1;
				self->last_error = 0;
				return (nomen_string){ buf, n };
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				ldr x0, [x19, #8]
				cbnz x0, .Lfile_read_chunk_go
				mov x0, #9
				str x0, [x19, #24]
				mov x0, #0
				mov x1, #0
				b .return_File_raw_read_chunk
				.Lfile_read_chunk_go:
				sub sp, sp, #16
				str x1, [sp, #0]
				ldr x0, [sp, #0]
				add x0, x0, #1
				bl _malloc
				str x0, [sp, #8]
				ldr x0, [sp, #8]
				mov x1, #1
				ldr x2, [sp, #0]
				ldr x3, [x19, #8]
				bl _fread
				ldr x1, [sp, #8]
				strb wzr, [x1, x0]
				ldr x2, [sp, #0]
				cmp x0, x2
				bge .Lfile_read_chunk_ret
				mov w3, #1
				strb w3, [x19, #16]
				.Lfile_read_chunk_ret:
				str xzr, [x19, #24]
				ldr x0, [sp, #8]
				ldr x1, [sp, #0]          // fat len half = bytes read
				add sp, sp, #16
				b .return_File_raw_read_chunk
			}
		}
		return ""
	}

	/**
	 * Read up to `size` bytes from the current position. `.ok(text)` (with `eof` set when
	 * fewer than `size` bytes were left), or `.fail(FileError)`.
	 **/
	pub func readChunk = (ref self {}, int size, out Result<string, FileError>) {
		const string chunk = self.raw_read_chunk(size)
		if self.last_error == 0 {
			return Result.ok(chunk)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Low-level `writeChunk`: records the errno in `last_error` instead of returning a
	 * `Result`.
	 **/
	internal func raw_write_chunk = (ref self {}, string data, int size) {
		#if META.arch == "c" {
			#raw {
				FILE *f = (FILE*)(unsigned long long)self->handle;
				if (!f) { self->last_error = 9; return; }
				fwrite(data.ptr, 1, size, f);
				self->last_error = 0;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// Fat-string ABI: data = (x1, x2), size in x3.
				ldr x4, [x19, #8]
				cbnz x4, .Lfile_write_chunk_go
				mov x0, #9
				str x0, [x19, #24]
				b .return_File_raw_write_chunk
				.Lfile_write_chunk_go:
				mov x0, x1
				mov x2, x3
				mov x1, #1
				mov x3, x4
				bl _fwrite
				str xzr, [x19, #24]
			}
		}
	}

	/**
	 * Write the first `size` bytes of `data` at the current position. `.ok(true)`, or
	 * `.fail(FileError)`.
	 **/
	pub func writeChunk = (ref self {}, string data, int size, out Result<bool, FileError>) {
		self.raw_write_chunk(data, size)
		if self.last_error == 0 {
			return Result.ok(true)
		}
		return Result.fail(File.error_of(self.last_error))
	}

	/**
	 * Whether a file exists at `path`. A missing file is `false`, not an error.
	 **/
	pub func exists = (string path, out bool) {
		#if META.arch == "c" {
			#raw {
				struct stat st;
				return stat(path.ptr, &st) == 0 ? 1 : 0;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				sub sp, sp, #160
				mov x1, sp
				bl _stat
				cmp x0, #0
				cset x0, eq
				add sp, sp, #160
				b .return_File_exists
			}
		}
		return false
	}

	/**
	 * Low-level `delete`: returns the errno (0 on success) instead of a `Result`.
	 **/
	internal func raw_delete = (string path, out int) {
		#if META.arch == "c" {
			#raw {
				if (remove(path.ptr)) return errno;
				return 0;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				bl _remove
				cbz w0, .Lfile_delete_ok
				bl ___error
				ldr w0, [x0]
				b .return_File_raw_delete
				.Lfile_delete_ok:
				mov x0, #0
				b .return_File_raw_delete
			}
		}
		return 0
	}

	/**
	 * Delete the file at `path`. `.ok(true)`, or `.fail(FileError)`.
	 **/
	pub func delete = (string path, out Result<bool, FileError>) {
		const int err = File.raw_delete(path)
		if err == 0 {
			return Result.ok(true)
		}
		return Result.fail(File.error_of(err))
	}

	/**
	 * Read the whole file at `path` in one call (open, read, close). `.ok(text)`, or
	 * `.fail(FileError)`.
	 **/
	pub func read_all = (string path, out Result<string, FileError>) {
		var Result<string, FileError> result = .fail(FileError.other)
		var f = File()
		match f.open(path, "r") {
			case .ok(did) {
				match f.readAll() {
					case .ok(text) {
						result = .ok(text)
					}
					case .fail(e2) {
						result = .fail(e2)
					}
				}
			}
			case .fail(e) {
				result = .fail(e)
			}
		}
		return result
	}

	/**
	 * Write `data` to the file at `path` in one call, replacing anything already there.
	 * `.ok(true)`, or `.fail(FileError)`.
	 **/
	// A write failure is reported as `.fail`, not silently swallowed (the `checked`
	// Result discard check forces ignoring it to be deliberate).
	pub func write_all = (string path, string data, out Result<bool, FileError>) {
		var Result<bool, FileError> result = .fail(FileError.other)
		var f = File()
		match f.open(path, "w") {
			case .ok(did) {
				match f.writeAll(data) {
					case .ok(did2) {
						result = f.close()
					}
					case .fail(e2) {
						var _ = f.close()
						result = .fail(e2)
					}
				}
			}
			case .fail(e) {
				result = .fail(e)
			}
		}
		return result
	}

	// Closes the handle if still open (no-op after close). Runs automatically
	// at scope exit, so an unclosed `File` never leaks. Best-effort: failures
	// are not reported (use `close` to observe them).
	func #destroy = (self) {
		#if META.arch == "c" {
			#raw {
				if (self->handle) {
					fclose((FILE*)(unsigned long long)self->handle);
					self->handle = 0;
				}
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				ldr x0, [x19, #8]
				cbz x0, .Lfile_destroy_end
				bl _fclose
				.Lfile_destroy_end:
				str xzr, [x19, #8]
			}
		}
	}
}
