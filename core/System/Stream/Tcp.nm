// Tcp — non-blocking sockets for Nomen tasks.
//
// Sockets are put in non-blocking mode and every wait goes through the
// runtime's netpoller hook (`__nomen_io_wait`): inside a Fiber the task parks
// (freeing its worker) until the socket is readable/writable; on a plain
// thread the hook blocks in poll(). So the same code scales from a handful of
// connections to thousands, and no call blocks a shared worker while it
// waits. See ASYNC.md Phase 3.
//
// Raw helpers return file descriptors / error codes (int-shaped), so the
// class wrappers construct the Tcp instances in Nomen. `error` mirrors
// Http's convention: 0 = ok, 1 = DNS, 2 = socket, 3 = connect, 4 = listen,
// 5 = closed.
//
//	var Tcp server = Tcp.listen(8080, 128)
//	async {
//		var Tcp conn = server.accept()
//		var bool ok = conn.send("hello")
//		conn.close()
//	}
//
// The method bodies are C (compiled directly on the C backend, and via the
// linked companion on aarch64) — OS socket/DNS interop, where hand-written
// per-target assembly is not practical.

// Tcp is an OWNING STRUCT (STRUCT_PLAN_3 Phase R, tranche 3 — the shape
// menu): the fields are the fd and an error code — the fd is the handle, so
// the value is movable and `#destroy` closes it. A moved Tcp transfers the
// socket; there is no aliasing copy to double-close.

/**
 * A TCP socket. `Tcp.listen` opens a server socket and `accept` takes its connections;
 * `Tcp.connect` opens a client connection. `send`, `recv` and `recv_all` transfer data.
 *
 * Waits never block a shared worker: inside a fiber the task parks until the socket is
 * ready, and on a plain thread the call blocks. A `Tcp` owns its socket, which is closed
 * when the value goes out of scope (or by `close`); moving it moves the socket.
 *
 * ```
 * var server = Tcp.listen(8080, 128)
 * var conn = server.accept()
 * if conn.is_open() {
 *     const sent = conn.send("hello")
 *     conn.close()
 * }
 * ```
 **/
pub mv struct Tcp {
	/**
	 * The socket's file descriptor, or -1 when it is closed or failed to open.
	 **/
	pub var int fd = -1
	/**
	 * Why the last operation failed: 0 ok, 1 DNS lookup, 2 socket creation, 3 connect, 4
	 * listen, 5 closed.
	 **/
	pub var last_error = 0

	/**
	 * Wrap an existing socket file descriptor.
	 **/
	pub func #init = (ref self, int handle) {
		self.fd = handle
		self.last_error = 0
	}

	/**
	 * Close the socket if it is still open. Runs automatically when the value goes out of
	 * scope.
	 **/
	pub func #destroy = (self) {
		#if META.arch == "c" {
			#raw {
				if (self->fd >= 0) {
					close(self->fd);
					self->fd = -1;
				}
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				if (self->fd >= 0) {
					close(self->fd);
					self->fd = -1;
				}
			}
		}
	}

	/**
	 * Close the socket now. Does nothing if it is already closed.
	 **/
	pub func close = (ref self {}) {
		Tcp.close_fd(self.fd)
		self.fd = -1
	}

	/**
	 * Whether the socket is open (`fd >= 0`).
	 **/
	pub func is_open = (self, out bool) => self.fd >= 0

	// ---- listening ----

	/**
	 * A server socket listening on `port` on all interfaces, with room for `backlog`
	 * pending connections. Check `is_open()` (or `last_error`) for success.
	 **/
	pub func listen = (int port, int backlog, mv out Tcp) {
		var int handle = Tcp.listen_fd(port, backlog)
		var t = Tcp(handle)
		if handle < 0 {
			t.last_error = 4
		}
		return t
	}

	/**
	 * Wait for and return the next incoming connection. The result is not open (`fd` -1)
	 * when the listener was cancelled or failed.
	 **/
	pub func accept = (ref self {}, mv out Tcp) {
		var int handle = Tcp.accept_fd(self.fd)
		var t = Tcp(handle)
		if handle < 0 {
			t.last_error = 5
		}
		return t
	}

	// ---- connecting ----

	/**
	 * Open a connection to `host` on `port`. Check `is_open()` (or `last_error == 0`) for
	 * success.
	 **/
	pub func connect = (string host, int port, mv out Tcp) {
		var int handle = Tcp.socket_fd()
		if handle < 0 {
			var bad = Tcp(-1)
			bad.last_error = 2
			return bad
		}
		var int err = Tcp.connect_to(handle, host, port)
		if err != 0 {
			Tcp.close_fd(handle)
			var bad = Tcp(-1)
			bad.last_error = err
			return bad
		}
		return Tcp(handle)
	}

	// ---- transferring ----

	/**
	 * Send all of `data`, waiting while the send buffer is full. Returns false on error or
	 * cancellation.
	 **/
	pub func send = (ref self {}, string data, out bool) {
		return Tcp.send_all(self.fd, data)
	}

	/**
	 * Receive up to `max` bytes, waiting until some arrive. Returns "" at end of stream, on
	 * error, or when cancelled.
	 **/
	pub func recv = (ref self {}, int max, mv out string) {
		return Tcp.recv_some(self.fd, max)
	}

	/**
	 * Receive everything until the peer closes the connection (as `Connection: close` HTTP
	 * does).
	 **/
	pub func recv_all = (ref self {}, mv out string) {
		return Tcp.recv_until_close(self.fd)
	}

	// ---- raw helpers (int-shaped, so the wrappers above build the Tcp) ----

	/**
	 * Low-level: create a non-blocking socket and return its descriptor (-1 on failure).
	 **/
	internal func socket_fd = (out int) {
		#if META.arch == "c" {
			#raw("file") {
				#include <sys/socket.h>
				#include <netdb.h>
				#include <netinet/in.h>
				#include <arpa/inet.h>
				#include <fcntl.h>
				#include <unistd.h>
				#include <string.h>
				#include <stdlib.h>
				#include <errno.h>
				#include <stdbool.h>
			}
		}
		#if META.arch == "c" {
			#raw {
				int handle = socket(AF_INET, SOCK_STREAM, 0);
				if (handle < 0) return -1;
				fcntl(handle, F_SETFL, fcntl(handle, F_GETFL, 0) | O_NONBLOCK);
				return handle;
			}
		}
		#if META.arch == "aarch64" {
			#raw("c", "file") {
				#include <sys/socket.h>
				#include <netdb.h>
				#include <netinet/in.h>
				#include <arpa/inet.h>
				#include <fcntl.h>
				#include <unistd.h>
				#include <string.h>
				#include <stdlib.h>
				#include <errno.h>
				#include <stdbool.h>
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				int handle = socket(AF_INET, SOCK_STREAM, 0);
				if (handle < 0) return -1;
				fcntl(handle, F_SETFL, fcntl(handle, F_GETFL, 0) | O_NONBLOCK);
				return handle;
			}
		}
	}

	/**
	 * Low-level: create a socket listening on `port` and return its descriptor (-1 on
	 * failure).
	 **/
	internal func listen_fd = (int port, int backlog, out int) {
		#if META.arch == "c" {
			#raw {
				int handle = socket(AF_INET, SOCK_STREAM, 0);
				if (handle < 0) return -1;
				int one = 1;
				setsockopt(handle, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
				struct sockaddr_in addr;
				memset(&addr, 0, sizeof(addr));
				addr.sin_family = AF_INET;
				addr.sin_addr.s_addr = htonl(INADDR_ANY);
				addr.sin_port = htons((unsigned short)port);
				if (bind(handle, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
					close(handle);
					return -1;
				}
				if (listen(handle, backlog) < 0) {
					close(handle);
					return -1;
				}
				fcntl(handle, F_SETFL, fcntl(handle, F_GETFL, 0) | O_NONBLOCK);
				return handle;
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				int handle = socket(AF_INET, SOCK_STREAM, 0);
				if (handle < 0) return -1;
				int one = 1;
				setsockopt(handle, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
				struct sockaddr_in addr;
				memset(&addr, 0, sizeof(addr));
				addr.sin_family = AF_INET;
				addr.sin_addr.s_addr = htonl(INADDR_ANY);
				addr.sin_port = htons((unsigned short)port);
				if (bind(handle, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
					close(handle);
					return -1;
				}
				if (listen(handle, backlog) < 0) {
					close(handle);
					return -1;
				}
				fcntl(handle, F_SETFL, fcntl(handle, F_GETFL, 0) | O_NONBLOCK);
				return handle;
			}
		}
	}

	/**
	 * Low-level: accept a connection on the `listener` descriptor (-1 on failure).
	 **/
	internal func accept_fd = (int listener, out int) {
		#if META.arch == "c" {
			#raw {
				for (;;) {
					int handle = accept(listener, NULL, NULL);
					if (handle >= 0) {
						fcntl(handle, F_SETFL, fcntl(handle, F_GETFL, 0) | O_NONBLOCK);
						return handle;
					}
					if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return -1;
					if (!__nomen_io_wait(listener, 0)) return -1;
				}
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				for (;;) {
					int handle = accept(listener, NULL, NULL);
					if (handle >= 0) {
						fcntl(handle, F_SETFL, fcntl(handle, F_GETFL, 0) | O_NONBLOCK);
						return handle;
					}
					if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return -1;
					if (!__nomen_io_wait(listener, 0)) return -1;
				}
			}
		}
	}

	/**
	 * Low-level: connect the descriptor `handle` to `host`:`port`. Returns 0 on success, or
	 * an error code (1 DNS lookup, 3 connect).
	 **/
	internal func connect_to = (int handle, string host, int port, out int) {
		#if META.arch == "c" {
			#raw {
				char portstr[16];
				snprintf(portstr, sizeof(portstr), "%d", port);
				struct addrinfo hints, *res = NULL;
				memset(&hints, 0, sizeof(hints));
				hints.ai_family = AF_INET;
				hints.ai_socktype = SOCK_STREAM;
				if (getaddrinfo(host.ptr, portstr, &hints, &res) != 0) return 1;
				int rc = connect(handle, res->ai_addr, res->ai_addrlen);
				freeaddrinfo(res);
				if (rc == 0) return 0;
				if (errno != EINPROGRESS) return 3;
				if (!__nomen_io_wait(handle, 1)) return 3;
				int so_err = 0;
				socklen_t so_len = sizeof(so_err);
				if (getsockopt(handle, SOL_SOCKET, SO_ERROR, &so_err, &so_len) < 0) return 3;
				return so_err == 0 ? 0 : 3;
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				char portstr[16];
				snprintf(portstr, sizeof(portstr), "%d", port);
				struct addrinfo hints, *res = NULL;
				memset(&hints, 0, sizeof(hints));
				hints.ai_family = AF_INET;
				hints.ai_socktype = SOCK_STREAM;
				if (getaddrinfo(host.ptr, portstr, &hints, &res) != 0) return 1;
				int rc = connect(handle, res->ai_addr, res->ai_addrlen);
				freeaddrinfo(res);
				if (rc == 0) return 0;
				if (errno != EINPROGRESS) return 3;
				if (!__nomen_io_wait(handle, 1)) return 3;
				int so_err = 0;
				socklen_t so_len = sizeof(so_err);
				if (getsockopt(handle, SOL_SOCKET, SO_ERROR, &so_err, &so_len) < 0) return 3;
				return so_err == 0 ? 0 : 3;
			}
		}
	}

	/**
	 * Low-level: send all of `data` on the descriptor `handle`. Returns false on failure.
	 **/
	internal func send_all = (int handle, string data, out bool) {
		#if META.arch == "c" {
			#raw {
				long off = 0;
				while (off < data.len) {
					ssize_t n = send(handle, data.ptr + off, (size_t)(data.len - off), 0);
					if (n > 0) {
						off += (long)n;
						continue;
					}
					if (errno == EAGAIN || errno == EWOULDBLOCK) {
						if (!__nomen_io_wait(handle, 1)) return false;
						continue;
					}
					if (errno == EINTR) continue;
					return false;
				}
				return true;
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				long off = 0;
				while (off < data.len) {
					ssize_t n = send(handle, data.ptr + off, (size_t)(data.len - off), 0);
					if (n > 0) {
						off += (long)n;
						continue;
					}
					if (errno == EAGAIN || errno == EWOULDBLOCK) {
						if (!__nomen_io_wait(handle, 1)) return false;
						continue;
					}
					if (errno == EINTR) continue;
					return false;
				}
				return true;
			}
		}
	}

	/**
	 * Low-level: receive up to `max` bytes from the descriptor `handle`.
	 **/
	internal func recv_some = (int handle, int max, mv out string) {
		#if META.arch == "c" {
			#raw {
				long cap = max > 0 ? max : 1;
				char *buf = (char *)malloc((size_t)cap);
				for (;;) {
					ssize_t n = recv(handle, buf, (size_t)cap, 0);
					if (n > 0) return (nomen_string){ buf, (long)n };
					if (n == 0) {
						free(buf);
						return (nomen_string){ strdup(""), 0 };
					}
					if (errno == EAGAIN || errno == EWOULDBLOCK) {
						if (!__nomen_io_wait(handle, 0)) {
							free(buf);
							return (nomen_string){ strdup(""), 0 };
						}
						continue;
					}
					if (errno == EINTR) continue;
					free(buf);
					return (nomen_string){ strdup(""), 0 };
				}
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				long cap = max > 0 ? max : 1;
				char *buf = (char *)malloc((size_t)cap);
				for (;;) {
					ssize_t n = recv(handle, buf, (size_t)cap, 0);
					if (n > 0) return (nomen_string){ buf, (long)n };
					if (n == 0) {
						free(buf);
						return (nomen_string){ strdup(""), 0 };
					}
					if (errno == EAGAIN || errno == EWOULDBLOCK) {
						if (!__nomen_io_wait(handle, 0)) {
							free(buf);
							return (nomen_string){ strdup(""), 0 };
						}
						continue;
					}
					if (errno == EINTR) continue;
					free(buf);
					return (nomen_string){ strdup(""), 0 };
				}
			}
		}
	}

	/**
	 * Low-level: receive from the descriptor `handle` until the peer closes.
	 **/
	internal func recv_until_close = (int handle, mv out string) {
		#if META.arch == "c" {
			#raw {
				long cap = 4096, len = 0;
				char *buf = (char *)malloc((size_t)cap);
				for (;;) {
					if (len + 1 >= cap) {
						cap *= 2;
						buf = (char *)realloc(buf, (size_t)cap);
					}
					ssize_t n = recv(handle, buf + len, (size_t)(cap - len - 1), 0);
					if (n > 0) {
						len += (long)n;
						continue;
					}
					if (n == 0) break;
					if (errno == EAGAIN || errno == EWOULDBLOCK) {
						if (!__nomen_io_wait(handle, 0)) break;
						continue;
					}
					if (errno == EINTR) continue;
					break;
				}
				buf[len] = 0;
				return (nomen_string){ buf, len };
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				long cap = 4096, len = 0;
				char *buf = (char *)malloc((size_t)cap);
				for (;;) {
					if (len + 1 >= cap) {
						cap *= 2;
						buf = (char *)realloc(buf, (size_t)cap);
					}
					ssize_t n = recv(handle, buf + len, (size_t)(cap - len - 1), 0);
					if (n > 0) {
						len += (long)n;
						continue;
					}
					if (n == 0) break;
					if (errno == EAGAIN || errno == EWOULDBLOCK) {
						if (!__nomen_io_wait(handle, 0)) break;
						continue;
					}
					if (errno == EINTR) continue;
					break;
				}
				buf[len] = 0;
				return (nomen_string){ buf, len };
			}
		}
	}

	/**
	 * Low-level: close the descriptor `handle`.
	 **/
	internal func close_fd = (int handle) {
		#if META.arch == "c" {
			#raw {
				if (handle >= 0) close(handle);
			}
		}
		#if META.arch == "aarch64" {
			#raw("c") {
				if (handle >= 0) close(handle);
			}
		}
	}
}
