// Arena-backed doubly-linked list. Values and next/prev links live in flat
// Buffers, so there is a single owner and cleanup is a flat free — no recursive
// pointer chasing, no borrow lifetimes. Node identifiers are stable int indices
// (read `count` before `add`); -1 means "no node" / "end".

/**
 * A doubly-linked list of values. Nodes are identified by stable integer indices: `add`
 * stores a value as node `length()` (read it before adding), `set_next` / `set_previous` link
 * nodes, and -1 means "no node".
 **/
pub mv struct LinkedList<T>: Enumerable {
	/**
	 * Node values, by node index (internal storage).
	 **/
	internal var values = Buffer<T>()
	/**
	 * Each node's next node, or -1 (internal storage).
	 **/
	internal mv nexts = Buffer<int>()
	/**
	 * Each node's previous node, or -1 (internal storage).
	 **/
	internal mv prevs = Buffer<int>()
	/**
	 * The index of the first node added, or -1 when the list is empty.
	 **/
	var int head = -1
	/**
	 * The number of nodes.
	 **/
	var count = 0

	/**
	 * Store `value` as a new, unlinked node; its index is the node count before the call.
	 * The first node added becomes `head`. The value moves into the list.
	 **/
	pub func add = (ref self { nexts, prevs, values }, mv T value) {
		var int idx = self.count
		self.values.grow(idx + 1)
		// The value arrives owned (`mv T value`): move a value-struct element
		// that OWNS resources into the fresh slot (the caller's storage
		// zeroes, no deep copy). A non-owning value struct is a legal bare
		// argument, so it keeps the copying store; strings keep the
		// deep-copying store too (their pair arrives by value).
		if T_TAKES_OWNERSHIP {
			self.values.store_take(idx, value)
		} else {
			self.values.store(idx, value)
		}
		self.nexts.grow_int(idx + 1)
		self.nexts.store_int(idx, -1)
		self.prevs.grow_int(idx + 1)
		self.prevs.store_int(idx, -1)
		self.count += 1
		if self.head == -1 {
			self.head = idx
		}
	}

	/**
	 * Link node `next` after node `idx` (also setting `next`'s previous link to `idx`).
	 * Pass -1 for no next node.
	 **/
	pub func set_next = (ref self { nexts, prevs }, int idx, int next) {
		self.nexts.store_int(idx, next)
		if next >= 0 && next < self.prevs.cap {
			self.prevs.store_int(next, idx)
		}
	}

	/**
	 * Link node `prev` before node `idx` (also setting `prev`'s next link to `idx`). Pass
	 * -1 for no previous node.
	 **/
	pub func set_previous = (ref self { nexts, prevs }, int idx, int prev) {
		self.prevs.store_int(idx, prev)
		if prev >= 0 && prev < self.nexts.cap {
			self.nexts.store_int(prev, idx)
		}
	}

	/**
	 * The node after node `idx`, or -1 at the end.
	 **/
	pub func next_at = (self, int idx, out int: out >= -1 && out < self.count) {
		return self.nexts.load_int(idx)
	}

	/**
	 * The node before node `idx`, or -1 at the start.
	 **/
	pub func previous_at = (self, int idx, out int: out >= -1 && out < self.count) {
		return self.prevs.load_int(idx)
	}

	/**
	 * The value of node 0. The list must be provably non-empty.
	 **/
	pub func first = (self: self.count > 0, out T) {
		return self.values.load(0)
	}

	/**
	 * The value of node `idx`. The index must be provably within `[0, count)`.
	 **/
	pub func at = (self, int idx: idx >= 0 && idx < self.count, out T) {
		return self.values.load(idx)
	}

	/**
	 * The value of node `idx`, or `fallback` when `idx` is out of range.
	 **/
	pub func at_or = (self, int idx, T fallback, out T) {
		if idx >= 0 && idx < self.count {
			return self.at(idx)
		}
		return fallback
	}

	/**
	 * The value of node `idx`. Panics when `idx` is out of range.
	 **/
	pub func at_or_panic = (self, int idx, out T) {
		if idx >= 0 && idx < self.count {
			return self.at(idx)
		}
		panic("index out of range")
	}

	/**
	 * The value of node `idx`, or `null` when `idx` is out of range.
	 **/
	pub func at_or_null = (self, int idx, out T?) {
		if idx >= 0 && idx < self.count {
			return self.at(idx)
		}
		return null
	}

	/**
	 * The number of nodes.
	 **/
	pub func length = (self, out int) {
		return self.count
	}
}
