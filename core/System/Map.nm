/**
 * An ordered key-value map with `set`/`get`/`get_or`/`has`/`remove`. Keys must be
 * `Hashable` (hashed to a `uint` via `key.hash()`) and `Equatable` (compared
 * with `==`); values may be any type.
 *
 * The capacity is always a power of two (initial 8, doubling on rehash), so
 * bucket indexing is a mask (`hash & (cap - 1)`) instead of a division — and
 * it is correct for negative hashes too: two's-complement `&` already lands
 * in `[0, cap)`, which is why no negative adjustment is needed.
 **/
pub struct Map<TK: Hashable + Equatable, TV> {
	var length = 0
	var Buffer<TK> keys = Buffer<TK>()
	var Buffer<TV> values = Buffer<TV>()
	var used = Buffer<int>()

	// Variadic-tuple constructor: Map<string, int>(["a", 1], ["b", 2]) or
	// Map(["a", 1], ["b", 2]) (type args inferred from the first pair).
	// Zero pairs yields an empty Map, so this also covers Map<K, V>().
	pub func #init = (self, ...[TK, TV] pairs) {
		var i = 0
		while i < pairs.length; i += 1 {
			self.set(pairs.at(i)._0, pairs.at(i)._1)
		}
	}

	pub func set = (ref self, move TK key, move TV value) {
		var int cap = self.keys.cap
		if cap == 0 {
			// alloc_T: for Buffer<TK> it is T_SIZE-aware (string keys are
			// 16-byte slots); for ClassBuffer<TV> it delegates to alloc_int
			// (one pointer per slot). Both have it for generic parity.
			cap = self.keys.alloc(8)
			self.values.alloc(8)
			self.used.alloc_u32(8)
		}
		if self.length * 4 >= cap * 3 {
			self.rehash(cap * 2)
			cap = self.keys.cap
		}
		var int idx = self.find_slot(key, cap)
		if self.used.load_u32(idx) == 0 {
			self.used.store_u32(idx, 1)
			self.keys.store(idx, key)
			self.values.store(idx, value)
			self.length += 1
		} else {
			self.values.replace(idx, value)
		}
	}

	pub func get = (self, TK key, out TV) {
		var int cap = self.keys.cap
		if cap == 0 {
			return 0
		}
		var int idx = self.find_slot(key, cap)
		if self.used.load_u32(idx) == 0 {
			return 0
		}
		return self.values.load(idx)
	}

	// Fused lookup-with-fallback: one probe instead of the `has` + `get`
	// pair (which probes twice) for the common "default when missing" shape.
	pub func get_or = (self, TK key, TV fallback, out TV) {
		var int cap = self.keys.cap
		if cap == 0 {
			return fallback
		}
		var int idx = self.find_slot(key, cap)
		if self.used.load_u32(idx) == 0 {
			return fallback
		}
		return self.values.load(idx)
	}

	// Lookup that traps when the key is absent — for when a missing key is
	// a bug, not a case (and `get`'s 0-for-missing would be ambiguous).
	pub func get_or_panic = (self, TK key, out TV) {
		var int cap = self.keys.cap
		if cap == 0 {
			panic("key not found")
		}
		var int idx = self.find_slot(key, cap)
		if self.used.load_u32(idx) == 0 {
			panic("key not found")
		}
		return self.values.load(idx)
	}

	pub func has = (self, TK key, out bool) {
		var int cap = self.keys.cap
		if cap == 0 {
			return false
		}
		var int idx = self.find_slot(key, cap)
		return self.used.load_u32(idx) != 0
	}

	pub func remove = (ref self, TK key) {
		var int cap = self.keys.cap
		if cap == 0 {
			return
		}
		var int idx = self.find_slot(key, cap)
		if self.used.load_u32(idx) == 0 {
			return
		}
		// Backward-shift deletion for linear probing. `gap` is the empty slot
		// walking forward through the cluster; `k` scans ahead of it. An entry
		// at k shifts into the gap only if the gap still lies within its valid
		// probe range ([home, k) cyclically); otherwise the entry stays put and
		// we keep scanning, because a later entry may still belong behind the
		// gap. This is the subtle point: k advances independently of the gap,
		// so entries past a non-moveable one are not stranded behind an empty
		// slot (which would make find_slot miss them). No tombstones, so
		// find_slot/get/has/set are unchanged, and the cost is the local cluster
		// length — not a full O(cap) rehash on every delete.
		var int gap = idx
		var int k = idx
		while true {
			k += 1
			if k >= cap {
				k = 0
			}
			if self.used.load_u32(k) == 0 {
				break
			}
			var int home = (self.keys.load(k).hash() as int) & (cap - 1)
			var int dgap = gap - home
			if dgap < 0 {
				dgap = dgap + cap
			}
			var int dk = k - home
			if dk < 0 {
				dk = dk + cap
			}
			if dgap < dk {
				// shift_T (not store_T): transfers the entry's owned pointers
				// wholesale and reclaims the displaced slot's value. store_T
				// would strdup a fresh copy into gap while leaving the source
				// slot's pointer stranded at the vacated slot — leaked once
				// used.store marks it empty (the buffer destroy skips it).
				self.keys.shift(gap, k)
				self.values.shift(gap, k)
				self.used.store_u32(gap, 1)
				gap = k
			}
		}
		self.used.store_u32(gap, 0)
		self.length = self.length - 1
	}

	func find_slot = (self, TK key, int cap, out int: out >= 0 && out < cap) {
		// cap is a power of two, so this is `hash mod cap` via a mask —
		// non-negative for any hash (two's complement), no adjustment.
		var int idx = (key.hash() as int) & (cap - 1)
		while self.used.load_u32(idx) != 0 {
			if self.keys.load(idx) == key {
				return idx
			}
			idx += 1
			if idx >= cap {
				idx = 0
			}
		}
		return idx
	}

	func rehash = (ref self, int new_cap) {
		var Buffer<TK> old_keys = move self.keys swap Buffer<TK>()
		var Buffer<TV> old_values = move self.values swap Buffer<TV>()
		var Buffer<int> old_used = move self.used swap Buffer<int>()
		var int old_cap = old_keys.cap

		self.keys.alloc(new_cap)
		self.values.alloc(new_cap)
		self.used.alloc_u32(new_cap)
		self.length = 0

		var i = 0
		while i < old_cap; i += 1 {
			if old_used.load_u32(i) != 0 {
				// move_T (not load_T) relinquishes the old slot, so each
				// key/value is owned by exactly one buffer (the new self)
				// afterwards. load_T would leave the old slot referencing
				// the same class pointer — a double-free when old_keys is
				// destroyed. The results are bound to locals so an
				// owning-element copy (e.g. a `Buffer<string>` slot, which
				// store_T strdup's) is freed here once the new buffer has
				// made its own copy — passing them inline would orphan the
				// move_T results.
				var TK k = old_keys.move(i)
				var TV v = old_values.move(i)
				self.set(move k, move v)
			}
		}
	}
}
