// FFI: the C library's heap-copy entry point (string.h). The adapter
// marshals the fat string to the thin char* the C ABI expects; the string
// result is re-wrapped with its length.
extern func strdup = (string s, move out string)

/**
 * A UTF-8 text string — a heap-owned, length-tracked sequence of bytes
 **/
pub struct string: Stringable, Hashable, Equatable {
	pub func hash = (self, out uint) {
		// djb2 over exactly self.length bytes — matches the byte count of
		// owned strings and literals (views hash the viewed bytes only).
		var uint h = 5381
		var i = 0
		while i < self.length; i += 1 {
			h = h * 33 + (self.at(i) as uint)
		}
		return h
	}

	// Returns an OWNED copy of self (`move out string`). Both backends hand
	// back a fresh allocation the caller frees — never an alias of self's
	// storage — so the result can outlive the receiver (e.g. escape a match
	// branch that reclaims the scrutinee temp). Goes through the `strdup`
	// extern: the adapter marshals self.ptr to libc and re-wraps the copy
	// with its length.
	pub func to_string = (self, move out string) {
		return strdup(self)
	}

	pub func at = (self, int index: index >= 0 && index < self.length, out char) {
		```
		#arch: c
		return self[index];
		```
		```
		#arch: aarch64
		// Fat-string ABI: x19 = self ptr, x20 = self len; index in x2
		// (self's pair occupies slots 0-1).
		ldrb w0, [x19, x2]
		```
	}

	// Bounds-checked access: `fallback` when index is outside
	// [0, self.length).
	pub func at_or = (self, int index, char fallback, out char) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		return fallback
	}

	// Bounds-checked access that traps when index is outside
	// [0, self.length) — out-of-range is a bug, not a case.
	pub func at_or_panic = (self, int index, out char) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		panic("index out of range")
	}

	// A non-owning slice [start, end) into self's buffer. Returns a `view
	// string` (ptr, len) that borrows from self: it may not outlive self's
	// scope and is invalidated if self is reassigned. Use .to_string() to
	// materialize an owned copy.
	pub func slice = (
		self,
		int start: start >= 0 && start <= self.length,
		int end: end >= start && end <= self.length,
		out view string
	) {
		```
		#arch: c
		nomen_view _r;
		_r.ptr = (void*)(self + start);
		_r.len = (long)(end - start);
		return _r;
		```
		```
		#arch: aarch64
		// view string is (ptr, len), returned in the x0/x1 register pair.
		// Fat-string ABI: x19 = self ptr, x20 = self len; start in x2,
		// end in x3 (self's pair occupies slots 0-1).
		add x0, x19, x2     // ptr = self + start
		sub x1, x3, x2      // len = end - start
		```
	}

	pub func set = (ref self, int index: index >= 0 && index < self.length, char value) {
		```
		#arch: c
		(*self)[index] = value;
		```
		```
		#arch: aarch64
		// x19 = self (pointer), x1 = index, w2 = value
		strb w2, [x19, x1]
		```
	}

	pub func #op_eq = (self, string other, out bool) {
		```
		#arch: c
		return strcmp(self, other) == 0;
		```
		```
		#arch: aarch64
		// Fat-string ABI: x19/x20 = self (ptr, len); other = (x2 ptr, x3
		// len). Equal lengths + equal bytes — no NUL scan.
		stp x20, x21, [sp, #-16]!
		cmp x20, x3
		b.ne .Lstring_eq_len_ne
		mov x0, x19
		mov x1, x2
		mov x2, x20
		bl _memcmp
		cmp x0, #0
		cset x0, eq
		b .Lstring_eq_done
		.Lstring_eq_len_ne:
		mov x0, #0
		.Lstring_eq_done:
		ldp x20, x21, [sp], #16
		```
	}

	pub func #op_add = (self, string other, out string) {
		```
		#arch: c
		int left_len = strlen(self);
		int right_len = strlen(other);
		char* result = malloc(left_len + right_len + 1);
		strcpy(result, self);
		strcat(result, other);
		return result;
		```
		```
		#arch: aarch64
		// Fat-string ABI: x19/x20 = self (ptr, len); other = (x2 ptr, x3
		// len). Two memcpys of known length — no strlen/strcpy/strcat.
		// Returns the (buf, total) pair.
		stp x21, x22, [sp, #-16]!
		stp x2, x3, [sp, #-16]!      // other (ptr, len)
		add x0, x20, x3
		add x0, x0, #1
		bl _malloc
		mov x21, x0                  // buf (callee-saved across memcpys)
		mov x0, x21
		mov x1, x19
		mov x2, x20
		bl _memcpy                   // left half
		ldp x1, x2, [sp]             // other ptr, len
		add x0, x21, x20
		bl _memcpy                   // right half
		ldp x1, x2, [sp], #16        // reload other len; pop
		add x3, x20, x2              // total bytes
		add x0, x21, x3
		strb wzr, [x0]               // NUL-terminate for libc consumers
		mov x1, x3
		mov x0, x21
		ldp x21, x22, [sp], #16
		```
	}

	pub func #op_mul = (self, int count, out string) {
		```
		#arch: c
		size_t str_len = strlen(self);
		size_t total = str_len * (size_t)count + 1;
		char* buf = malloc(total);
		char* p = buf;
		for (int i = 0; i < count; i++) {
			memcpy(p, self, str_len);
			p += str_len;
		}
		*p = 0;
		return buf;
		```
		```
		#arch: aarch64
		// Fat-string ABI: x19/x20 = self (ptr, len); count in x2. memcpy
		// loop of known stride; returns the (buf, total) pair.
		stp x20, x21, [sp, #-16]!
		stp x22, x23, [sp, #-16]!
		stp x24, x25, [sp, #-16]!
		mov x21, x20            // self len (stride)
		mov x22, x2             // count
		mul x23, x21, x22       // total bytes
		add x0, x23, #1
		bl _malloc
		mov x24, x0             // buf
		mov x25, x0             // cursor
		.Lstring_mul_loop:
		cbz x22, .Lstring_mul_done
		mov x0, x25
		mov x1, x19
		mov x2, x21
		bl _memcpy
		add x25, x25, x21
		sub x22, x22, #1
		b .Lstring_mul_loop
		.Lstring_mul_done:
		add x0, x24, x23
		strb wzr, [x0]          // NUL-terminate for libc consumers
		mov x1, x23
		mov x0, x24
		ldp x24, x25, [sp], #16
		ldp x22, x23, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// Replace the first non-overlapping occurrence of needle with
	// replacement. No match — or an empty needle — returns an owned copy
	// of self. Views pass straight in (no `to_string` copy): both sides
	// are only ever read.
	pub func replace_first = (self, view string needle, view string replacement, out string) {
		var sb = StringBuilder()
		var int i = 0
		var int n = self.length
		var int nlen = needle.length
		var bool replaced = nlen == 0
		while i < n {
			if !replaced && nlen > 0 && i + nlen <= n && match_at(self, needle, i) {
				sb.append_string_view(replacement)
				i = i + nlen
				replaced = true
			} else {
				sb.append_char(self.at(i))
				i = i + 1
			}
		}
		return sb.to_string()
	}

	// Replace all non-overlapping occurrences of needle with replacement,
	// left to right. Same edge behavior as replace_first.
	pub func replace_all = (self, view string needle, view string replacement, out string) {
		var sb = StringBuilder()
		var int i = 0
		var int n = self.length
		var int nlen = needle.length
		while i < n {
			if nlen > 0 && i + nlen <= n && match_at(self, needle, i) {
				sb.append_string_view(replacement)
				i = i + nlen
			} else {
				sb.append_char(self.at(i))
				i = i + 1
			}
		}
		return sb.to_string()
	}

	// First index of `needle` in self, or -1 when absent. An empty needle
	// matches at 0 (JavaScript indexOf semantics).
	pub func index_of = (self, view string needle, out int) {
		return self.index_of_from(needle, 0)
	}

	// First index of `needle` at or after byte offset `from`, or -1. `from`
	// is clamped into [0, self.length]; an empty needle returns the clamped
	// `from`, so a `from` past the end yields self.length for the empty
	// needle and -1 otherwise.
	pub func index_of_from = (self, view string needle, int from, out int) {
		var int f = from
		if f < 0 {
			f = 0
		}
		if f > self.length {
			f = self.length
		}
		if needle.length == 0 {
			return f
		}
		var int last = self.length - needle.length
		var int i = f
		while i <= last; i += 1 {
			if match_at(self, needle, i) {
				return i
			}
		}
		return -1
	}

	// Whether `needle` occurs anywhere in self.
	pub func contains = (self, view string needle, out bool) {
		return self.index_of(needle) >= 0
	}

	// Whether self begins with `prefix`.
	pub func starts_with = (self, view string prefix, out bool) {
		if prefix.length > self.length {
			return false
		}
		return match_at(self, prefix, 0)
	}

	// Whether self ends with `suffix`.
	pub func ends_with = (self, view string suffix, out bool) {
		if suffix.length > self.length {
			return false
		}
		return match_at(self, suffix, self.length - suffix.length)
	}

	// The code of the byte at `index`, or -1 when out of bounds — the
	// JavaScript charCodeAt NaN case as a plain int parsers can test.
	pub func char_code_at = (self, int index, out int) {
		if index >= 0 {
			if index < self.length {
				return self.at(index) as int
			}
		}
		return -1
	}

	// Owned copy of self[start, end) with both bounds clamped into
	// [0, self.length] and an inverted pair swapped (JavaScript substring
	// semantics: out-of-range operands can never trap).
	pub func substring = (self, int start, int end, out string) {
		var int a = start
		var int b = end
		if a < 0 {
			a = 0
		}
		if a > self.length {
			a = self.length
		}
		if b > self.length {
			b = self.length
		}
		if b < a {
			b = a
		}
		var view v = self.slice(a, b)
		return v.to_string()
	}

	// Owned copy of self with leading and trailing ASCII whitespace
	// (tab, LF, VT, FF, CR, space) removed. All-whitespace yields "".
	pub func trim = (self, out string) {
		var int start = 0
		while start < self.length; start += 1 {
			if !is_space_byte(self.char_code_at(start)) {
				break
			}
		}
		var int end = self.length
		while end > start; end -= 1 {
			if !is_space_byte(self.char_code_at(end - 1)) {
				break
			}
		}
		var view v = self.slice(start, end)
		return v.to_string()
	}

	// Owned copy of self with trailing ASCII whitespace removed.
	pub func trim_end = (self, out string) {
		var int end = self.length
		while end > 0; end -= 1 {
			if !is_space_byte(self.char_code_at(end - 1)) {
				break
			}
		}
		var view v = self.slice(0, end)
		return v.to_string()
	}

	// Owned copy of self with leading ASCII whitespace removed.
	pub func trim_start = (self, out string) {
		var int start = 0
		while start < self.length; start += 1 {
			if !is_space_byte(self.char_code_at(start)) {
				break
			}
		}
		var view v = self.slice(start, self.length)
		return v.to_string()
	}

	// Owned ASCII-lowercased copy of self (A-Z mapped to a-z; all other
	// bytes — including UTF-8 sequences — pass through unchanged).
	pub func to_lowercase = (self, out string) {
		var sb = StringBuilder()
		var int i = 0
		while i < self.length; i += 1 {
			var int code = self.at(i) as int
			if code > 64 && code < 91 {
				code += 32
			}
			sb.append_char(code as char)
		}
		return sb.to_string()
	}

	// Owned ASCII-uppercased copy of self (a-z mapped to A-Z; all other
	// bytes — including UTF-8 sequences — pass through unchanged).
	pub func to_uppercase = (self, out string) {
		var sb = StringBuilder()
		var int i = 0
		while i < self.length; i += 1 {
			var int code = self.at(i) as int
			if code > 96 && code < 123 {
				code -= 32
			}
			sb.append_char(code as char)
		}
		return sb.to_string()
	}
}

// ASCII whitespace byte: tab, LF, VT, FF, CR, space.
func is_space_byte = (int code, out bool) {
	return (code >= 9 && code <= 13) || code == 32
}

// needle matches text at byte offset pos (caller guarantees pos + len fits;
// the trailing guard makes the bound explicit so `.at` verifies).
func match_at = (view string text, view string needle, int pos, out bool) {
	var int i = 0
	var int nlen = needle.length
	var int n = text.length
	while i < nlen && pos + i < n {
		if text.at(pos + i) != needle.at(i) {
			return false
		}
		i = i + 1
	}
	return i == nlen
}
