
pub struct string: Stringable {
    pub func to_string = (self, out string) {
        ```
        #arch: c
        return strdup(self);
        ```
        ```
        #arch: aarch64
        mov x0, x19
        ```
    }

    pub func at = (self, int index: index >= 0 && index < self.length, out char) {
        ```
        #arch: c
        return self[index];
        ```
        ```
        #arch: aarch64
        // x19 = self (pointer), x1 = index
        ldrb w0, [x19, x1]
        ```
    }

    // A non-owning slice [start, end) into self's buffer. Returns a `view
    // string` (ptr, len) that borrows from self: it may not outlive self's
    // scope and is invalidated if self is reassigned. Use .to_string() to
    // materialize an owned copy.
    pub func slice = (self, int start: start >= 0 && start <= self.length, int end: end >= start && end <= self.length, out view string) {
        ```
        #arch: c
        nomen_view _r;
        _r.ptr = (void*)(self + start);
        _r.len = (long)(end - start);
        return _r;
        ```
        ```
        #arch: aarch64
        // view string is (ptr, len), returned in the x0/x1 register pair.
        // x19 = self (char*), x1 = start, x2 = end (retained through prologue).
        add x0, x19, x1     // ptr = self + start
        sub x1, x2, x1      // len = end - start
        ```
    }

	pub func set = (ref self, int index: index >= 0 && index < self.length, char value) {
		```
		#arch: c
		(*self)[index] = value;
		```
        ```
        #arch: aarch64
        // x19 = self (pointer), x1 = index, w2 = value
        strb w2, [x19, x1]
        ```
    }

    pub func #op_add = (self, string other, out string) {
        ```
        #arch: c
        int left_len = strlen(self);
        int right_len = strlen(other);
        char* result = malloc(left_len + right_len + 1);
        strcpy(result, self);
        strcat(result, other);
        return result;
        ```
        ```
        #arch: aarch64
        stp x20, x21, [sp, #-16]!
        mov x20, x1
        bl _strlen
        mov x21, x0
        mov x0, x20
        bl _strlen
        add x0, x21, x0
        add x0, x0, #1
        bl _malloc
        mov x21, x0
        mov x1, x19
        bl _strcpy
        mov x0, x21
        mov x1, x20
        bl _strcat
        mov x0, x21
        ldp x20, x21, [sp], #16
        ```
    }

    pub func #op_mul = (self, int count, out string) {
        ```
        #arch: c
        size_t str_len = strlen(self);
        size_t total = str_len * (size_t)count + 1;
        char* buf = malloc(total);
        char* p = buf;
        for (int i = 0; i < count; i++) {
            memcpy(p, self, str_len);
            p += str_len;
        }
        *p = 0;
        return buf;
        ```
        ```
        #arch: aarch64
        stp x20, x21, [sp, #-16]!
        stp x22, xzr, [sp, #-16]!
        mov x20, x1
        bl _strlen
        mov x21, x0
        mul x0, x0, x20
        add x0, x0, #1
        bl _malloc
        str x0, [x29, #8]
        mov x22, x0
        .Lmul_loop:
        cbz x20, .Lmul_done
        mov x0, x22
        mov x1, x19
        mov x2, x21
        bl _memcpy
        add x22, x22, x21
        sub x20, x20, #1
        b .Lmul_loop
        .Lmul_done:
        strb wzr, [x22]
        ldr x0, [x29, #8]
        ldp x22, xzr, [sp], #16
        ldp x20, x21, [sp], #16
        ```
    }
}
