/**
 * A fixed-length array of values, created with a literal (`[1, 2, 3]`) and addressable by index
 **/
pub struct Array<T>: Viewable {
	pub const int length

	pub func #init = (...T items) {
		```
		#arch: c
		self->length = _items_len;
		T* data = (T*)((char*)self + sizeof(*self));
		for (int i = 0; i < _items_len; i++) data[i] = items[i];
		```
		```
		#arch: aarch64
		// x19 = self (struct pointer), variadic items packed at call site
		// _items_len at [x29, #0], items ptr at [x29, #8]

		// Store length
		ldr x0, [x29, #0]
		str x0, [x19, #8]

		// Copy items: memcpy(self + 16, items, len * T_SIZE)
		ldr x2, [x29, #0]
		mov x3, #T_SIZE
		mul x2, x2, x3
		add x0, x19, #16
		ldr x1, [x29, #8]
		bl _memcpy
		```
	}

	// Inline-storage element access — `unsafe` Nomen single-sourced for both
	// backends (docs/CORE_RAW.md roadmap item 2). `self[index]` lowers to the
	// element base each backend already uses for Array receivers (C skips the
	// struct header; aarch64's receiver IS the first element).
	pub inline func at = (self, int index: index >= 0 && index < self.length, out T) {
		unsafe {
			return self[index]
		}
	}

	pub func first = (self: self.length > 0, out T) {
		unsafe {
			return self[0]
		}
	}

	// The string-slot specialization the raw `#if T_NEEDS_STRDUP` blocks used
	// to express: T_NEEDS_STRDUP is a per-instantiation constant the
	// monomorphizer substitutes (true for string, false otherwise) and folds,
	// so each mono body keeps only its arm.
	pub func set = (ref self, int index: index >= 0 && index < self.length, T value) {
		unsafe {
			if T_NEEDS_STRDUP {
				// T is string: a fat value whose backing bytes must be
				// heap-copied per slot — otherwise the slot would share the
				// incoming pointer and auto_free would double-free it. Free
				// the displaced slot's bytes (no local: a named copy would be
				// auto-freed too), then store a fresh deep copy.
				free((self[index] as ptr char) as uint64)
				self[index] = strdup(value)
			} else {
				self[index] = value
			}
		}
	}

	// Bounds-checked accessors — the runtime-checked escape hatch for
	// indices the constraint checker can't prove (see PERF.md gap 5). Unlike
	// every other Array method these have Nomen-level bodies: the method-call
	// receiver conventions for Array receivers (first-element pointer on
	// aarch64, struct Array_<T>* on C) are passed through unchanged, and the
	// bodies read self.length / self.at through them.
	pub func at_or = (self, int index, T fallback, out T) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		return fallback
	}

	pub func at_or_panic = (self, int index, out T) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		panic("index out of range")
	}

	pub func at_end = (self, out T) {
		unsafe {
			return self[self.length - 1]
		}
	}

	// A non-mv (ptr, len) slice [start, end) over self's inline element
	// storage, returned as a `view T`. Borrows from self (may not outlive it,
	// invalidated on reassignment). Element access via view.at / view.length.
	pub func slice = (
		self,
		int start: start >= 0 && start <= self.length,
		int end: end >= start && end <= self.length,
		out view T
	) {
		```
		#arch: c
		nomen_view _r;
		T* _data = (T*)((char*)self + sizeof(*self));
		_r.ptr = (void*)(_data + start);
		_r.len = (long)(end - start);
		return _r;
		```
		```
		#arch: aarch64
		// x19 = self (first elem), x1 = start, x2 = end.
		// Return (ptr, len) in x0/x1.
		mov x3, #T_SIZE
		madd x0, x1, x3, x19
		sub x1, x2, x1
		```
	}

	pub func with = (T value, int count: count >= 0, out Array<T>: out.length == count) {
		```
		#arch: c
		long _header = 16;
		void* _result = malloc(_header + count * T_SIZE);
		((long*)_result)[1] = count;
		T* _data = (T*)((char*)_result + _header);
		for (long i = 0; i < count; i++) {
			// T_NEEDS_STRDUP is 1 when T is string (a fat value whose backing
			// bytes must be heap-copied per slot — otherwise all n slots would
			// share one pointer and auto_free would n-free it). For all other
			// T it is 0 and the plain assignment runs.
			#if T_NEEDS_STRDUP
				_data[i] = nomen_str_dup(value);
			#else
				_data[i] = value;
			#endif
		}
		return _result;
		```
	```
	#arch: aarch64
	// Returns x0 = heap-allocated array pointer ([ptr]=length, [ptr+8..]=data).
	// Entry dispatch (the asm twin of the C body's #if T_NEEDS_STRDUP): a
	// FAT T (string) arrives as the (ptr, len) pair in x0/x1 with the count
	// in x2; a thin T arrives as the value in x0 with the count in x1.
	// STRUCT_PLAN_3 B1 cutover: a FAT seed must be strdup'd per slot — every
	// slot sharing one pointer would be freed n times by the mv
	// set/destroy paths (pre-B1 the displaced-set free was record-guarded,
	// so a raw rodata seed was simply never freed).
	stp x19, x20, [sp, #-16]!
	mov x7, #T_FAT
	cmp x7, #1
	b.eq .Larray_with_fat_entry
	// Thin: [sp] = value, count in x1.
	stp xzr, x0, [sp, #-16]!
	mov x19, x1
	b .Larray_with_counted
	.Larray_with_fat_entry:
	// Fat: [sp] = len, [sp+8] = ptr; count in x2.
	stp x1, x0, [sp, #-16]!
	mov x19, x2
	.Larray_with_counted:

	// ptr = malloc(8 + count * T_SIZE)
	mov x2, #T_SIZE
	mul x0, x19, x2
	add x0, x0, #8
	bl _malloc
	mov x20, x0                 // x20 = base pointer
	str x19, [x20]              // [ptr] = count

	cbz x19, .Larray_with_end
	mov x2, #0                  // i = 0
	.Larray_with_loop:
	mov x3, #T_SIZE
	mul x4, x2, x3
	add x5, x20, #8
	add x5, x5, x4              // addr = data + offset

	// T_FAT (string): strdup the seed's ptr half into each slot.
	mov x7, #T_FAT
	cmp x7, #1
	b.ne .Larray_with_plain
	ldr x0, [sp, #8]
	cbz x0, .Larray_with_pair
	bl _strdup
	ldr x1, [sp]
	str x0, [x5]
	str x1, [x5, #8]
	b .Larray_with_next
	.Larray_with_pair:
	stp xzr, xzr, [x5]
	b .Larray_with_next

	.Larray_with_plain:
	// Store the value (parked at [sp+8]) using a width that matches
	// T_SIZE. For T_SIZE <= 8 the value is a scalar; T_SIZE > 8 (a
	// non-fat struct) byte-copies from the parked pointer.
	cmp x3, #8
	b.gt .Larray_with_copy_loop
	cmp x3, #4
	b.eq .Larray_with_store4
	cmp x3, #2
	b.eq .Larray_with_store2
	cmp x3, #1
	b.eq .Larray_with_store1
	ldr x0, [sp, #8]
	str x0, [x5]
	b .Larray_with_next
	.Larray_with_store4:
	ldr x0, [sp, #8]
	str w0, [x5]
	b .Larray_with_next
	.Larray_with_store2:
	ldr x0, [sp, #8]
	strh w0, [x5]
	b .Larray_with_next
	.Larray_with_store1:
	ldr x0, [sp, #8]
	strb w0, [x5]
	b .Larray_with_next

	.Larray_with_copy_loop:
	// Struct element (T_SIZE > 8): [sp+8] is a pointer to the bytes —
	// copy them one by one so adjacent slots aren't clobbered.
	mov x6, #0
	ldr x0, [sp, #8]
	.Larray_with_byte:
	ldrb w7, [x0, x6]
	strb w7, [x5, x6]
	add x6, x6, #1
	cmp x6, x3
	blt .Larray_with_byte

	.Larray_with_next:
	add x2, x2, #1
	cmp x2, x19
	blt .Larray_with_loop

	.Larray_with_end:
	mov x0, x20                 // return heap pointer
	add sp, sp, #16             // pop the parked value pair
	ldp x19, x20, [sp], #16
	// Fall through to the builder's .return epilogue (it pops the raw
	// block's stack frame) — a bare `ret` here would skip it.
	```
	}

	pub func add = (self, Array other, out Array) {
		```
		#arch: c
		long _self_len = self->length;
		long _other_len = other->length;
		long _result_len = _self_len + _other_len;
		long _header = sizeof(*self);
		void* _result = malloc(_header + _result_len * T_SIZE);
		((long*)_result)[0] = 0;
		((long*)_result)[1] = _result_len;
		T* _data = (T*)((char*)_result + _header);
		T* self_data = (T*)((char*)self + _header);
		T* other_data = (T*)((char*)other + _header);
		memcpy(_data, self_data, _self_len * T_SIZE);
		memcpy(_data + _self_len, other_data, _other_len * T_SIZE);
		return _result;
		```
		```
		#arch: aarch64
		// x19 = self (first elem), x20 = other (first elem), x8 = return buf (first elem)
		// Length prefix is at [base - 8]

		// Save return buffer (clobbered by _memcpy)
		str x8, [sp, #-16]!

		// Load lengths and store result length
		ldr x2, [x19, #-8]
		ldr x3, [x20, #-8]
		add x4, x2, x3
		ldr x8, [sp]
		str x4, [x8, #-8]

		// self_bytes = self_len * T_SIZE
		mov x5, #T_SIZE
		mul x5, x2, x5

		// memcpy(return_buf, self, self_bytes)
		mov x0, x8
		mov x1, x19
		mov x2, x5
		bl _memcpy

		// Reload return buf and self_len (clobbered by memcpy)
		ldr x8, [sp]
		ldr x2, [x19, #-8]
		mov x5, #T_SIZE
		mul x5, x2, x5

		// other_bytes
		ldr x3, [x20, #-8]
		mov x6, #T_SIZE
		mul x6, x3, x6

		// memcpy(return_buf + self_bytes, other, other_bytes)
		add x0, x8, x5
		mov x1, x20
		mov x2, x6
		bl _memcpy

		add sp, sp, #16
		```
	}

	pub func mul = (self, int other, out Array) {
		```
		#arch: c
		long _self_len = self->length;
		long _result_len = _self_len * other;
		long _header = sizeof(*self);
		void* _result = malloc(_header + _result_len * T_SIZE);
		((long*)_result)[0] = 0;
		((long*)_result)[1] = _result_len;
		T* _data = (T*)((char*)_result + _header);
		T* self_data = (T*)((char*)self + _header);
		for (long i = 0; i < other; i++) {
			memcpy(_data + i * _self_len, self_data, _self_len * T_SIZE);
		}
		return _result;
		```
		```
		#arch: aarch64
		// x19 = self (first elem), x1 = multiplier, x8 = return buf (first elem)

		// Save return buf and multiplier
		stp x8, x1, [sp, #-16]!

		// self_len and self_bytes
		ldr x2, [x19, #-8]
		mov x5, #T_SIZE
		mul x5, x2, x5

		// result_len = self_len * multiplier
		mul x3, x2, x1
		ldr x8, [sp]
		str x3, [x8, #-8]

		// Loop: copy self to result multiplier times
		mov x4, #0

		.Larray_mul_loop:
		ldr x1, [sp, #8]
		cmp x4, x1
		b.ge .Larray_mul_end

		// dest = return_buf + x4 * self_bytes
		ldr x8, [sp]
		mul x6, x4, x5
		add x0, x8, x6

		// memcpy(dest, self, self_bytes)
		mov x1, x19
		mov x2, x5
		bl _memcpy

		add x4, x4, #1
		b .Larray_mul_loop

		.Larray_mul_end:
		add sp, sp, #16
		```
	}
}
