/**
 * A fixed-length array of values, created with a literal (`[1, 2, 3]`) and addressable by index
 **/
pub struct Array<T>: Viewable {
	/**
	 * The number of elements. Fixed when the array is created.
	 **/
	pub const int length

	/**
	 * An array holding `items` in order (what an array literal like `[1, 2, 3]` creates).
	 **/
	pub func #init = (self, ...T items) {
		#if META.arch == "c" {
			#raw {
				self->length = _items_len;
				T* data = (T*)((char*)self + sizeof(*self));
				for (int i = 0; i < _items_len; i++) data[i] = items[i];
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// x19 = self (struct pointer), variadic items packed at call site
				// _items_len at [x29, #0], items ptr at [x29, #8]

				// Store length
				ldr x0, [x29, #0]
				str x0, [x19, #8]

				// Copy items: memcpy(self + 16, items, len * T_SIZE)
				ldr x2, [x29, #0]
				mov x3, #T_SIZE
				mul x2, x2, x3
				add x0, x19, #16
				ldr x1, [x29, #8]
				bl _memcpy
			}
		}
	}

	/**
	 * The element at `index`. The index must be provably within `[0, length)`; use `at_or`,
	 * `at_or_null` or `at_or_panic` when it can't be proven at compile time.
	 **/
	// Inline-storage element access — `unsafe` Nomen single-sourced for both
	// backends (docs/CORE_RAW.md roadmap item 2). `self[index]` lowers to the
	// element base each backend already uses for Array receivers (C skips the
	// struct header; aarch64's receiver IS the first element).
	pub inline func at = (self, int index: index >= 0 && index < self.length, out T) {
		unsafe {
			return self[index]
		}
	}

	/**
	 * The first element. The array must be provably non-empty.
	 **/
	pub func first = (self: self.length > 0, out T) {
		unsafe {
			return self[0]
		}
	}

	/**
	 * Replace the element at `index` with `value`. The index must be provably within
	 * `[0, length)`.
	 **/
	// The string-slot specialization the raw `#if T_NEEDS_STRDUP` blocks used
	// to express: T_NEEDS_STRDUP is a per-instantiation constant the
	// monomorphizer substitutes (true for string, false otherwise) and folds,
	// so each mono body keeps only its arm.
	pub func set = (ref self {}, int index: index >= 0 && index < self.length, T value) {
		unsafe {
			if T_NEEDS_STRDUP {
				// T is string: a fat value whose backing bytes must be
				// heap-copied per slot — otherwise the slot would share the
				// incoming pointer and auto_free would double-free it. Free
				// the displaced slot's bytes (no local: a named copy would be
				// auto-freed too), then store a fresh deep copy.
				free((self[index] as ptr char) as uint64)
				self[index] = value.copy()
			} else {
				self[index] = value
			}
		}
	}

	/**
	 * The element at `index`, or `fallback` when `index` is out of range.
	 **/
	// Bounds-checked accessors — the runtime-checked escape hatch for
	// indices the constraint checker can't prove (see PERF.md gap 5). Unlike
	// every other Array method these have Nomen-level bodies: the method-call
	// receiver conventions for Array receivers (first-element pointer on
	// aarch64, struct Array_<T>* on C) are passed through unchanged, and the
	// bodies read self.length / self.at through them.
	pub func at_or = (self, int index, T fallback, out T) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		return fallback
	}

	/**
	 * The element at `index`. Panics when `index` is outside `[0, length)`.
	 **/
	pub func at_or_panic = (self, int index, out T) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		panic("index out of range")
	}

	/**
	 * The element at `index`, or `null` when `index` is out of range
	 * (`arr.at_or_null(i) ?? fallback`).
	 **/
	pub func at_or_null = (self, int index, out T?) {
		if index >= 0 && index < self.length {
			return self.at(index)
		}
		return null
	}

	/**
	 * The last element. The array must not be empty.
	 **/
	pub func at_end = (self, out T) {
		unsafe {
			return self[self.length - 1]
		}
	}

	/**
	 * A borrowed view of the elements in `[start, end)`, without copying. The view may not
	 * outlive the array and is invalidated if the array is reassigned.
	 **/
	pub func slice = (
		self,
		int start: start >= 0 && start <= self.length,
		int end: end >= start && end <= self.length,
		out view T
	) {
		#if META.arch == "c" {
			#raw {
				nomen_view _r;
				T* _data = (T*)((char*)self + sizeof(*self));
				_r.ptr = (void*)(_data + start);
				_r.len = (long)(end - start);
				return _r;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// x19 = self (first elem), x1 = start, x2 = end.
				// Return (ptr, len) in x0/x1.
				mov x3, #T_SIZE
				madd x0, x1, x3, x19
				sub x1, x2, x1
			}
		}
	}

	/**
	 * A new array of `count` elements, each a copy of `value` (`Array.with(0, 10)`).
	 **/
	pub func with = (T value, int count: count >= 0, out Array<T>: out.length == count) {
		#if META.arch == "c" {
			#raw {
				long _header = 16;
				void* _result = malloc(_header + count * T_SIZE);
				((long*)_result)[1] = count;
				T* _data = (T*)((char*)_result + _header);
				for (long i = 0; i < count; i++) {
					// T_NEEDS_STRDUP is 1 when T is string (a fat value whose backing
					// bytes must be heap-copied per slot — otherwise all n slots would
					// share one pointer and auto_free would n-free it). For all other
					// T it is 0 and the plain assignment runs.
					#if T_NEEDS_STRDUP
						_data[i] = nomen_str_dup(value);
					#else
						_data[i] = value;
					#endif
				}
				return _result;
			}
		}
	#if META.arch == "aarch64" {
		#raw {
			// Returns x0 = heap-allocated array pointer ([ptr]=length, [ptr+8..]=data).
			// Entry dispatch (the asm twin of the C body's #if T_NEEDS_STRDUP): a
			// FAT T (string) arrives as the (ptr, len) pair in x0/x1 with the count
			// in x2; a thin T arrives as the value in x0 with the count in x1.
			// STRUCT_PLAN_3 B1 cutover: a FAT seed must be strdup'd per slot — every
			// slot sharing one pointer would be freed n times by the mv
			// set/destroy paths (pre-B1 the displaced-set free was record-guarded,
			// so a raw rodata seed was simply never freed).
			stp x19, x20, [sp, #-16]!
			mov x7, #T_FAT
			cmp x7, #1
			b.eq .Larray_with_fat_entry
			// Thin: [sp] = value, count in x1.
			stp xzr, x0, [sp, #-16]!
			mov x19, x1
			b .Larray_with_counted
			.Larray_with_fat_entry:
			// Fat: [sp] = len, [sp+8] = ptr; count in x2.
			stp x1, x0, [sp, #-16]!
			mov x19, x2
			.Larray_with_counted:

			// ptr = malloc(8 + count * T_SIZE)
			mov x2, #T_SIZE
			mul x0, x19, x2
			add x0, x0, #8
			bl _malloc
			mov x20, x0                 // x20 = base pointer
			str x19, [x20]              // [ptr] = count

			cbz x19, .Larray_with_end
			mov x2, #0                  // i = 0
			.Larray_with_loop:
			mov x3, #T_SIZE
			mul x4, x2, x3
			add x5, x20, #8
			add x5, x5, x4              // addr = data + offset

			// T_FAT (string): strdup the seed's ptr half into each slot.
			mov x7, #T_FAT
			cmp x7, #1
			b.ne .Larray_with_plain
			ldr x0, [sp, #8]
			cbz x0, .Larray_with_pair
			bl _strdup
			ldr x1, [sp]
			str x0, [x5]
			str x1, [x5, #8]
			b .Larray_with_next
			.Larray_with_pair:
			stp xzr, xzr, [x5]
			b .Larray_with_next

			.Larray_with_plain:
			// Store the value (parked at [sp+8]) using a width that matches
			// T_SIZE. For T_SIZE <= 8 the value is a scalar; T_SIZE > 8 (a
			// non-fat struct) byte-copies from the parked pointer.
			cmp x3, #8
			b.gt .Larray_with_copy_loop
			cmp x3, #4
			b.eq .Larray_with_store4
			cmp x3, #2
			b.eq .Larray_with_store2
			cmp x3, #1
			b.eq .Larray_with_store1
			ldr x0, [sp, #8]
			str x0, [x5]
			b .Larray_with_next
			.Larray_with_store4:
			ldr x0, [sp, #8]
			str w0, [x5]
			b .Larray_with_next
			.Larray_with_store2:
			ldr x0, [sp, #8]
			strh w0, [x5]
			b .Larray_with_next
			.Larray_with_store1:
			ldr x0, [sp, #8]
			strb w0, [x5]
			b .Larray_with_next

			.Larray_with_copy_loop:
			// Struct element (T_SIZE > 8): [sp+8] is a pointer to the bytes —
			// copy them one by one so adjacent slots aren't clobbered.
			mov x6, #0
			ldr x0, [sp, #8]
			.Larray_with_byte:
			ldrb w7, [x0, x6]
			strb w7, [x5, x6]
			add x6, x6, #1
			cmp x6, x3
			blt .Larray_with_byte

			.Larray_with_next:
			add x2, x2, #1
			cmp x2, x19
			blt .Larray_with_loop

			.Larray_with_end:
			mov x0, x20                 // return heap pointer
			add sp, sp, #16             // pop the parked value pair
			ldp x19, x20, [sp], #16
			// Fall through to the builder's .return epilogue (it pops the raw
			// block's stack frame) — a bare `ret` here would skip it.
		}
	}
	}

	/**
	 * A new heap array holding the same elements. String elements are deep-copied
	 * (each slot gets its own bytes); other elements are copied by value.
	 **/
	pub func copy = (self, out Array<T>: out.length == self.length) {
		#if META.arch == "c" {
			#raw {
				long _header = sizeof(*self);
				long _len = self->length;
				void* _result = malloc(_header + _len * T_SIZE);
				((long*)_result)[0] = 0;
				((long*)_result)[1] = _len;
				T* _data = (T*)((char*)_result + _header);
				T* _src = (T*)((char*)self + _header);
				for (long i = 0; i < _len; i++) {
					#if T_HAS_COPY
						_data[i] = T_copy(&_src[i]);
					#elif T_NEEDS_STRDUP
						_data[i] = nomen_str_dup(_src[i]);
					#else
						_data[i] = _src[i];
					#endif
				}
				return _result;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// x19 = self (first elem), length at [x19, #-8].
				// Returns x0 = heap-allocated array pointer ([ptr]=length, [ptr+8..]=data).
				stp x20, x21, [sp, #-16]!
				stp x22, x23, [sp, #-16]!
				ldr x21, [x19, #-8]         // x21 = length

				// ptr = malloc(8 + length * T_SIZE)
				mov x2, #T_SIZE
				mul x0, x21, x2
				add x0, x0, #8
				bl _malloc
				mov x20, x0                 // x20 = base pointer
				str x21, [x20]              // [ptr] = length

				// memcpy(ptr + 8, self, length * T_SIZE)
				add x0, x20, #8
				mov x1, x19
				mov x2, #T_SIZE
				mul x2, x21, x2
				bl _memcpy

				// T_FAT (string): give each slot its own copy of the bytes
				// (length-based, so NUL bytes survive).
				mov x7, #T_FAT
				cmp x7, #1
				b.ne .Larray_copy_structs
				mov x22, #0                 // i = 0
				.Larray_copy_loop:
				cmp x22, x21
				b.ge .Larray_copy_end
				add x23, x20, #8
				add x23, x23, x22, lsl #4   // x23 = &slot[i]
				ldr x0, [x23]
				cbz x0, .Larray_copy_next
				ldr x0, [x23, #8]
				add x0, x0, #1
				bl _malloc                  // malloc(len + 1)
				ldr x1, [x23]
				ldr x2, [x23, #8]
				bl _memcpy                  // returns the destination
				ldr x2, [x23, #8]
				strb wzr, [x0, x2]
				str x0, [x23]
				.Larray_copy_next:
				add x22, x22, #1
				b .Larray_copy_loop

				// T_HAS_COPY (a struct with its own copy()): rebuild each
				// slot through T_copy(x0 = &src[i], x8 = &dst[i]), over the
				// memcpy'd bytes (they are the source's, never freed here).
				.Larray_copy_structs:
				mov x7, #T_HAS_COPY
				cmp x7, #1
				b.ne .Larray_copy_end
				mov x22, #0                 // i = 0
				.Larray_copy_struct_loop:
				cmp x22, x21
				b.ge .Larray_copy_end
				mov x2, #T_SIZE
				mul x23, x22, x2            // x23 = i * T_SIZE
				add x0, x19, x23            // &src[i]
				add x8, x20, #8
				add x8, x8, x23             // &dst[i]
				bl T_copy
				add x22, x22, #1
				b .Larray_copy_struct_loop

				.Larray_copy_end:
				mov x0, x20                 // return heap pointer
				ldp x22, x23, [sp], #16
				ldp x20, x21, [sp], #16
			}
		}
	}

	/**
	 * A new array holding this array's elements followed by `other`'s (the `+` operator).
	 * Elements are copied like `copy()`: strings get their own bytes, and a struct with a
	 * `copy()` goes through it.
	 **/
	pub func add = (self, Array<T> other, out Array<T>: out.length == self.length + other.length) {
		#if META.arch == "c" {
			#raw {
				long _self_len = self->length;
				long _other_len = other->length;
				long _len = _self_len + _other_len;
				long _header = sizeof(*self);
				void* _result = malloc(_header + _len * T_SIZE);
				((long*)_result)[0] = 0;
				((long*)_result)[1] = _len;
				T* _data = (T*)((char*)_result + _header);
				T* _a = (T*)((char*)self + _header);
				T* _b = (T*)((char*)other + _header);
				for (long i = 0; i < _len; i++) {
					T* _src = i < _self_len ? &_a[i] : &_b[i - _self_len];
					#if T_HAS_COPY
						_data[i] = T_copy(_src);
					#elif T_NEEDS_STRDUP
						_data[i] = nomen_str_dup(*_src);
					#else
						_data[i] = *_src;
					#endif
				}
				return _result;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// x19 = self (first elem, length at [-8]); x1 = other's base
				// pointer (an Array<T> param: [ptr]=length, [ptr+8..]=data).
				// Returns x0 = heap-allocated array pointer ([ptr]=length, [ptr+8..]=data).
				stp x20, x21, [sp, #-16]!
				stp x22, x23, [sp, #-16]!
				stp x24, x25, [sp, #-16]!
				stp x26, x27, [sp, #-16]!
				add x20, x1, #8             // x20 = other (first elem; survives the calls)
				ldr x21, [x19, #-8]         // x21 = self length
				ldr x22, [x20, #-8]         // x22 = other length
				add x23, x21, x22           // x23 = result length

				mov x2, #T_SIZE
				mul x0, x23, x2
				add x0, x0, #8
				bl _malloc
				mov x24, x0                 // x24 = base pointer
				str x23, [x24]

				// memcpy(base + 8, self, self_len * T_SIZE)
				add x0, x24, #8
				mov x1, x19
				mov x2, #T_SIZE
				mul x2, x21, x2
				bl _memcpy
				// memcpy(base + 8 + self_bytes, other, other_len * T_SIZE)
				mov x2, #T_SIZE
				mul x3, x21, x2
				add x0, x24, #8
				add x0, x0, x3
				mov x1, x20
				mul x2, x22, x2
				bl _memcpy

				// T_FAT (string): give each slot its own copy of the bytes.
				mov x7, #T_FAT
				cmp x7, #1
				b.ne .Larray_add_structs
				mov x25, #0
				.Larray_add_loop:
				cmp x25, x23
				b.ge .Larray_add_end
				add x26, x24, #8
				add x26, x26, x25, lsl #4   // x26 = &slot[i]
				ldr x0, [x26]
				cbz x0, .Larray_add_next
				ldr x0, [x26, #8]
				add x0, x0, #1
				bl _malloc                  // malloc(len + 1)
				ldr x1, [x26]
				ldr x2, [x26, #8]
				bl _memcpy
				ldr x2, [x26, #8]
				strb wzr, [x0, x2]
				str x0, [x26]
				.Larray_add_next:
				add x25, x25, #1
				b .Larray_add_loop

				// T_HAS_COPY: rebuild each slot through T_copy(x0 = &src, x8 = &dst).
				.Larray_add_structs:
				mov x7, #T_HAS_COPY
				cmp x7, #1
				b.ne .Larray_add_end
				mov x25, #0
				.Larray_add_struct_loop:
				cmp x25, x23
				b.ge .Larray_add_end
				mov x2, #T_SIZE
				cmp x25, x21
				b.ge .Larray_add_struct_other
				mul x3, x25, x2
				add x0, x19, x3
				b .Larray_add_struct_dst
				.Larray_add_struct_other:
				sub x3, x25, x21
				mul x3, x3, x2
				add x0, x20, x3
				.Larray_add_struct_dst:
				mul x3, x25, x2
				add x8, x24, #8
				add x8, x8, x3
				bl T_copy
				add x25, x25, #1
				b .Larray_add_struct_loop

				.Larray_add_end:
				mov x0, x24
				ldp x26, x27, [sp], #16
				ldp x24, x25, [sp], #16
				ldp x22, x23, [sp], #16
				ldp x20, x21, [sp], #16
			}
		}
	}

	/**
	 * A new array holding this array's elements repeated `count` times (the `*` operator);
	 * a count below 1 gives an empty array. Elements are copied like `copy()`.
	 **/
	pub func mul = (self, int count, out Array<T>) {
		#if META.arch == "c" {
			#raw {
				long _self_len = self->length;
				long _count = count < 0 ? 0 : count;
				long _len = _self_len * _count;
				long _header = sizeof(*self);
				void* _result = malloc(_header + _len * T_SIZE);
				((long*)_result)[0] = 0;
				((long*)_result)[1] = _len;
				T* _data = (T*)((char*)_result + _header);
				T* _a = (T*)((char*)self + _header);
				for (long i = 0; i < _len; i++) {
					T* _src = &_a[i % _self_len];
					#if T_HAS_COPY
						_data[i] = T_copy(_src);
					#elif T_NEEDS_STRDUP
						_data[i] = nomen_str_dup(*_src);
					#else
						_data[i] = *_src;
					#endif
				}
				return _result;
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				// x19 = self (first elem), x1 = count.
				// Returns x0 = heap-allocated array pointer ([ptr]=length, [ptr+8..]=data).
				stp x21, x22, [sp, #-16]!
				stp x23, x24, [sp, #-16]!
				stp x25, x26, [sp, #-16]!
				mov x22, x1
				cmp x22, #0
				csel x22, x22, xzr, gt      // x22 = max(count, 0)
				ldr x21, [x19, #-8]         // x21 = self length
				mul x23, x21, x22           // x23 = result length

				mov x2, #T_SIZE
				mul x0, x23, x2
				add x0, x0, #8
				bl _malloc
				mov x24, x0                 // x24 = base pointer
				str x23, [x24]

				// memcpy(base + 8 + k * self_bytes, self, self_bytes) per repeat
				mov x25, #0
				.Larray_mul_copy:
				cmp x25, x22
				b.ge .Larray_mul_copied
				mov x2, #T_SIZE
				mul x2, x21, x2
				mul x3, x25, x2
				add x0, x24, #8
				add x0, x0, x3
				mov x1, x19
				bl _memcpy
				add x25, x25, #1
				b .Larray_mul_copy
				.Larray_mul_copied:

				// T_FAT (string): give each slot its own copy of the bytes.
				mov x7, #T_FAT
				cmp x7, #1
				b.ne .Larray_mul_structs
				mov x25, #0
				.Larray_mul_loop:
				cmp x25, x23
				b.ge .Larray_mul_end
				add x26, x24, #8
				add x26, x26, x25, lsl #4   // x26 = &slot[i]
				ldr x0, [x26]
				cbz x0, .Larray_mul_next
				ldr x0, [x26, #8]
				add x0, x0, #1
				bl _malloc                  // malloc(len + 1)
				ldr x1, [x26]
				ldr x2, [x26, #8]
				bl _memcpy
				ldr x2, [x26, #8]
				strb wzr, [x0, x2]
				str x0, [x26]
				.Larray_mul_next:
				add x25, x25, #1
				b .Larray_mul_loop

				// T_HAS_COPY: rebuild each slot through T_copy(x0 = &src, x8 = &dst).
				.Larray_mul_structs:
				mov x7, #T_HAS_COPY
				cmp x7, #1
				b.ne .Larray_mul_end
				mov x25, #0
				.Larray_mul_struct_loop:
				cmp x25, x23
				b.ge .Larray_mul_end
				udiv x3, x25, x21
				msub x3, x3, x21, x25       // x3 = i % self_len
				mov x2, #T_SIZE
				mul x3, x3, x2
				add x0, x19, x3
				mul x3, x25, x2
				add x8, x24, #8
				add x8, x8, x3
				bl T_copy
				add x25, x25, #1
				b .Larray_mul_struct_loop

				.Larray_mul_end:
				mov x0, x24
				ldp x25, x26, [sp], #16
				ldp x23, x24, [sp], #16
				ldp x21, x22, [sp], #16
			}
		}
	}
}
