/**
 * A 32-bit unsigned integer
 **/
pub struct uint32: Stringable, Hashable, Equatable {

	/**
	 * `a / b`: integer division, truncating toward zero. The divisor must be provably
	 * non-zero.
	 **/
	// The divisor contract (SPEC, Division and Modulo by Zero): scalar
	// arithmetic lowers natively, so these declarations are the contract
	// signatures the checker enforces at every `/` and `%` site.
	func #op_div = (self, uint32 divisor: divisor != 0, out uint32) {
		return self / divisor
	}

	/**
	 * `a % b`: the remainder of integer division. The divisor must be provably non-zero.
	 **/
	func #op_mod = (self, uint32 divisor: divisor != 0, out uint32) {
		return self % divisor
	}
	/**
	 * A hash of the value, so it can be a `Map` key or `Set` element.
	 **/
	pub func hash = (self, out uint) {
		return self as uint
	}

	/**
	 * The value in base 10, as a new string.
	 **/
	pub func to_string = (self, mv out string) {
		#if META.arch == "c" {
			#raw {
				int length = snprintf(NULL, 0, "%u", self);
				char* str = malloc(length + 1);
				snprintf(str, length + 1, "%u", self);
				// Fat-string ABI: snprintf already counted the bytes.
				return (nomen_string){ str, length };
			}
		}
		#if META.arch == "aarch64" {
			#raw {
				sub sp, sp, #128
				str x0, [sp, #0]
				str x1, [sp, #8]
				str x2, [sp, #16]
				str x3, [sp, #24]
				mov x0, xzr
				mov x1, xzr
				adr x2, .Lfmt_uint32_u
				mov x3, x19
				bl _snprintf
				add x0, x0, #1
				str x0, [sp, #64]
				bl _malloc
				str x0, [sp, #72]
				ldr x0, [sp, #72]
				ldr x1, [sp, #64]
				adr x2, .Lfmt_uint32_u
				mov x3, x19
				bl _snprintf
				mov x1, x0
				ldr x0, [sp, #72]
				add sp, sp, #128
				b .Lend_uint32_to_string
				.Lfmt_uint32_u: .asciz "%u"
				.p2align 2
				.Lend_uint32_to_string:
			}
		}
	}
}
