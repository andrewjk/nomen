// ClassBuffer<T>: a flat buffer of owned class pointers of type T. The
// class-ness is compile-time: #destroy calls the monomorphized element destroy
// (`T_destroy` -> e.g. Animal_destroy) directly, and store_int/replace_int
// forbid 0 (you can't overwrite a pointer with null and leak it — use move_int
// to relinquish a slot). T must be a class. Buffer<T> is the value counterpart.

/**
 * A flat buffer of owned class pointers of type T — the backing store for collections of classes
 **/
pub struct ClassBuffer<T> {
	internal var uint64 data = 0
	// Publicly readable; grown only by ClassBuffer's own methods (`readonly`).
	readonly cap = 0

	internal func alloc_int = (ref self, int size, out int: out >= size) {
		self.cap = size
		self.data = calloc(size, 8)
		return self.cap
	}

	// Semantic parity with Buffer<T>.alloc: generic code (e.g. Map#init's
	// `self.values.alloc(N)`) forwards to either Buffer — where alloc is
	// T_SIZE-aware (string slots are 16 bytes) — or this ClassBuffer, whose
	// slots are always one pointer wide. The compiler routes value-struct
	// element types to Buffer and class/trait elements to ClassBuffer
	// (monomorphize's field rewrite), so a call arriving HERE is always
	// pointer-sized: delegate to alloc_int.
	func alloc = (ref self, int size, out int: out >= size) {
		return self.alloc_int(size)
	}

	internal func grow_int = (ref self, int needed, out int: out >= needed) {
		if self.cap >= needed {
			return self.cap
		}
		var int new_cap = self.cap
		if new_cap == 0 {
			new_cap = 4
		}
		while new_cap < needed; new_cap *= 2 { }
		self.data = realloc(self.data, new_cap * 8)
		memset(self.data + self.cap * 8, 0, (new_cap - self.cap) * 8)
		self.cap = new_cap
		return self.cap
	}

	internal inline func load_int = (self, int i: i >= 0 && i < self.cap, out int) {
		```
		#arch: c
		return ((long*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #3
		add x0, x0, x1
		ldr x0, [x0]
		```
	}

	// Address of slot `i` (library-only): the ELEMENT BORROW primitive for
	// trait/class elements — `ref T x = list.at(i)` (docs/HANDLERS.md Stage
	// 4) reaches here through the List wrapper when the element is a trait
	// (the items buffer is a ClassBuffer). ClassBuffer slots are 8-byte
	// handles, so the slot's CONTENT is the instance pointer: return the
	// stored word, not the slot's address. Library-internal: bounds are the
	// caller's obligation (the List wrapper constrains them).
	internal func slot_ptr = (ref self, int i, out ptr T) {
		```
		#arch: c
		// The slot's address: through the alias, reads and writes hit the
		// stored handle word. void* converts to the caller's `T*` spelling.
		return (void *)&((unsigned long long *)self->data)[i];
		```
		```
		#arch: aarch64
		// 8-byte slots: the address of slot i — loading through it yields
		// the stored handle.
		ldr x8, [x19, #8]
		lsl x9, x1, #3
		add x0, x9, x8
		```
	}

	// Generic (T-typed) counterparts of the _int primitives. ClassBuffer only
	// ever holds 8-byte class pointers (T_SIZE is 8), so these are
	// behaviorally identical to their _int counterparts — they exist so
	// List<T> can call a single uniform API whether T is a value struct
	// (Buffer) or a class (ClassBuffer, after the Buffer<T> field is
	// rewritten). Bodies use 8-byte slots, matching _int.

	func grow = (ref self, int needed, out int: out >= needed) {
		if self.cap >= needed {
			return self.cap
		}
		var int new_cap = self.cap
		if new_cap == 0 {
			new_cap = 4
		}
		while new_cap < needed; new_cap *= 2 { }
		self.data = realloc(self.data, new_cap * 8)
		memset(self.data + self.cap * 8, 0, (new_cap - self.cap) * 8)
		self.cap = new_cap
		return self.cap
	}

	inline func load = (self, int i: i >= 0 && i < self.cap, out T) {
		```
		#arch: c
		return (void*)((long*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #3
		add x0, x0, x1
		ldr x0, [x0]
		```
	}

	// Labeled delegation point for raw-body callers in other containers
	// (StableList's chunked storage calls this): `load` is `inline` — spliced
	// at Nomen call sites, so no label exists for a raw C call or `bl` to
	// target. Mirror of Buffer.load_from (class slots are pointer words —
	// the pointer load IS the borrow form).
	internal func load_from = (self, int i: i >= 0 && i < self.cap, out T) {
		return self.load(i)
	}

	// Store the owned class pointer `val` into slot `i`, which MUST be fresh
	// (calloc'd, or zeroed by mv/move_int). Takes OWNERSHIP of `val`
	// (`mv`): the slot's #destroy reclaims the instance, so the caller must
	// not free its copy — a fresh constructor result transfers here directly,
	// and a local must be moved (its own cleanup is suppressed at the call
	// site). This is a plain pointer store — it does NOT destroy/free the
	// slot's previous occupant, so a second `store` at an occupied index
	// leaks that instance. Use replace (or replace_int) to overwrite a live
	// slot.
	internal inline func store = (ref self, int i: i >= 0 && i < self.cap, mv T val: val != 0) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] = (long)val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	// Move a class pointer out of a slot: return it and zero the slot so the
	// buffer no longer references it. Declared `mv out T` so the borrow
	// checker treats the result as OWNED — the slot is relinquished, so the
	// caller is the sole remaining owner. This is the mv-extract primitive
	// (parallel to List.pop); use it (not load) when transferring ownership
	// out of a ClassBuffer slot, or moving a value into a fresh mv
	// container — load returns a BORROW (the slot is unchanged) and storing
	// it elsewhere would create shared ownership (double-free at destroy).
	inline func move = (ref self, int i: i >= 0 && i < self.cap, mv out T) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		void *val = (void*)slots[i];
		slots[i] = 0;
		return val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x3, x0, x3
		ldr x0, [x3]
		str xzr, [x3]
		```
	}

	// Apply `f` to slot `i` in place — the mv-counterpart of Buffer's
	// modify for class elements. `f` receives the current instance pointer
	// as a MOVE argument — the only expressible parameter mode for a
	// class-tier element (a bare `Box<T>` param is rejected — B2/T2 — and a
	// `ref` param's &binding lowering mismatches this raw call) — so the
	// displaced instance's reclamation is the CALLEE's mv-param contract:
	// a function whose parameter is not returned frees it at its own exit
	// (the C auto-free registration / the aarch64 return-compare arm). The
	// body frees nothing — freeing here too was a double free (the
	// aarch64 callee already reclaimed it; the audit caught the stale
	// free). Storing the returned instance raw is sound: the slot takes
	// sole ownership and `f`'s return is not retained elsewhere. NOT
	// `inline`: the body calls through the fn pointer.
	func modify = (ref self, int i: i >= 0 && i < self.cap, func(T, out T) f) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		void *old = (void*)slots[i];
		void *new_value = (void*)((void *(*)(void *, void *))f->code)(f->env, old);
		slots[i] = (long)new_value;
		```
		```
		#arch: aarch64
		// x19 = self, x1 = i, x2 = f (a closure descriptor — env goes in x0,
		// the old slot value shifts to x1). Class slots are one pointer wide.
		// `old` is MOVED into f — the callee's mv-param contract reclaims
		// it; this body frees nothing.
		stp x20, x21, [sp, #-16]!
		stp x22, x23, [sp, #-16]!
		stp x24, x25, [sp, #-16]!
		mov x22, x2
		ldr x9, [x19, #8]
		lsl x3, x1, #3
		add x20, x9, x3
		ldr x24, [x22]
		ldr x0, [x22, #8]
		ldr x1, [x20]
		blr x24
		mov x23, x0
		str x23, [x20]
		ldp x24, x25, [sp], #16
		ldp x22, x23, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	internal inline func store_int = (ref self, int i: i >= 0 && i < self.cap, int val: val != 0) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	internal inline func move_int = (ref self, int i: i >= 0 && i < self.cap, out int) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		long val = slots[i];
		slots[i] = 0;
		return val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x3, x0, x3
		ldr x0, [x3]
		str xzr, [x3]
		```
	}

	// Store into a slot, freeing the previous value (it is an owned class
	// pointer): run its destroy then free it before overwriting.
	internal func replace_int = (ref self, int i: i >= 0 && i < self.cap, int val: val != 0) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		if (slots[i]) {
			T_destroy((void*)slots[i]);
			free((void*)slots[i]);
		}
		slots[i] = val;
		```
		```
		#arch: aarch64
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x21, x0, x3
		mov x20, x2
		ldr x0, [x21]
		cbz x0, .Lcb_replace_store
		mov x22, x0
		bl T_destroy
		mov x0, x22
		bl _free
		.Lcb_replace_store:
		str x20, [x21]
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// Reclaim slot i's owned class pointer (destroy + free) WITHOUT writing
	// the slot — the destroy half of replace_int, without the store, zeroing
	// the handle so a re-destroy is a no-op. The caller (Map.set_slot_ptr's
	// replace path — the value-side sibling of `values.replace`) overwrites
	// the slot immediately afterwards. Contract: the slot must be
	// overwritten before it is read or destroyed again.
	internal func destroy_at = (ref self, int i: i >= 0 && i < self.cap) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		if (slots[i]) {
			T_destroy((void*)slots[i]);
			free((void*)slots[i]);
			slots[i] = 0;
		}
		```
		```
		#arch: aarch64
		stp x20, x21, [sp, #-16]!
		ldr x20, [x19, #8]
		lsl x3, x1, #3
		add x20, x20, x3
		ldr x0, [x20]
		cbz x0, .Lcb_destroy_at_done
		mov x21, x0
		bl T_destroy
		mov x0, x21
		bl _free
		str xzr, [x20]
		.Lcb_destroy_at_done:
		ldp x20, x21, [sp], #16
		```
	}

	// T-typed alias of replace_int: free the outgoing class pointer (destroy +
	// free) then store the new one. Used by List.set so the uniform API
	// preserves ownership for class elements.
	// Overwrite a live slot: destroy + free the displaced instance, then take
	// OWNERSHIP of `val` (`mv`) — same transfer rule as store.
	func replace = (ref self, int i: i >= 0 && i < self.cap, mv T val: val != 0) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		if (slots[i]) {
			T_destroy((void*)slots[i]);
			free((void*)slots[i]);
		}
		slots[i] = (long)val;
		```
		```
		#arch: aarch64
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x21, x0, x3
		mov x20, x2
		ldr x0, [x21]
		cbz x0, .Lcb_replace_T_store
		mov x22, x0
		bl T_destroy
		mov x0, x22
		bl _free
		.Lcb_replace_T_store:
		str x20, [x21]
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// Move slot src into slot dst: reclaim dst's previous instance (destroy +
	// free), take over src's pointer, and zero src — exactly one slot owns the
	// instance afterwards. The class-buffer counterpart of Buffer.shift,
	// used by Map/Set.remove's backward-shift so shifting entries neither
	// duplicates nor orphans owned instances.
	func shift = (
		ref self,
		int dst: dst >= 0 && dst < self.cap,
		int src: src >= 0 && src < self.cap
	) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		if (dst != src) {
			if (slots[dst]) {
				T_destroy((void*)slots[dst]);
				free((void*)slots[dst]);
			}
			slots[dst] = slots[src];
			slots[src] = 0;
		}
		```
		```
		#arch: aarch64
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		ldr x9, [x19, #8]
		lsl x3, x1, #3
		add x20, x9, x3
		lsl x3, x2, #3
		add x21, x9, x3
		cmp x20, x21
		b.eq .Lcb_shift_T_done
		ldr x0, [x20]
		cbz x0, .Lcb_shift_T_move
		mov x22, x0
		bl T_destroy
		mov x0, x22
		bl _free
		.Lcb_shift_T_move:
		ldr x9, [x21]
		str x9, [x20]
		str xzr, [x21]
		.Lcb_shift_T_done:
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// A non-mv (ptr, len) slice [start, end) over this buffer's class
	// pointers, returned as a `view T` (T is a class, so each element is an
	// 8-byte pointer). Borrows from self — invalidated on reassignment. Mirrors
	// Buffer.slice; ClassBuffer stores 8-byte slots, so the element width is 8.
	func slice = (
		self,
		int start: start >= 0,
		int end: end >= start && end <= self.cap,
		out view T
	) {
		```
		#arch: c
		nomen_view _r;
		_r.ptr = (void*)((long*)(unsigned long long)self->data + start);
		_r.len = (long)(end - start);
		return _r;
		```
		```
		#arch: aarch64
		// x19 = self (ClassBuffer struct ptr), x1 = start, x2 = end.
		// self->data at [x19, #8]. Return (ptr, len) in x0/x1.
		ldr x0, [x19, #8]
		mov x3, #8
		madd x0, x1, x3, x0
		sub x1, x2, x1
		```
	}

	func #destroy = () {
		```
		#arch: c
		if (self->data) {
			long *slots = (long*)(unsigned long long)self->data;
			for (int i = 0; i < self->cap; i++) {
				if (slots[i]) {
					T_destroy((void*)slots[i]);
					free((void*)slots[i]);
				}
			}
			free(slots);
		}
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		cbz x0, .Lcb_destroy_end
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		mov x20, x0
		ldr x21, [x19, #16]
		mov x22, #0
		.Lcb_destroy_loop:
		cmp x22, x21
		b.ge .Lcb_destroy_done
		ldr x0, [x20, x22, lsl #3]
		cbz x0, .Lcb_destroy_skip
		str x0, [sp, #-16]!
		bl T_destroy
		ldr x0, [sp], #16
		bl _free
		.Lcb_destroy_skip:
		add x22, x22, #1
		b .Lcb_destroy_loop
		.Lcb_destroy_done:
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		.Lcb_destroy_end:
		ldr x0, [x19, #8]
		cbz x0, .Lcb_destroy_free_done
		bl _free
		.Lcb_destroy_free_done:
		str xzr, [x19, #8]
		str xzr, [x19, #16]
		```
	}
}
