// ClassBuffer<T>: a flat buffer of owned class pointers of type T. The
// class-ness is compile-time: #destroy calls the monomorphized element destroy
// (`T_destroy` -> e.g. Animal_destroy) directly, and store_int/replace_int
// forbid 0 (you can't overwrite a pointer with null and leak it — use move_int
// to relinquish a slot). T must be a class. Buffer<T> is the value counterpart.

/**
 * A flat buffer of owned class pointers of type T — the backing store for collections of classes
 **/
pub struct ClassBuffer<T> {
	var uint64 data = 0
	var cap = 0

	func alloc_int = (ref self, int size, out int: out >= size) {
		```
		#arch: c
		self->cap = size;
		self->data = (unsigned long long)(long*)calloc(size, sizeof(long));
		return self->cap;
		```
		```
		#arch: aarch64
		str x1, [x19, #16]
		mov x0, x1
		mov x1, #8
		bl _calloc
		str x0, [x19, #8]
		ldr x0, [x19, #16]
		```
	}

	func grow_int = (ref self, int needed, out int: out >= needed) {
		```
		#arch: c
		if (self->cap >= needed) return self->cap;
		int new_cap = self->cap;
		if (new_cap == 0) new_cap = 4;
		while (new_cap < needed) new_cap *= 2;
		self->data = (unsigned long long)(long*)realloc((long*)(unsigned long long)self->data, new_cap * sizeof(long));
		memset((long*)(unsigned long long)self->data + self->cap, 0, (new_cap - self->cap) * sizeof(long));
		self->cap = new_cap;
		return self->cap;
		```
		```
		#arch: aarch64
		ldr x2, [x19, #16]
		cmp x2, x1
		b.ge .Lcb_grow_end
		mov x3, #4
		cmp x2, #0
		csel x3, x3, x2, eq
		cmp x3, x1
		b.ge .Lcb_grow_got
		.Lcb_grow_loop:
		lsl x3, x3, #1
		cmp x3, x1
		b.lt .Lcb_grow_loop
		.Lcb_grow_got:
		sub sp, sp, #16
		str x2, [sp, #0]
		str x3, [sp, #8]
		ldr x0, [x19, #8]
		lsl x1, x3, #3
		bl _realloc
		str x0, [x19, #8]
		ldr x2, [sp, #0]
		ldr x3, [sp, #8]
		add sp, sp, #16
		str x3, [x19, #16]
		add x0, x0, x2, lsl #3
		mov x1, #0
		sub x2, x3, x2
		lsl x2, x2, #3
		bl _memset
		.Lcb_grow_end:
		ldr x0, [x19, #16]
		```
	}

	inline func load_int = (self, int i: i >= 0 && i < self.cap, out int) {
		```
		#arch: c
		return ((long*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #3
		add x0, x0, x1
		ldr x0, [x0]
		```
	}

	// T_SIZE-aware aliases of the _int primitives. ClassBuffer only ever holds
	// 8-byte class pointers (T_SIZE is 8), so these are behaviorally identical
	// to their _int counterparts — they exist so List<T> can call a single
	// uniform `_T` API whether T is a value struct (Buffer) or a class
	// (ClassBuffer, after the Buffer<T> field is rewritten). Bodies use 8-byte
	// slots, matching _int.

	func grow_T = (ref self, int needed, out int: out >= needed) {
		```
		#arch: c
		if (self->cap >= needed) return self->cap;
		int new_cap = self->cap;
		if (new_cap == 0) new_cap = 4;
		while (new_cap < needed) new_cap *= 2;
		self->data = (unsigned long long)(long*)realloc((long*)(unsigned long long)self->data, new_cap * sizeof(long));
		memset((long*)(unsigned long long)self->data + self->cap, 0, (new_cap - self->cap) * sizeof(long));
		self->cap = new_cap;
		return self->cap;
		```
		```
		#arch: aarch64
		ldr x2, [x19, #16]
		cmp x2, x1
		b.ge .Lcb_grow_T_end
		mov x3, #4
		cmp x2, #0
		csel x3, x3, x2, eq
		cmp x3, x1
		b.ge .Lcb_grow_T_got
		.Lcb_grow_T_loop:
		lsl x3, x3, #1
		cmp x3, x1
		b.lt .Lcb_grow_T_loop
		.Lcb_grow_T_got:
		sub sp, sp, #16
		str x2, [sp, #0]
		str x3, [sp, #8]
		ldr x0, [x19, #8]
		lsl x1, x3, #3
		bl _realloc
		str x0, [x19, #8]
		ldr x2, [sp, #0]
		ldr x3, [sp, #8]
		add sp, sp, #16
		str x3, [x19, #16]
		add x0, x0, x2, lsl #3
		mov x1, #0
		sub x2, x3, x2
		lsl x2, x2, #3
		bl _memset
		.Lcb_grow_T_end:
		ldr x0, [x19, #16]
		```
	}

	inline func load_T = (self, int i: i >= 0 && i < self.cap, out T) {
		```
		#arch: c
		return (void*)((long*)(unsigned long long)self->data)[i];
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x1, x1, #3
		add x0, x0, x1
		ldr x0, [x0]
		```
	}

	inline func store_T = (ref self, int i: i >= 0 && i < self.cap, T val: val != 0) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] = (long)val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	// Move a class pointer out of a slot: return it and zero the slot so the
	// buffer no longer references it. Declared `mov out T` so the borrow
	// checker treats the result as OWNED — the slot is relinquished, so the
	// caller is the sole remaining owner. This is the owning-extract primitive
	// (parallel to List.pop); use it (not load_T) when transferring ownership
	// out of a ClassBuffer slot, or moving a value into a fresh owning
	// container — load_T returns a BORROW (the slot is unchanged) and storing
	// it elsewhere would create shared ownership (double-free at destroy).
	inline func move_T = (ref self, int i: i >= 0 && i < self.cap, mov out T) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		void *val = (void*)slots[i];
		slots[i] = 0;
		return val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x3, x0, x3
		ldr x0, [x3]
		str xzr, [x3]
		```
	}

	inline func store_int = (ref self, int i: i >= 0 && i < self.cap, int val: val != 0) {
		```
		#arch: c
		((long*)(unsigned long long)self->data)[i] = val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x0, x0, x3
		str x2, [x0]
		```
	}

	inline func move_int = (ref self, int i: i >= 0 && i < self.cap, out int) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		long val = slots[i];
		slots[i] = 0;
		return val;
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x3, x0, x3
		ldr x0, [x3]
		str xzr, [x3]
		```
	}

	// Store into a slot, freeing the previous value (it is an owned class
	// pointer): run its destroy then free it before overwriting.
	func replace_int = (ref self, int i: i >= 0 && i < self.cap, int val: val != 0) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		if (slots[i]) {
			T_destroy((void*)slots[i]);
			free((void*)slots[i]);
		}
		slots[i] = val;
		```
		```
		#arch: aarch64
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x21, x0, x3
		mov x20, x2
		ldr x0, [x21]
		cbz x0, .Lcb_replace_store
		mov x22, x0
		bl T_destroy
		mov x0, x22
		bl _free
		.Lcb_replace_store:
		str x20, [x21]
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// T-typed alias of replace_int: free the outgoing class pointer (destroy +
	// free) then store the new one. Used by List.set so the uniform `_T` API
	// preserves ownership for class elements.
	func replace_T = (ref self, int i: i >= 0 && i < self.cap, T val: val != 0) {
		```
		#arch: c
		long *slots = (long*)(unsigned long long)self->data;
		if (slots[i]) {
			T_destroy((void*)slots[i]);
			free((void*)slots[i]);
		}
		slots[i] = (long)val;
		```
		```
		#arch: aarch64
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		ldr x0, [x19, #8]
		lsl x3, x1, #3
		add x21, x0, x3
		mov x20, x2
		ldr x0, [x21]
		cbz x0, .Lcb_replace_T_store
		mov x22, x0
		bl T_destroy
		mov x0, x22
		bl _free
		.Lcb_replace_T_store:
		str x20, [x21]
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		```
	}

	// A non-owning (ptr, len) slice [start, end) over this buffer's class
	// pointers, returned as a `view T` (T is a class, so each element is an
	// 8-byte pointer). Borrows from self — invalidated on reassignment. Mirrors
	// Buffer.slice; ClassBuffer stores 8-byte slots, so the element width is 8.
	func slice = (self, int start: start >= 0, int end: end >= start, out view T) {
		```
		#arch: c
		nomen_view _r;
		_r.ptr = (void*)((long*)(unsigned long long)self->data + start);
		_r.len = (long)(end - start);
		return _r;
		```
		```
		#arch: aarch64
		// x19 = self (ClassBuffer struct ptr), x1 = start, x2 = end.
		// self->data at [x19, #8]. Return (ptr, len) in x0/x1.
		ldr x0, [x19, #8]
		mov x3, #8
		madd x0, x1, x3, x0
		sub x1, x2, x1
		```
	}

	func #destroy = () {
		```
		#arch: c
		if (self->data) {
			long *slots = (long*)(unsigned long long)self->data;
			for (int i = 0; i < self->cap; i++) {
				if (slots[i]) {
					T_destroy((void*)slots[i]);
					free((void*)slots[i]);
				}
			}
			free(slots);
		}
		```
		```
		#arch: aarch64
		ldr x0, [x19, #8]
		cbz x0, .Lcb_destroy_end
		stp x20, x21, [sp, #-16]!
		str x22, [sp, #-16]!
		mov x20, x0
		ldr x21, [x19, #16]
		mov x22, #0
		.Lcb_destroy_loop:
		cmp x22, x21
		b.ge .Lcb_destroy_done
		ldr x0, [x20, x22, lsl #3]
		cbz x0, .Lcb_destroy_skip
		str x0, [sp, #-16]!
		bl T_destroy
		ldr x0, [sp], #16
		bl _free
		.Lcb_destroy_skip:
		add x22, x22, #1
		b .Lcb_destroy_loop
		.Lcb_destroy_done:
		ldr x22, [sp], #16
		ldp x20, x21, [sp], #16
		.Lcb_destroy_end:
		ldr x0, [x19, #8]
		cbz x0, .Lcb_destroy_free_done
		bl _free
		.Lcb_destroy_free_done:
		str xzr, [x19, #8]
		str xzr, [x19, #16]
		```
	}
}
