// Task runtime — thread-pool-backed execution primitive.
//
// Spawned tasks run on a shared worker pool. The pool starts at a
// configurable size (default 4, via Task.set_pool_size before the first
// spawn) and grows on demand up to 64 workers when every worker is busy,
// preventing deadlocks from nested spawns. The pool drains and joins all
// workers at process exit; Task.shutdown_pool does this explicitly.
//
// The pool infrastructure (types, worker loop, submit, shutdown, cancel
// thread-local) lives in build_spawn_node and is emitted as file-scope C
// on the first spawn — not in Task's own methods — so that Task can be
// generic without duplicating the pool per instantiation.
//
// See ASYNC.md for the design. C backend only for now; aarch64 will follow
// once the API stabilizes.

pub class Task<T> : Sendable {
	pub var uint64 handle = 0
	pub var bool done = false
	pub var uint64 result_slot = 0
	pub var uint64 cancel_flag = 0
	pub var uint64 future = 0

	// Block until the task finishes. Idempotent — calling twice is safe, and
	// a Task captured from a nursery spawn can be waited on here AND joined
	// by the nursery at block exit (both wait on the same shared future).
	pub func wait = (ref self) {
		```
		#arch: c
		if (self->future) {
			__echo_future_wait((struct echo_future *)self->future);
		} else if (self->handle && !self->done) {
			void *ret;
			pthread_join((pthread_t)self->handle, &ret);
			self->handle = 0;
			self->done = 1;
		}
		```
	}

	// Block until the task finishes, then return its result as T.
	// The spawn build phase allocates a heap slot (owned by the future) and
	// the trampoline writes the function's return value there before exiting.
	// For tasks with no return value (void functions), returns the zero value.
	pub func result = (ref self, out T) {
		```
		#arch: c
		if (self->future) {
			__echo_future_wait((struct echo_future *)self->future);
		} else if (self->handle && !self->done) {
			void *ret;
			pthread_join((pthread_t)self->handle, &ret);
			self->handle = 0;
			self->done = 1;
		}
		return *(T *)self->result_slot;
		```
	}

	// Block until the task finishes, then return its result as a uint64.
	// Convenience for the common case; same as result() for uint64 tasks.
	pub func result_uint64 = (ref self, out uint64) {
		```
		#arch: c
		if (self->future) {
			__echo_future_wait((struct echo_future *)self->future);
		} else if (self->handle && !self->done) {
			void *ret;
			pthread_join((pthread_t)self->handle, &ret);
			self->handle = 0;
			self->done = 1;
		}
		return *(unsigned long long *)self->result_slot;
		```
	}

	// Request that the task stop. Cooperative — the task observes this via
	// `Task.current_cancelled()` at its own checkpoints. No preemption.
	pub func cancel = (ref self) {
		```
		#arch: c
		if (self->cancel_flag) {
			*(unsigned long long *)self->cancel_flag = 1;
		}
		```
	}

	// Has the currently-running task been asked to cancel? Returns false
	// when called from outside any spawned task (e.g. main thread).
	pub func current_cancelled = (out bool) {
		```
		#arch: c
		return __echo_current_cancel_flag && *__echo_current_cancel_flag;
		```
	}

	// Configure the worker pool size. Must be called before the first spawn
	// — once the pool is initialized (lazily on first submit), the initial
	// size is fixed (the pool still grows on demand up to 64 workers when
	// every worker is busy). No-op if called after init (silent; check the
	// return value to detect). Returns 1 if the size was set, 0 otherwise.
	pub func set_pool_size = (int n, out int) {
		```
		#arch: c
		if (__echo_pool_init || n <= 0) return 0;
		__echo_pool_size = n;
		return 1;
		```
	}

	// Shut the worker pool down: drain the queue, join every worker, and
	// free the pool. Runs automatically at process exit (registered via
	// atexit on first submit), so outstanding fire-and-forget tasks always
	// complete before exit. Call explicitly to join all outstanding tasks
	// before continuing; the pool re-initializes on the next spawn.
	// Do NOT call from a spawned task (a worker joining its coworkers
	// deadlocks).
	pub func shutdown_pool = () {
		```
		#arch: c
		__echo_pool_shutdown();
		```
	}

	// Release this handle's reference to the future. The future owns the
	// result slot and cancel flag; it (and they) are freed only when the
	// last reference — this handle, the running trampoline, or a tracking
	// nursery — is released. The Task instance itself is freed by the
	// auto-free pass after #destroy returns.
	pub func #destroy = () {
		```
		#arch: c
		if (self->future) {
			__echo_future_release((struct echo_future *)self->future);
			self->future = 0;
			self->result_slot = 0;
			self->cancel_flag = 0;
		}
		```
	}
}
