/**
 * Trait for value equality. A struct that conforms to `Equatable` and does
 * not define its own `#op_eq` gets a field-by-field equality method bound
 * from the reflection default below (`#self` becomes the struct's name, the
 * `#op_eq` walk unrolls over `META.info(#self).fields`), so `==` — and `!=`
 * as its negation — work between two instances. A field whose type cannot
 * compare (`==` resolving to nothing) is a per-field compile error in the
 * generated body; a hand-written `#op_eq` always wins.
 **/
pub trait Equatable {
	func eq = (self, #self other, out bool) {
		var result = true
		#for field of META.info(#self).fields {
			result = result && field.get(self) == field.get(other)
		}
		return result
	}
}
