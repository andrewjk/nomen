/**
 * Wall-clock time and sleeping.
 *
 * All members are static — no instance is constructed.
 *
 *	const uint64 started = Time.now_ms()       // wall-clock ms since the epoch
 *	const uint64 unix    = Time.now_unix()     // Unix seconds
 *	const uint64 t       = Time.now_ns()       // wall-clock ns since the epoch
 *	Time.sleep_ms(50)                          // sleep 50 ms
 **/
pub struct Time {
	// (static) Wall-clock milliseconds since the Unix epoch.
	pub func now_ms = (out uint64) {
		```
		#arch: c
		#scope: file
		#include <time.h>
		```
		```
		#arch: c
		struct timespec ts;
		clock_gettime(CLOCK_REALTIME, &ts);
		return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
		```
		```
		#arch: aarch64
		sub sp, sp, #160
		mov x0, #0
		mov x1, sp
		bl _clock_gettime
		ldr x0, [sp, #0]
		mov x1, #1000
		mul x0, x0, x1
		ldr x1, [sp, #8]
		ldr x2, =1000000
		udiv x1, x1, x2
		add x0, x0, x1
		add sp, sp, #160
		b .return_Time_now_ms
		```
		return 0
	}

	// (static) Wall-clock nanoseconds since the Unix epoch. Uses the same
	// CLOCK_REALTIME source as `now_ms` (portable across macOS and Linux,
	// where the CLOCK_MONOTONIC id differs) but keeps the full nanosecond
	// resolution, which `Tester.bench` needs to time short function bodies.
	// Seconds since the epoch times 1e9 stays well inside uint64 range.
	pub func now_ns = (out uint64) {
		```
		#arch: c
		struct timespec ts;
		clock_gettime(CLOCK_REALTIME, &ts);
		return (uint64_t)ts.tv_sec * 1000000000 + (uint64_t)ts.tv_nsec;
		```
		```
		#arch: aarch64
		sub sp, sp, #160
		mov x0, #0
		mov x1, sp
		bl _clock_gettime
		ldr x0, [sp, #0]
		ldr x1, =1000000000
		mul x0, x0, x1
		ldr x1, [sp, #8]
		add x0, x0, x1
		add sp, sp, #160
		b .return_Time_now_ns
		```
		return 0
	}

	// (static) Wall-clock seconds since the Unix epoch.
	pub func now_unix = (out uint64) {
		```
		#arch: c
		return (uint64_t)time(NULL);
		```
		```
		#arch: aarch64
		mov x0, #0
		bl _time
		```
	}

	// (static) Block the calling task for `ms` milliseconds. Uses nanosleep,
	// so it is not capped at the 32-bit usleep range.
	pub func sleep_ms = (uint64 ms) {
		```
		#arch: c
		struct timespec ts;
		ts.tv_sec = ms / 1000;
		ts.tv_nsec = (long)(ms % 1000) * 1000000;
		nanosleep(&ts, NULL);
		```
		```
		#arch: aarch64
		sub sp, sp, #16
		mov x1, #1000
		udiv x2, x0, x1
		msub x3, x2, x1, x0
		str x2, [sp, #0]
		mul x3, x3, x1
		mul x3, x3, x1
		str x3, [sp, #8]
		mov x0, sp
		mov x1, #0
		bl _nanosleep
		add sp, sp, #16
		```
	}
}
