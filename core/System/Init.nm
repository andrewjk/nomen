/**
 * Program startup state — the argument count and argument list passed to `main`,
 * plus whether stdout is a terminal (for renderer selection).
 **/
pub mv struct Init {
	/**
	 * The number of command-line arguments, including the program name.
	 **/
	var int argc
	/**
	 * The command-line arguments (up to 16), starting with the program name.
	 **/
	var string[16] args
	/**
	 * Whether standard output is a terminal (rather than a file or pipe).
	 **/
	var bool is_tty
}

// FFI: the C library's decimal-string parser (stdlib.h).
foreign func atoi = (string s, out int)

/**
 * Parses a decimal string into an int
 **/
pub func parse_int = (string s, out int) {
	return atoi(s)
}
