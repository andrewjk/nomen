/**
 * Program startup state — the argument count and argument list passed to `main`,
 * plus whether stdout is a terminal (for renderer selection).
 **/
pub struct Init {
	var int argc
	var string[16] args
	var bool is_tty
}

// FFI: the C library's decimal-string parser (stdlib.h).
extern func atoi = (string s, out int)

/**
 * Parses a decimal string into an int
 **/
pub func parse_int = (string s, out int) {
	return atoi(s)
}
