// JSON serialize / deserialize for Echo primitive values.
//
// `serialize` quotes and escapes a string into a JSON string literal;
// `deserialize` parses a JSON string literal back into the raw value.
// Integer helpers round-trip JSON numbers. All parsing/escaping is
// implemented in C (compiled as a companion file on aarch64) so the
// logic stays in one place.

pub struct Json {
	// Serialize a string to a JSON string literal, e.g. a"b"c -> "a\"b\"c".
	pub func serialize = (string value, out string) {
		```
		#arch: c, aarch64_use_c
		long cap = 0;
		const char* p = value;
		while (*p) {
			unsigned char c = (unsigned char)*p;
			if (c == '"' || c == '\\' || c < 0x20) cap += 2;
			else cap += 1;
			p++;
		}
		char* out = (char*)malloc(cap + 3);
		char* w = out;
		*w++ = '"';
		p = value;
		while (*p) {
			unsigned char c = (unsigned char)*p;
			if (c == '"') { *w++ = '\\'; *w++ = '"'; }
			else if (c == '\\') { *w++ = '\\'; *w++ = '\\'; }
			else if (c == '\n') { *w++ = '\\'; *w++ = 'n'; }
			else if (c == '\t') { *w++ = '\\'; *w++ = 't'; }
			else if (c == '\r') { *w++ = '\\'; *w++ = 'r'; }
			else { *w++ = (char)c; }
			p++;
		}
		*w++ = '"';
		*w = 0;
		return out;
		```
	}

	// Deserialize a JSON string literal to the raw, unescaped value.
	pub func deserialize = (string json, out string) {
		```
		#arch: c, aarch64_use_c
		const char* p = json;
		while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
		if (*p != '"') return strdup("");
		p++;
		const char* start = p;
		long len = 0;
		while (*p && *p != '"') {
			if (*p == '\\' && *(p + 1)) { len += 1; p += 2; }
			else { len += 1; p++; }
		}
		char* out = (char*)malloc(len + 1);
		char* w = out;
		p = start;
		while (*p && *p != '"') {
			if (*p == '\\' && *(p + 1)) {
				p++;
				char e = *p;
				if (e == 'n') *w++ = '\n';
				else if (e == 't') *w++ = '\t';
				else if (e == 'r') *w++ = '\r';
				else *w++ = e;
				p++;
			} else {
				*w++ = *p++;
			}
		}
		*w = 0;
		return out;
		```
	}

	// Serialize an integer to a JSON number string.
	pub func serialize_int = (int value, out string) {
		```
		#arch: c, aarch64_use_c
		#include <stdio.h>
		char* out = (char*)malloc(24);
		snprintf(out, 24, "%ld", value);
		return out;
		```
	}

	// Deserialize a JSON number string to an integer.
	pub func deserialize_int = (string json, out int) {
		```
		#arch: c, aarch64_use_c
		#include <stdlib.h>
		return strtol(json, 0, 10);
		```
	}
}
