// JSON serialize / deserialize for Echo string values, written in pure Echo.
//
// `serialize` quotes and escapes a string into a JSON string literal;
// `deserialize` parses a JSON string literal back into the raw value.
// Integer (de)serialization is handled by int.to_string() and int.parse()
// (see int.echo), so this struct only deals with JSON strings.

import Buffer

pub struct Json {
	// Serialize a string to a JSON string literal, escaping the special
	// characters ", \, newline, tab and carriage return.
	pub func serialize = (string value, out string) {
		var string bs = "\x5c"
		var string built = "\""
		var int i = 0
		var int len = value.length()
		while i < len {
			var char c = value.at(i)
			var int code = c as int
			switch {
				case code == 34 {
					built = built + bs + "\""
				}
				case code == 92 {
					built = built + bs + bs
				}
				case code == 10 {
					built = built + bs + "n"
				}
				case code == 9 {
					built = built + bs + "t"
				}
				case code == 13 {
					built = built + bs + "r"
				}
				else {
					built = built + "\{c}"
				}
			}
			i = i + 1
		}
		return built + "\""
	}

	// Deserialize a JSON string literal to the raw, unescaped value.
	pub func deserialize = (string json, out string) {
		var string parsed = ""
		var int len = json.length()
		var int i = 0
		// skip up to the opening quote
		while i < len {
			if (json.at(i) as int) == 34 {
				i = i + 1
				break
			}
			i = i + 1
		}
		// read until the unescaped closing quote, unescaping as we go
		while i < len {
			var char c = json.at(i)
			var int code = c as int
			if code == 34 {
				break
			}
			if code == 92 {
				i = i + 1
				if i < len {
					var char e = json.at(i)
					var int ec = e as int
					switch {
						case ec == 110 {
							parsed = parsed + "\n"
						}
						case ec == 116 {
							parsed = parsed + "\t"
						}
						case ec == 114 {
							parsed = parsed + "\r"
						}
						case ec == 34 {
							parsed = parsed + "\""
						}
						case ec == 92 {
							parsed = parsed + "\x5c"
						}
						else {
							parsed = parsed + "\{e}"
						}
					}
				}
		} else {
			parsed = parsed + "\{c}"
		}
		i = i + 1
	}
	return parsed
	}

	// Parse a JSON document into a tree of JsonNode.
	pub func parse = (string s, out JsonNode) {
		var Buffer pos = Buffer()
		pos.alloc_int(1)
		pos.store_int(0, 0)
		var int len = s.length()
		return json_parse_value(s, ref pos, len)
	}

	// Serialize a JsonNode tree back to a JSON string.
	pub func stringify = (JsonNode n, out string) {
		return json_ser_value(n)
	}
}

// A node in a parsed JSON tree. Arrays and objects own their children as a
// linked list (child = first element/pair, linked through `next`), built
// recursively so each node has a single owner.
class JsonNode {
	var int kind = 0 // 0=null, 1=bool, 2=number, 3=string, 4=array, 5=object
	var float num = 0.0
	var string text = ""
	mov JsonNode? child = null
	mov JsonNode? next = null
	mov JsonNode? val = null
}

func json_skip_ws = (string s, ref Buffer pos, int len) {
	while pos.load_int(0) < len {
		var int i = pos.load_int(0)
		var int code = s.at(i) as int
		if code == 32 || code == 9 || code == 10 || code == 13 {
			pos.store_int(0, i + 1)
		} else {
			return
		}
	}
}

func json_parse_string = (string s, ref Buffer pos, int len, out JsonNode) {
	var int i = pos.load_int(0)
	i = i + 1
	var string sbuf = ""
	while i < len {
		var char c = s.at(i)
		var int code = c as int
		if code == 34 {
			i = i + 1
			break
		}
		if code == 92 {
			i = i + 1
			if i < len {
				var char e = s.at(i)
				var int ec = e as int
				switch {
					case ec == 110 {
						sbuf = sbuf + "\n"
					}
					case ec == 116 {
						sbuf = sbuf + "\t"
					}
					case ec == 114 {
						sbuf = sbuf + "\r"
					}
					case ec == 34 {
						sbuf = sbuf + "\""
					}
					case ec == 92 {
						sbuf = sbuf + "\x5c"
					}
					else {
						sbuf = sbuf + "\{e}"
					}
				}
			}
		} else {
			sbuf = sbuf + "\{c}"
		}
		i = i + 1
	}
	pos.store_int(0, i)
	var JsonNode n = JsonNode()
	n.kind = 3
	n.text = sbuf
	return n
}

func json_parse_number = (string s, ref Buffer pos, int len, out JsonNode) {
	var int i = pos.load_int(0)
	var int start = i
	while i < len {
		var int code = s.at(i) as int
		if code == 45 || code == 43 || code == 46 || code == 101 || code == 69 || (code >= 48 && code <= 57) {
			i = i + 1
		} else {
			break
		}
	}
	pos.store_int(0, i)
	var string nbuf = ""
	var int j = start
	while j < i {
		nbuf = nbuf + "\{s.at(j)}"
		j = j + 1
	}
	var JsonNode n = JsonNode()
	n.kind = 2
	n.text = nbuf
	return n
}

func json_parse_literal = (string s, ref Buffer pos, int len, out JsonNode) {
	var int i = pos.load_int(0)
	var int code = s.at(i) as int
	var JsonNode n = JsonNode()
	var int adv = 4
	if code == 116 {
		n.kind = 1
		adv = 4
	} else {
		if code == 102 {
			n.kind = 6
			adv = 5
		} else {
			n.kind = 0
			adv = 4
		}
	}
	pos.store_int(0, i + adv)
	return n
}

func json_parse_value = (string s, ref Buffer pos, int len, out JsonNode) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		var JsonNode n = JsonNode()
		return n
	}
	var int code = s.at(i) as int
	if code == 123 {
		pos.store_int(0, i + 1)
		var JsonNode n = JsonNode()
		n.kind = 5
		n.child = json_parse_pairs(s, ref pos, len)
		return n
	}
	if code == 91 {
		pos.store_int(0, i + 1)
		var JsonNode n = JsonNode()
		n.kind = 4
		n.child = json_parse_elements(s, ref pos, len)
		return n
	}
	if code == 34 {
		return json_parse_string(s, ref pos, len)
	}
	if code == 116 || code == 102 || code == 110 {
		return json_parse_literal(s, ref pos, len)
	}
	return json_parse_number(s, ref pos, len)
}

func json_parse_elements = (string s, ref Buffer pos, int len, out JsonNode?) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return null
	}
	if (s.at(i) as int) == 93 {
		pos.store_int(0, i + 1)
		return null
	}
	var JsonNode elem = json_parse_value(s, ref pos, len)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos.load_int(0)
	if i2 < len {
		if (s.at(i2) as int) == 44 {
			pos.store_int(0, i2 + 1)
		}
	}
	elem.next = json_parse_elements(s, ref pos, len)
	return elem
}

func json_parse_pairs = (string s, ref Buffer pos, int len, out JsonNode?) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return null
	}
	if (s.at(i) as int) == 125 {
		pos.store_int(0, i + 1)
		return null
	}
	json_skip_ws(s, ref pos, len)
	var JsonNode key = json_parse_string(s, ref pos, len)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos.load_int(0)
	if i2 < len {
		if (s.at(i2) as int) == 58 {
			pos.store_int(0, i2 + 1)
		}
	}
	var JsonNode v = json_parse_value(s, ref pos, len)
	key.val = v
	json_skip_ws(s, ref pos, len)
	var int i3 = pos.load_int(0)
	if i3 < len {
		if (s.at(i3) as int) == 44 {
			pos.store_int(0, i3 + 1)
		}
	}
	key.next = json_parse_pairs(s, ref pos, len)
	return key
}

func json_ser_list = (JsonNode first, out string) {
	if first.next == null {
		return json_ser_value(first)
	}
	return json_ser_value(first) + "," + json_ser_list(first.next)
}

func json_ser_pairs = (JsonNode first, out string) {
	var string ppart = "\"" + first.text + "\":"
	if first.val == null {
		ppart = ppart + "null"
	} else {
		ppart = ppart + json_ser_value(first.val)
	}
	if first.next == null {
		return ppart
	}
	return ppart + "," + json_ser_pairs(first.next)
}

func json_ser_value = (JsonNode n, out string) {
	var int k = n.kind
	if k == 0 {
		return "" + "null"
	}
	if k == 1 {
		return "" + "true"
	}
	if k == 6 {
		return "" + "false"
	}
	if k == 2 {
		return n.text
	}
	if k == 3 {
		return "\"" + n.text + "\""
	}
	if k == 4 {
		if n.child == null {
			return "[" + "]"
		}
		return "[" + json_ser_list(n.child) + "]"
	}
	if n.child == null {
		return "{" + "}"
	}
	return "{" + json_ser_pairs(n.child) + "}"
}
