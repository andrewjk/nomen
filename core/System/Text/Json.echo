// JSON serialize / deserialize for Echo string values, written in pure Echo.
//
// `serialize` quotes and escapes a string into a JSON string literal;
// `deserialize` parses a JSON string literal back into the raw value.
// Integer (de)serialization is handled by int.to_string() and int.parse()
// (see int.echo), so this struct only deals with JSON strings.

import Buffer
import StringBuilder

pub struct Json {
	// Serialize a string to a JSON string literal, escaping the special
	// characters ", \, newline, tab and carriage return.
	pub func serialize = (string value, out string) {
		var StringBuilder sb = StringBuilder()
		sb.append_char('"')
		var int i = 0
		var int len = value.length()
		while i < len {
			var char c = value.at(i)
			var int code = c as int
			switch {
				case code == 34 {
					sb.append_string("\x5c\"")
				}
				case code == 92 {
					sb.append_string("\x5c\x5c")
				}
				case code == 10 {
					sb.append_string("\x5cn")
				}
				case code == 9 {
					sb.append_string("\x5ct")
				}
				case code == 13 {
					sb.append_string("\x5cr")
				}
				else {
					sb.append_char(c)
				}
			}
			i = i + 1
		}
		sb.append_char('"')
		return sb.to_string()
	}

	// Deserialize a JSON string literal to the raw, unescaped value.
	pub func deserialize = (string json, out string) {
		var StringBuilder sb = StringBuilder()
		var int len = json.length()
		var int i = 0
		// skip up to the opening quote
		while i < len {
			if (json.at(i) as int) == 34 {
				i = i + 1
				break
			}
			i = i + 1
		}
		// read until the unescaped closing quote, unescaping as we go
		while i < len {
			var char c = json.at(i)
			var int code = c as int
			if code == 34 {
				break
			}
			if code == 92 {
				i = i + 1
				if i < len {
					var char e = json.at(i)
					var int ec = e as int
					switch {
						case ec == 110 {
							sb.append_string("\n")
						}
						case ec == 116 {
							sb.append_string("\t")
						}
						case ec == 114 {
							sb.append_string("\r")
						}
						case ec == 34 {
							sb.append_char('"')
						}
						case ec == 92 {
							sb.append_string("\x5c")
						}
						else {
							sb.append_char(e)
						}
					}
				}
			} else {
				sb.append_char(c)
			}
			i = i + 1
		}
		return sb.to_string()
	}

	// Parse a JSON document into a tree of JsonNode.
	pub func parse = (string s, out JsonNode) {
		var Buffer<int> pos = Buffer<int>()
		pos.alloc_int(1)
		pos.store_int(0, 0)
		var int len = s.length()
		return json_parse_value(s, ref pos, len)
	}

	// Serialize a JsonNode tree back to a JSON string.
	pub func stringify = (JsonNode n, out string) {
		var StringBuilder sb = StringBuilder()
		json_ser_value(n, ref sb)
		return sb.to_string()
	}
}

// A node in a parsed JSON tree. Arrays and objects own their children as a
// linked list (child = first element/pair, linked through `next`), built
// recursively so each node has a single owner.
class JsonNode {
	var int kind = 0 // 0=null, 1=bool, 2=number, 3=string, 4=array, 5=object
	var float num = 0.0
	var string text = ""
	mov JsonNode? child = null
	mov JsonNode? next = null
	mov JsonNode? val = null
}

func json_skip_ws = (string s, ref Buffer<int> pos, int len) {
	while pos.load_int(0) < len {
		var int i = pos.load_int(0)
		var int code = s.at(i) as int
		if code == 32 || code == 9 || code == 10 || code == 13 {
			pos.store_int(0, i + 1)
		} else {
			return
		}
	}
}

func json_parse_string = (string s, ref Buffer<int> pos, int len, out JsonNode) {
	var int i = pos.load_int(0)
	i = i + 1
	var StringBuilder sb = StringBuilder()
	while i < len {
		var char c = s.at(i)
		var int code = c as int
		if code == 34 {
			i = i + 1
			break
		}
		if code == 92 {
			i = i + 1
			if i < len {
				var char e = s.at(i)
				var int ec = e as int
				switch {
					case ec == 110 {
						sb.append_string("\n")
					}
					case ec == 116 {
						sb.append_string("\t")
					}
					case ec == 114 {
						sb.append_string("\r")
					}
					case ec == 34 {
						sb.append_char('"')
					}
					case ec == 92 {
						sb.append_string("\x5c")
					}
					else {
						sb.append_char(e)
					}
				}
			}
		} else {
			sb.append_char(c)
		}
		i = i + 1
	}
	pos.store_int(0, i)
	var JsonNode n = JsonNode()
	n.kind = 3
	n.text = sb.to_string()
	return n
}

func json_parse_number = (string s, ref Buffer<int> pos, int len, out JsonNode) {
	var int i = pos.load_int(0)
	var int start = i
	while i < len {
		var int code = s.at(i) as int
		if code == 45 || code == 43 || code == 46 || code == 101 || code == 69 || (code >= 48 && code <= 57) {
			i = i + 1
		} else {
			break
		}
	}
	pos.store_int(0, i)
	var StringBuilder sb = StringBuilder()
	var int j = start
	while j < i {
		sb.append_char(s.at(j))
		j = j + 1
	}
	var JsonNode n = JsonNode()
	n.kind = 2
	n.text = sb.to_string()
	return n
}

func json_parse_literal = (string s, ref Buffer<int> pos, int len, out JsonNode) {
	var int i = pos.load_int(0)
	var int code = s.at(i) as int
	var JsonNode n = JsonNode()
	var int adv = 4
	if code == 116 {
		n.kind = 1
		adv = 4
	} else {
		if code == 102 {
			n.kind = 6
			adv = 5
		} else {
			n.kind = 0
			adv = 4
		}
	}
	pos.store_int(0, i + adv)
	return n
}

func json_parse_value = (string s, ref Buffer<int> pos, int len, out JsonNode) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		var JsonNode n = JsonNode()
		return n
	}
	var int code = s.at(i) as int
	if code == 123 {
		pos.store_int(0, i + 1)
		var JsonNode n = JsonNode()
		n.kind = 5
		n.child = json_parse_pairs(s, ref pos, len)
		return n
	}
	if code == 91 {
		pos.store_int(0, i + 1)
		var JsonNode n = JsonNode()
		n.kind = 4
		n.child = json_parse_elements(s, ref pos, len)
		return n
	}
	if code == 34 {
		return json_parse_string(s, ref pos, len)
	}
	if code == 116 || code == 102 || code == 110 {
		return json_parse_literal(s, ref pos, len)
	}
	return json_parse_number(s, ref pos, len)
}

func json_parse_elements = (string s, ref Buffer<int> pos, int len, out JsonNode?) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return null
	}
	if (s.at(i) as int) == 93 {
		pos.store_int(0, i + 1)
		return null
	}
	var JsonNode elem = json_parse_value(s, ref pos, len)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos.load_int(0)
	if i2 < len {
		if (s.at(i2) as int) == 44 {
			pos.store_int(0, i2 + 1)
		}
	}
	elem.next = json_parse_elements(s, ref pos, len)
	return elem
}

func json_parse_pairs = (string s, ref Buffer<int> pos, int len, out JsonNode?) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return null
	}
	if (s.at(i) as int) == 125 {
		pos.store_int(0, i + 1)
		return null
	}
	json_skip_ws(s, ref pos, len)
	var JsonNode key = json_parse_string(s, ref pos, len)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos.load_int(0)
	if i2 < len {
		if (s.at(i2) as int) == 58 {
			pos.store_int(0, i2 + 1)
		}
	}
	var JsonNode v = json_parse_value(s, ref pos, len)
	key.val = v
	json_skip_ws(s, ref pos, len)
	var int i3 = pos.load_int(0)
	if i3 < len {
		if (s.at(i3) as int) == 44 {
			pos.store_int(0, i3 + 1)
		}
	}
	key.next = json_parse_pairs(s, ref pos, len)
	return key
}

func json_ser_list = (JsonNode first, ref StringBuilder sb) {
	json_ser_value(first, ref sb)
	if first.next != null {
		sb.append_char(',')
		json_ser_list(first.next, ref sb)
	}
}

func json_ser_pairs = (JsonNode first, ref StringBuilder sb) {
	sb.append_char('"')
	sb.append_string(first.text)
	sb.append_string("\":")
	if first.val == null {
		sb.append_string("null")
	} else {
		json_ser_value(first.val, ref sb)
	}
	if first.next != null {
		sb.append_char(',')
		json_ser_pairs(first.next, ref sb)
	}
}

func json_ser_value = (JsonNode n, ref StringBuilder sb) {
	var int k = n.kind
	if k == 0 {
		sb.append_string("null")
		return
	}
	if k == 1 {
		sb.append_string("true")
		return
	}
	if k == 6 {
		sb.append_string("false")
		return
	}
	if k == 2 {
		sb.append_string(n.text)
		return
	}
	if k == 3 {
		sb.append_char('"')
		sb.append_string(n.text)
		sb.append_char('"')
		return
	}
	if k == 4 {
		sb.append_char('[')
		if n.child != null {
			json_ser_list(n.child, ref sb)
		}
		sb.append_char(']')
		return
	}
	sb.append_char('{')
	if n.child != null {
		json_ser_pairs(n.child, ref sb)
	}
	sb.append_char('}')
}
