// Base64 encoding (RFC 4648), in pure Nomen.
//
// Two alphabets: the standard one (`+` and `/`, section 4) and the
// URL- and filename-safe one (`-` and `_`, section 5). Strings are byte
// arrays, so binary data (digests, keys) round-trips unchanged.
//
// Decoding is strict, so every byte string has exactly one accepted
// encoding: characters outside the alphabet (including whitespace and
// line breaks) are rejected, `=` may only appear as trailing padding, and
// the unused low bits of the final character must be zero.

/**
 * Base64 encoding of bytes (RFC 4648) — standard (`encode`/`decode`) and URL-safe (`encode_url`/`decode_url`) alphabets
 *
 *	Console.write(Base64.encode("foobar"))       // "Zm9vYmFy"
 *	Console.write(Base64.encode_url("\xFB\xFF"))  // "-_8" (no padding)
 *	match Base64.decode("Zm9vYg==") {
 *		case .ok(bytes) -> Console.write(bytes)    // "foob"
 *		case .fail(e) -> Console.write("bad base64")
 *	}
 *
 * `encode` always pads to a multiple of four characters with `=`;
 * `decode` requires that padding. `encode_url` omits padding (the usual
 * form in URLs, JWTs and cookies); `decode_url` accepts input with or
 * without it.
 **/
pub struct Base64 {
	// Encode data with the standard alphabet, padded with `=`.
	pub func encode = (view string data, mv out string) {
		return base64_encode(data, false, true)
	}

	// Encode data with the URL-safe alphabet (`-` and `_`), without padding.
	pub func encode_url = (view string data, mv out string) {
		return base64_encode(data, true, false)
	}

	// Decode standard-alphabet base64. The input must be padded to a
	// multiple of four characters.
	pub func decode = (view string text, out string ! Base64Error) {
		return base64_decode(text, false, true)
	}

	// Decode URL-safe base64. Padding is optional, but when present it
	// must be correct.
	pub func decode_url = (view string text, out string ! Base64Error) {
		return base64_decode(text, true, false)
	}
}

func base64_encode = (view string data, bool url, bool pad, mv out string) {
	var sb = StringBuilder()
	const len = data.length
	var i = 0
	// Whole 3-byte groups: 24 bits become four 6-bit characters.
	while i + 2 < len; i += 3 {
		const b0 = data.char_code_at_or(i, 0)
		const b1 = data.char_code_at_or(i + 1, 0)
		const b2 = data.char_code_at_or(i + 2, 0)
		const n = (b0 << 16) | (b1 << 8) | b2
		sb.append_char(base64_char(n >> 18, url))
		sb.append_char(base64_char((n >> 12) & 63, url))
		sb.append_char(base64_char((n >> 6) & 63, url))
		sb.append_char(base64_char(n & 63, url))
	}
	const rest = len - i
	if rest == 1 {
		const n = data.char_code_at_or(i, 0) << 16
		sb.append_char(base64_char(n >> 18, url))
		sb.append_char(base64_char((n >> 12) & 63, url))
		if pad {
			sb.append_string("==")
		}
	}
	if rest == 2 {
		const b0 = data.char_code_at_or(i, 0)
		const b1 = data.char_code_at_or(i + 1, 0)
		const n = (b0 << 16) | (b1 << 8)
		sb.append_char(base64_char(n >> 18, url))
		sb.append_char(base64_char((n >> 12) & 63, url))
		sb.append_char(base64_char((n >> 6) & 63, url))
		if pad {
			sb.append_char('=')
		}
	}
	return sb.to_string()
}

func base64_decode = (view string text, bool url, bool require_padding, out string ! Base64Error) {
	const len = text.length
	if require_padding && len % 4 != 0 {
		return .invalid_length
	}
	// Count the trailing `=` (at most two are ever valid).
	var pad = 0
	while pad < len && text.char_code_at_or(len - 1 - pad, 0) == 61; pad += 1 {
	}
	if pad > 2 {
		return .invalid_padding
	}
	// Padding, when present, must complete the final group.
	if pad > 0 && len % 4 != 0 {
		return .invalid_padding
	}
	const data_len = len - pad
	// A lone character in the final group carries only 6 of 8 bits.
	if data_len % 4 == 1 {
		return .invalid_length
	}
	var sb = StringBuilder()
	var acc = 0
	var bits = 0
	var i = 0
	while i < data_len; i += 1 {
		const code = text.char_code_at_or(i, 0)
		const v = base64_value(code, url)
		if v < 0 {
			if code == 61 {
				return .invalid_padding
			}
			return .invalid_character(i)
		}
		acc = ((acc << 6) | v) & 0xFFFF
		bits += 6
		if bits >= 8 {
			bits -= 8
			sb.append_char(((acc >> bits) & 0xFF) as char)
		}
	}
	// The leftover low bits of the final character must be zero.
	if (acc & ((1 << bits) - 1)) != 0 {
		return .invalid_padding
	}
	return sb.to_string()
}

// The base64 character for a 6-bit value.
func base64_char = (int v, bool url, out char) {
	switch {
		case v < 26 {
			return (65 + v) as char
		}
		case v < 52 {
			return (71 + v) as char
		}
		case v < 62 {
			return (v - 4) as char
		}
		case v == 62 && url {
			return '-'
		}
		case v == 62 {
			return '+'
		}
		case url {
			return '_'
		}
	}
	return '/'
}

// The 6-bit value of a base64 character byte, or -1 when it is not in
// the alphabet.
func base64_value = (int code, bool url, out int) {
	switch {
		case code >= 65 && code <= 90 {
			return code - 65
		}
		case code >= 97 && code <= 122 {
			return code - 71
		}
		case code >= 48 && code <= 57 {
			return code + 4
		}
		case url && code == 45 {
			return 62
		}
		case url && code == 95 {
			return 63
		}
		case !url && code == 43 {
			return 62
		}
		case !url && code == 47 {
			return 63
		}
	}
	return -1
}
