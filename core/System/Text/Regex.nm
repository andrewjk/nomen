// Regular expression support implemented in pure Nomen.
//
// `test` reports whether a pattern matches anywhere in the input; `match`
// returns the first matched substring (or "" when there is no match).
// Patterns use POSIX Extended Regular Expression syntax, extended with
// non-capturing groups `(?:...)`, lookaround (`(?=...)` / `(?!...)` /
// `(?<=...)` / `(?<!...)`), and counted repetition (`{n}` / `{n,}` / `{n,m}`).

/**
 * Regular-expression helpers (`test`/`match`/`count`/`replace_all`) using POSIX ERE syntax plus `(?:...)`, lookaround, and `{n,m}` counted repetition
 **/
pub struct Regex {
	// Test whether pattern matches anywhere in input.
	pub func test = (string pattern, string input, out bool) {
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var i = 0
		while i <= len; i += 1 {
			if clen > 0 && i < len {
				i = find_next_byte(input, i, len, charset)
				if i > len {
					break
				}
			}
			var caps = List<int>()
			if match_here(pattern, 0, pat_len, input, i, len, ref caps) >= 0 {
				return true
			}
		}
		return false
	}

	// Return the first substring of input matching pattern, or "" if none.
	// `move out string`: the built match (or the copied empty literal) is
	// handed to the caller as an owned value.
	pub func match = (string pattern, string input, move out string) {
		var match_result = ""
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var i = 0
		while i <= len; i += 1 {
			if clen > 0 && i < len {
				i = find_next_byte(input, i, len, charset)
				if i > len {
					break
				}
			}
			var caps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, i, len, ref caps)
			if end >= 0 {
				var int j = i
				while j < end; j += 1 {
					match_result = match_result + "\{input.at(j)}"
				}
				break
			}
		}
		return match_result
	}

	// Try to match pattern anywhere in input. On a match, append the whole
	// match as group 0 followed by capture groups 1..N to `out` ("" for a
	// group that did not participate in the match) and return true. Return
	// false with `out` untouched when nothing matches. A group that repeats
	// (`(a)+`) reports its LAST iteration.
	pub func captures = (
		string pattern,
		string input,
		ref List<string> dst,
		out bool
	) { var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var int groups = capture_count(pattern)
		var i = 0
		while i <= len; i += 1 {
			if clen > 0 && i < len {
				i = find_next_byte(input, i, len, charset)
				if i > len {
					break
				}
			}
			var caps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, i, len, ref caps)
			if end >= 0 {
				var string whole = input.substring(i, end)
				dst.push(whole)
				var g = 1
				while g <= groups; g += 1 {
					var int at = last_capture_index(caps, g)
					if at >= 0 {
						var int s = caps.at(at + 1)
						if s >= 0 {
							var string cap = input.substring(s, caps.at(at + 2))
							dst.push(cap)
						} else {
							dst.push("")
						}
					} else {
						dst.push("")
					}
				}
				return true
			}
		}
		return false
	}

	// Find the first match of pattern in input and fill `dst` with where it
	// sits: .found with byte offsets .start/.end, the matched .text, and
	// .length (all zero/empty when .found is false — mvzr-style positions
	// for callers doing their own index bookkeeping). `dst` is fully reset
	// first, so a reused RegexMatch carries nothing over. Scans every
	// position: the first-byte prefilter would skip nullable patterns'
	// empty matches at skipped positions, reporting a wrong .start.
	pub func find = (string pattern, string input, ref RegexMatch dst) {
		dst.found = false
		dst.start = 0
		dst.end = 0
		dst.length = 0
		dst.text = ""
		var int pat_len = pattern.length
		var int len = input.length
		var i = 0
		while i <= len; i += 1 {
			var caps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, i, len, ref caps)
			if end >= 0 {
				dst.found = true
				dst.start = i
				dst.end = end
				dst.length = end - i
				dst.text = input.substring(i, end)
				return
			}
		}
	}

	// Count the number of non-overlapping occurrences of pattern in input.
	pub func count = (string pattern, string input, out int) {
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var total = 0
		var pos = 0
		while pos < len {
			if clen > 0 {
				pos = find_next_byte(input, pos, len, charset)
				if pos >= len {
					break
				}
			}
			var caps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, pos, len, ref caps)
			if end >= 0 {
				total += 1
				if end == pos {
					pos += 1
				} else {
					pos = end
				}
			} else {
				pos += 1
			}
		}
		return total
	}

	// Replace all non-overlapping occurrences of pattern in input with replacement.
	pub func replace_all = (
		string pattern,
		string input,
		string replacement,
		out string
	) { var sb = StringBuilder()
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var pos = 0
		while pos < len {
			if clen > 0 {
				var int next = find_next_byte(input, pos, len, charset)
				// Copy the bytes we're skipping over.
				while pos < next {
					sb.append_char(input.at(pos))
					pos += 1
				}
				if pos >= len {
					break
				}
			}
			var caps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, pos, len, ref caps)
			if end >= 0 {
				sb.append_string(replacement)
				if end == pos {
					sb.append_char(input.at(pos))
					pos += 1
				} else {
					pos = end
				}
			} else {
				sb.append_char(input.at(pos))
				pos += 1
			}
		}
		return sb.to_string()
	}

	// Whether pattern matches anywhere in input, ignoring ASCII case.
	pub func test_ci = (string pattern, string input, out bool) {
		var string folded = fold_pattern(pattern)
		return Regex.test(folded, input)
	}

	// First match of pattern in input, ignoring ASCII case ("" if none).
	pub func match_ci = (string pattern, string input, move out string) {
		var string folded = fold_pattern(pattern)
		return Regex.match(folded, input)
	}

	// find, ignoring ASCII case.
	pub func find_ci = (string pattern, string input, ref RegexMatch dst) {
		var string folded = fold_pattern(pattern)
		Regex.find(folded, input, ref dst)
	}

	// captures, ignoring ASCII case.
	pub func captures_ci = (string pattern, string input, ref List<string> dst, out bool) {
		var string folded = fold_pattern(pattern)
		return Regex.captures(folded, input, ref dst)
	}

	// replace_all, ignoring ASCII case.
	pub func replace_all_ci = (string pattern, string input, string replacement, out string) {
		var string folded = fold_pattern(pattern)
		return Regex.replace_all(folded, input, replacement)
	}
}

// Rewrite pattern so the case-sensitive engine matches case-insensitively:
// literals become both-case classes ([kK]), class members and ranges gain
// their case counterparts ([a-z] -> [a-zA-Z]). Structural syntax — groups,
// alternation, quantifiers, anchors, escaped punctuation — is copied
// through unchanged.
func fold_pattern = (string pattern, move out string) {
	var int n = pattern.length
	var sb = StringBuilder()
	var i = 0
	while i < n; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			// Escaped char: shorthands, backrefs, and control escapes
			// (\n \r \t) keep their backslash; other escaped letters
			// become both-case classes; escaped punctuation is copied
			// literally.
			if i + 1 < n {
				var char e = pattern.at(i + 1)
				if is_shorthand(e) || is_backref_digit(e) || is_control_escape(e) {
					sb.append_char(c)
					sb.append_char(e)
				} else {
					if is_alpha_byte(e) {
						sb.append_char('[')
						sb.append_char(e)
						sb.append_char(swap_case_byte(e))
						sb.append_char(']')
					} else {
						sb.append_char(c)
						sb.append_char(e)
					}
				}
				i += 1
			} else {
				sb.append_char(c)
			}
		} else {
			if c == '[' {
				var int ce = atom_end_pos(pattern, i, n)
				fold_class(pattern, i, ce, ref sb)
				i = ce - 1
			} else {
				if is_alpha_byte(c) {
					sb.append_char('[')
					sb.append_char(c)
					sb.append_char(swap_case_byte(c))
					sb.append_char(']')
				} else {
					sb.append_char(c)
				}
			}
		}
	}
	return sb.to_string()
}

// fold a character class [cs..ce): copy its contents, adding the case
// counterpart of every letter member and mirroring letter ranges.
func fold_class = (string pattern, int cs, int ce, ref StringBuilder dst) {
	dst.append_char('[')
	var int i = cs + 1
	if i < ce - 1 {
		if pattern.at(i) == '^' {
			dst.append_char('^')
			i += 1
		}
	}
	var int content_end = ce - 1
	while i < content_end; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			dst.append_char(c)
			if i + 1 < content_end {
				var char e = pattern.at(i + 1)
				dst.append_char(e)
				// A shorthand or control escape (\n \r \t) keeps its
				// backslash; other escaped letters gain their case
				// counterpart.
				if is_alpha_byte(e) && !is_shorthand(e) && !is_control_escape(e) {
					dst.append_char(swap_case_byte(e))
				}
				i += 1
			}
		} else {
			if i + 2 < content_end {
				if pattern.at(i + 1) == '-' {
					var char lo = c
					var char hi = pattern.at(i + 2)
					dst.append_char(lo)
					dst.append_char('-')
					dst.append_char(hi)
					if is_alpha_byte(lo) {
						if is_alpha_byte(hi) {
							dst.append_char(swap_case_byte(lo))
							dst.append_char('-')
							dst.append_char(swap_case_byte(hi))
						}
					}
					i += 2
				} else {
					if is_alpha_byte(c) {
						dst.append_char(c)
						dst.append_char(swap_case_byte(c))
					} else {
						dst.append_char(c)
					}
				}
			} else {
				if is_alpha_byte(c) {
					dst.append_char(c)
					dst.append_char(swap_case_byte(c))
				} else {
					dst.append_char(c)
				}
			}
		}
	}
	dst.append_char(']')
}

// ASCII letter test for pattern characters.
func is_alpha_byte = (char c, out bool) {
	var int code = c as int
	return (code > 64 && code < 91) || (code > 96 && code < 123)
}

// The ASCII letter with the opposite case (unchanged for non-letters).
func swap_case_byte = (char c, out char) {
	var int code = c as int
	if code > 64 && code < 91 {
		return (code + 32) as char
	}
	if code > 96 && code < 123 {
		return (code - 32) as char
	}
	return c
}

// Scan input[pos..len) for the next byte that appears in charset.
// Returns the index of the match, or len if none found / charset is empty.
func find_next_byte = (string input, int pos, int len, string charset, out int) {
	if pos >= len {
		return len
	}
	if charset.length == 0 {
		return len
	}
	var i = pos
	while i < len && i < input.length; i += 1 {
		var j = 0
		while j < charset.length; j += 1 {
			if input.at(i) == charset.at(j) {
				return i
			}
		}
	}
	return len
}

// Extract the set of possible first bytes from a pattern into a charset string.
// Returns "" if every byte is possible (e.g. pattern starts with '.', '(' with
// an unbounded repeat, or an alternative whose first set can't be determined).
func first_byte_set = (string pattern, int pat_len, out string) {
	if pat_len == 0 {
		return ""
	}
	var sb = StringBuilder()
	if collect_first_bytes(pattern, 0, pat_len, ref sb) < 0 {
		// Some alternative's first-byte set is indeterminable — a wildcard
		// '.', an empty alternative, or similar. The charset is a PREFILTER
		// (candidate positions via strpbrk): under-approximating it would
		// skip positions where a match can start, so disable it entirely.
		return ""
	}
	return sb.to_string()
}

// Walk top-level alternatives of pattern[pat_pos..pat_end), appending the first
// byte(s) of each alternative to sb. Alternations at depth 0 are split on '|'.
// Returns -1 when any alternative's first-byte set can't be determined (the
// caller must then disable the prefilter), 0 otherwise.
func collect_first_bytes = (
	string pattern,
	int pat_pos,
	int pat_end,
	ref StringBuilder sb,
	out int
) {
	var depth = 0
	var int i = pat_pos
	var int alt_start = pat_pos
	while i < pat_end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 2
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, pat_end)
			} else {
				if c == '(' {
					depth = depth + 1
				}
				if c == ')' {
					if depth > 0 {
						depth -= 1
					}
				}
				if (c as int) == 124 {
					if depth == 0 {
						if alt_first_bytes(pattern, alt_start, i, ref sb) < 0 {
							return -1
						}
						alt_start = i + 1
					}
				}
				i += 1
			}
		}
	}
	return alt_first_bytes(pattern, alt_start, pat_end, ref sb)
}

// Append the set of bytes that can start a match of the alternative occupying
// pattern[start..end) to sb. Returns -1 when the set can't be determined (the
// caller must disable the prefilter), 0 when it was appended.
//
// Handles the shapes the engine's matcher can produce: a leading anchor is
// zero-width (skipped), a leading group contributes its CONTENT's first bytes
// (recursively over the group's own top-level alternatives), and ANY leading
// atom — literal, escaped, class, or group — quantified with '?'/'*' is
// nullable: what FOLLOWS it can also be first, so the scan continues past it.
// A wildcard '.' or an empty alternative makes the set indeterminable.
func alt_first_bytes = (string pattern, int start, int end, ref StringBuilder sb, out int) {
	var int i = start
	while i < end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			// escaped literal: first byte is the byte the escape names
			// (\n is LF, \r is CR, \t is TAB; any other escaped character
			// is its own literal byte) — unless it's a backreference
			// (depends on a capture) or a complement shorthand (not an
			// inclusion set), which disable the prefilter.
			if i + 1 < end {
				var char e = pattern.at(i + 1)
				if is_backref_digit(e) {
					return -1
				}
				if is_shorthand(e) {
					if shorthand_members(e, ref sb) < 0 {
						return -1
					}
				} else {
					sb.append_char(escaped_byte_value(e) as char)
				}
				// A '?'/'*' quantifier makes the atom nullable — the first
				// byte can also come from whatever follows it.
				var int cont = nullable_quant_after(pattern, i + 2, end)
				if cont < 0 {
					return 0
				}
				i = cont
				continue
			}
			return 0
		}
		if c == '[' {
			var int a_end = atom_end_pos(pattern, i, end)
			// A NEGATED class can match any byte outside its member set —
			// not expressible as an inclusion charset, and under-approximating
			// (the member bytes alone) would make strpbrk skip valid match
			// positions. Disable the prefilter instead.
			var int cs = i + 1
			if cs < a_end - 1 {
				if pattern.at(cs) == '^' {
					return -1
				}
			}
			add_class_chars(pattern, i + 1, a_end - 1, ref sb)
			var int cont = nullable_quant_after(pattern, a_end, end)
			if cont < 0 {
				return 0
			}
			i = cont
			continue
		}
		if c == '(' {
			var int a_end = atom_end_pos(pattern, i, end)
			var int kind = group_kind(pattern, i, end)
			if kind >= 2 {
				// Lookaround: zero-width — contributes no byte, so the first
				// byte comes from whatever follows.
				i = a_end
				continue
			}
			// The group's first bytes are the union of its content's
			// top-level alternatives' first bytes.
			var int inner = group_inner_start(pattern, i, end)
			if collect_first_bytes(pattern, inner, a_end - 1, ref sb) < 0 {
				return -1
			}
			var int cont = nullable_quant_after(pattern, a_end, end)
			if cont < 0 {
				return 0
			}
			i = cont
			continue
		}
		if c == '^' || c == '$' {
			// zero-width assertions never consume a byte
			i += 1
			continue
		}
		if c == '.' {
			// wildcard (any byte except '\n') — not expressible as an
			// inclusion set; the prefilter must be disabled.
			return -1
		}
		sb.append_char(c)
		var int cont = nullable_quant_after(pattern, i + 1, end)
		if cont < 0 {
			return 0
		}
		i = cont
		continue
	}
	// An empty alternative (nothing left after nullable atoms — or nothing at
	// all) can match at any position — indeterminable.
	return -1
}

// If the atom ending at `after` carries a nullable quantifier ('?' or '*',
// optionally marked lazy by a second '?'), return the position just past the
// quantifier; otherwise return -1. Callers keep scanning from the returned
// position: a nullable leading atom means the alternative's match can also
// START with whatever follows, so those bytes belong in the first-byte set
// too. ('+' is NOT nullable — the atom must match once — so it leaves the
// atom's own bytes as the whole first set.)
func nullable_quant_after = (string pattern, int after, int end, out int) {
	var int j = after
	if j >= end {
		return -1
	}
	var char q = pattern.at(j)
	if q == '?' || q == '*' {
		j += 1
		if j < end {
			if pattern.at(j) == '?' {
				j += 1
			}
		}
		return j
	}
	if q == '{' {
		// A counted bound is nullable only when its minimum is 0 ({0}, {0,},
		// {0,m}); the first byte then also comes from what follows.
		var int qe = counted_quant_end(pattern, j, end)
		if qe >= 0 {
			var int qmin = counted_quant_min(pattern, j)
			if qmin == 0 {
				var int k = qe
				if k < end {
					if pattern.at(k) == '?' {
						k += 1
					}
				}
				return k
			}
			return -1
		}
	}
	return -1
}

// Parse a counted repetition bound `{n}`, `{n,}`, or `{n,m}` whose '{' is at
// pos. Returns the position just past the closing '}', or -1 when the braces
// are not a valid bound (the '{' is then a literal character).
func counted_quant_end = (string pattern, int pos, int pat_end, out int) {
	var int i = pos + 1
	var int digits = i
	while i < pat_end {
		if is_digit_byte(pattern.at(i)) {
			i += 1
		} else {
			break
		}
	}
	if i == digits {
		return -1
	}
	if i < pat_end {
		if pattern.at(i) == ',' {
			i += 1
			while i < pat_end {
				if is_digit_byte(pattern.at(i)) {
					i += 1
				} else {
					break
				}
			}
		}
	}
	if i < pat_end {
		if pattern.at(i) == '}' {
			return i + 1
		}
	}
	return -1
}

// The minimum repetition count of a `{...}` bound at pos (assumes a valid
// bound was found by counted_quant_end).
func counted_quant_min = (string pattern, int pos, out int) {
	var int i = pos + 1
	var value = 0
	while i < pattern.length {
		if is_digit_byte(pattern.at(i)) {
			value = value * 10 + ((pattern.at(i) as int) - 48)
			i += 1
		} else {
			break
		}
	}
	return value
}

// The maximum repetition count of a `{...}` bound at pos: the value after the
// comma for `{n,m}`, -1 for the unbounded `{n,}`, and the minimum for `{n}`.
func counted_quant_max = (string pattern, int pos, int pat_end, out int) {
	var int i = pos + 1
	while i < pat_end {
		if is_digit_byte(pattern.at(i)) {
			i += 1
		} else {
			break
		}
	}
	if i >= pat_end {
		return counted_quant_min(pattern, pos)
	}
	if pattern.at(i) != ',' {
		return counted_quant_min(pattern, pos)
	}
	var int j = i + 1
	var value = 0
	var int digits = j
	while j < pat_end {
		if is_digit_byte(pattern.at(j)) {
			value = value * 10 + ((pattern.at(j) as int) - 48)
			j += 1
		} else {
			break
		}
	}
	if j == digits {
		// `{n,}` — unbounded maximum.
		return -1
	}
	return value
}

// Whether a pattern character is an ASCII digit.
func is_digit_byte = (char c, out bool) {
	var int code = c as int
	return code >= 48 && code <= 57
}

// Append the members of character class [start..end) to sb. Ranges (a-z) are
// expanded; negation (^) is ignored (we want all candidates).
func add_class_chars = (
	string pattern,
	int start,
	int end,
	ref StringBuilder sb
) { var int cs = start
	if cs < end {
		if pattern.at(cs) == '^' {
			cs += 1
		}
	}
	var int i = cs
	while i < end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			// Escaped byte: contribute the byte the escape names (\n is
			// LF, \r is CR, \t is TAB; any other escaped character is its
			// own literal byte) so the prefilter stays a superset of the
			// matcher's first bytes.
			if i + 1 < end {
				sb.append_char(escaped_byte_value(pattern.at(i + 1)) as char)
			}
			i += 2
		} else {
			if i + 2 < end {
				if pattern.at(i + 1) == '-' {
					var int lo = pattern.at(i) as int
					var int hi = pattern.at(i + 2) as int
					while lo <= hi {
						sb.append_char(lo as char)
						lo += 1
					}
					i += 3
				} else {
					sb.append_char(c)
					i += 1
				}
			} else {
				sb.append_char(c)
				i += 1
			}
		}
	}
}

// Match pattern[pat_pos..pat_end) against input starting at in_pos.
// Returns the end position in input after a successful match, or -1.
// Return contract: a successful match never reads past in_len, so the result
// is always <= in_len (and -1 on failure). This lets callers prove an index
// bounded by the result is also bounded by the input length.
// `caps` collects capture spans as (group_index, start, end) triples in
// match order; a later entry for the same group supersedes an earlier one.
func match_here = (
	string pattern,
	int pat_pos,
	int pat_end,
	string input,
	int in_pos,
	int in_len,
	ref List<int> caps,
	out int: out <= in_len
) {
	// Handle top-level alternation: a '|' at bracket/paren depth 0 splits the
	// range into alternatives. Char classes and escapes are skipped so a '|' or
	// '\|' inside them is not mistaken for an alternation operator.
	var depth = 0
	var int i = pat_pos
	while i < pat_end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 2
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, pat_end)
			} else {
				if c == '(' {
					depth += 1
				}
				if c == ')' {
					if depth > 0 {
						depth -= 1
					}
				}
				if (c as int) == 124 {
					if depth == 0 {
						var int left = match_here(
							pattern,
							pat_pos,
							i,
							input,
							in_pos,
							in_len,
							ref caps,
						)
						if left >= 0 {
							return left
						}
						return match_here(pattern, i + 1, pat_end, input, in_pos, in_len, ref caps)
					}
				}
				i += 1
			}
		}
	}

	// Pattern exhausted: match succeeds at the current position.
	if pat_pos >= pat_end {
		return in_pos
	}

	var char pc = pattern.at(pat_pos)

	// Anchors (zero-width assertions).
	if pc == '^' {
		if in_pos != 0 {
			return -1
		}
		return match_here(pattern, pat_pos + 1, pat_end, input, in_pos, in_len, ref caps)
	}
	if pc == '$' {
		if in_pos != in_len {
			return -1
		}
		return match_here(pattern, pat_pos + 1, pat_end, input, in_pos, in_len, ref caps)
	}

	// Lookaround assertions are zero-width: evaluate the inner pattern and
	// continue matching the rest at the SAME input position.
	if pc == '(' && is_non_capturing_open(pattern, pat_pos, pat_end) {
		var int look_kind = group_kind(pattern, pat_pos, pat_end)
		if look_kind >= 2 {
			var int look_end = atom_end_pos(pattern, pat_pos, pat_end)
			var int look_inner = group_inner_start(pattern, pat_pos, pat_end)
			if lookaround_succeeds(
				look_kind,
				pattern,
				look_inner,
				look_end - 1,
				input,
				in_pos,
				in_len,
			) == false {
				return -1
			}
			return match_here(pattern, look_end, pat_end, input, in_pos, in_len, ref caps)
		}
	}

	// Determine the bounds of the current atom.
	var int a_end = atom_end_pos(pattern, pat_pos, pat_end)

	// Check for a quantifier following the atom. A trailing '?' marks the
	// quantifier LAZY (shortest match first) — the rest of the pattern then
	// starts after both symbols.
	if a_end < pat_end {
		var char q = pattern.at(a_end)
		if q == '*' || q == '+' || q == '?' {
			var lazy = 0
			var int rest = a_end + 1
			if rest < pat_end {
				if pattern.at(rest) == '?' {
					lazy = 1
					rest += 1
				}
			}
			if q == '*' {
				return match_star(
					pattern,
					pat_pos,
					a_end,
					rest,
					pat_end,
					input,
					in_pos,
					0,
					lazy,
					in_len,
					ref caps,
				)
			}
			if q == '+' {
				return match_star(
					pattern,
					pat_pos,
					a_end,
					rest,
					pat_end,
					input,
					in_pos,
					1,
					lazy,
					in_len,
					ref caps,
				)
			}
			return match_optional(
				pattern,
				pat_pos,
				a_end,
				rest,
				pat_end,
				input,
				in_pos,
				lazy,
				in_len,
				ref caps,
			)
		}
		if q == '{' {
			// Counted repetition: {n}, {n,}, {n,m}, optionally lazy ({..}?).
			var int qe = counted_quant_end(pattern, a_end, pat_end)
			if qe >= 0 {
				var int qmin = counted_quant_min(pattern, a_end)
				var int qmax = counted_quant_max(pattern, a_end, pat_end)
				var counted_lazy = 0
				var int counted_rest = qe
				if counted_rest < pat_end {
					if pattern.at(counted_rest) == '?' {
						counted_lazy = 1
						counted_rest += 1
					}
				}
				return match_counted(
					pattern,
					pat_pos,
					a_end,
					counted_rest,
					pat_end,
					input,
					in_pos,
					qmin,
					qmax,
					counted_lazy,
					0,
					in_len,
					ref caps,
				)
			}
		}
	}

	// No quantifier: match the atom once, then the rest of the pattern. A
	// GROUP atom goes through the continuation-aware path: its inner
	// alternatives retry when the rest fails on an earlier one (JS-style
	// backtracking — `(head|header)(\s|$|>)` must still match "header>").
	if pc == '(' {
		return match_group_then_rest(
			pattern,
			pat_pos,
			a_end,
			a_end,
			pat_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
	}
	var int next = match_single_atom(pattern, pat_pos, a_end, input, in_pos, in_len, ref caps)
	if next < 0 {
		return -1
	}
	return match_here(pattern, a_end, pat_end, input, next, in_len, ref caps)
}

// The position of the first top-level '|' in [start, end), or -1. Escapes,
// character classes, and nested groups are skipped so only depth-0
// alternation operators count (same scanning discipline as match_here).
func next_top_level_alt = (string pattern, int start, int end, out int) {
	var depth = 0
	var int i = start
	while i < end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 2
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, end)
			} else {
				if c == '(' {
					depth += 1
				}
				if c == ')' {
					if depth > 0 {
						depth -= 1
					}
				}
				if (c as int) == 124 {
					if depth == 0 {
						return i
					}
				}
				i += 1
			}
		}
	}
	return -1
}

// Match the group atom spanning [atom_start, atom_end) ('(' at atom_start)
// and then the continuation [rest, pat_end), retrying the group's LATER
// alternatives whenever the continuation fails on an earlier one. Without
// this, a group commits to the first alternative that matches the group
// ALONE and a failing continuation aborts the whole match — the engine had
// no backtracking into a group's alternatives (PORT.md: `(head|header)`
// never reached `header` when `(\s|$|>)` rejected what `head` left behind).
// A group without a top-level '|' behaves exactly like the old
// match-atom-then-continue path, and a failed trial restores the group's
// previous capture span before the next attempt.
func match_group_then_rest = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int in_len,
	ref List<int> caps,
	out int
) {
	var int g = group_index_at(pattern, atom_start)
	var int at = last_capture_index(caps, g)
	var int old_start = -1
	var int old_end = -1
	if at >= 0 {
		old_start = caps.at(at + 1)
		old_end = caps.at(at + 2)
	}
	var int inner_start = group_inner_start(pattern, atom_start, pat_end)
	var int inner_end = atom_end - 1
	var int s = inner_start
	while s <= inner_end {
		var int bar = next_top_level_alt(pattern, s, inner_end)
		var int e = inner_end
		if bar >= 0 {
			e = bar
		}
		var int next = match_here(pattern, s, e, input, in_pos, in_len, ref caps)
		if next >= 0 {
			record_capture(ref caps, g, in_pos, next)
			var int r = match_here(pattern, rest, pat_end, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
		record_capture(ref caps, g, old_start, old_end)
		if bar >= 0 {
			s = bar + 1
		} else {
			s = inner_end + 1
		}
	}
	return -1
}

// Return the position just past the atom that starts at pat_pos. Handles
// character classes [...], groups (...), and escaped characters (\x).
func atom_end_pos = (string pattern, int pat_pos, int pat_end, out int) {
	var char pc = pattern.at(pat_pos)
	if pc == '[' {
		var int cs = pat_pos + 1
		if cs < pat_end {
			if pattern.at(cs) == '^' {
				cs += 1
			}
		}
		while cs < pat_end; cs += 1 {
			if pattern.at(cs) == ']' {
				return cs + 1
			}
		}
		return pat_end
	}
	if pc == '(' {
		var d = 1
		var int j = pat_pos + 1
		while j < pat_end; j += 1 {
			var char c = pattern.at(j)
			if c == '(' {
				d += 1
			}
			if c == ')' {
				d -= 1
				if d == 0 {
					return j + 1
				}
			}
		}
		return pat_end
	}
	if (pc as int) == 92 {
		if pat_pos + 1 < pat_end {
			return pat_pos + 2
		}
		return pat_pos + 1
	}
	return pat_pos + 1
}

// Match the atom [atom_start..atom_end) exactly once at in_pos.
// Returns the new input position after consuming the atom, or -1.
func match_single_atom = (
	string pattern,
	int atom_start,
	int atom_end,
	string input,
	int in_pos,
	int in_len,
	ref List<int> caps,
	out int
) {
	var char pc = pattern.at(atom_start)

	if pc == '.' {
		if in_pos < in_len {
			if (input.at(in_pos) as int) != 10 {
				return in_pos + 1
			}
		}
		return -1
	}
	if pc == '[' {
		if in_pos < in_len {
			if char_in_class(pattern, atom_start, atom_end, input, in_pos, in_len) {
				return in_pos + 1
			}
		}
		return -1
	}
	if pc == '(' {
		// Match the group's inner content, recording the group's span on
		// success. On failure, restore the span this path started with (a
		// repeated group's earlier iterations survive a failed extra trial)
		// — or mark the group unset when it had no earlier span here.
		var int g = group_index_at(pattern, atom_start)
		var int at = last_capture_index(caps, g)
		var int old_start = -1
		var int old_end = -1
		if at >= 0 {
			old_start = caps.at(at + 1)
			old_end = caps.at(at + 2)
		}
		var int next = match_here(
			pattern,
			group_inner_start(pattern, atom_start, atom_end),
			atom_end - 1,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			record_capture(ref caps, g, in_pos, next)
			return next
		}
		record_capture(ref caps, g, old_start, old_end)
		return -1
	}
	if (pc as int) == 92 {
		if atom_start + 1 < atom_end {
			var char ec = pattern.at(atom_start + 1)
			if is_backref_digit(ec) {
				// \1..\9: match the same text capture group N matched.
				return match_backref(input, backref_group(ec), in_pos, in_len, ref caps)
			}
			if is_shorthand(ec) {
				// \d \s \w and complements: class membership by name.
				if in_pos < in_len {
					if matches_shorthand(ec, input.at(in_pos)) {
						return in_pos + 1
					}
				}
				return -1
			}
			if in_pos < in_len {
				if (input.at(in_pos) as int) == escaped_byte_value(ec) {
					return in_pos + 1
				}
			}
		}
		return -1
	}
	if in_pos < in_len {
		if input.at(in_pos) == pc {
			return in_pos + 1
		}
	}
	return -1
}

// Report whether input.at(pos) matches the single-character atom at
// [atom_start..atom_end). Used by the greedy star matcher.
func char_matches_atom = (
	string pattern,
	int atom_start,
	int atom_end,
	string input,
	int pos,
	int in_len,
	out bool
) {
	var char pc = pattern.at(atom_start)
	var char ic = input.at(pos)
	if pc == '.' {
		if (ic as int) == 10 {
			return false
		}
		return true
	}
	if pc == '[' {
		return char_in_class(pattern, atom_start, atom_end, input, pos, in_len)
	}
	if (pc as int) == 92 {
		if atom_start + 1 < atom_end {
			var char ec = pattern.at(atom_start + 1)
			if is_backref_digit(ec) {
				// A backreference is a multi-byte atom; the greedy
				// single-character loop never consults this for it.
				return false
			}
			if is_shorthand(ec) {
				return matches_shorthand(ec, ic)
			}
			return (ic as int) == escaped_byte_value(ec)
		}
		return false
	}
	return pc == ic
}

// Evaluate a lookaround assertion at in_pos:
//   2 (?=inner)   succeeds when inner matches starting here
//   3 (?!inner)   succeeds when inner does NOT match starting here
//   4 (?<=inner)  succeeds when inner matches ending exactly here
//   5 (?<!inner)  succeeds when no such match ends here
// Captures inside lookarounds are not recorded (a throwaway capture log is
// used) — the supported patterns are capture-free assertions.
func lookaround_succeeds = (
	int kind,
	string pattern,
	int inner,
	int inner_end,
	string input,
	int in_pos,
	int in_len,
	out bool
) {
	if kind == 2 {
		var trial = List<int>()
		return match_here(pattern, inner, inner_end, input, in_pos, in_len, ref trial) >= 0
	}
	if kind == 3 {
		var trial = List<int>()
		return match_here(pattern, inner, inner_end, input, in_pos, in_len, ref trial) < 0
	}
	var found = false
	var s = 0
	while s <= in_pos {
		var trial = List<int>()
		var int e = match_here(pattern, inner, inner_end, input, s, in_len, ref trial)
		if e == in_pos {
			found = true
			break
		}
		s += 1
	}
	if kind == 4 {
		return found
	}
	return found == false
}

// Match the atom [atom_start..atom_end) between min_count and max_count times
// (max_count -1 means unbounded), then the continuation [rest..pat_end). This
// backs counted repetition `{n}` / `{n,}` / `{n,m}`; greedy tries one more
// iteration before stopping, lazy stops first. An atom that matches the empty
// string is not repeated further (an empty iteration cannot make progress).
func match_counted = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int max_count,
	int lazy,
	int count,
	int in_len,
	ref List<int> caps,
	out int
) {
	var can_stop = count >= min_count
	var can_more = max_count < 0 || count < max_count
	if lazy > 0 {
		if can_stop {
			var int stop = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		if can_more {
			var int next = match_single_atom(
				pattern,
				atom_start,
				atom_end,
				input,
				in_pos,
				in_len,
				ref caps,
			)
			if next >= 0 {
				if next != in_pos {
					return match_counted(
						pattern,
						atom_start,
						atom_end,
						rest,
						pat_end,
						input,
						next,
						min_count,
						max_count,
						lazy,
						count + 1,
						in_len,
						ref caps,
					)
				}
			}
		}
		return -1
	}
	if can_more {
		var int next = match_single_atom(
			pattern,
			atom_start,
			atom_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			if next != in_pos {
				var int r = match_counted(
					pattern,
					atom_start,
					atom_end,
					rest,
					pat_end,
					input,
					next,
					min_count,
					max_count,
					lazy,
					count + 1,
					in_len,
					ref caps,
				)
				if r >= 0 {
					return r
				}
			}
		}
	}
	if can_stop {
		return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
	}
	return -1
}

// Match the atom [atom_start..atom_end) followed by the rest of the pattern
// pattern[rest..pat_end). min_count is 0 for '*' and 1 for '+'; lazy picks
// the shortest repetition first instead of the longest. Single-character
// atoms are handled iteratively; groups recurse.
func match_star = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps,
	out int
) {
	var char pc = pattern.at(atom_start)
	if pc == '(' {
		return match_star_group(
			pattern,
			atom_start,
			atom_end,
			rest,
			pat_end,
			input,
			in_pos,
			min_count,
			lazy,
			in_len,
			ref caps,
		)
	}
	if (pc as int) == 92 {
		if atom_start + 1 < atom_end {
			if is_backref_digit(pattern.at(atom_start + 1)) {
				// A backreference matches a whole span per iteration — the
				// single-character greedy loop below can't apply.
				return match_star_backref(
					pattern,
					atom_start,
					rest,
					pat_end,
					input,
					in_pos,
					min_count,
					lazy,
					in_len,
					ref caps,
				)
			}
		}
	}

	// Greedily consume the longest run of matching characters.
	var int max_pos = in_pos
	while max_pos < in_len {
		if char_matches_atom(pattern, atom_start, atom_end, input, max_pos, in_len) {
			max_pos += 1
		} else {
			break
		}
	}
	if lazy > 0 {
		// Lazy: extend from the minimum until the rest matches.
		var int try_pos = in_pos + min_count
		while try_pos <= max_pos; try_pos += 1 {
			var int r = match_here(pattern, rest, pat_end, input, try_pos, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
		return -1
	}
	// Backtrack from the longest match down to the minimum, trying the rest.
	var int try_pos = max_pos
	while try_pos >= in_pos + min_count; try_pos -= 1 {
		var int r = match_here(pattern, rest, pat_end, input, try_pos, in_len, ref caps)
		if r >= 0 {
			return r
		}
	}
	return -1
}

// Recursive backtracking for group atoms quantified with '*' or '+'.
func match_star_group = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps,
	out int
) {
	if lazy > 0 {
		// Lazy: stop repeating first (minimum met), then try one more
		// iteration before giving up. The iteration retries the group's
		// top-level alternatives (see match_group_iteration).
		if min_count <= 0 {
			var int stop = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		return match_group_iteration(
			pattern,
			atom_start,
			atom_end,
			rest,
			pat_end,
			input,
			in_pos,
			min_count,
			lazy,
			in_len,
			ref caps,
		)
	}
	// Try matching the group one more time (greedy) — each top-level
	// alternative in turn — before stopping.
	var int r = match_group_iteration(
		pattern,
		atom_start,
		atom_end,
		rest,
		pat_end,
		input,
		in_pos,
		min_count,
		lazy,
		in_len,
		ref caps,
	)
	if r >= 0 {
		return r
	}
	// Stop repeating and try the rest of the pattern, if the minimum is met.
	if min_count <= 0 {
		return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
	}
	return -1
}

// Try ONE further iteration of a quantified group at in_pos, retrying the
// group's top-level alternatives while the remaining star recursion fails.
// Returns the recursion's result, or -1 when no alternative leads to a
// match. An alternative that matches the empty string is not recursed into
// (an empty iteration cannot make progress; the caller's stop path covers
// it), and every failed trial restores the group's previous capture span.
func match_group_iteration = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps,
	out int
) {
	var int g = group_index_at(pattern, atom_start)
	var int at = last_capture_index(caps, g)
	var int old_start = -1
	var int old_end = -1
	if at >= 0 {
		old_start = caps.at(at + 1)
		old_end = caps.at(at + 2)
	}
	var int inner_start = group_inner_start(pattern, atom_start, pat_end)
	var int inner_end = atom_end - 1
	var int s = inner_start
	while s <= inner_end {
		var int bar = next_top_level_alt(pattern, s, inner_end)
		var int e = inner_end
		if bar >= 0 {
			e = bar
		}
		var int next = match_here(pattern, s, e, input, in_pos, in_len, ref caps)
		if next >= 0 {
			record_capture(ref caps, g, in_pos, next)
			if next != in_pos {
				var new_min = 0
				if min_count > 0 {
					new_min = min_count - 1
				}
				var int r = match_star_group(
					pattern,
					atom_start,
					atom_end,
					rest,
					pat_end,
					input,
					next,
					new_min,
					lazy,
					in_len,
					ref caps,
				)
				if r >= 0 {
					return r
				}
			}
		}
		record_capture(ref caps, g, old_start, old_end)
		if bar >= 0 {
			s = bar + 1
		} else {
			s = inner_end + 1
		}
	}
	return -1
}

// Match the atom optionally ('?'), preferring to include it unless lazy.
func match_optional = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int lazy,
	int in_len,
	ref List<int> caps,
	out int
) {
	if lazy > 0 {
		// Lazy: try without the atom first.
		var int skip = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
		if skip >= 0 {
			return skip
		}
		// A group atom includes continuation-aware alternative retries (see
		// match_group_then_rest) in both moods.
		if pattern.at(atom_start) == '(' {
			return match_group_then_rest(
				pattern,
				atom_start,
				atom_end,
				rest,
				pat_end,
				input,
				in_pos,
				in_len,
				ref caps,
			)
		}
		var int next = match_single_atom(
			pattern,
			atom_start,
			atom_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			return match_here(pattern, rest, pat_end, input, next, in_len, ref caps)
		}
		return -1
	}
	if pattern.at(atom_start) == '(' {
		var int grouped = match_group_then_rest(
			pattern,
			atom_start,
			atom_end,
			rest,
			pat_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if grouped >= 0 {
			return grouped
		}
	} else {
		var int next = match_single_atom(
			pattern,
			atom_start,
			atom_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			var int r = match_here(pattern, rest, pat_end, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
	}
	return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
}

// Report whether input.at(in_pos) belongs to the character class whose '[' is
// at open_pos and whose ']' is at atom_end - 1 (atom_end is just after ']').
func char_in_class = (
	string pattern,
	int open_pos,
	int atom_end,
	string input,
	int in_pos,
	int in_len,
	out bool
) {
	if in_pos >= in_len {
		return false
	}
	var char ic = input.at(in_pos)

	var int content_start = open_pos + 1
	var negated = false
	if content_start < atom_end {
		if pattern.at(content_start) == '^' {
			negated = true
			content_start += 1
		}
	}
	var int content_end = atom_end - 1

	var found = false
	var int i = content_start
	while i < content_end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			if i + 1 < content_end {
				var char e = pattern.at(i + 1)
				if is_shorthand(e) {
					// \d \s \w (and complements) inside a class.
					if matches_shorthand(e, ic) {
						found = true
					}
				} else {
					if (ic as int) == escaped_byte_value(e) {
						found = true
					}
				}
			}
			i = i + 2
		} else {
			if i + 2 < content_end {
				if pattern.at(i + 1) == '-' {
					var char lo = c
					var char hi = pattern.at(i + 2)
					if (ic as int) >= (lo as int) {
						if (ic as int) <= (hi as int) {
							found = true
						}
					}
					i += 3
				} else {
					if ic == c {
						found = true
					}
					i += 1
				}
			} else {
				if ic == c {
					found = true
				}
				i += 1
			}
		}
	}

	if negated {
		if found {
			return false
		}
		return true
	}
	return found
}

// Whether the '(' at open_pos opens a non-capturing construct: `(?:` or one
// of the lookaround forms `(?=`, `(?!`, `(?<=`, `(?<!`. Every supported
// group whose open paren is immediately followed by '?' is non-capturing.
func is_non_capturing_open = (string pattern, int open_pos, int pat_end, out bool) {
	if open_pos + 1 >= pat_end {
		return false
	}
	return pattern.at(open_pos + 1) == '?'
}

// Classify the group opening at open_pos:
//   0 capturing group (...)
//   1 non-capturing group (?:...)
//   2 positive lookahead (?=...)
//   3 negative lookahead (?!...)
//   4 positive lookbehind (?<=...)
//   5 negative lookbehind (?<!...)
func group_kind = (string pattern, int open_pos, int pat_end, out int) {
	if is_non_capturing_open(pattern, open_pos, pat_end) == false {
		return 0
	}
	if open_pos + 2 >= pat_end {
		return 0
	}
	var char c = pattern.at(open_pos + 2)
	if c == ':' {
		return 1
	}
	if c == '=' {
		return 2
	}
	if c == '!' {
		return 3
	}
	if c == '<' {
		if open_pos + 3 < pat_end {
			if pattern.at(open_pos + 3) == '=' {
				return 4
			}
			if pattern.at(open_pos + 3) == '!' {
				return 5
			}
		}
	}
	return 0
}

// The position of the first byte INSIDE the group whose '(' opens at
// open_pos: past `(?:`, `(?=`, `(?!`, or `(?<=`/`(?<!` for the prefixed
// forms, or open_pos + 1 for a plain capturing group.
func group_inner_start = (string pattern, int open_pos, int pat_end, out int) {
	var int kind = group_kind(pattern, open_pos, pat_end)
	if kind == 1 || kind == 2 || kind == 3 {
		return open_pos + 3
	}
	if kind == 4 || kind == 5 {
		return open_pos + 4
	}
	return open_pos + 1
}

// The number of capture groups in the whole pattern: every '(' that is not
// escaped, not inside a character class, and not a non-capturing prefix
// (`(?:`, `(?=`, `(?!`, `(?<=`, `(?<!`).
func capture_count = (string pattern, out int) {
	var int n = pattern.length
	var count = 0
	var i = 0
	while i < n; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 1
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, n) - 1
			} else {
				if c == '(' {
					if is_non_capturing_open(pattern, i, n) == false {
						count += 1
					}
				}
			}
		}
	}
	return count
}

// The capture-group index (1-based) of the group whose '(' opens at
// open_pos: one more than the number of capturing opens before it in the
// pattern (the whole match is group 0). Returns 0 for a non-capturing
// construct so callers record no span.
func group_index_at = (string pattern, int open_pos, out int) {
	var count = 0
	var i = 0
	while i < open_pos; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 1
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, open_pos) - 1
			} else {
				if c == '(' {
					if is_non_capturing_open(pattern, i, open_pos) == false {
						count += 1
					}
				}
			}
		}
	}
	if is_non_capturing_open(pattern, open_pos, pattern.length) {
		return 0
	}
	return count + 1
}

// Record a capture span (start, end) for the group whose '(' opens at
// group_pos. A later span for the same group supersedes the earlier one, so
// a repeated group reports its last iteration; a failed group records
// (-1, -1) so stale spans from an abandoned attempt never surface.
func record_capture = (ref List<int> caps, int group, int start, int end) {
	if group <= 0 {
		return
	}
	var int at = last_capture_index(caps, group)
	if at >= 0 {
		caps.set(at + 1, start)
		caps.set(at + 2, end)
	} else {
		caps.push(group)
		caps.push(start)
		caps.push(end)
	}
}

// The log index of the LAST entry for `group` in caps, or -1 when the group
// has no entry. Entries are (group, start, end) triples.
func last_capture_index = (List<int> caps, int group, out int) {
	var int best = -1
	var i = 0
	while i < caps.length; i += 3 {
		if caps.at(i) == group {
			best = i
		}
	}
	return best
}

/**
 * A Regex.find result: whether the pattern matched, where, and what
 **/
pub struct RegexMatch {
	var found = false
	var start = 0
	var end = 0
	var length = 0
	var text = ""
}

// Whether the escaped character c (the byte after a backslash) is a
// backreference (\1..\9; \0 is the whole-match escape, not supported here).
func is_backref_digit = (char c, out bool) {
	var int code = c as int
	return code >= 49 && code <= 57
}

// The capture group a backreference refers to: '1' -> 1 .. '9' -> 9.
func backref_group = (char c, out int) {
	return (c as int) - 48
}

// Match the text capture group `group` last matched, at in_pos. Returns the
// position after the span, or -1 when the group has no span here (it did not
// participate) or the text differs.
func match_backref = (
	string input,
	int group,
	int in_pos,
	int in_len,
	ref List<int> caps,
	out int
) {
	var int at = last_capture_index(caps, group)
	if at < 0 {
		return -1
	}
	var int s = caps.at(at + 1)
	if s < 0 {
		return -1
	}
	var int len = caps.at(at + 2) - s
	if in_pos + len > in_len {
		return -1
	}
	var i = 0
	while i < len; i += 1 {
		if input.at(in_pos + i) != input.at(s + i) {
			return -1
		}
	}
	return in_pos + len
}

// Greedy/lazy backtracking for a backreference atom quantified with '*' or
// '+' (each iteration consumes the referenced span).
func match_star_backref = (
	string pattern,
	int atom_start,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps,
	out int
) {
	var int group = backref_group(pattern.at(atom_start + 1))
	if lazy > 0 {
		if min_count <= 0 {
			var int stop = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		var int next = match_backref(input, group, in_pos, in_len, ref caps)
		if next >= 0 {
			if next != in_pos {
				var new_min = 0
				if min_count > 0 {
					new_min = min_count - 1
				}
				return match_star_backref(
					pattern,
					atom_start,
					rest,
					pat_end,
					input,
					next,
					new_min,
					lazy,
					in_len,
					ref caps,
				)
			}
		}
		return -1
	}
	var int next = match_backref(input, group, in_pos, in_len, ref caps)
	if next >= 0 {
		if next != in_pos {
			var new_min = 0
			if min_count > 0 {
				new_min = min_count - 1
			}
			var int r = match_star_backref(
				pattern,
				atom_start,
				rest,
				pat_end,
				input,
				next,
				new_min,
				lazy,
				in_len,
				ref caps,
			)
			if r >= 0 {
				return r
			}
		}
	}
	if min_count <= 0 {
		return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
	}
	return -1
}

// Whether the escaped character c names an ASCII shorthand class:
// \d \D (digits), \w \W (word characters), \s \S (whitespace).
func is_shorthand = (char c, out bool) {
	var int code = c as int
	return code == 100 || code == 68 || code == 119 || code == 87 || code == 115 || code == 83
}

// Whether the escaped character c names a control-character shorthand
// (\n \r \t) that the engine maps to its real control byte.
func is_control_escape = (char c, out bool) {
	var int code = c as int
	return code == 110 || code == 114 || code == 116
}

// The byte an escaped atom names: \n is LF (10), \r is CR (13), \t is TAB
// (9); every other escaped character is the literal byte of that character.
func escaped_byte_value = (char c, out int) {
	var int code = c as int
	if code == 110 {
		return 10
	}
	if code == 114 {
		return 13
	}
	if code == 116 {
		return 9
	}
	return code
}

// Whether byte b belongs to the shorthand class named by c. Uppercase names
// are the complements (S/D/W match anything the lowercase set excludes).
func matches_shorthand = (char c, char b, out bool) {
	var int kind = c as int
	var int code = b as int
	var found = false
	if kind == 100 || kind == 68 {
		// \d \D
		found = code >= 48 && code <= 57
	} else {
		if kind == 119 || kind == 87 {
			// \w \W
			found = (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || (code >= 48 && code <= 57) || code == 95
		} else {
			// \s \S
			found = (code >= 9 && code <= 13) || code == 32
		}
	}
	if kind >= 65 && kind <= 90 {
		return !found
	}
	return found
}

// Append the member bytes of the lowercase shorthand class named by c to the
// first-byte charset. Complement shorthands (S/D/W) match "anything else" —
// not expressible as an inclusion set — so they return -1, which disables
// the caller's prefilter.
func shorthand_members = (char c, ref StringBuilder sb, out int) {
	var int kind = c as int
	if kind == 83 || kind == 68 || kind == 87 {
		return -1
	}
	if kind == 100 {
		var code = 48
		while code <= 57; code += 1 {
			sb.append_char(code as char)
		}
		return 0
	}
	if kind == 119 {
		var code = 48
		while code <= 57; code += 1 {
			sb.append_char(code as char)
		}
		var upper = 65
		while upper <= 90; upper += 1 {
			sb.append_char(upper as char)
		}
		var lower = 97
		while lower <= 122; lower += 1 {
			sb.append_char(lower as char)
		}
		sb.append_char('_')
		return 0
	}
	// \s: tab, LF, VT, FF, CR, space
	var w = 9
	while w <= 13; w += 1 {
		sb.append_char(w as char)
	}
	sb.append_char(32 as char)
	return 0
}
