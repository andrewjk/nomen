// Regular expression support implemented in pure Nomen.
//
// `test` reports whether a pattern matches anywhere in the input; `match`
// returns the first matched substring (or "" when there is no match).
// Patterns use POSIX Extended Regular Expression syntax, extended with
// non-capturing groups `(?:...)`, lookaround (`(?=...)` / `(?!...)` /
// `(?<=...)` / `(?<!...)`), and counted repetition (`{n}` / `{n,}` / `{n,m}`).

/**
 * Regular-expression helpers (`test`/`match`/`count`/`replace_all`) using POSIX ERE syntax plus `(?:...)`, lookaround, and `{n,m}` counted repetition
 **/
pub struct Regex {
	// Test whether pattern matches anywhere in input.
	pub func test = (string pattern, string input, out bool) {
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var p = RxProg()
		var caps = RxCaps()
		if rx_compile(pattern, ref p) >= 0 {
			caps.slots.alloc_int(p.ngroups * 3 + 3)
			var i = 0
			while i <= len; i += 1 {
				if clen > 0 && i < len {
					i = find_next_byte(input, i, len, charset)
					if i > len {
						break
					}
				}
				rx_caps_reset(ref caps)
				if rx_match_seq(ref p, 0, input, i, len, ref caps) >= 0 {
					return true
				}
			}
			return false
		}
		var i = 0
		while i <= len; i += 1 {
			if clen > 0 && i < len {
				i = find_next_byte(input, i, len, charset)
				if i > len {
					break
				}
			}
			var lcaps = List<int>()
			if match_here(pattern, 0, pat_len, input, i, len, ref lcaps) >= 0 {
				return true
			}
		}
		return false
	}

	// Return the first substring of input matching pattern, or "" if none.
	// `mv out string`: the matched span (or the empty literal) is handed to
	// the caller as an owned value.
	pub func match = (string pattern, string input, mv out string) {
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var p = RxProg()
		var caps = RxCaps()
		if rx_compile(pattern, ref p) >= 0 {
			caps.slots.alloc_int(p.ngroups * 3 + 3)
			var i = 0
			while i <= len; i += 1 {
				if clen > 0 && i < len {
					i = find_next_byte(input, i, len, charset)
					if i > len {
						break
					}
				}
				rx_caps_reset(ref caps)
				var int end = rx_match_seq(ref p, 0, input, i, len, ref caps)
				if end >= 0 {
					// One owned substring copy. The old accumulator
					// (`match_result = match_result + "\{input.at(j)}"` per
					// matched byte) paid an interpolation malloc PLUS a
					// whole-accumulator re-copy per byte — O(n²) in the span.
					return input.substring(i, end)
				}
			}
			return ""
		}
		var i = 0
		while i <= len; i += 1 {
			if clen > 0 && i < len {
				i = find_next_byte(input, i, len, charset)
				if i > len {
					break
				}
			}
			var lcaps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, i, len, ref lcaps)
			if end >= 0 {
				return input.substring(i, end)
			}
		}
		return ""
	}

	// Try to match pattern anywhere in input. On a match, append the whole
	// match as group 0 followed by capture groups 1..N to `out` ("" for a
	// group that did not participate in the match) and return true. Return
	// false with `out` untouched when nothing matches. A group that repeats
	// (`(a)+`) reports its LAST iteration.
	pub func captures = (
		string pattern,
		string input,
		ref List<string> dst { items },
		out bool
	) { var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var int groups = capture_count(pattern)
		var p = RxProg()
		var caps = RxCaps()
		var compiled = rx_compile(pattern, ref p) >= 0
		if compiled {
			caps.slots.alloc_int(p.ngroups * 3 + 3)
		}
		var i = 0
		while i <= len; i += 1 {
			if clen > 0 && i < len {
				if compiled {
					i = find_next_byte(input, i, len, charset)
				} else {
					i = find_next_byte(input, i, len, charset)
				}
				if i > len {
					break
				}
			}
			var int end = -1
			if compiled {
				rx_caps_reset(ref caps)
				end = rx_match_seq(ref p, 0, input, i, len, ref caps)
			} else {
				var lcaps = List<int>()
				end = match_here(pattern, 0, pat_len, input, i, len, ref lcaps)
			}
			if end >= 0 {
				if compiled == false {
					// Legacy path: re-run to capture, then report the
					// legacy capture log. (Never taken for a well-formed
					// pattern — the compiled tables are sized from the
					// pattern length.)
					var legacy = List<int>()
					var int lend = match_here(pattern, 0, pat_len, input, i, len, ref legacy)
					if lend >= 0 {
						emit_captures_legacy(input, groups, legacy, ref dst)
						return true
					}
					return false
				}
				var string whole = input.substring(i, end)
				dst.push(mv whole)
				var g = 1
				while g <= groups; g += 1 {
					var int at = rx_last_capture(caps, g)
					if at >= 0 {
						var int s = caps.slots.load_int(at + 1)
						if s >= 0 {
							var string cap = input.substring(s, caps.slots.load_int(at + 2))
							dst.push(mv cap)
						} else {
							dst.push("")
						}
					} else {
						dst.push("")
					}
				}
				return true
			}
		}
		return false
	}

	// Find the first match of pattern in input and fill `dst` with where it
	// sits: .found with byte offsets .start/.end, the matched .text, and
	// .length (all zero/empty when .found is false — mvzr-style positions
	// for callers doing their own index bookkeeping). `dst` is fully reset
	// first, so a reused RegexMatch carries nothing over. Scans every
	// position: the first-byte prefilter would skip nullable patterns'
	// empty matches at skipped positions, reporting a wrong .start.
	pub func find = (string pattern, string input, ref RegexMatch dst { text }) {
		dst.found = false
		dst.start = 0
		dst.end = 0
		dst.length = 0
		dst.text = ""
		var int pat_len = pattern.length
		var int len = input.length
		var p = RxProg()
		var caps = RxCaps()
		var compiled = rx_compile(pattern, ref p) >= 0
		if compiled {
			caps.slots.alloc_int(p.ngroups * 3 + 3)
		}
		var i = 0
		while i <= len; i += 1 {
			var int end = -1
			if compiled {
				rx_caps_reset(ref caps)
				end = rx_match_seq(ref p, 0, input, i, len, ref caps)
			} else {
				var lcaps = List<int>()
				end = match_here(pattern, 0, pat_len, input, i, len, ref lcaps)
			}
			if end >= 0 {
				dst.found = true
				dst.start = i
				dst.end = end
				dst.length = end - i
				dst.text = input.substring(i, end)
				return
			}
		}
	}

	// Count the number of non-overlapping occurrences of pattern in input.
	pub func count = (string pattern, string input, out int) {
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var total = 0
		var pos = 0
		var p = RxProg()
		var caps = RxCaps()
		if rx_compile(pattern, ref p) >= 0 {
			caps.slots.alloc_int(p.ngroups * 3 + 3)
			while pos < len {
				if clen > 0 {
					pos = find_next_byte(input, pos, len, charset)
					if pos >= len {
						break
					}
				}
				rx_caps_reset(ref caps)
				var int end = rx_match_seq(ref p, 0, input, pos, len, ref caps)
				if end >= 0 {
					total += 1
					if end == pos {
						pos += 1
					} else {
						pos = end
					}
				} else {
					pos += 1
				}
			}
			return total
		}
		while pos < len {
			if clen > 0 {
				pos = find_next_byte(input, pos, len, charset)
				if pos >= len {
					break
				}
			}
			var lcaps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, pos, len, ref lcaps)
			if end >= 0 {
				total += 1
				if end == pos {
					pos += 1
				} else {
					pos = end
				}
			} else {
				pos += 1
			}
		}
		return total
	}

	// Replace all non-overlapping occurrences of pattern in input with replacement.
	// Literal bytes between matches are copied in bulk runs (one
	// `append_string_view` per run) — the old loop appended per byte.
	pub func replace_all = (
		string pattern,
		string input,
		string replacement,
		out string
	) {
		var sb = StringBuilder()
		var int pat_len = pattern.length
		var int len = input.length
		var string charset = first_byte_set(pattern, pat_len)
		var int clen = charset.length
		var pos = 0
		var run_start = 0
		var p = RxProg()
		var caps = RxCaps()
		if rx_compile(pattern, ref p) >= 0 {
			caps.slots.alloc_int(p.ngroups * 3 + 3)
			while pos < len {
				if clen > 0 {
					// Prefilter: jump to the next candidate byte. The skipped
					// run stays pending — it is copied in bulk at the next
					// match, or by the tail copy below.
					pos = find_next_byte(input, pos, len, charset)
					if pos >= len {
						break
					}
				}
				rx_caps_reset(ref caps)
				var int end = rx_match_seq(ref p, 0, input, pos, len, ref caps)
				if end >= 0 {
					sb.append_string_view(input.slice(run_start, pos))
					sb.append_string(replacement)
					if end == pos {
						// Empty match: the byte at pos is not consumed — it
						// starts the next literal run.
						run_start = pos
						pos += 1
					} else {
						pos = end
						run_start = pos
					}
				} else {
					pos += 1
				}
			}
			sb.append_string_view(input.slice(run_start, len))
			return sb.to_string()
		}
		while pos < len {
			if clen > 0 {
				pos = find_next_byte(input, pos, len, charset)
				if pos >= len {
					break
				}
			}
			var lcaps = List<int>()
			var int end = match_here(pattern, 0, pat_len, input, pos, len, ref lcaps)
			if end >= 0 {
				sb.append_string_view(input.slice(run_start, pos))
				sb.append_string(replacement)
				if end == pos {
					run_start = pos
					pos += 1
				} else {
					pos = end
					run_start = pos
				}
			} else {
				pos += 1
			}
		}
		sb.append_string_view(input.slice(run_start, len))
		return sb.to_string()
	}

	// Whether pattern matches anywhere in input, ignoring ASCII case.
	pub func test_ci = (string pattern, string input, out bool) {
		var string folded = fold_pattern(pattern)
		return Regex.test(folded, input)
	}

	// First match of pattern in input, ignoring ASCII case ("" if none).
	pub func match_ci = (string pattern, string input, mv out string) {
		var string folded = fold_pattern(pattern)
		return Regex.match(folded, input)
	}

	// find, ignoring ASCII case.
	pub func find_ci = (string pattern, string input, ref RegexMatch dst { text }) {
		var string folded = fold_pattern(pattern)
		Regex.find(folded, input, ref dst)
	}

	// captures, ignoring ASCII case.
	pub func captures_ci = (string pattern, string input, ref List<string> dst { items }, out bool) {
		var string folded = fold_pattern(pattern)
		return Regex.captures(folded, input, ref dst)
	}

	// replace_all, ignoring ASCII case.
	pub func replace_all_ci = (string pattern, string input, string replacement, out string) {
		var string folded = fold_pattern(pattern)
		return Regex.replace_all(folded, input, replacement)
	}
}

// Rewrite pattern so the case-sensitive engine matches case-insensitively:
// literals become both-case classes ([kK]), class members and ranges gain
// their case counterparts ([a-z] -> [a-zA-Z]). Structural syntax — groups,
// alternation, quantifiers, anchors, escaped punctuation — is copied
// through unchanged.
func fold_pattern = (string pattern, mv out string) {
	var int n = pattern.length
	var sb = StringBuilder()
	var i = 0
	while i < n; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			// Escaped char: shorthands, backrefs, and control escapes
			// (\n \r \t) keep their backslash; other escaped letters
			// become both-case classes; escaped punctuation is copied
			// literally.
			if i + 1 < n {
				var char e = pattern.at(i + 1)
				if is_shorthand(e) || is_backref_digit(e) || is_control_escape(e) {
					sb.append_char(c)
					sb.append_char(e)
				} else {
					if is_alpha_byte(e) {
						sb.append_char('[')
						sb.append_char(e)
						sb.append_char(swap_case_byte(e))
						sb.append_char(']')
					} else {
						sb.append_char(c)
						sb.append_char(e)
					}
				}
				i += 1
			} else {
				sb.append_char(c)
			}
		} else {
			if c == '[' {
				var int ce = atom_end_pos(pattern, i, n)
				fold_class(pattern, i, ce, ref sb)
				i = ce - 1
			} else {
				if is_alpha_byte(c) {
					sb.append_char('[')
					sb.append_char(c)
					sb.append_char(swap_case_byte(c))
					sb.append_char(']')
				} else {
					sb.append_char(c)
				}
			}
		}
	}
	return sb.to_string()
}

// fold a character class [cs..ce): copy its contents, adding the case
// counterpart of every letter member and mirroring letter ranges.
func fold_class = (string pattern, int cs, int ce, ref StringBuilder dst {}) {
	dst.append_char('[')
	var int i = cs + 1
	if i < ce - 1 {
		if pattern.at(i) == '^' {
			dst.append_char('^')
			i += 1
		}
	}
	var int content_end = ce - 1
	while i < content_end; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			dst.append_char(c)
			if i + 1 < content_end {
				var char e = pattern.at(i + 1)
				dst.append_char(e)
				// A shorthand or control escape (\n \r \t) keeps its
				// backslash; other escaped letters gain their case
				// counterpart.
				if is_alpha_byte(e) && !is_shorthand(e) && !is_control_escape(e) {
					dst.append_char(swap_case_byte(e))
				}
				i += 1
			}
		} else {
			if i + 2 < content_end {
				if pattern.at(i + 1) == '-' {
					var char lo = c
					var char hi = pattern.at(i + 2)
					dst.append_char(lo)
					dst.append_char('-')
					dst.append_char(hi)
					if is_alpha_byte(lo) {
						if is_alpha_byte(hi) {
							dst.append_char(swap_case_byte(lo))
							dst.append_char('-')
							dst.append_char(swap_case_byte(hi))
						}
					}
					i += 2
				} else {
					if is_alpha_byte(c) {
						dst.append_char(c)
						dst.append_char(swap_case_byte(c))
					} else {
						dst.append_char(c)
					}
				}
			} else {
				if is_alpha_byte(c) {
					dst.append_char(c)
					dst.append_char(swap_case_byte(c))
				} else {
					dst.append_char(c)
				}
			}
		}
	}
	dst.append_char(']')
}

// ASCII letter test for pattern characters.
func is_alpha_byte = (char c, out bool) {
	var int code = c as int
	return (code > 64 && code < 91) || (code > 96 && code < 123)
}

// The ASCII letter with the opposite case (unchanged for non-letters).
func swap_case_byte = (char c, out char) {
	var int code = c as int
	if code > 64 && code < 91 {
		return (code + 32) as char
	}
	if code > 96 && code < 123 {
		return (code - 32) as char
	}
	return c
}

// Scan input[pos..len) for the next byte that appears in charset.
// Returns the index of the match, or len if none found / charset is empty.
func find_next_byte = (string input, int pos, int len, string charset, out int) {
	if pos >= len {
		return len
	}
	if charset.length == 0 {
		return len
	}
	var i = pos
	while i < len && i < input.length; i += 1 {
		var j = 0
		while j < charset.length; j += 1 {
			if input.at(i) == charset.at(j) {
				return i
			}
		}
	}
	return len
}

// Extract the set of possible first bytes from a pattern into a charset string.
// Returns "" if every byte is possible (e.g. pattern starts with '.', '(' with
// an unbounded repeat, or an alternative whose first set can't be determined).
func first_byte_set = (string pattern, int pat_len, out string) {
	if pat_len == 0 {
		return ""
	}
	var sb = StringBuilder()
	if collect_first_bytes(pattern, 0, pat_len, ref sb) < 0 {
		// Some alternative's first-byte set is indeterminable — a wildcard
		// '.', an empty alternative, or similar. The charset is a PREFILTER
		// (candidate positions via strpbrk): under-approximating it would
		// skip positions where a match can start, so disable it entirely.
		return ""
	}
	return sb.to_string()
}

// Walk top-level alternatives of pattern[pat_pos..pat_end), appending the first
// byte(s) of each alternative to sb. Alternations at depth 0 are split on '|'.
// Returns -1 when any alternative's first-byte set can't be determined (the
// caller must then disable the prefilter), 0 otherwise.
func collect_first_bytes = (
	string pattern,
	int pat_pos,
	int pat_end,
	ref StringBuilder sb {},
	out int
) {
	var depth = 0
	var int i = pat_pos
	var int alt_start = pat_pos
	while i < pat_end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 2
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, pat_end)
			} else {
				if c == '(' {
					depth = depth + 1
				}
				if c == ')' {
					if depth > 0 {
						depth -= 1
					}
				}
				if (c as int) == 124 {
					if depth == 0 {
						if alt_first_bytes(pattern, alt_start, i, ref sb) < 0 {
							return -1
						}
						alt_start = i + 1
					}
				}
				i += 1
			}
		}
	}
	return alt_first_bytes(pattern, alt_start, pat_end, ref sb)
}

// Append the set of bytes that can start a match of the alternative occupying
// pattern[start..end) to sb. Returns -1 when the set can't be determined (the
// caller must disable the prefilter), 0 when it was appended.
//
// Handles the shapes the engine's matcher can produce: a leading anchor is
// zero-width (skipped), a leading group contributes its CONTENT's first bytes
// (recursively over the group's own top-level alternatives), and ANY leading
// atom — literal, escaped, class, or group — quantified with '?'/'*' is
// nullable: what FOLLOWS it can also be first, so the scan continues past it.
// A wildcard '.' or an empty alternative makes the set indeterminable.
func alt_first_bytes = (string pattern, int start, int end, ref StringBuilder sb {}, out int) {
	var int i = start
	while i < end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			// escaped literal: first byte is the byte the escape names
			// (\n is LF, \r is CR, \t is TAB; any other escaped character
			// is its own literal byte) — unless it's a backreference
			// (depends on a capture) or a complement shorthand (not an
			// inclusion set), which disable the prefilter.
			if i + 1 < end {
				var char e = pattern.at(i + 1)
				if is_backref_digit(e) {
					return -1
				}
				if is_shorthand(e) {
					if shorthand_members(e, ref sb) < 0 {
						return -1
					}
				} else {
					sb.append_char(escaped_byte_value(e) as char)
				}
				// A '?'/'*' quantifier makes the atom nullable — the first
				// byte can also come from whatever follows it.
				var int cont = nullable_quant_after(pattern, i + 2, end)
				if cont < 0 {
					return 0
				}
				i = cont
				continue
			}
			return 0
		}
		if c == '[' {
			var int a_end = atom_end_pos(pattern, i, end)
			// A NEGATED class can match any byte outside its member set —
			// not expressible as an inclusion charset, and under-approximating
			// (the member bytes alone) would make strpbrk skip valid match
			// positions. Disable the prefilter instead.
			var int cs = i + 1
			if cs < a_end - 1 {
				if pattern.at(cs) == '^' {
					return -1
				}
			}
			add_class_chars(pattern, i + 1, a_end - 1, ref sb)
			var int cont = nullable_quant_after(pattern, a_end, end)
			if cont < 0 {
				return 0
			}
			i = cont
			continue
		}
		if c == '(' {
			var int a_end = atom_end_pos(pattern, i, end)
			var int kind = group_kind(pattern, i, end)
			if kind >= 2 {
				// Lookaround: zero-width — contributes no byte, so the first
				// byte comes from whatever follows.
				i = a_end
				continue
			}
			// The group's first bytes are the union of its content's
			// top-level alternatives' first bytes.
			var int inner = group_inner_start(pattern, i, end)
			if collect_first_bytes(pattern, inner, a_end - 1, ref sb) < 0 {
				return -1
			}
			var int cont = nullable_quant_after(pattern, a_end, end)
			if cont < 0 {
				return 0
			}
			i = cont
			continue
		}
		if c == '^' || c == '$' {
			// zero-width assertions never consume a byte
			i += 1
			continue
		}
		if c == '.' {
			// wildcard (any byte except '\n') — not expressible as an
			// inclusion set; the prefilter must be disabled.
			return -1
		}
		sb.append_char(c)
		var int cont = nullable_quant_after(pattern, i + 1, end)
		if cont < 0 {
			return 0
		}
		i = cont
		continue
	}
	// An empty alternative (nothing left after nullable atoms — or nothing at
	// all) can match at any position — indeterminable.
	return -1
}

// If the atom ending at `after` carries a nullable quantifier ('?' or '*',
// optionally marked lazy by a second '?'), return the position just past the
// quantifier; otherwise return -1. Callers keep scanning from the returned
// position: a nullable leading atom means the alternative's match can also
// START with whatever follows, so those bytes belong in the first-byte set
// too. ('+' is NOT nullable — the atom must match once — so it leaves the
// atom's own bytes as the whole first set.)
func nullable_quant_after = (string pattern, int after, int end, out int) {
	var int j = after
	if j >= end {
		return -1
	}
	var char q = pattern.at(j)
	if q == '?' || q == '*' {
		j += 1
		if j < end {
			if pattern.at(j) == '?' {
				j += 1
			}
		}
		return j
	}
	if q == '{' {
		// A counted bound is nullable only when its minimum is 0 ({0}, {0,},
		// {0,m}); the first byte then also comes from what follows.
		var int qe = counted_quant_end(pattern, j, end)
		if qe >= 0 {
			var int qmin = counted_quant_min(pattern, j)
			if qmin == 0 {
				var int k = qe
				if k < end {
					if pattern.at(k) == '?' {
						k += 1
					}
				}
				return k
			}
			return -1
		}
	}
	return -1
}

// Parse a counted repetition bound `{n}`, `{n,}`, or `{n,m}` whose '{' is at
// pos. Returns the position just past the closing '}', or -1 when the braces
// are not a valid bound (the '{' is then a literal character).
func counted_quant_end = (string pattern, int pos, int pat_end, out int) {
	var int i = pos + 1
	var int digits = i
	while i < pat_end {
		if is_digit_byte(pattern.at(i)) {
			i += 1
		} else {
			break
		}
	}
	if i == digits {
		return -1
	}
	if i < pat_end {
		if pattern.at(i) == ',' {
			i += 1
			while i < pat_end {
				if is_digit_byte(pattern.at(i)) {
					i += 1
				} else {
					break
				}
			}
		}
	}
	if i < pat_end {
		if pattern.at(i) == '}' {
			return i + 1
		}
	}
	return -1
}

// The minimum repetition count of a `{...}` bound at pos (assumes a valid
// bound was found by counted_quant_end).
func counted_quant_min = (string pattern, int pos, out int) {
	var int i = pos + 1
	var value = 0
	while i < pattern.length {
		if is_digit_byte(pattern.at(i)) {
			value = value * 10 + ((pattern.at(i) as int) - 48)
			i += 1
		} else {
			break
		}
	}
	return value
}

// The maximum repetition count of a `{...}` bound at pos: the value after the
// comma for `{n,m}`, -1 for the unbounded `{n,}`, and the minimum for `{n}`.
func counted_quant_max = (string pattern, int pos, int pat_end, out int) {
	var int i = pos + 1
	while i < pat_end {
		if is_digit_byte(pattern.at(i)) {
			i += 1
		} else {
			break
		}
	}
	if i >= pat_end {
		return counted_quant_min(pattern, pos)
	}
	if pattern.at(i) != ',' {
		return counted_quant_min(pattern, pos)
	}
	var int j = i + 1
	var value = 0
	var int digits = j
	while j < pat_end {
		if is_digit_byte(pattern.at(j)) {
			value = value * 10 + ((pattern.at(j) as int) - 48)
			j += 1
		} else {
			break
		}
	}
	if j == digits {
		// `{n,}` — unbounded maximum.
		return -1
	}
	return value
}

// Whether a pattern character is an ASCII digit.
func is_digit_byte = (char c, out bool) {
	var int code = c as int
	return code >= 48 && code <= 57
}

// Append the members of character class [start..end) to sb. Ranges (a-z) are
// expanded; negation (^) is ignored (we want all candidates).
func add_class_chars = (
	string pattern,
	int start,
	int end,
	ref StringBuilder sb {}
) { var int cs = start
	if cs < end {
		if pattern.at(cs) == '^' {
			cs += 1
		}
	}
	var int i = cs
	while i < end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			// Escaped byte: contribute the byte the escape names (\n is
			// LF, \r is CR, \t is TAB; any other escaped character is its
			// own literal byte) so the prefilter stays a superset of the
			// matcher's first bytes.
			if i + 1 < end {
				sb.append_char(escaped_byte_value(pattern.at(i + 1)) as char)
			}
			i += 2
		} else {
			if i + 2 < end {
				if pattern.at(i + 1) == '-' {
					var int lo = pattern.at(i) as int
					var int hi = pattern.at(i + 2) as int
					while lo <= hi {
						sb.append_char(lo as char)
						lo += 1
					}
					i += 3
				} else {
					sb.append_char(c)
					i += 1
				}
			} else {
				sb.append_char(c)
				i += 1
			}
		}
	}
}

// Match pattern[pat_pos..pat_end) against input starting at in_pos.
// Returns the end position in input after a successful match, or -1.
// Return contract: a successful match never reads past in_len, so the result
// is always <= in_len (and -1 on failure). This lets callers prove an index
// bounded by the result is also bounded by the input length.
// `caps` collects capture spans as (group_index, start, end) triples in
// match order; a later entry for the same group supersedes an earlier one.
func match_here = (
	string pattern,
	int pat_pos,
	int pat_end,
	string input,
	int in_pos,
	int in_len,
	ref List<int> caps { items },
	out int: out <= in_len
) {
	// Handle top-level alternation: a '|' at bracket/paren depth 0 splits the
	// range into alternatives. Char classes and escapes are skipped so a '|' or
	// '\|' inside them is not mistaken for an alternation operator.
	var depth = 0
	var int i = pat_pos
	while i < pat_end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 2
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, pat_end)
			} else {
				if c == '(' {
					depth += 1
				}
				if c == ')' {
					if depth > 0 {
						depth -= 1
					}
				}
				if (c as int) == 124 {
					if depth == 0 {
						var int left = match_here(
							pattern,
							pat_pos,
							i,
							input,
							in_pos,
							in_len,
							ref caps,
						)
						if left >= 0 {
							return left
						}
						return match_here(pattern, i + 1, pat_end, input, in_pos, in_len, ref caps)
					}
				}
				i += 1
			}
		}
	}

	// Pattern exhausted: match succeeds at the current position.
	if pat_pos >= pat_end {
		return in_pos
	}

	var char pc = pattern.at(pat_pos)

	// Anchors (zero-width assertions).
	if pc == '^' {
		if in_pos != 0 {
			return -1
		}
		return match_here(pattern, pat_pos + 1, pat_end, input, in_pos, in_len, ref caps)
	}
	if pc == '$' {
		if in_pos != in_len {
			return -1
		}
		return match_here(pattern, pat_pos + 1, pat_end, input, in_pos, in_len, ref caps)
	}

	// Lookaround assertions are zero-width: evaluate the inner pattern and
	// continue matching the rest at the SAME input position.
	if pc == '(' && is_non_capturing_open(pattern, pat_pos, pat_end) {
		var int look_kind = group_kind(pattern, pat_pos, pat_end)
		if look_kind >= 2 {
			var int look_end = atom_end_pos(pattern, pat_pos, pat_end)
			var int look_inner = group_inner_start(pattern, pat_pos, pat_end)
			if lookaround_succeeds(
				look_kind,
				pattern,
				look_inner,
				look_end - 1,
				input,
				in_pos,
				in_len,
			) == false {
				return -1
			}
			return match_here(pattern, look_end, pat_end, input, in_pos, in_len, ref caps)
		}
	}

	// Determine the bounds of the current atom.
	var int a_end = atom_end_pos(pattern, pat_pos, pat_end)

	// Check for a quantifier following the atom. A trailing '?' marks the
	// quantifier LAZY (shortest match first) — the rest of the pattern then
	// starts after both symbols.
	if a_end < pat_end {
		var char q = pattern.at(a_end)
		if q == '*' || q == '+' || q == '?' {
			var lazy = 0
			var int rest = a_end + 1
			if rest < pat_end {
				if pattern.at(rest) == '?' {
					lazy = 1
					rest += 1
				}
			}
			if q == '*' {
				return match_star(
					pattern,
					pat_pos,
					a_end,
					rest,
					pat_end,
					input,
					in_pos,
					0,
					lazy,
					in_len,
					ref caps,
				)
			}
			if q == '+' {
				return match_star(
					pattern,
					pat_pos,
					a_end,
					rest,
					pat_end,
					input,
					in_pos,
					1,
					lazy,
					in_len,
					ref caps,
				)
			}
			return match_optional(
				pattern,
				pat_pos,
				a_end,
				rest,
				pat_end,
				input,
				in_pos,
				lazy,
				in_len,
				ref caps,
			)
		}
		if q == '{' {
			// Counted repetition: {n}, {n,}, {n,m}, optionally lazy ({..}?).
			var int qe = counted_quant_end(pattern, a_end, pat_end)
			if qe >= 0 {
				var int qmin = counted_quant_min(pattern, a_end)
				var int qmax = counted_quant_max(pattern, a_end, pat_end)
				var counted_lazy = 0
				var int counted_rest = qe
				if counted_rest < pat_end {
					if pattern.at(counted_rest) == '?' {
						counted_lazy = 1
						counted_rest += 1
					}
				}
				return match_counted(
					pattern,
					pat_pos,
					a_end,
					counted_rest,
					pat_end,
					input,
					in_pos,
					qmin,
					qmax,
					counted_lazy,
					0,
					in_len,
					ref caps,
				)
			}
		}
	}

	// No quantifier: match the atom once, then the rest of the pattern. A
	// GROUP atom goes through the continuation-aware path: its inner
	// alternatives retry when the rest fails on an earlier one (JS-style
	// backtracking — `(head|header)(\s|$|>)` must still match "header>").
	if pc == '(' {
		return match_group_then_rest(
			pattern,
			pat_pos,
			a_end,
			a_end,
			pat_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
	}
	var int next = match_single_atom(pattern, pat_pos, a_end, input, in_pos, in_len, ref caps)
	if next < 0 {
		return -1
	}
	return match_here(pattern, a_end, pat_end, input, next, in_len, ref caps)
}

// The position of the first top-level '|' in [start, end), or -1. Escapes,
// character classes, and nested groups are skipped so only depth-0
// alternation operators count (same scanning discipline as match_here).
func next_top_level_alt = (string pattern, int start, int end, out int) {
	var depth = 0
	var int i = start
	while i < end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 2
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, end)
			} else {
				if c == '(' {
					depth += 1
				}
				if c == ')' {
					if depth > 0 {
						depth -= 1
					}
				}
				if (c as int) == 124 {
					if depth == 0 {
						return i
					}
				}
				i += 1
			}
		}
	}
	return -1
}

// Match the group atom spanning [atom_start, atom_end) ('(' at atom_start)
// and then the continuation [rest, pat_end), retrying the group's LATER
// alternatives whenever the continuation fails on an earlier one. Without
// this, a group commits to the first alternative that matches the group
// ALONE and a failing continuation aborts the whole match — the engine had
// no backtracking into a group's alternatives (PORT.md: `(head|header)`
// never reached `header` when `(\s|$|>)` rejected what `head` left behind).
// A group without a top-level '|' behaves exactly like the old
// match-atom-then-continue path, and a failed trial restores the group's
// previous capture span before the next attempt.
func match_group_then_rest = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	var int g = group_index_at(pattern, atom_start)
	var int at = last_capture_index(caps, g)
	var int old_start = -1
	var int old_end = -1
	if at >= 0 {
		old_start = caps.at(at + 1)
		old_end = caps.at(at + 2)
	}
	var int inner_start = group_inner_start(pattern, atom_start, pat_end)
	var int inner_end = atom_end - 1
	var int s = inner_start
	while s <= inner_end {
		var int bar = next_top_level_alt(pattern, s, inner_end)
		var int e = inner_end
		if bar >= 0 {
			e = bar
		}
		var int next = match_here(pattern, s, e, input, in_pos, in_len, ref caps)
		if next >= 0 {
			record_capture(ref caps, g, in_pos, next)
			var int r = match_here(pattern, rest, pat_end, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
		record_capture(ref caps, g, old_start, old_end)
		if bar >= 0 {
			s = bar + 1
		} else {
			s = inner_end + 1
		}
	}
	return -1
}

// Return the position just past the atom that starts at pat_pos. Handles
// character classes [...], groups (...), and escaped characters (\x).
func atom_end_pos = (string pattern, int pat_pos, int pat_end, out int) {
	var char pc = pattern.at(pat_pos)
	if pc == '[' {
		var int cs = pat_pos + 1
		if cs < pat_end {
			if pattern.at(cs) == '^' {
				cs += 1
			}
		}
		while cs < pat_end; cs += 1 {
			if pattern.at(cs) == ']' {
				return cs + 1
			}
		}
		return pat_end
	}
	if pc == '(' {
		var d = 1
		var int j = pat_pos + 1
		while j < pat_end; j += 1 {
			var char c = pattern.at(j)
			if c == '(' {
				d += 1
			}
			if c == ')' {
				d -= 1
				if d == 0 {
					return j + 1
				}
			}
		}
		return pat_end
	}
	if (pc as int) == 92 {
		if pat_pos + 1 < pat_end {
			return pat_pos + 2
		}
		return pat_pos + 1
	}
	return pat_pos + 1
}

// Match the atom [atom_start..atom_end) exactly once at in_pos.
// Returns the new input position after consuming the atom, or -1.
func match_single_atom = (
	string pattern,
	int atom_start,
	int atom_end,
	string input,
	int in_pos,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	var char pc = pattern.at(atom_start)

	if pc == '.' {
		if in_pos < in_len {
			if (input.at(in_pos) as int) != 10 {
				return in_pos + 1
			}
		}
		return -1
	}
	if pc == '[' {
		if in_pos < in_len {
			if char_in_class(pattern, atom_start, atom_end, input, in_pos, in_len) {
				return in_pos + 1
			}
		}
		return -1
	}
	if pc == '(' {
		// Match the group's inner content, recording the group's span on
		// success. On failure, restore the span this path started with (a
		// repeated group's earlier iterations survive a failed extra trial)
		// — or mark the group unset when it had no earlier span here.
		var int g = group_index_at(pattern, atom_start)
		var int at = last_capture_index(caps, g)
		var int old_start = -1
		var int old_end = -1
		if at >= 0 {
			old_start = caps.at(at + 1)
			old_end = caps.at(at + 2)
		}
		var int next = match_here(
			pattern,
			group_inner_start(pattern, atom_start, atom_end),
			atom_end - 1,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			record_capture(ref caps, g, in_pos, next)
			return next
		}
		record_capture(ref caps, g, old_start, old_end)
		return -1
	}
	if (pc as int) == 92 {
		if atom_start + 1 < atom_end {
			var char ec = pattern.at(atom_start + 1)
			if is_backref_digit(ec) {
				// \1..\9: match the same text capture group N matched.
				return match_backref(input, backref_group(ec), in_pos, in_len, ref caps)
			}
			if is_shorthand(ec) {
				// \d \s \w and complements: class membership by name.
				if in_pos < in_len {
					if matches_shorthand(ec, input.at(in_pos)) {
						return in_pos + 1
					}
				}
				return -1
			}
			if in_pos < in_len {
				if (input.at(in_pos) as int) == escaped_byte_value(ec) {
					return in_pos + 1
				}
			}
		}
		return -1
	}
	if in_pos < in_len {
		if input.at(in_pos) == pc {
			return in_pos + 1
		}
	}
	return -1
}

// Report whether input.at(pos) matches the single-character atom at
// [atom_start..atom_end). Used by the greedy star matcher.
func char_matches_atom = (
	string pattern,
	int atom_start,
	int atom_end,
	string input,
	int pos,
	int in_len,
	out bool
) {
	var char pc = pattern.at(atom_start)
	var char ic = input.at(pos)
	if pc == '.' {
		if (ic as int) == 10 {
			return false
		}
		return true
	}
	if pc == '[' {
		return char_in_class(pattern, atom_start, atom_end, input, pos, in_len)
	}
	if (pc as int) == 92 {
		if atom_start + 1 < atom_end {
			var char ec = pattern.at(atom_start + 1)
			if is_backref_digit(ec) {
				// A backreference is a multi-byte atom; the greedy
				// single-character loop never consults this for it.
				return false
			}
			if is_shorthand(ec) {
				return matches_shorthand(ec, ic)
			}
			return (ic as int) == escaped_byte_value(ec)
		}
		return false
	}
	return pc == ic
}

// Evaluate a lookaround assertion at in_pos:
//   2 (?=inner)   succeeds when inner matches starting here
//   3 (?!inner)   succeeds when inner does NOT match starting here
//   4 (?<=inner)  succeeds when inner matches ending exactly here
//   5 (?<!inner)  succeeds when no such match ends here
// Captures inside lookarounds are not recorded (a throwaway capture log is
// used) — the supported patterns are capture-free assertions.
func lookaround_succeeds = (
	int kind,
	string pattern,
	int inner,
	int inner_end,
	string input,
	int in_pos,
	int in_len,
	out bool
) {
	if kind == 2 {
		var trial = List<int>()
		return match_here(pattern, inner, inner_end, input, in_pos, in_len, ref trial) >= 0
	}
	if kind == 3 {
		var trial = List<int>()
		return match_here(pattern, inner, inner_end, input, in_pos, in_len, ref trial) < 0
	}
	var found = false
	var s = 0
	while s <= in_pos {
		var trial = List<int>()
		var int e = match_here(pattern, inner, inner_end, input, s, in_len, ref trial)
		if e == in_pos {
			found = true
			break
		}
		s += 1
	}
	if kind == 4 {
		return found
	}
	return found == false
}

// Match the atom [atom_start..atom_end) between min_count and max_count times
// (max_count -1 means unbounded), then the continuation [rest..pat_end). This
// backs counted repetition `{n}` / `{n,}` / `{n,m}`; greedy tries one more
// iteration before stopping, lazy stops first. An atom that matches the empty
// string is not repeated further (an empty iteration cannot make progress).
func match_counted = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int max_count,
	int lazy,
	int count,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	var can_stop = count >= min_count
	var can_more = max_count < 0 || count < max_count
	if lazy > 0 {
		if can_stop {
			var int stop = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		if can_more {
			var int next = match_single_atom(
				pattern,
				atom_start,
				atom_end,
				input,
				in_pos,
				in_len,
				ref caps,
			)
			if next >= 0 {
				if next != in_pos {
					return match_counted(
						pattern,
						atom_start,
						atom_end,
						rest,
						pat_end,
						input,
						next,
						min_count,
						max_count,
						lazy,
						count + 1,
						in_len,
						ref caps,
					)
				}
			}
		}
		return -1
	}
	if can_more {
		var int next = match_single_atom(
			pattern,
			atom_start,
			atom_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			if next != in_pos {
				var int r = match_counted(
					pattern,
					atom_start,
					atom_end,
					rest,
					pat_end,
					input,
					next,
					min_count,
					max_count,
					lazy,
					count + 1,
					in_len,
					ref caps,
				)
				if r >= 0 {
					return r
				}
			}
		}
	}
	if can_stop {
		return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
	}
	return -1
}

// Match the atom [atom_start..atom_end) followed by the rest of the pattern
// pattern[rest..pat_end). min_count is 0 for '*' and 1 for '+'; lazy picks
// the shortest repetition first instead of the longest. Single-character
// atoms are handled iteratively; groups recurse.
func match_star = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	var char pc = pattern.at(atom_start)
	if pc == '(' {
		return match_star_group(
			pattern,
			atom_start,
			atom_end,
			rest,
			pat_end,
			input,
			in_pos,
			min_count,
			lazy,
			in_len,
			ref caps,
		)
	}
	if (pc as int) == 92 {
		if atom_start + 1 < atom_end {
			if is_backref_digit(pattern.at(atom_start + 1)) {
				// A backreference matches a whole span per iteration — the
				// single-character greedy loop below can't apply.
				return match_star_backref(
					pattern,
					atom_start,
					rest,
					pat_end,
					input,
					in_pos,
					min_count,
					lazy,
					in_len,
					ref caps,
				)
			}
		}
	}

	// Greedily consume the longest run of matching characters.
	var int max_pos = in_pos
	while max_pos < in_len {
		if char_matches_atom(pattern, atom_start, atom_end, input, max_pos, in_len) {
			max_pos += 1
		} else {
			break
		}
	}
	if lazy > 0 {
		// Lazy: extend from the minimum until the rest matches.
		var int try_pos = in_pos + min_count
		while try_pos <= max_pos; try_pos += 1 {
			var int r = match_here(pattern, rest, pat_end, input, try_pos, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
		return -1
	}
	// Backtrack from the longest match down to the minimum, trying the rest.
	var int try_pos = max_pos
	while try_pos >= in_pos + min_count; try_pos -= 1 {
		var int r = match_here(pattern, rest, pat_end, input, try_pos, in_len, ref caps)
		if r >= 0 {
			return r
		}
	}
	return -1
}

// Recursive backtracking for group atoms quantified with '*' or '+'.
func match_star_group = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	if lazy > 0 {
		// Lazy: stop repeating first (minimum met), then try one more
		// iteration before giving up. The iteration retries the group's
		// top-level alternatives (see match_group_iteration).
		if min_count <= 0 {
			var int stop = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		return match_group_iteration(
			pattern,
			atom_start,
			atom_end,
			rest,
			pat_end,
			input,
			in_pos,
			min_count,
			lazy,
			in_len,
			ref caps,
		)
	}
	// Try matching the group one more time (greedy) — each top-level
	// alternative in turn — before stopping.
	var int r = match_group_iteration(
		pattern,
		atom_start,
		atom_end,
		rest,
		pat_end,
		input,
		in_pos,
		min_count,
		lazy,
		in_len,
		ref caps,
	)
	if r >= 0 {
		return r
	}
	// Stop repeating and try the rest of the pattern, if the minimum is met.
	if min_count <= 0 {
		return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
	}
	return -1
}

// Try ONE further iteration of a quantified group at in_pos, retrying the
// group's top-level alternatives while the remaining star recursion fails.
// Returns the recursion's result, or -1 when no alternative leads to a
// match. An alternative that matches the empty string is not recursed into
// (an empty iteration cannot make progress; the caller's stop path covers
// it), and every failed trial restores the group's previous capture span.
func match_group_iteration = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	var int g = group_index_at(pattern, atom_start)
	var int at = last_capture_index(caps, g)
	var int old_start = -1
	var int old_end = -1
	if at >= 0 {
		old_start = caps.at(at + 1)
		old_end = caps.at(at + 2)
	}
	var int inner_start = group_inner_start(pattern, atom_start, pat_end)
	var int inner_end = atom_end - 1
	var int s = inner_start
	while s <= inner_end {
		var int bar = next_top_level_alt(pattern, s, inner_end)
		var int e = inner_end
		if bar >= 0 {
			e = bar
		}
		var int next = match_here(pattern, s, e, input, in_pos, in_len, ref caps)
		if next >= 0 {
			record_capture(ref caps, g, in_pos, next)
			if next != in_pos {
				var new_min = 0
				if min_count > 0 {
					new_min = min_count - 1
				}
				var int r = match_star_group(
					pattern,
					atom_start,
					atom_end,
					rest,
					pat_end,
					input,
					next,
					new_min,
					lazy,
					in_len,
					ref caps,
				)
				if r >= 0 {
					return r
				}
			}
		}
		record_capture(ref caps, g, old_start, old_end)
		if bar >= 0 {
			s = bar + 1
		} else {
			s = inner_end + 1
		}
	}
	return -1
}

// Match the atom optionally ('?'), preferring to include it unless lazy.
func match_optional = (
	string pattern,
	int atom_start,
	int atom_end,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int lazy,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	if lazy > 0 {
		// Lazy: try without the atom first.
		var int skip = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
		if skip >= 0 {
			return skip
		}
		// A group atom includes continuation-aware alternative retries (see
		// match_group_then_rest) in both moods.
		if pattern.at(atom_start) == '(' {
			return match_group_then_rest(
				pattern,
				atom_start,
				atom_end,
				rest,
				pat_end,
				input,
				in_pos,
				in_len,
				ref caps,
			)
		}
		var int next = match_single_atom(
			pattern,
			atom_start,
			atom_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			return match_here(pattern, rest, pat_end, input, next, in_len, ref caps)
		}
		return -1
	}
	if pattern.at(atom_start) == '(' {
		var int grouped = match_group_then_rest(
			pattern,
			atom_start,
			atom_end,
			rest,
			pat_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if grouped >= 0 {
			return grouped
		}
	} else {
		var int next = match_single_atom(
			pattern,
			atom_start,
			atom_end,
			input,
			in_pos,
			in_len,
			ref caps,
		)
		if next >= 0 {
			var int r = match_here(pattern, rest, pat_end, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
	}
	return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
}

// Report whether input.at(in_pos) belongs to the character class whose '[' is
// at open_pos and whose ']' is at atom_end - 1 (atom_end is just after ']').
func char_in_class = (
	string pattern,
	int open_pos,
	int atom_end,
	string input,
	int in_pos,
	int in_len,
	out bool
) {
	if in_pos >= in_len {
		return false
	}
	var char ic = input.at(in_pos)

	var int content_start = open_pos + 1
	var negated = false
	if content_start < atom_end {
		if pattern.at(content_start) == '^' {
			negated = true
			content_start += 1
		}
	}
	var int content_end = atom_end - 1

	var found = false
	var int i = content_start
	while i < content_end {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			if i + 1 < content_end {
				var char e = pattern.at(i + 1)
				if is_shorthand(e) {
					// \d \s \w (and complements) inside a class.
					if matches_shorthand(e, ic) {
						found = true
					}
				} else {
					if (ic as int) == escaped_byte_value(e) {
						found = true
					}
				}
			}
			i = i + 2
		} else {
			if i + 2 < content_end {
				if pattern.at(i + 1) == '-' {
					var char lo = c
					var char hi = pattern.at(i + 2)
					if (ic as int) >= (lo as int) {
						if (ic as int) <= (hi as int) {
							found = true
						}
					}
					i += 3
				} else {
					if ic == c {
						found = true
					}
					i += 1
				}
			} else {
				if ic == c {
					found = true
				}
				i += 1
			}
		}
	}

	if negated {
		if found {
			return false
		}
		return true
	}
	return found
}

// Whether the '(' at open_pos opens a non-capturing construct: `(?:` or one
// of the lookaround forms `(?=`, `(?!`, `(?<=`, `(?<!`. Every supported
// group whose open paren is immediately followed by '?' is non-capturing.
func is_non_capturing_open = (string pattern, int open_pos, int pat_end, out bool) {
	if open_pos + 1 >= pat_end {
		return false
	}
	return pattern.at(open_pos + 1) == '?'
}

// Classify the group opening at open_pos:
//   0 capturing group (...)
//   1 non-capturing group (?:...)
//   2 positive lookahead (?=...)
//   3 negative lookahead (?!...)
//   4 positive lookbehind (?<=...)
//   5 negative lookbehind (?<!...)
func group_kind = (string pattern, int open_pos, int pat_end, out int) {
	if is_non_capturing_open(pattern, open_pos, pat_end) == false {
		return 0
	}
	if open_pos + 2 >= pat_end {
		return 0
	}
	var char c = pattern.at(open_pos + 2)
	if c == ':' {
		return 1
	}
	if c == '=' {
		return 2
	}
	if c == '!' {
		return 3
	}
	if c == '<' {
		if open_pos + 3 < pat_end {
			if pattern.at(open_pos + 3) == '=' {
				return 4
			}
			if pattern.at(open_pos + 3) == '!' {
				return 5
			}
		}
	}
	return 0
}

// The position of the first byte INSIDE the group whose '(' opens at
// open_pos: past `(?:`, `(?=`, `(?!`, or `(?<=`/`(?<!` for the prefixed
// forms, or open_pos + 1 for a plain capturing group.
func group_inner_start = (string pattern, int open_pos, int pat_end, out int) {
	var int kind = group_kind(pattern, open_pos, pat_end)
	if kind == 1 || kind == 2 || kind == 3 {
		return open_pos + 3
	}
	if kind == 4 || kind == 5 {
		return open_pos + 4
	}
	return open_pos + 1
}

// The number of capture groups in the whole pattern: every '(' that is not
// escaped, not inside a character class, and not a non-capturing prefix
// (`(?:`, `(?=`, `(?!`, `(?<=`, `(?<!`).
func capture_count = (string pattern, out int) {
	var int n = pattern.length
	var count = 0
	var i = 0
	while i < n; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 1
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, n) - 1
			} else {
				if c == '(' {
					if is_non_capturing_open(pattern, i, n) == false {
						count += 1
					}
				}
			}
		}
	}
	return count
}

// The capture-group index (1-based) of the group whose '(' opens at
// open_pos: one more than the number of capturing opens before it in the
// pattern (the whole match is group 0). Returns 0 for a non-capturing
// construct so callers record no span.
func group_index_at = (string pattern, int open_pos, out int) {
	var count = 0
	var i = 0
	while i < open_pos; i += 1 {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			i += 1
		} else {
			if c == '[' {
				i = atom_end_pos(pattern, i, open_pos) - 1
			} else {
				if c == '(' {
					if is_non_capturing_open(pattern, i, open_pos) == false {
						count += 1
					}
				}
			}
		}
	}
	if is_non_capturing_open(pattern, open_pos, pattern.length) {
		return 0
	}
	return count + 1
}

// Record a capture span (start, end) for the group whose '(' opens at
// group_pos. A later span for the same group supersedes the earlier one, so
// a repeated group reports its last iteration; a failed group records
// (-1, -1) so stale spans from an abandoned attempt never surface.
func record_capture = (ref List<int> caps { items }, int group, int start, int end) {
	if group <= 0 {
		return
	}
	var int at = last_capture_index(caps, group)
	if at >= 0 {
		caps.set(at + 1, start)
		caps.set(at + 2, end)
	} else {
		caps.push(group)
		caps.push(start)
		caps.push(end)
	}
}

// The log index of the LAST entry for `group` in caps, or -1 when the group
// has no entry. Entries are (group, start, end) triples.
func last_capture_index = (List<int> caps, int group, out int) {
	var int best = -1
	var i = 0
	while i < caps.length; i += 3 {
		if caps.at(i) == group {
			best = i
		}
	}
	return best
}

// The capture post-processing of Regex.captures over the legacy engine's
// List-based log (groups 1..N appended after the caller pushed the whole
// match). Used only by the legacy fallback path.
func emit_captures_legacy = (
	string input,
	int groups,
	List<int> caps,
	ref List<string> dst { items }
) {
	var g = 1
	while g <= groups; g += 1 {
		var int at = last_capture_index(caps, g)
		if at >= 0 {
			var int s = caps.at(at + 1)
			if s >= 0 {
				var string cap = input.substring(s, caps.at(at + 2))
				dst.push(mv cap)
			} else {
				dst.push("")
			}
		} else {
			dst.push("")
		}
	}
}

/**
 * A Regex.find result: whether the pattern matched, where, and what
 **/
pub mv struct RegexMatch {
	var found = false
	var start = 0
	var end = 0
	var length = 0
	mv text = ""
}

// Whether the escaped character c (the byte after a backslash) is a
// backreference (\1..\9; \0 is the whole-match escape, not supported here).
func is_backref_digit = (char c, out bool) {
	var int code = c as int
	return code >= 49 && code <= 57
}

// The capture group a backreference refers to: '1' -> 1 .. '9' -> 9.
func backref_group = (char c, out int) {
	return (c as int) - 48
}

// Match the text capture group `group` last matched, at in_pos. Returns the
// position after the span, or -1 when the group has no span here (it did not
// participate) or the text differs.
func match_backref = (
	string input,
	int group,
	int in_pos,
	int in_len,
	ref List<int> caps {},
	out int
) {
	var int at = last_capture_index(caps, group)
	if at < 0 {
		return -1
	}
	var int s = caps.at(at + 1)
	if s < 0 {
		return -1
	}
	var int len = caps.at(at + 2) - s
	if in_pos + len > in_len {
		return -1
	}
	var i = 0
	while i < len; i += 1 {
		if input.at(in_pos + i) != input.at(s + i) {
			return -1
		}
	}
	return in_pos + len
}

// Greedy/lazy backtracking for a backreference atom quantified with '*' or
// '+' (each iteration consumes the referenced span).
func match_star_backref = (
	string pattern,
	int atom_start,
	int rest,
	int pat_end,
	string input,
	int in_pos,
	int min_count,
	int lazy,
	int in_len,
	ref List<int> caps { items },
	out int
) {
	var int group = backref_group(pattern.at(atom_start + 1))
	if lazy > 0 {
		if min_count <= 0 {
			var int stop = match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		var int next = match_backref(input, group, in_pos, in_len, ref caps)
		if next >= 0 {
			if next != in_pos {
				var new_min = 0
				if min_count > 0 {
					new_min = min_count - 1
				}
				return match_star_backref(
					pattern,
					atom_start,
					rest,
					pat_end,
					input,
					next,
					new_min,
					lazy,
					in_len,
					ref caps,
				)
			}
		}
		return -1
	}
	var int next = match_backref(input, group, in_pos, in_len, ref caps)
	if next >= 0 {
		if next != in_pos {
			var new_min = 0
			if min_count > 0 {
				new_min = min_count - 1
			}
			var int r = match_star_backref(
				pattern,
				atom_start,
				rest,
				pat_end,
				input,
				next,
				new_min,
				lazy,
				in_len,
				ref caps,
			)
			if r >= 0 {
				return r
			}
		}
	}
	if min_count <= 0 {
		return match_here(pattern, rest, pat_end, input, in_pos, in_len, ref caps)
	}
	return -1
}

// Whether the escaped character c names an ASCII shorthand class:
// \d \D (digits), \w \W (word characters), \s \S (whitespace).
func is_shorthand = (char c, out bool) {
	var int code = c as int
	return code == 100 || code == 68 || code == 119 || code == 87 || code == 115 || code == 83
}

// Whether the escaped character c names a control-character shorthand
// (\n \r \t) that the engine maps to its real control byte.
func is_control_escape = (char c, out bool) {
	var int code = c as int
	return code == 110 || code == 114 || code == 116
}

// The byte an escaped atom names: \n is LF (10), \r is CR (13), \t is TAB
// (9); every other escaped character is the literal byte of that character.
func escaped_byte_value = (char c, out int) {
	var int code = c as int
	if code == 110 {
		return 10
	}
	if code == 114 {
		return 13
	}
	if code == 116 {
		return 9
	}
	return code
}

// Whether byte b belongs to the shorthand class named by c. Uppercase names
// are the complements (S/D/W match anything the lowercase set excludes).
func matches_shorthand = (char c, char b, out bool) {
	var int kind = c as int
	var int code = b as int
	var found = false
	if kind == 100 || kind == 68 {
		// \d \D
		found = code >= 48 && code <= 57
	} else {
		if kind == 119 || kind == 87 {
			// \w \W
			found = (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || (code >= 48 && code <= 57) || code == 95
		} else {
			// \s \S
			found = (code >= 9 && code <= 13) || code == 32
		}
	}
	if kind >= 65 && kind <= 90 {
		return !found
	}
	return found
}

// Append the member bytes of the lowercase shorthand class named by c to the
// first-byte charset. Complement shorthands (S/D/W) match "anything else" —
// not expressible as an inclusion set — so they return -1, which disables
// the caller's prefilter.
func shorthand_members = (char c, ref StringBuilder sb {}, out int) {
	var int kind = c as int
	if kind == 83 || kind == 68 || kind == 87 {
		return -1
	}
	if kind == 100 {
		var code = 48
		while code <= 57; code += 1 {
			sb.append_char(code as char)
		}
		return 0
	}
	if kind == 119 {
		var code = 48
		while code <= 57; code += 1 {
			sb.append_char(code as char)
		}
		var upper = 65
		while upper <= 90; upper += 1 {
			sb.append_char(upper as char)
		}
		var lower = 97
		while lower <= 122; lower += 1 {
			sb.append_char(lower as char)
		}
		sb.append_char('_')
		return 0
	}
	// \s: tab, LF, VT, FF, CR, space
	var w = 9
	while w <= 13; w += 1 {
		sb.append_char(w as char)
	}
	sb.append_char(32 as char)
	return 0
}

// ─────────────────────────────────────────────────────────────────────────────
// Compiled-pattern engine.
//
// The string-walking engine above re-derives the pattern's structure on every
// attempt: each `match_here` call rescans its range for top-level alternation,
// re-runs `atom_end_pos` per atom, and `group_index_at` re-walks the pattern
// from position 0 at every group match. This engine compiles the pattern ONCE
// per public call into flat tables (seq → alts → steps → atoms + 256-bit class
// bitmaps) and runs a recursive VM whose functions are line-by-line
// translations of the string-walking ones — same trial order, same capture
// record/restore points — so results are identical while per-position work
// drops to table loads and byte compares.
//
// Tables are parallel Buffer<int>s sized from the pattern length (each source
// char contributes at most one step/atom), so overflow cannot happen for any
// pattern the compiler accepts; the -1 path is kept as a soundness fallback
// that routes the call to the original engine.
// ─────────────────────────────────────────────────────────────────────────────

// Compiled program tables. All indices are ints.
mv struct RxProg {
	// SEQ: one "pattern range" (whole pattern, group inner, lookaround inner).
	// Its alternatives live at seq_alt0[seq] .. +seq_nalt[seq]-1 and are tried
	// in order — the compiled form of match_here's top-level '|' split.
	mv seq_alt0 = Buffer<int>()
	mv seq_nalt = Buffer<int>()
	var nseq = 0
	var cap_seq = 0

	// ALT: a linear sequence of steps (one source alternative).
	mv step0 = Buffer<int>()
	mv nsteps = Buffer<int>()
	var nalt = 0
	var cap_alt = 0

	// STEP: one quantified atom.
	mv step_atom = Buffer<int>()
	mv step_q = Buffer<int>() // 0 none, 1 star(*), 2 plus(+), 3 opt(?), 4 counted
	mv step_lazy = Buffer<int>()
	mv step_min = Buffer<int>()
	mv step_max = Buffer<int>()
	var nstep = 0
	var cap_step = 0

	// ATOM.
	mv atom_kind = Buffer<int>()
	mv atom_v0 = Buffer<int>() // lit byte / class id / group index / look kind
	mv atom_v1 = Buffer<int>() // group & look inner SEQ id
	var natom = 0
	var cap_atom = 0

	// CLASS bitmaps: class c occupies bits[c*4 .. c*4+4); one 64-bit word per
	// 64 byte codes, 4 words = the full 256-bit membership set. Negated
	// classes and complement shorthands are resolved at compile time.
	mv bits = Buffer<int>()
	var ncls = 0
	var cap_cls = 0

	// Capture groups in the pattern (reported spans: group 1..ngroups).
	var ngroups = 0

	// Deferred inner-seq compiles: a group/lookaround atom's inner range is
	// NOT compiled while the enclosing alternative's steps are being laid
	// out (that would splice the inner steps into the middle of the
	// alternative — breaking the contiguous step0+nsteps addressing). The
	// (atom, range) pairs are parked here; rx_compile_alt drains the stack
	// after its walk, when the enclosing steps are contiguous.
	mv dq = Buffer<int>()
	mv ds = Buffer<int>()
	mv de = Buffer<int>()
	var nd = 0

	// Alternative SIBLING CHAIN: deferred inner compiles allocate alt ids
	// BETWEEN a seq's own alternatives, so ids are not contiguous. The seq
	// header stores the first alt; each alt's alt_next points at its next
	// sibling (-1 = end), patched by the parent after both ids exist.
	mv alt_next = Buffer<int>()

	// First-byte sets, computed per ALT after its steps are laid out (and
	// per SEQ as the union of its alternatives). A gate consults them to
	// skip alternatives whose first consuming byte cannot match at the
	// candidate position — sound because the skipped trial would fail at
	// its first byte-consuming atom before any capture state changes (the
	// first-byte walk stops at the first non-nullable step, so every path
	// the gate excludes needs a byte the position does not hold).
	mv alt_fb = Buffer<int>()
	mv alt_flags = Buffer<int>() // bit 0: may start with any byte; bit 1: may match empty
	mv seq_fb = Buffer<int>()
	mv seq_flags = Buffer<int>()
}

// Capture-span log: the same (group, start, end) triple format the old
// engine's List<int> carried, hoisted to one allocation per public call and
// reset per candidate position (n = 0 — no realloc, no per-position heap).
mv struct RxCaps {
	mv slots = Buffer<int>()
	var n = 0
}

const RX_A_LIT = 0
const RX_A_ANY = 1
const RX_A_CLASS = 2
const RX_A_GROUP = 3
const RX_A_BACKREF = 4
const RX_A_LOOK = 5
const RX_A_BOL = 6
const RX_A_EOL = 7
const RX_A_NOMATCH = 8

const RX_Q_NONE = 0
const RX_Q_STAR = 1
const RX_Q_PLUS = 2
const RX_Q_OPT = 3
const RX_Q_COUNTED = 4

// The number of ints the tables hold per source pattern character (slack for
// the seq/alt headers around splits). Everything is sized from this, so a
// table can only overflow on an int-overflow-sized pattern.
func rx_table_cap = (int pat_len, out int) {
	return pat_len * 2 + 8
}

// Reset the capture log for a new candidate position (the old engine built a
// fresh List<int> per position; n = 0 is that fresh log, minus the heap).
func rx_caps_reset = (ref RxCaps caps { n }) {
	caps.n = 0
}

// The log index of the LAST entry for `group`, or -1 (old last_capture_index).
func rx_last_capture = (RxCaps caps, int group, out int) {
	var int best = -1
	var i = 0
	while i < caps.n; i += 3 {
		if caps.slots.load_int(i) == group {
			best = i
		}
	}
	return best
}

// Record a capture span (old record_capture): a later span supersedes an
// earlier one; a failed group records (-1, -1).
func rx_record = (ref RxCaps caps { slots, n }, int group, int start, int end) {
	if group <= 0 {
		return
	}
	var int at = rx_last_capture(caps, group)
	if at >= 0 {
		if at + 2 < caps.slots.cap {
			caps.slots.store_int(at + 1, start)
			caps.slots.store_int(at + 2, end)
		}
		return
	}
	if caps.n + 2 < caps.slots.cap {
		caps.slots.store_int(caps.n, group)
		caps.slots.store_int(caps.n + 1, start)
		caps.slots.store_int(caps.n + 2, end)
		caps.n += 3
	}
}

// Whether byte b is a member of class c (256-bit bitmap test).
func rx_class_has = (ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, int cls, char b, out bool) {
	var int code = b as int
	var int word = p.bits.load_int(cls * 4 + (code >> 6))
	return ((word >> (code & 63)) & 1) == 1
}

// ── The VM: each function translates its string-walking counterpart ─────────

// The next alternative in a seq's sibling chain (-1 at the end).
func rx_next_alt = (ref RxProg p {}, int alt, out int) {
	var int result = -1
	if alt >= 0 {
		if alt < p.alt_next.cap {
			result = p.alt_next.load_int(alt)
		}
	}
	return result
}

// Guarded table reads used by the chain-walking loops: taking the index as
// a PARAMETER keeps the loads outside the caller's flow-range tracking
// (load-derived indices merge a -1 terminator into their range, which the
// constraint evaluator then treats as provably negative).
func rx_flags_at = (ref RxProg p {}, int alt, out int) {
	if alt < 0 {
		return 0
	}
	if alt >= p.alt_flags.cap {
		return 0
	}
	return p.alt_flags.load_int(alt)
}

func rx_fb_word_at = (ref RxProg p {}, int alt, int word: word >= 0 && word < 4, out int) {
	if alt < 0 {
		return 0
	}
	if alt >= p.alt_fb.cap {
		return 0
	}
	return p.alt_fb.load_int(alt * 4 + word)
}

// match_here: try the SEQ's alternatives in order (the top-level split,
// precomputed at compile time).
func rx_match_seq = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int seq,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int: out <= in_len
) {
	// Seq gate: when the whole seq must consume a byte (non-nullable, no
	// wildcard first set) and the byte at the position is in no
	// alternative's first-byte set, nothing can match here.
	var int sflags = p.seq_flags.load_int(seq)
	if (sflags & 3) == 0 {
		if in_pos < in_len {
			var int code = input.at(in_pos) as int
			var int fi = seq * 4 + (code >> 6)
			if fi >= 0 && fi < p.seq_fb.cap {
				var int word = p.seq_fb.load_int(fi)
				if ((word >> (code & 63)) & 1) == 0 {
					return -1
				}
			}
		} else {
			return -1
		}
	}
	var int alt_k = p.seq_alt0.load_int(seq)
	var int na = p.seq_nalt.load_int(seq)
	var k = 0
	while k < na; k += 1 {
		// Per-alt gate: skip alternatives whose first consuming byte is not
		// at the position (the skipped trial would fail at its first
		// consuming atom, before touching capture state).
		if alt_k < 0 {
			return -1
		}
		var int aflags = p.alt_flags.load_int(alt_k)
		if (aflags & 3) == 0 {
			if in_pos < in_len {
				var int code = input.at(in_pos) as int
				var int fi = alt_k * 4 + (code >> 6)
				var skip = false
				if fi >= 0 && fi < p.alt_fb.cap {
					var int word = p.alt_fb.load_int(fi)
					if ((word >> (code & 63)) & 1) == 0 {
						skip = true
					}
				}
				if skip {
					alt_k = rx_next_alt(ref p, alt_k)
					continue
				}
			} else {
				alt_k = rx_next_alt(ref p, alt_k)
				continue
			}
		}
		var int r = rx_match_alt(ref p, alt_k, 0, input, in_pos, in_len, ref caps)
		if r >= 0 {
			return r
		}
		alt_k = rx_next_alt(ref p, alt_k)
	}
	return -1
}

// match_here's post-split body: pattern exhausted → success; otherwise run
// the step at step_idx (quantifier dispatch) and continue with the rest of
// the alternative as the continuation.
func rx_match_alt = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int alt,
	int step_idx,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int: out <= in_len
) {
	var int s0 = p.step0.load_int(alt)
	var int ns = p.nsteps.load_int(alt)
	// Pattern exhausted: match succeeds at the current position.
	if step_idx >= ns {
		return in_pos
	}
	var int st = s0 + step_idx
	var int atom = p.step_atom.load_int(st)
	var int q = p.step_q.load_int(st)
	var int lazy = p.step_lazy.load_int(st)
	if q == RX_Q_STAR {
		return rx_star(ref p, atom, 0, lazy, alt, step_idx + 1, input, in_pos, in_len, ref caps)
	}
	if q == RX_Q_PLUS {
		return rx_star(ref p, atom, 1, lazy, alt, step_idx + 1, input, in_pos, in_len, ref caps)
	}
	if q == RX_Q_OPT {
		return rx_optional(ref p, atom, lazy, alt, step_idx + 1, input, in_pos, in_len, ref caps)
	}
	if q == RX_Q_COUNTED {
		var int mn = p.step_min.load_int(st)
		var int mx = p.step_max.load_int(st)
		return rx_counted(ref p, atom, mn, mx, lazy, 0, alt, step_idx + 1, input, in_pos, in_len, ref caps)
	}
	// No quantifier. Anchors and lookarounds are zero-width; a GROUP atom goes
	// through the continuation-aware path (JS-style alternative retries).
	var int kind = p.atom_kind.load_int(atom)
	if kind == RX_A_LOOK {
		var int lk = p.atom_v0.load_int(atom)
		var int inner = p.atom_v1.load_int(atom)
		if rx_look_succeeds(ref p, lk, inner, input, in_pos, in_len) == false {
			return -1
		}
		return rx_match_alt(ref p, alt, step_idx + 1, input, in_pos, in_len, ref caps)
	}
	if kind == RX_A_GROUP {
		return rx_group_then_rest(ref p, atom, alt, step_idx + 1, input, in_pos, in_len, ref caps)
	}
	var int next = rx_single_atom(ref p, atom, input, in_pos, in_len, ref caps)
	if next < 0 {
		return -1
	}
	return rx_match_alt(ref p, alt, step_idx + 1, input, next, in_len, ref caps)
}

// match_single_atom: match one atom (no quantifier) exactly once.
func rx_single_atom = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var int kind = p.atom_kind.load_int(atom)
	if kind == RX_A_LIT {
		if in_pos < in_len {
			if (input.at(in_pos) as int) == p.atom_v0.load_int(atom) {
				return in_pos + 1
			}
		}
		return -1
	}
	if kind == RX_A_ANY {
		if in_pos < in_len {
			if (input.at(in_pos) as int) != 10 {
				return in_pos + 1
			}
		}
		return -1
	}
	if kind == RX_A_CLASS {
		if in_pos < in_len {
			if rx_class_has(ref p, p.atom_v0.load_int(atom), input.at(in_pos)) {
				return in_pos + 1
			}
		}
		return -1
	}
	if kind == RX_A_BOL {
		if in_pos != 0 {
			return -1
		}
		return in_pos
	}
	if kind == RX_A_EOL {
		if in_pos != in_len {
			return -1
		}
		return in_pos
	}
	if kind == RX_A_NOMATCH {
		// A trailing backslash never matches (old match_single_atom's
		// `atom_start + 1 < atom_end` fall-through).
		return -1
	}
	if kind == RX_A_BACKREF {
		return rx_backref(input, p.atom_v0.load_int(atom), in_pos, in_len, ref caps)
	}
	if kind == RX_A_GROUP {
		// Match the group's inner content, recording the group's span on
		// success; on failure restore the span this path started with.
		var int g = p.atom_v0.load_int(atom)
		var int at = rx_last_capture(caps, g)
		var int old_start = -1
		var int old_end = -1
		if at >= 0 {
			old_start = caps.slots.load_int(at + 1)
			old_end = caps.slots.load_int(at + 2)
		}
		var int next = rx_match_seq(ref p, p.atom_v1.load_int(atom), input, in_pos, in_len, ref caps)
		if next >= 0 {
			rx_record(ref caps, g, in_pos, next)
			return next
		}
		rx_record(ref caps, g, old_start, old_end)
		return -1
	}
	return -1
}

// char_matches_atom: whether the single-byte atom matches input.at(pos).
func rx_byte_matches = (ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, int atom, string input, int pos, out bool) {
	var int kind = p.atom_kind.load_int(atom)
	if kind == RX_A_LIT {
		return (input.at(pos) as int) == p.atom_v0.load_int(atom)
	}
	if kind == RX_A_ANY {
		return (input.at(pos) as int) != 10
	}
	if kind == RX_A_CLASS {
		return rx_class_has(ref p, p.atom_v0.load_int(atom), input.at(pos))
	}
	return false
}

// match_group_then_rest: try the group's alternatives in order; a trial whose
// continuation fails restores the group's previous span before the next.
func rx_group_then_rest = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int cont_alt,
	int cont_step,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var int g = p.atom_v0.load_int(atom)
	var int at = rx_last_capture(caps, g)
	var int old_start = -1
	var int old_end = -1
	if at >= 0 {
		old_start = caps.slots.load_int(at + 1)
		old_end = caps.slots.load_int(at + 2)
	}
	var int seq = p.atom_v1.load_int(atom)
	var int alt_k = p.seq_alt0.load_int(seq)
	var int na = p.seq_nalt.load_int(seq)
	var k = 0
	while k < na; k += 1 {
		// Per-alt gate (see rx_match_seq): the skipped trial would fail at
		// its first consuming atom without touching capture state.
		if alt_k < 0 {
			return -1
		}
		var int aflags = p.alt_flags.load_int(alt_k)
		if (aflags & 3) == 0 {
			if in_pos < in_len {
				var int code = input.at(in_pos) as int
				var int fi = alt_k * 4 + (code >> 6)
				var skip = false
				if fi >= 0 && fi < p.alt_fb.cap {
					var int word = p.alt_fb.load_int(fi)
					if ((word >> (code & 63)) & 1) == 0 {
						skip = true
					}
				}
				if skip {
					alt_k = rx_next_alt(ref p, alt_k)
					continue
				}
			} else {
				alt_k = rx_next_alt(ref p, alt_k)
				continue
			}
		}
		var int next = rx_match_alt(ref p, alt_k, 0, input, in_pos, in_len, ref caps)
		if next >= 0 {
			rx_record(ref caps, g, in_pos, next)
			var int r = rx_match_alt(ref p, cont_alt, cont_step, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
		rx_record(ref caps, g, old_start, old_end)
		alt_k = rx_next_alt(ref p, alt_k)
	}
	return -1
}

// match_star: greedy/lazy repetition of one atom. Single-byte atoms run the
// greedy scan iteratively; groups and backreferences recurse.
func rx_star = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int min_count,
	int lazy,
	int cont_alt,
	int cont_step,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var int kind = p.atom_kind.load_int(atom)
	if kind == RX_A_GROUP {
		return rx_star_group(ref p, atom, min_count, lazy, cont_alt, cont_step, input, in_pos, in_len, ref caps)
	}
	if kind == RX_A_BACKREF {
		return rx_star_backref(ref p, atom, min_count, lazy, cont_alt, cont_step, input, in_pos, in_len, ref caps)
	}
	// Greedily consume the longest run of matching characters. The test is
	// inlined per atom kind (no per-byte call): the run is the innermost
	// loop of every star-shaped pattern (e.g. `[^\n]+` over the whole
	// input), so a call frame per byte is the dominant cost.
	var int max_pos = in_pos
	var int akind = p.atom_kind.load_int(atom)
	if akind == RX_A_LIT {
		var int lit = p.atom_v0.load_int(atom)
		while max_pos < in_len {
			if (input.at(max_pos) as int) == lit {
				max_pos += 1
			} else {
				break
			}
		}
	} else {
		if akind == RX_A_ANY {
			while max_pos < in_len {
				if (input.at(max_pos) as int) != 10 {
					max_pos += 1
				} else {
					break
				}
			}
		} else {
			if akind == RX_A_CLASS {
				var int cls = p.atom_v0.load_int(atom)
				while max_pos < in_len {
					var int code = input.at(max_pos) as int
					var int fi = cls * 4 + (code >> 6)
					if fi >= 0 && fi < p.bits.cap {
						var int word = p.bits.load_int(fi)
						if ((word >> (code & 63)) & 1) == 1 {
							max_pos += 1
						} else {
							break
						}
					} else {
						break
					}
				}
			} else {
				while max_pos < in_len {
					if rx_byte_matches(ref p, atom, input, max_pos) {
						max_pos += 1
					} else {
						break
					}
				}
			}
		}
	}
	if lazy > 0 {
		var int try_pos = in_pos + min_count
		while try_pos <= max_pos; try_pos += 1 {
			var int r = rx_match_alt(ref p, cont_alt, cont_step, input, try_pos, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
		return -1
	}
	var int try_pos = max_pos
	while try_pos >= in_pos + min_count; try_pos -= 1 {
		var int r = rx_match_alt(ref p, cont_alt, cont_step, input, try_pos, in_len, ref caps)
		if r >= 0 {
			return r
		}
	}
	return -1
}

// match_star_group + match_group_iteration: one more iteration of a
// quantified group, retrying the group's alternatives while the remaining
// star recursion fails.
func rx_group_iteration = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int cont_alt,
	int cont_step,
	int min_count,
	int lazy,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var int g = p.atom_v0.load_int(atom)
	var int at = rx_last_capture(caps, g)
	var int old_start = -1
	var int old_end = -1
	if at >= 0 {
		old_start = caps.slots.load_int(at + 1)
		old_end = caps.slots.load_int(at + 2)
	}
	var int seq = p.atom_v1.load_int(atom)
	var int alt_k = p.seq_alt0.load_int(seq)
	var int na = p.seq_nalt.load_int(seq)
	var k = 0
	while k < na; k += 1 {
		// Per-alt gate (see rx_match_seq).
		if alt_k < 0 {
			return -1
		}
		var int aflags = p.alt_flags.load_int(alt_k)
		if (aflags & 3) == 0 {
			if in_pos < in_len {
				var int code = input.at(in_pos) as int
				var int fi = alt_k * 4 + (code >> 6)
				var skip = false
				if fi >= 0 && fi < p.alt_fb.cap {
					var int word = p.alt_fb.load_int(fi)
					if ((word >> (code & 63)) & 1) == 0 {
						skip = true
					}
				}
				if skip {
					alt_k = rx_next_alt(ref p, alt_k)
					continue
				}
			} else {
				alt_k = rx_next_alt(ref p, alt_k)
				continue
			}
		}
		var int next = rx_match_alt(ref p, alt_k, 0, input, in_pos, in_len, ref caps)
		if next >= 0 {
			rx_record(ref caps, g, in_pos, next)
			if next != in_pos {
				var new_min = 0
				if min_count > 0 {
					new_min = min_count - 1
				}
				var int r = rx_star_group(ref p, atom, new_min, lazy, cont_alt, cont_step, input, next, in_len, ref caps)
				if r >= 0 {
					return r
				}
			}
		}
		rx_record(ref caps, g, old_start, old_end)
		alt_k = rx_next_alt(ref p, alt_k)
	}
	return -1
}

func rx_star_group = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int min_count,
	int lazy,
	int cont_alt,
	int cont_step,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	if lazy > 0 {
		if min_count <= 0 {
			var int stop = rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		return rx_group_iteration(ref p, atom, cont_alt, cont_step, min_count, lazy, input, in_pos, in_len, ref caps)
	}
	var int r = rx_group_iteration(ref p, atom, cont_alt, cont_step, min_count, lazy, input, in_pos, in_len, ref caps)
	if r >= 0 {
		return r
	}
	if min_count <= 0 {
		return rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
	}
	return -1
}

// match_star_backref: each iteration consumes the referenced span.
func rx_star_backref = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int min_count,
	int lazy,
	int cont_alt,
	int cont_step,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var int group = p.atom_v0.load_int(atom)
	if lazy > 0 {
		if min_count <= 0 {
			var int stop = rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		var int next = rx_backref(input, group, in_pos, in_len, ref caps)
		if next >= 0 {
			if next != in_pos {
				var new_min = 0
				if min_count > 0 {
					new_min = min_count - 1
				}
				return rx_star_backref(ref p, atom, new_min, lazy, cont_alt, cont_step, input, next, in_len, ref caps)
			}
		}
		return -1
	}
	var int next = rx_backref(input, group, in_pos, in_len, ref caps)
	if next >= 0 {
		if next != in_pos {
			var new_min = 0
			if min_count > 0 {
				new_min = min_count - 1
			}
			var int r = rx_star_backref(ref p, atom, new_min, lazy, cont_alt, cont_step, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
	}
	if min_count <= 0 {
		return rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
	}
	return -1
}

// match_counted: {n}/{n,}/{n,m} repetition via single-atom trials.
func rx_counted = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int min_count,
	int max_count,
	int lazy,
	int count,
	int cont_alt,
	int cont_step,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var can_stop = count >= min_count
	var can_more = max_count < 0 || count < max_count
	if lazy > 0 {
		if can_stop {
			var int stop = rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
			if stop >= 0 {
				return stop
			}
		}
		if can_more {
			var int next = rx_single_atom(ref p, atom, input, in_pos, in_len, ref caps)
			if next >= 0 {
				if next != in_pos {
					return rx_counted(ref p, atom, min_count, max_count, lazy, count + 1, cont_alt, cont_step, input, next, in_len, ref caps)
				}
			}
		}
		return -1
	}
	if can_more {
		var int next = rx_single_atom(ref p, atom, input, in_pos, in_len, ref caps)
		if next >= 0 {
			if next != in_pos {
				var int r = rx_counted(ref p, atom, min_count, max_count, lazy, count + 1, cont_alt, cont_step, input, next, in_len, ref caps)
				if r >= 0 {
					return r
				}
			}
		}
	}
	if can_stop {
		return rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
	}
	return -1
}

// match_optional: '?' with greedy/lazy preference.
func rx_optional = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int atom,
	int lazy,
	int cont_alt,
	int cont_step,
	string input,
	int in_pos,
	int in_len,
	ref RxCaps caps { slots, n },
	out int
) {
	var int kind = p.atom_kind.load_int(atom)
	if lazy > 0 {
		var int skip = rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
		if skip >= 0 {
			return skip
		}
		if kind == RX_A_GROUP {
			return rx_group_then_rest(ref p, atom, cont_alt, cont_step, input, in_pos, in_len, ref caps)
		}
		var int next = rx_single_atom(ref p, atom, input, in_pos, in_len, ref caps)
		if next >= 0 {
			return rx_match_alt(ref p, cont_alt, cont_step, input, next, in_len, ref caps)
		}
		return -1
	}
	if kind == RX_A_GROUP {
		var int grouped = rx_group_then_rest(ref p, atom, cont_alt, cont_step, input, in_pos, in_len, ref caps)
		if grouped >= 0 {
			return grouped
		}
	} else {
		var int next = rx_single_atom(ref p, atom, input, in_pos, in_len, ref caps)
		if next >= 0 {
			var int r = rx_match_alt(ref p, cont_alt, cont_step, input, next, in_len, ref caps)
			if r >= 0 {
				return r
			}
		}
	}
	return rx_match_alt(ref p, cont_alt, cont_step, input, in_pos, in_len, ref caps)
}

// lookaround_succeeds: kinds 2/3 look ahead from in_pos; 4/5 look behind for
// a match ending exactly at in_pos. Trials use a throwaway capture log.
func rx_look_succeeds = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int kind,
	int inner,
	string input,
	int in_pos,
	int in_len,
	out bool
) {
	if kind == 2 {
		var trial = RxCaps()
		return rx_match_seq(ref p, inner, input, in_pos, in_len, ref trial) >= 0
	}
	if kind == 3 {
		var trial = RxCaps()
		return rx_match_seq(ref p, inner, input, in_pos, in_len, ref trial) < 0
	}
	var found = false
	var s = 0
	while s <= in_pos {
		var trial = RxCaps()
		var int e = rx_match_seq(ref p, inner, input, s, in_len, ref trial)
		if e == in_pos {
			found = true
			break
		}
		s += 1
	}
	if kind == 4 {
		return found
	}
	return found == false
}

// match_backref: match the text capture group `group` last matched.
func rx_backref = (
	string input,
	int group,
	int in_pos,
	int in_len,
	ref RxCaps caps {},
	out int
) {
	var int at = rx_last_capture(caps, group)
	if at < 0 {
		return -1
	}
	var int s = caps.slots.load_int(at + 1)
	if s < 0 {
		return -1
	}
	var int len = caps.slots.load_int(at + 2) - s
	if in_pos + len > in_len {
		return -1
	}
	var i = 0
	while i < len; i += 1 {
		if input.at(in_pos + i) != input.at(s + i) {
			return -1
		}
	}
	return in_pos + len
}

// ── The compiler: pattern string → tables ───────────────────────────────────
//
// The walk mirrors the string-walking scanner exactly: the same helper
// functions (atom_end_pos, group_kind, group_inner_start, group_index_at,
// counted_quant_*) decide atom bounds and quantifier text at COMPILE time
// that the old engine re-derived on every match attempt. A class atom's
// member scan mirrors char_in_class's loop shape (same off-by-ones) so edge
// cases like a trailing range (`[a-]`) compile to the same membership set
// the runtime scan tests.

// Compile a whole pattern. Returns 0, or -1 when the pattern needs the
// legacy engine (never for a well-formed source — tables are sized from the
// pattern length; the -1 path is pure insurance).
func rx_compile = (string pattern, ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, out int) {
	var int cap = rx_table_cap(pattern.length)
	p.cap_seq = cap
	p.cap_alt = cap
	p.cap_step = cap
	p.cap_atom = cap
	p.cap_cls = cap
	p.seq_alt0.alloc_int(cap)
	p.seq_nalt.alloc_int(cap)
	p.step0.alloc_int(cap)
	p.nsteps.alloc_int(cap)
	p.step_atom.alloc_int(cap)
	p.step_q.alloc_int(cap)
	p.step_lazy.alloc_int(cap)
	p.step_min.alloc_int(cap)
	p.step_max.alloc_int(cap)
	p.atom_kind.alloc_int(cap)
	p.atom_v0.alloc_int(cap)
	p.atom_v1.alloc_int(cap)
	p.bits.alloc_int(cap * 4)
	p.dq.alloc_int(cap)
	p.ds.alloc_int(cap)
	p.de.alloc_int(cap)
	p.alt_fb.alloc_int(cap * 4)
	p.alt_flags.alloc_int(cap)
	p.seq_fb.alloc_int(cap * 4)
	p.seq_flags.alloc_int(cap)
	p.alt_next.alloc_int(cap)
	var int seq = rx_compile_seq(pattern, 0, pattern.length, ref p)
	if seq < 0 {
		return -1
	}
	p.ngroups = capture_count(pattern)
	return 0
}

// Compile pattern[s..e) as a SEQ: split top-level alternation (the same scan
// match_here does at every attempt, done once here), compile each piece as
// an ALT. The seq header is pushed first and patched after its alts.
func rx_compile_seq = (string pattern, int s, int e, ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, out int) {
	if p.nseq >= p.cap_seq {
		return -1
	}
	var int seq_id = p.nseq
	p.nseq += 1
	// Placeholders; patched below once the alt range is known.
	p.seq_alt0.store_int(seq_id, 0)
	p.seq_nalt.store_int(seq_id, 0)
	var int first_alt = -1
	var int prev_alt = -1
	var int nalt = 0
	var a = s
	while true {
		var int bar = next_top_level_alt(pattern, a, e)
		var int alt_end = e
		if bar >= 0 {
			alt_end = bar
		}
		var int alt_id = rx_compile_alt(pattern, a, alt_end, ref p)
		if alt_id < 0 {
			return -1
		}
		if prev_alt >= 0 {
			p.alt_next.store_int(prev_alt, alt_id)
		} else {
			first_alt = alt_id
		}
		prev_alt = alt_id
		nalt += 1
		if bar < 0 {
			break
		}
		a = bar + 1
	}
	if prev_alt >= 0 {
		p.alt_next.store_int(prev_alt, -1)
	}
	p.seq_alt0.store_int(seq_id, first_alt)
	p.seq_nalt.store_int(seq_id, nalt)
	// Union the alternatives' first-byte sets for this seq's gate.
	var seq_flags = 0
	if rx_seq_union(ref p, first_alt, nalt, seq_id, ref seq_flags) < 0 {
		return -1
	}
	p.seq_flags.store_int(seq_id, seq_flags)
	return seq_id
}

// OR the first-byte sets of a seq's alternatives (walking the sibling
// chain) into seq_fb, collecting flags. Recursive so every table index is
// a parameter (see rx_flags_at).
func rx_seq_union = (
	ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next },
	int alt,
	int remaining,
	int seq_id,
	ref int flags,
	out int
) {
	if remaining <= 0 || alt < 0 {
		return 0
	}
	if alt >= p.alt_flags.cap {
		return -1
	}
	var int af = p.alt_flags.load_int(alt)
	if (af & 1) == 1 {
		flags = flags | 1
	}
	if (af & 2) == 2 {
		flags = flags | 2
	}
	var w3 = 0
	while w3 < 4; w3 += 1 {
		var int fi = seq_id * 4 + w3
		if fi >= 0 && fi < p.seq_fb.cap {
			var int fi2 = alt * 4 + w3
			if fi2 >= 0 && fi2 < p.alt_fb.cap {
				var int word = p.seq_fb.load_int(fi)
				p.seq_fb.store_int(fi, word | p.alt_fb.load_int(fi2))
			}
		}
	}
	var int nxt = p.alt_next.load_int(alt)
	return rx_seq_union(ref p, nxt, remaining - 1, seq_id, ref flags)
}

// Compile pattern[s..e) (one alternative — no top-level bars) as a linear
// sequence of quantified-atom steps.
func rx_compile_alt = (string pattern, int s, int e, ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, out int) {
	if p.nalt >= p.cap_alt {
		return -1
	}
	var int alt_id = p.nalt
	p.nalt += 1
	p.step0.store_int(alt_id, p.nstep)
	p.nsteps.store_int(alt_id, 0)
	// Defers pushed while walking THIS alternative are drained at the end,
	// so the inner compiles cannot splice steps into this alt's range.
	var int defer_mark = p.nd
	var i = s
	while i < e {
		var char c = pattern.at(i)
		var int atom = -1
		var int consumed = i + 1
		var no_quant = false
		if c == '^' {
			// Zero-width anchor — the old engine handles it before the
			// atom-bounds walk, so it never carries a quantifier.
			atom = rx_push_atom(ref p, RX_A_BOL, 0, 0)
			no_quant = true
		} else {
			if c == '$' {
				atom = rx_push_atom(ref p, RX_A_EOL, 0, 0)
				no_quant = true
			} else {
				if c == '(' {
					var int a_end = atom_end_pos(pattern, i, e)
					var int kind = group_kind(pattern, i, e)
					if kind >= 2 {
						// Lookaround: zero-width, no quantifier (the old
						// engine consumes it before reading a quantifier,
						// so a following '*' is a literal atom).
						atom = rx_push_atom(ref p, RX_A_LOOK, kind, 0)
						if atom < 0 {
							return -1
						}
						if p.nd >= p.cap_step {
							return -1
						}
						p.dq.store_int(p.nd, atom)
						p.ds.store_int(p.nd, group_inner_start(pattern, i, e))
						p.de.store_int(p.nd, a_end - 1)
						p.nd += 1
						consumed = a_end
						no_quant = true
					} else {
						var int g = group_index_at(pattern, i)
						atom = rx_push_atom(ref p, RX_A_GROUP, g, 0)
						if atom < 0 {
							return -1
						}
						if p.nd >= p.cap_step {
							return -1
						}
						p.dq.store_int(p.nd, atom)
						p.ds.store_int(p.nd, group_inner_start(pattern, i, e))
						p.de.store_int(p.nd, a_end - 1)
						p.nd += 1
						consumed = a_end
					}
				} else {
					if c == '[' {
						var int a_end = atom_end_pos(pattern, i, e)
						var int cls = rx_build_class_bits(pattern, i + 1, a_end - 1, ref p)
						if cls < 0 {
							return -1
						}
						atom = rx_push_atom(ref p, RX_A_CLASS, cls, 0)
						consumed = a_end
					} else {
						if (c as int) == 92 {
							// Escaped atom: backreference, shorthand class,
							// literal byte — or a trailing backslash, which
							// never matches.
							if i + 1 >= e {
								atom = rx_push_atom(ref p, RX_A_NOMATCH, 0, 0)
								consumed = i + 1
							} else {
								var char ec = pattern.at(i + 1)
								if is_backref_digit(ec) {
									atom = rx_push_atom(ref p, RX_A_BACKREF, backref_group(ec), 0)
								} else {
									if is_shorthand(ec) {
										var int cls = rx_build_shorthand_bits(ec, ref p)
										if cls < 0 {
											return -1
										}
										atom = rx_push_atom(ref p, RX_A_CLASS, cls, 0)
									} else {
										atom = rx_push_atom(ref p, RX_A_LIT, escaped_byte_value(ec), 0)
									}
								}
								consumed = i + 2
							}
						} else {
							if c == '.' {
								atom = rx_push_atom(ref p, RX_A_ANY, 0, 0)
							} else {
								// Literal byte — including the stray
								// quantifier characters the old engine
								// treats as literals when they do not
								// follow an atom.
								atom = rx_push_atom(ref p, RX_A_LIT, c as int, 0)
							}
						}
					}
				}
			}
		}
		if atom < 0 {
			return -1
		}
		// Quantifier parse (skipped for zero-width atoms, matching the old
		// engine's ordering).
		var int q = RX_Q_NONE
		var lazy = 0
		var int mn = 0
		var int mx = 0
		if no_quant == false {
			consumed = rx_parse_quant(pattern, consumed, e, ref q, ref lazy, ref mn, ref mx)
		}
		// One step = one index across all five parallel columns.
		if p.nstep >= p.cap_step {
			return -1
		}
		var int st = p.nstep
		p.nstep += 1
		p.step_atom.store_int(st, atom)
		p.step_q.store_int(st, q)
		p.step_lazy.store_int(st, lazy)
		p.step_min.store_int(st, mn)
		p.step_max.store_int(st, mx)
		var int ns = p.nsteps.load_int(alt_id)
		p.nsteps.store_int(alt_id, ns + 1)
		i = consumed
	}
	// Drain the deferred inner-seq compiles (deepest-first stack order;
	// each compile may push more defers — nested groups — handled by the
	// same loop). Steps pushed here belong to NEW alts (the inner seqs),
	// never to this one, so this alt's step0+nsteps stay contiguous.
	while p.nd > defer_mark {
		p.nd -= 1
		var int at = p.dq.load_int(p.nd)
		var int is = p.ds.load_int(p.nd)
		var int ie = p.de.load_int(p.nd)
		var int inner_seq = rx_compile_seq(pattern, is, ie, ref p)
		if inner_seq < 0 {
			return -1
		}
		p.atom_v1.store_int(at, inner_seq)
	}
	// Compute this alt's first-byte set for the candidate gate: walk the
	// steps, collecting the byte set of the first consuming atom; zero-width
	// atoms (anchors, lookarounds) and nullable steps (star/opt/{0..}) let
	// the walk continue — what FOLLOWS them can also be first. Reaching the
	// end means every step can match empty: the alt may match empty (no
	// gate). A wildcard-shaped set (ANY, BACKREF) sets the any flag (no
	// gate — always descend).
	var w = 0
	while w < 4; w += 1 {
		var int fi0 = alt_id * 4 + w
		if fi0 >= 0 && fi0 < p.alt_fb.cap {
			p.alt_fb.store_int(fi0, 0)
		}
	}
	var flags = 0
	var si = 0
	while true {
		if si >= p.nsteps.load_int(alt_id) {
			// Every step nullable/zero-width: the alt can match empty.
			flags = flags | 2
			break
		}
		var int st2 = p.step0.load_int(alt_id) + si
		var int at2 = p.step_atom.load_int(st2)
		var int q2 = p.step_q.load_int(st2)
		var int mn2 = p.step_min.load_int(st2)
		var nullable_step = q2 == RX_Q_STAR || q2 == RX_Q_OPT || (q2 == RX_Q_COUNTED && mn2 == 0)
		var int akind = p.atom_kind.load_int(at2)
		var atom_nullable = false
		var atom_zero_width = false
		if akind == RX_A_LIT {
			var int code = p.atom_v0.load_int(at2)
			var int fi = alt_id * 4 + (code >> 6)
			if fi >= 0 && fi < p.alt_fb.cap {
				var int word = p.alt_fb.load_int(fi)
				p.alt_fb.store_int(fi, word | (1 << (code & 63)))
			}
		} else {
			if akind == RX_A_CLASS {
				var int cls = p.atom_v0.load_int(at2)
				var w4 = 0
				while w4 < 4; w4 += 1 {
					var int fi = alt_id * 4 + w4
					if fi >= 0 && fi < p.alt_fb.cap {
						var int word = p.alt_fb.load_int(fi)
						p.alt_fb.store_int(fi, word | p.bits.load_int(cls * 4 + w4))
					}
				}
			} else {
				if akind == RX_A_ANY {
					flags = flags | 1
				} else {
					if akind == RX_A_BACKREF {
						// A backref consumes an unknown span (possibly
						// nothing): no gate, and the walk continues.
						flags = flags | 1
						atom_nullable = true
					} else {
						if akind == RX_A_GROUP {
							// The group's first bytes are its inner seq's
							// union (compiled during the drain above).
							var int inner = p.atom_v1.load_int(at2)
							var w5 = 0
							while w5 < 4; w5 += 1 {
								var int fi = alt_id * 4 + w5
								if fi >= 0 && fi < p.alt_fb.cap {
									var int word = p.alt_fb.load_int(fi)
									p.alt_fb.store_int(fi, word | p.seq_fb.load_int(inner * 4 + w5))
								}
							}
							var int iflags = p.seq_flags.load_int(inner)
							if (iflags & 1) == 1 {
								flags = flags | 1
							}
							if (iflags & 2) == 2 {
								atom_nullable = true
							}
						} else {
							if akind == RX_A_LOOK || akind == RX_A_BOL || akind == RX_A_EOL {
								// Zero-width: no bytes; what follows can be
								// first.
								atom_zero_width = true
							}
							// RX_A_NOMATCH: no bytes, never nullable — the
							// gate will skip this alt, which is exact (it
							// can never match).
						}
					}
				}
			}
		}
		if atom_zero_width || nullable_step || atom_nullable {
			// The walk continues: whatever follows this step can also be
			// first (a conservative superset — e.g. a `{1,}` quantifier on
			// a nullable group keeps its own bytes AND continues).
			si += 1
		} else {
			break
		}
	}
	p.alt_flags.store_int(alt_id, flags)
	return alt_id
}

// Append one atom to the atom tables. -1 on table overflow.
func rx_push_atom = (ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, int kind, int v0, int v1, out int) {
	if p.natom >= p.cap_atom {
		return -1
	}
	var int id = p.natom
	p.natom += 1
	p.atom_kind.store_int(id, kind)
	p.atom_v0.store_int(id, v0)
	p.atom_v1.store_int(id, v1)
	return id
}

// rx_parse_quant mirrors match_here's quantifier read: '*', '+', '?' (each
// optionally lazy via a trailing '?'), or a valid `{n}/{n,}/{n,m}` bound
// (invalid braces are literals). Returns the position past the quantifier,
// or `at` unchanged when there is none.
func rx_parse_quant = (
	string pattern,
	int at,
	int e,
	ref int q,
	ref int lazy,
	ref int mn,
	ref int mx,
	out int
) {
	if at >= e {
		return at
	}
	var char c = pattern.at(at)
	if c == '*' {
		q = RX_Q_STAR
		var int rest = at + 1
		if rest < e {
			if pattern.at(rest) == '?' {
				lazy = 1
				rest += 1
			}
		}
		return rest
	}
	if c == '+' {
		q = RX_Q_PLUS
		mn = 1
		var int rest = at + 1
		if rest < e {
			if pattern.at(rest) == '?' {
				lazy = 1
				rest += 1
			}
		}
		return rest
	}
	if c == '?' {
		q = RX_Q_OPT
		var int rest = at + 1
		if rest < e {
			if pattern.at(rest) == '?' {
				lazy = 1
				rest += 1
			}
		}
		return rest
	}
	if c == '{' {
		var int qe = counted_quant_end(pattern, at, e)
		if qe >= 0 {
			q = RX_Q_COUNTED
			mn = counted_quant_min(pattern, at)
			mx = counted_quant_max(pattern, at, e)
			var int rest = qe
			if rest < e {
				if pattern.at(rest) == '?' {
					lazy = 1
					rest += 1
				}
			}
			return rest
		}
	}
	return at
}

// Set the bits of `code` in class slot `cls`.
func rx_set_bit = (ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, int cls, int code: code >= 0 && code < 256) {
	var int word = p.bits.load_int(cls * 4 + (code >> 6))
	p.bits.store_int(cls * 4 + (code >> 6), word | (1 << (code & 63)))
}


// The lowercase member set of shorthand class `kind`, expressed as bitmap
// mutations: complement shorthands (uppercase) fill everything EXCEPT the
// lowercase set — the same membership matches_shorthand computes.
func rx_set_shorthand_bits = (ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, int cls, char e) {
	var int kind = e as int
	var complement = false
	if kind >= 65 && kind <= 90 {
		complement = true
		kind += 32
	}
	var code = 0
	while code < 256; code += 1 {
		var found = false
		if kind == 100 {
			found = code >= 48 && code <= 57
		} else {
			if kind == 119 {
				found = (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || (code >= 48 && code <= 57) || code == 95
			} else {
				found = (code >= 9 && code <= 13) || code == 32
			}
		}
		if complement == false {
			if found {
				rx_set_bit(ref p, cls, code)
			}
		} else {
			if found == false {
				rx_set_bit(ref p, cls, code)
			}
		}
	}
}

// A fresh class slot holding the membership set of shorthand escape `e`
// (\d \w \s and their complements).
func rx_build_shorthand_bits = (char e, ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, out int) {
	if p.ncls >= p.cap_cls {
		return -1
	}
	var int cls = p.ncls
	p.ncls += 1
	var w = 0
	while w < 4; w += 1 {
		p.bits.store_int(cls * 4 + w, 0)
	}
	rx_set_shorthand_bits(ref p, cls, e)
	return cls
}

// Build the 256-bit membership set of the class spanning pattern[cs..ce)
// (the same range char_in_class scans at runtime — same loop shape, same
// boundaries). Negation is resolved here: the complement set, so the VM's
// test is a single bitmap probe.
func rx_build_class_bits = (string pattern, int cs, int ce, ref RxProg p { seq_alt0, seq_nalt, nseq, cap_seq, step0, nsteps, nalt, cap_alt, step_atom, step_q, step_lazy, step_min, step_max, nstep, cap_step, atom_kind, atom_v0, atom_v1, natom, cap_atom, bits, ncls, cap_cls, ngroups, dq, ds, de, nd, alt_fb, alt_flags, seq_fb, seq_flags, alt_next }, out int) {
	if p.ncls >= p.cap_cls {
		return -1
	}
	var int cls = p.ncls
	p.ncls += 1
	var w = 0
	while w < 4; w += 1 {
		p.bits.store_int(cls * 4 + w, 0)
	}
	var negated = false
	var int pos = cs
	if pos < ce {
		if pattern.at(pos) == '^' {
			negated = true
			pos += 1
		}
	}
	var i = pos
	while i < ce {
		var char c = pattern.at(i)
		if (c as int) == 92 {
			if i + 1 < ce {
				var char e = pattern.at(i + 1)
				if is_shorthand(e) {
					rx_set_shorthand_bits(ref p, cls, e)
				} else {
					rx_set_bit(ref p, cls, escaped_byte_value(e))
				}
			}
			i = i + 2
		} else {
			if i + 2 < ce {
				if pattern.at(i + 1) == '-' {
					var int lo = c as int
					var int hi = pattern.at(i + 2) as int
					while lo <= hi {
						rx_set_bit(ref p, cls, lo)
						lo += 1
					}
					i += 3
				} else {
					rx_set_bit(ref p, cls, c as int)
					i += 1
				}
			} else {
				rx_set_bit(ref p, cls, c as int)
				i += 1
			}
		}
	}
	if negated {
		// Negated class: complement the member set. (char_in_class answers
		// `!found` — this is that, precomputed.)
		var code = 0
		while code < 256; code += 1 {
			var int word = p.bits.load_int(cls * 4 + (code >> 6))
			p.bits.store_int(cls * 4 + (code >> 6), word ^ (1 << (code & 63)))
		}
	}
	return cls
}

// Candidate-position prefilter over a 256-entry byte table (the compiled
// form of find_next_byte's charset scan: one indexed load per input byte
// instead of a charset loop).
