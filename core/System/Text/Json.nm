// JSON serialize / deserialize for Nomen string values, written in pure Nomen.
//
// `serialize` quotes and escapes a string into a JSON string literal;
// `deserialize` parses a JSON string literal back into the raw value.
// Integer (de)serialization is handled by int.to_string() and int.parse()
// (see int.nm), so this struct only deals with JSON strings.
//
// `parse` / `stringify` use a JsonTree pool (flat Buffer-backed slot array)
// instead of per-node heap allocation, avoiding O(nodes) malloc/free per
// parse cycle. The caller creates a JsonTree once and resets it per document.

/**
 * JSON serialization helpers — `serialize`/`deserialize` strings, `parse`/`stringify` via a JsonTree
 **/
pub struct Json {
	// Serialize a string to a JSON string literal, escaping the special
	// characters ", \, newline, tab and carriage return.
	pub func serialize = (string value, out string) {
		var sb = StringBuilder()
		sb.append_char('"')
		var i = 0
		var int len = value.length
		while i < len; i += 1 {
			var char c = value.at(i)
			var int code = c as int
			switch {
				case code == 34 {
					sb.append_string("\x5c\"")
				}
				case code == 92 {
					sb.append_string("\x5c\x5c")
				}
				case code == 10 {
					sb.append_string("\x5cn")
				}
				case code == 9 {
					sb.append_string("\x5ct")
				}
				case code == 13 {
					sb.append_string("\x5cr")
				}
				else {
					sb.append_char(c)
				}
			}
		}
		sb.append_char('"')
		return sb.to_string()
	}

	// Deserialize a JSON string literal to the raw, unescaped value.
	pub func deserialize = (string json, out string) {
		var sb = StringBuilder()
		var int len = json.length
		var i = 0
		// skip up to the opening quote
		while i < len; i += 1 {
			if (json.at(i) as int) == 34 {
				i += 1
				break
			}
		}
		// read until the unescaped closing quote, unescaping as we go
		while i < len; i += 1 {
			var char c = json.at(i)
			var int code = c as int
			if code == 34 {
				break
			}
			if code == 92 {
				i += 1
				if i < len {
					var char e = json.at(i)
					var int ec = e as int
					switch {
						case ec == 110 {
							sb.append_string("\n")
						}
						case ec == 116 {
							sb.append_string("\t")
						}
						case ec == 114 {
							sb.append_string("\r")
						}
						case ec == 34 {
							sb.append_char('"')
						}
						case ec == 92 {
							sb.append_string("\x5c")
						}
						else {
							sb.append_char(e)
						}
					}
				}
			} else {
				sb.append_char(c)
			}
		}
		return sb.to_string()
	}

	// Parse a JSON document into tree. The caller provides a JsonTree pool
	// which is reset and filled. Returns the index of the root node.
	pub func parse = (string s, ref JsonTree tree, out int) {
		tree.reset()
		var pos = Buffer<int>()
		pos.alloc_int(1)
		pos.store_int(0, 0)
		var int len = s.length
		return json_parse_value(s, ref pos, len, ref tree)
	}

	// Serialize a node in the tree back to a JSON string.
	pub func stringify = (ref JsonTree tree, int root, out string) {
		var sb = StringBuilder()
		json_ser_value(ref tree, root, ref sb)
		return sb.to_string()
	}
}

func json_skip_ws = (string s, ref Buffer<int> pos, int len) {
	while pos.load_int(0) < len {
		var int i = pos.load_int(0)
		var int code = s.at(i) as int
		if code == 32 || code == 9 || code == 10 || code == 13 {
			pos.store_int(0, i + 1)
		} else {
			return
		}
	}
}

func json_parse_string = (string s, ref Buffer<int> pos, int len, ref JsonTree tree, out int) {
	var int i = pos.load_int(0)
	i += 1
	var sb = StringBuilder()
	while i < len; i += 1 {
		var char c = s.at(i)
		var int code = c as int
		if code == 34 {
			i += 1
			break
		}
		if code == 92 {
			i += 1
			if i < len {
				var char e = s.at(i)
				var int ec = e as int
				switch {
					case ec == 110 {
						sb.append_string("\n")
					}
					case ec == 116 {
						sb.append_string("\t")
					}
					case ec == 114 {
						sb.append_string("\r")
					}
					case ec == 34 {
						sb.append_char('"')
					}
					case ec == 92 {
						sb.append_string("\x5c")
					}
					else {
						sb.append_char(e)
					}
				}
			}
		} else {
			sb.append_char(c)
		}
	}
	pos.store_int(0, i)
	var int n = tree.alloc_node()
	tree.set_kind(n, 3)
	tree.set_text(n, sb.to_string())
	return n
}

func json_parse_number = (string s, ref Buffer<int> pos, int len, ref JsonTree tree, out int) {
	var int i = pos.load_int(0)
	var int start = i
	while i < len {
		var int code = s.at(i) as int
		if code == 45 || code == 43 || code == 46 || code == 101 || code == 69 || (code >= 48 && code <= 57) {
			i += 1
		} else {
			break
		}
	}
	pos.store_int(0, i)
	var sb = StringBuilder()
	var int j = start
	while j < i; j += 1 {
		sb.append_char(s.at(j))
	}
	var int n = tree.alloc_node()
	tree.set_kind(n, 2)
	tree.set_text(n, sb.to_string())
	return n
}

func json_parse_literal = (string s, ref Buffer<int> pos, int len, ref JsonTree tree, out int) {
	var int i = pos.load_int(0)
	var int code = s.at(i) as int
	var int n = tree.alloc_node()
	var adv = 4
	if code == 116 {
		tree.set_kind(n, 1)
		adv = 4
	} else {
		if code == 102 {
			tree.set_kind(n, 6)
			adv = 5
		} else {
			tree.set_kind(n, 0)
			adv = 4
		}
	}
	pos.store_int(0, i + adv)
	return n
}

func json_parse_value = (string s, ref Buffer<int> pos, int len, ref JsonTree tree, out int) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return tree.alloc_node()
	}
	var int code = s.at(i) as int
	if code == 123 {
		pos.store_int(0, i + 1)
		var int n = tree.alloc_node()
		tree.set_kind(n, 5)
		tree.set_child(n, json_parse_pairs(s, ref pos, len, ref tree))
		return n
	}
	if code == 91 {
		pos.store_int(0, i + 1)
		var int n = tree.alloc_node()
		tree.set_kind(n, 4)
		tree.set_child(n, json_parse_elements(s, ref pos, len, ref tree))
		return n
	}
	if code == 34 {
		return json_parse_string(s, ref pos, len, ref tree)
	}
	if code == 116 || code == 102 || code == 110 {
		return json_parse_literal(s, ref pos, len, ref tree)
	}
	return json_parse_number(s, ref pos, len, ref tree)
}

func json_parse_elements = (string s, ref Buffer<int> pos, int len, ref JsonTree tree, out int) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return -1
	}
	if (s.at(i) as int) == 93 {
		pos.store_int(0, i + 1)
		return -1
	}
	var int elem = json_parse_value(s, ref pos, len, ref tree)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos.load_int(0)
	if i2 < len {
		if (s.at(i2) as int) == 44 {
			pos.store_int(0, i2 + 1)
		}
	}
	tree.set_next(elem, json_parse_elements(s, ref pos, len, ref tree))
	return elem
}

func json_parse_pairs = (string s, ref Buffer<int> pos, int len, ref JsonTree tree, out int) {
	json_skip_ws(s, ref pos, len)
	var int i = pos.load_int(0)
	if i >= len {
		return -1
	}
	if (s.at(i) as int) == 125 {
		pos.store_int(0, i + 1)
		return -1
	}
	json_skip_ws(s, ref pos, len)
	var int key = json_parse_string(s, ref pos, len, ref tree)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos.load_int(0)
	if i2 < len {
		if (s.at(i2) as int) == 58 {
			pos.store_int(0, i2 + 1)
		}
	}
	var int v = json_parse_value(s, ref pos, len, ref tree)
	tree.set_val(key, v)
	json_skip_ws(s, ref pos, len)
	var int i3 = pos.load_int(0)
	if i3 < len {
		if (s.at(i3) as int) == 44 {
			pos.store_int(0, i3 + 1)
		}
	}
	tree.set_next(key, json_parse_pairs(s, ref pos, len, ref tree))
	return key
}

func json_ser_list = (ref JsonTree tree, int first, ref StringBuilder sb) {
	json_ser_value(ref tree, first, ref sb)
	var int next = tree.get_next(first)
	if next >= 0 {
		sb.append_char(',')
		json_ser_list(ref tree, next, ref sb)
	}
}

func json_ser_pairs = (ref JsonTree tree, int first, ref StringBuilder sb) {
	sb.append_char('"')
	sb.append_string(tree.get_text(first))
	sb.append_string("\":")
	var int v = tree.get_val(first)
	if v < 0 {
		sb.append_string("null")
	} else {
		json_ser_value(ref tree, v, ref sb)
	}
	var int next = tree.get_next(first)
	if next >= 0 {
		sb.append_char(',')
		json_ser_pairs(ref tree, next, ref sb)
	}
}

func json_ser_value = (ref JsonTree tree, int n, ref StringBuilder sb) {
	var int k = tree.get_kind(n)
	if k == 0 {
		sb.append_string("null")
		return
	}
	if k == 1 {
		sb.append_string("true")
		return
	}
	if k == 6 {
		sb.append_string("false")
		return
	}
	if k == 2 {
		sb.append_string(tree.get_text(n))
		return
	}
	if k == 3 {
		sb.append_char('"')
		sb.append_string(tree.get_text(n))
		sb.append_char('"')
		return
	}
	if k == 4 {
		sb.append_char('[')
		var int child = tree.get_child(n)
		if child >= 0 {
			json_ser_list(ref tree, child, ref sb)
		}
		sb.append_char(']')
		return
	}
	sb.append_char('{')
	var int child = tree.get_child(n)
	if child >= 0 {
		json_ser_pairs(ref tree, child, ref sb)
	}
	sb.append_char('}')
}
