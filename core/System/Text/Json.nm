// JSON serialize / deserialize for Nomen string values, written in pure Nomen.
//
// `serialize` quotes and escapes a string into a JSON string literal;
// `deserialize` parses a JSON string literal back into the raw value.
// Integer (de)serialization is handled by int.to_string() and int.parse()
// (see int.nm), so this struct only deals with JSON strings.
//
// `parse` / `stringify` use a JsonTree pool (a flat StableList of nodes)
// instead of per-node heap allocation, avoiding O(nodes) malloc/free per
// parse cycle. The caller creates a JsonTree once and resets it per document.

/**
 * JSON helpers. `parse` reads a document into a `JsonTree` and `stringify` writes one back
 * out; `serialize` / `deserialize` convert a single string to and from a JSON string literal.
 * To read or write a struct directly, use `json_decode_into` and `json_encode`.
 *
 * ```
 * var tree = JsonTree()
 * const root = Json.parse("[1, 2, 3]", ref tree)
 * const text = Json.stringify(ref tree, root)
 * ```
 **/
pub struct Json {
	/**
	 * `value` as a quoted JSON string literal, with `"`, `\`, newline, tab and carriage
	 * return escaped.
	 **/
	// `mv out string`: returns the StringBuilder's owned heap copy.
	pub func serialize = (string value, mv out string) {
		var sb = StringBuilder()
		sb.append_char('"')
		var i = 0
		var int len = value.length
		while i < len; i += 1 {
			var char c = value.at(i)
			var int code = c as int
			switch {
				case code == 34 {
					sb.append_string("\x5c\"")
				}
				case code == 92 {
					sb.append_string("\x5c\x5c")
				}
				case code == 10 {
					sb.append_string("\x5cn")
				}
				case code == 9 {
					sb.append_string("\x5ct")
				}
				case code == 13 {
					sb.append_string("\x5cr")
				}
				case _ {
				sb.append_char(c)
			}
			}
		}
		sb.append_char('"')
		return sb.to_string()
	}

	/**
	 * The raw value of the JSON string literal `json` (quotes removed, escapes decoded).
	 **/
	// `mv out string`: returns the StringBuilder's owned heap copy.
	pub func deserialize = (string json, mv out string) {
		var sb = StringBuilder()
		var int len = json.length
		var i = 0
		// skip up to the opening quote
		while i < len; i += 1 {
			if (json.at(i) as int) == 34 {
				i += 1
				break
			}
		}
		// read until the unescaped closing quote, unescaping as we go
		while i < len; i += 1 {
			var char c = json.at(i)
			var int code = c as int
			if code == 34 {
				break
			}
			if code == 92 {
				i += 1
				if i < len {
					var char e = json.at(i)
					var int ec = e as int
					switch {
						case ec == 110 {
							sb.append_string("\n")
						}
						case ec == 116 {
							sb.append_string("\t")
						}
						case ec == 114 {
							sb.append_string("\r")
						}
						case ec == 34 {
							sb.append_char('"')
						}
						case ec == 92 {
							sb.append_string("\x5c")
						}
						case _ {
						sb.append_char(e)
					}
					}
				}
			} else {
				sb.append_char(c)
			}
		}
		return sb.to_string()
	}

	/**
	 * Parse the JSON document `s` into `tree` and return the index of its root node. `tree`
	 * is reset first, so any earlier document in it is discarded.
	 **/
	pub func parse = (string s, ref JsonTree tree { nodes }, out int) {
		tree.reset()
		var int pos = 0
		var int len = s.length
		return json_parse_value(s, ref pos, len, ref tree)
	}

	/**
	 * The JSON text of the node `root` in `tree` (and everything under it).
	 **/
	pub func stringify = (ref JsonTree tree { nodes }, int root, out string) {
		var sb = StringBuilder()
		json_ser_value(ref tree, root, ref sb)
		return sb.to_string()
	}
}

func json_skip_ws = (string s, ref int pos, int len) {
	while pos < len {
		var int i = pos
		var int code = s.at(i) as int
		if code == 32 || code == 9 || code == 10 || code == 13 {
			pos = i + 1
		} else {
			return
		}
	}
}

func json_parse_string = (string s, ref int pos, int len, ref JsonTree tree { nodes }, out int) {
	var int i = pos
	i += 1
	var sb = StringBuilder()
	while i < len {
		// Scan-to-next-escape fast path: copy the run of plain bytes in ONE
		// bulk append instead of a per-byte append_char (each of which pays
		// the builder's capacity check and length bump).
		var int run_start = i
		var int code = 0
		while i < len {
			code = s.at(i) as int
			if code == 34 || code == 92 {
				break
			}
			i += 1
		}
		if i > run_start {
			sb.append_string_view(s.slice(run_start, i))
		}
		if i >= len {
			break
		}
		if code == 34 {
			i += 1
			break
		}
		// code == 92 — escape sequence: consume the backslash, append the
		// decoded byte (an unknown escape appends the byte verbatim).
		i += 1
		if i < len {
			var char e = s.at(i)
			var int ec = e as int
			switch {
				case ec == 110 {
					sb.append_string("\n")
				}
				case ec == 116 {
					sb.append_string("\t")
				}
				case ec == 114 {
					sb.append_string("\r")
				}
				case ec == 34 {
					sb.append_char('"')
				}
				case ec == 92 {
					sb.append_string("\x5c")
				}
				case _ {
				sb.append_char(e)
			}
			}
			i += 1
		}
	}
	pos = i
	var int n = tree.alloc_node()
	tree.set_kind(n, 3)
	tree.take_text(n, ref sb)
	return n
}

func json_parse_number = (string s, ref int pos, int len, ref JsonTree tree { nodes }, out int) {
	var int i = pos
	var int start = i
	while i < len {
		var int code = s.at(i) as int
		if code == 45 || code == 43 || code == 46 || code == 101 || code == 69 || (code >= 48 && code <= 57) {
			i += 1
		} else {
			break
		}
	}
	pos = i
	var sb = StringBuilder()
	// One bulk append for the whole run of number bytes (the scan above
	// already found its end) — no per-byte append_char.
	sb.append_string_view(s.slice(start, i))
	var int n = tree.alloc_node()
	tree.set_kind(n, 2)
	tree.take_text(n, ref sb)
	return n
}

func json_parse_literal = (string s, ref int pos, int len, ref JsonTree tree { nodes }, out int) {
	var int i = pos
	var int code = s.at(i) as int
	var int n = tree.alloc_node()
	var adv = 4
	switch {
		case code == 116 {
			tree.set_kind(n, 1)
			adv = 4
		}
		case code == 102 {
			tree.set_kind(n, 6)
			adv = 5
		}
		case _ {
		tree.set_kind(n, 0)
		adv = 4
	}
	}
	pos = i + adv
	return n
}

func json_parse_value = (string s, ref int pos, int len, ref JsonTree tree { nodes }, out int) {
	json_skip_ws(s, ref pos, len)
	var int i = pos
	if i >= len {
		return tree.alloc_node()
	}
	var int code = s.at(i) as int
	if code == 123 {
		pos = i + 1
		var int n = tree.alloc_node()
		tree.set_kind(n, 5)
		tree.set_child(n, json_parse_pairs(s, ref pos, len, ref tree))
		return n
	}
	if code == 91 {
		pos = i + 1
		var int n = tree.alloc_node()
		tree.set_kind(n, 4)
		tree.set_child(n, json_parse_elements(s, ref pos, len, ref tree))
		return n
	}
	if code == 34 {
		return json_parse_string(s, ref pos, len, ref tree)
	}
	if code == 116 || code == 102 || code == 110 {
		return json_parse_literal(s, ref pos, len, ref tree)
	}
	return json_parse_number(s, ref pos, len, ref tree)
}

func json_parse_elements = (string s, ref int pos, int len, ref JsonTree tree { nodes }, out int) {
	json_skip_ws(s, ref pos, len)
	var int i = pos
	if i >= len {
		return -1
	}
	if (s.at(i) as int) == 93 {
		pos = i + 1
		return -1
	}
	var int elem = json_parse_value(s, ref pos, len, ref tree)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos
	if i2 < len {
		if (s.at(i2) as int) == 44 {
			pos = i2 + 1
		}
	}
	tree.set_next(elem, json_parse_elements(s, ref pos, len, ref tree))
	return elem
}

func json_parse_pairs = (string s, ref int pos, int len, ref JsonTree tree { nodes }, out int) {
	json_skip_ws(s, ref pos, len)
	var int i = pos
	if i >= len {
		return -1
	}
	if (s.at(i) as int) == 125 {
		pos = i + 1
		return -1
	}
	json_skip_ws(s, ref pos, len)
	var int key = json_parse_string(s, ref pos, len, ref tree)
	json_skip_ws(s, ref pos, len)
	var int i2 = pos
	if i2 < len {
		if (s.at(i2) as int) == 58 {
			pos = i2 + 1
		}
	}
	var int v = json_parse_value(s, ref pos, len, ref tree)
	tree.set_val(key, v)
	json_skip_ws(s, ref pos, len)
	var int i3 = pos
	if i3 < len {
		if (s.at(i3) as int) == 44 {
			pos = i3 + 1
		}
	}
	tree.set_next(key, json_parse_pairs(s, ref pos, len, ref tree))
	return key
}

func json_ser_list = (ref JsonTree tree { nodes }, int first, ref StringBuilder sb {}) {
	json_ser_value(ref tree, first, ref sb)
	var int next = tree.get_next(first)
	if next >= 0 {
		sb.append_char(',')
		json_ser_list(ref tree, next, ref sb)
	}
}

func json_ser_pairs = (ref JsonTree tree { nodes }, int first, ref StringBuilder sb {}) {
	sb.append_char('"')
	sb.append_string_view(tree.get_text_view(first))
	sb.append_string("\":")
	var int v = tree.get_val(first)
	if v < 0 {
		sb.append_string("null")
	} else {
		json_ser_value(ref tree, v, ref sb)
	}
	var int next = tree.get_next(first)
	if next >= 0 {
		sb.append_char(',')
		json_ser_pairs(ref tree, next, ref sb)
	}
}

func json_ser_value = (ref JsonTree tree { nodes }, int n, ref StringBuilder sb {}) {
	var int k = tree.get_kind(n)
	if k == 0 {
		sb.append_string("null")
		return
	}
	if k == 1 {
		sb.append_string("true")
		return
	}
	if k == 6 {
		sb.append_string("false")
		return
	}
	if k == 2 {
		sb.append_string_view(tree.get_text_view(n))
		return
	}
	if k == 3 {
		sb.append_char('"')
		sb.append_string_view(tree.get_text_view(n))
		sb.append_char('"')
		return
	}
	if k == 4 {
		sb.append_char('[')
		var int child = tree.get_child(n)
		if child >= 0 {
			json_ser_list(ref tree, child, ref sb)
		}
		sb.append_char(']')
		return
	}
	sb.append_char('{')
	var int child = tree.get_child(n)
	if child >= 0 {
		json_ser_pairs(ref tree, child, ref sb)
	}
	sb.append_char('}')
}

// ===========================================================================
// Compile-time serde: decode straight into a typed struct, and encode one
// back out. The per-field dispatch is generated by `#for` reflection at
// compile time (docs/COMPTIME.md stages 2-3): no DOM, no tree walk,
// no runtime key->field map — just the per-field stores a hand-written
// decoder would emit, keyed by `@rename` when present and omitted by
// `@skip`. Supports string / int / float / bool, nested value structs, and
// `StableList<T>` containers of any supported element (recursively, via
// `field.type` + the `META.name(T)` / `META.is_struct(T)` /
// `META.is_container(T)` comptime predicates).
// ===========================================================================

/**
 * Decode the JSON object `text` into the struct `target`, field by field. A key matches a
 * field's name, or its `@rename("…")` value; `@skip` fields are ignored. Missing keys leave
 * the field as it was and unknown keys are skipped. Supports string, int, float and bool
 * fields, nested structs and `StableList<T>` arrays of those.
 *
 * Decoding into the same value again refills it in place, reusing list storage.
 **/
// Repeated decodes into the same value REPLACE list content (the array is
// truncated to the new length, its storage retained — the pool reuse that makes a
// decode cycle allocation-free) and re-fill struct fields in place.
pub func json_decode_into<T> = (string text, ref T target) {
	var int pos = 0
	json_decode_object_into(text, ref pos, text.length, ref target)
}

/**
 * Encode the struct `value` as a JSON object string. Keys are the field names, or their
 * `@rename("…")` values; `@skip` fields are left out. Supports the same field types as
 * `json_decode_into`.
 **/
// `value` is BORROWED (`ref`): the walk reads fields and element slots in place, so
// encoding a reused value (a decode-refill loop) moves no container — the mirror of
// `stringify`'s `ref JsonTree`.
pub func json_encode<T> = (ref T value, out string) {
	var sb = StringBuilder()
	json_encode_element(ref value, ref sb)
	return sb.to_string()
}

// -- decode -----------------------------------------------------------------

// Decode a JSON OBJECT into `target`. Scalar/string stores go through
// `field.set` (an owned value assigned through a `ref` parameter LEAKS —
// see FOLLOWUP); struct and container fields recurse by `ref`. Reached
// with plain-struct T only.
func json_decode_object_into<T> = (string s, ref int pos, int len, ref T target) {
	var int open = pos
	json_skip_ws(s, ref pos, len)
	open = pos
	if open >= len {
		return
	}
	if (s.at(open) as int) != 123 {
		return
	}
	pos = open + 1
	while true {
		json_skip_ws(s, ref pos, len)
		var int i = pos
		if i >= len {
			return
		}
		var int c = s.at(i) as int
		if c == 125 {
			pos = i + 1
			return
		}
		if c == 44 {
			pos = i + 1
			continue
		}
		var key = json_read_key_span(s, ref pos, len)
		json_skip_ws(s, ref pos, len)
		pos = pos + 1
		json_skip_ws(s, ref pos, len)
		var bool matched = false
		#for field of META.info(T).fields {
			var bool skip_field = false
			if field.has_attr("skip") {
				skip_field = true
			}
			var bool hit = false
			if field.has_attr("rename") {
				hit = json_key_eq(s, key.start, key.end, field.attr("rename"))
			} else {
				hit = json_key_eq(s, key.start, key.end, field.name)
			}
			if hit && !skip_field {
				matched = true
				if field.type.name == "string" {
					field.set(target, json_read_string_value(s, ref pos, len))
				}
				if field.type.name == "int" {
					field.set(target, json_read_int(s, ref pos, len))
				}
				if field.type.name == "float" {
					field.set(target, json_read_float(s, ref pos, len))
				}
				if field.type.name == "bool" {
					field.set(target, json_read_bool(s, ref pos, len))
				}
				if field.type.name == "StableList" {
					json_decode_list_into(s, ref pos, len, ref field.get(target))
				}
				if field.is_struct {
					json_decode_object_into(s, ref pos, len, ref field.get(target))
				}
			}
		}
		if !matched {
			json_skip_value(s, ref pos, len)
		}
	}
}

// Decode a JSON array into `list`, one element at a time — as a REFILL:
// the list is truncated to the decoded length (StableList.truncate keeps
// the slabs), existing element slots are reused — scalars re-stored via
// `set`, containers/structs decoded IN PLACE through an element borrow
// (`ref elem = list.at(idx)`, which recursively resets/refills the slot's
// own storage) — and elements beyond the current length decode into a
// fresh local and push. This is the typed form of the JsonTree pool: a
// repeated decode into the same value (the bench's per-iteration cycle)
// refills the container storage instead of re-allocating a fresh chunk-0
// slab per nested array. Assigning an owned value through a `ref`
// parameter leaks, so fresh elements still decode into a LOCAL.
func json_decode_list_into<E> = (string s, ref int pos, int len, ref StableList<E> list) {
	json_skip_ws(s, ref pos, len)
	var int open = pos
	if open >= len {
		return
	}
	if (s.at(open) as int) != 91 {
		return
	}
	pos = open + 1
	var int idx = 0
	while true {
		json_skip_ws(s, ref pos, len)
		var int i = pos
		if i >= len {
			list.truncate(idx)
			return
		}
		var int c = s.at(i) as int
		if c == 93 {
			pos = i + 1
			list.truncate(idx)
			return
		}
		if c == 44 {
			pos = i + 1
			continue
		}
		if idx < list.length {
			// REFILL the slot at idx — the comptime dispatch folds to one
			// arm per specialization, exactly like the fresh arms below.
			if META.name(E) == "string" {
				list.set(idx, json_read_string_value(s, ref pos, len))
			}
			if META.name(E) == "int" {
				list.set(idx, json_read_int(s, ref pos, len))
			}
			if META.name(E) == "float" {
				list.set(idx, json_read_float(s, ref pos, len))
			}
			if META.name(E) == "bool" {
				list.set(idx, json_read_bool(s, ref pos, len))
			}
			if META.is_container(E) {
				ref elem = list.at(idx)
				json_decode_list_into(s, ref pos, len, ref elem)
			}
			if META.is_struct(E) {
				ref elem = list.at(idx)
				json_decode_object_into(s, ref pos, len, ref elem)
			}
		} else {
			var item = E()
			if META.name(E) == "string" {
				item = json_read_string_value(s, ref pos, len)
			}
			if META.name(E) == "int" {
				item = json_read_int(s, ref pos, len)
			}
			if META.name(E) == "float" {
				item = json_read_float(s, ref pos, len)
			}
			if META.name(E) == "bool" {
				item = json_read_bool(s, ref pos, len)
			}
			if META.is_container(E) {
				json_decode_list_into(s, ref pos, len, ref item)
			}
			if META.is_struct(E) {
				json_decode_object_into(s, ref pos, len, ref item)
			}
			if META.is_struct(E) {
				list.push(mv item)
			}
			if META.is_container(E) {
				list.push(mv item)
			}
			if META.name(E) == "string" {
				list.push(mv item)
			}
			if META.name(E) == "int" {
				list.push(item)
			}
			if META.name(E) == "float" {
				list.push(item)
			}
			if META.name(E) == "bool" {
				list.push(item)
			}
		}
		idx += 1
	}
}

// A key's span in the source, so keys compare byte-for-byte without
// materializing a string (the decoder's hot path).
mv struct JsonKeySpan {
	var start = 0
	var end = 0
}

// Scan the quoted key at the cursor, returning its INNER span. Escapes are
// kept raw: comparisons against plain names are exact for unescaped keys.
func json_read_key_span = (string s, ref int pos, int len, out JsonKeySpan) {
	var span = JsonKeySpan()
	var int i = pos
	i += 1
	span.start = i
	while i < len; i += 1 {
		var int code = s.at(i) as int
		if code == 92 {
			i += 1
			continue
		}
		if code == 34 {
			span.end = i
			pos = i + 1
			return span
		}
	}
	span.end = i
	pos = i
	return span
}

func json_key_eq = (string s, int start, int end, string expected, out bool) {
	if end - start != expected.length {
		return false
	}
	var int i = start
	while i < end; i += 1 {
		if (s.at(i) as int) != (expected.at(i - start) as int) {
			return false
		}
	}
	return true
}

func json_read_quoted = (string s, ref int pos, int len, out string) {
	var int i = pos
	var sb = StringBuilder()
	sb.append_char('"')
	i += 1
	while i < len; i += 1 {
		var char c = s.at(i)
		var int code = c as int
		sb.append_char(c)
		if code == 92 {
			i += 1
			if i < len {
				sb.append_char(s.at(i))
			}
			continue
		}
		if code == 34 {
			i += 1
			break
		}
	}
	pos = i
	return sb.to_string()
}

func json_read_string_value = (string s, ref int pos, int len, out string) {
	var quoted = json_read_quoted(s, ref pos, len)
	return Json.deserialize(quoted)
}

// Append `"` + `value` + `"` into `sb` in place — the encode-path form of
// `sb.append_string(Json.serialize(value))` with no temp StringBuilder, no
// `to_string` copy, and no per-call free. The fast path scans for the five
// escape-requiring codes first; when the value has none (keys and the vast
// majority of values), the whole literal lands as a bare memcpy between two
// quote chars — no per-character dispatch, no allocation. The slow path is
// `serialize`'s switch, appended straight into `sb`.
func json_append_quoted = (ref StringBuilder sb {}, string value) {
	var int len = value.length
	var int i = 0
	var bool plain = true
	while i < len; i += 1 {
		var int code = value.at(i) as int
		if code == 34 || code == 92 || code == 10 || code == 9 || code == 13 {
			plain = false
			break
		}
	}
	if plain {
		sb.append_char('"')
		sb.append_string(value)
		sb.append_char('"')
		return
	}
	sb.append_char('"')
	i = 0
	while i < len; i += 1 {
		var char c = value.at(i)
		var int code = c as int
		switch {
			case code == 34 {
				sb.append_string("\x5c\"")
			}
			case code == 92 {
				sb.append_string("\x5c\x5c")
			}
			case code == 10 {
				sb.append_string("\x5cn")
			}
			case code == 9 {
				sb.append_string("\x5ct")
			}
			case code == 13 {
				sb.append_string("\x5cr")
			}
			case _ {
			sb.append_char(c)
		}
		}
	}
	sb.append_char('"')
}

func json_read_int = (string s, ref int pos, int len, out int) {
	var int i = pos
	var int sign = 1
	if (s.at(i) as int) == 45 {
		sign = -1
		i += 1
	}
	var int value = 0
	while i < len; i += 1 {
		var int code = s.at(i) as int
		if code < 48 {
			break
		}
		if code > 57 {
			break
		}
		value = value * 10 + (code - 48)
	}
	pos = i
	return sign * value
}

func json_read_float = (string s, ref int pos, int len, out float) {
	var int i = pos
	var float sign = 1.0
	if (s.at(i) as int) == 45 {
		sign = -1.0
		i += 1
	}
	var float value = 0.0
	while i < len; i += 1 {
		var int code = s.at(i) as int
		if code < 48 {
			break
		}
		if code > 57 {
			break
		}
		value = value * 10.0 + ((code - 48) as float)
	}
	if i < len {
		if (s.at(i) as int) == 46 {
			i += 1
			var float scale = 0.1
			while i < len; i += 1 {
				var int code = s.at(i) as int
				if code < 48 {
					break
				}
				if code > 57 {
					break
				}
				value = value + ((code - 48) as float) * scale
				scale = scale / 10.0
			}
		}
	}
	pos = i
	return sign * value
}

func json_read_bool = (string s, ref int pos, int len, out bool) {
	var int i = pos
	if i < len {
		if (s.at(i) as int) == 116 {
			pos = i + 4
			return true
		}
	}
	if i + 4 < len {
		pos = i + 5
	}
	return false
}

// Skip one JSON value (unknown keys): strings to the closing quote,
// objects/arrays by depth, everything else to a delimiter.
func json_skip_value = (string s, ref int pos, int len) {
	json_skip_ws(s, ref pos, len)
	var int i = pos
	if i >= len {
		return
	}
	var int code = s.at(i) as int
	if code == 34 {
		i += 1
		while i < len; i += 1 {
			var int c = s.at(i) as int
			if c == 92 {
				i += 1
				continue
			}
			if c == 34 {
				i += 1
				break
			}
		}
		pos = i
		return
	}
	if code == 91 || code == 123 {
		var int depth = 0
		var in_string = false
		while i < len; i += 1 {
			var int c = s.at(i) as int
			if in_string {
				if c == 92 {
					i += 1
					continue
				}
				if c == 34 {
					in_string = false
				}
				continue
			}
			if c == 34 {
				in_string = true
				continue
			}
			if c == 91 || c == 123 {
				depth += 1
				continue
			}
			if c == 93 || c == 125 {
				depth -= 1
				if depth == 0 {
					i += 1
					break
				}
			}
		}
		pos = i
		return
	}
	while i < len; i += 1 {
		var int c = s.at(i) as int
		if c == 44 || c == 93 || c == 125 {
			break
		}
	}
	pos = i
}

// -- encode -----------------------------------------------------------------

// Encode one value of type T — the mirror of json_decode_value_into. The
// value is borrowed (`ref`) end to end: fields and element slots are read
// where they live.
func json_encode_element<T> = (ref T value, ref StringBuilder sb {}) {
	if META.name(T) == "string" {
		json_append_quoted(ref sb, value)
		return
	}
	if META.name(T) == "int" {
		sb.append_int(value)
		return
	}
	if META.name(T) == "float" {
		json_append_float(ref sb, value)
		return
	}
	if META.name(T) == "bool" {
		if value {
			sb.append_string("true")
		} else {
			sb.append_string("false")
		}
		return
	}
	if META.is_container(T) {
		json_encode_list(ref value, ref sb)
		return
	}
	if META.is_struct(T) {
		json_encode_into(ref value, ref sb)
	}
}

// Fixed 6-decimal float formatting without snprintf: integer math on the
// whole/fraction split (the serializer's hot path).
func json_append_float = (ref StringBuilder sb {}, float v) {
	var float f = v
	if f < 0.0 {
		sb.append_char('-')
		f = 0.0 - f
	}
	var int whole = f as int
	var float scaled = (f - (whole as float)) * 1000000.0 + 0.5
	var int frac = scaled as int
	if frac >= 1000000 {
		whole += 1
		frac = 0
	}
	sb.append_int(whole)
	sb.append_char('.')
	if frac < 100000 {
		sb.append_char('0')
	}
	if frac < 10000 {
		sb.append_char('0')
	}
	if frac < 1000 {
		sb.append_char('0')
	}
	if frac < 100 {
		sb.append_char('0')
	}
	if frac < 10 {
		sb.append_char('0')
	}
	sb.append_int(frac)
}

func json_encode_list<E> = (ref StableList<E> list, ref StringBuilder sb {}) {
	sb.append_char('[')
	var int i = 0
	while i < list.length; i += 1 {
		if i > 0 {
			sb.append_char(',')
		}
		// The element BORROW (`ref` binds the slot — no per-element deep
		// copy, no scope-exit destroy). The owning load (`var elem =
		// list.at(i)`) deep-copied every element and freed the copy at
		// the loop-body scope: for container elements that copy
		// materialized a full 256-slot chunk per element (Buffer has no
		// length, so `copy` clones `cap` slots). The borrow is read-only
		// — encode never mutates the source list — so the aliasing is
		// sound and the walk is zero-copy (strings included: the slot
		// store convention landed, so a `ref string` element borrow is
		// spelled like any other).
		ref elem = list.at(i)
		json_encode_element(ref elem, ref sb)
	}
	sb.append_char(']')
}

func json_encode_into<T> = (ref T value, ref StringBuilder sb {}) {
	sb.append_char('{')
	var bool first = true
	#for field of META.info(T).fields {
		var bool skip_field = false
		if field.has_attr("skip") {
			skip_field = true
		}
		if !skip_field {
			var string key = field.name
			if field.has_attr("rename") {
				key = field.attr("rename")
			}
			if !first {
				sb.append_char(',')
			}
			first = false
			// The key is a comptime string (the field's name or its
			// @rename value), but the escape check still runs per field:
			// `json_append_quoted`'s fast path appends it as a bare memcpy
			// between quotes when no escape is needed — the per-field
			// `Json.serialize(key)` this replaces allocated a temp
			// StringBuilder, a `to_string` copy, and its teardown on every
			// encoded object.
			json_append_quoted(ref sb, key)
			sb.append_char(':')
			json_encode_element(ref field.get(value), ref sb)
		}
	}
	sb.append_char('}')
}
