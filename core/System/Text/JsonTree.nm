// JsonTree: a flat pool of JSON tree nodes backed by a Buffer<JsonNode> slab.
// Each node is a value struct stored at index N in the buffer; grow_T/store_T/
// load_T handle the slab arithmetic. The caller creates a JsonTree once and
// calls reset() per document to reuse the slab without reallocation.
//
// set_text is the one exception to the load/store pattern: it calls strdup
// directly into the slab via raw code, because routing the strdup'd pointer
// through an Nomen local would subject it to auto-free at scope exit, leaving
// the slab's text pointer dangling.

// A node in a parsed JSON tree, stored by value in the pool.
//   kind: 0=null, 1=true, 2=number, 3=string, 4=array, 5=object, 6=false
//   child/next/val are node indices, -1 = none.
struct JsonNode {
	var kind = 0
	var text = ""
	var int child = -1
	var int next = -1
	var int val = -1
}

/**
 * A flat, buffer-backed pool of JSON tree nodes — the parsed representation `Json.parse` produces
 **/
pub struct JsonTree {
	var Buffer<JsonNode> nodes = Buffer<JsonNode>()
	var count = 0

	func alloc_node = (ref self, out int) {
		var int idx = self.count
		self.nodes.grow_T(idx + 1)
		self.count = idx + 1
		var default = JsonNode()
		self.nodes.store_T(idx, default)
		// store_T deep-copies the owning `text` field (strdup of the shared
		// empty-string literal) into the slot. JsonTree manages node texts
		// manually (set_text strdup's into the slab; free_text/release frees
		// them; NULL means "no text"), so the slot must start NULL — free the
		// strdup'd default and NULL it, or reset() would leak it. idx is x1.
		```
		#arch: c
		JsonNode *nodes = (JsonNode*)(unsigned long long)self->nodes.data;
		free(nodes[idx].text.ptr);
		nodes[idx].text.ptr = 0;
		nodes[idx].text.len = 0;
		```
		```
		#arch: aarch64
		// x19 = self. count is at self+32 and already equals idx+1 here, so
		// idx = count - 1. nodes.data at self+16, JsonNode size 56 (fat text),
		// text at +16 (ptr) / +24 (len).
		ldr x0, [x19, #16]
		ldr x1, [x19, #32]
		sub x1, x1, #1
		mov x3, #56
		madd x1, x1, x3, xzr
		add x0, x0, x1
		add x0, x0, #16
		ldr x1, [x0]
		str xzr, [x0]
		str xzr, [x0, #8]
		cbz x1, .Lalloc_node_text_skip
		mov x0, x1
		bl _free
		.Lalloc_node_text_skip:
		```
		return idx
	}

	// Free a node's strdup'd text pointer (set_text writes a heap pointer via
	// raw strdup; this mirrors it). idx is x1, following set_text's layout.
	func free_text = (ref self, int idx) {
		```
		#arch: c
		JsonNode *nodes = (JsonNode*)(unsigned long long)self->nodes.data;
		if (nodes[idx].text.ptr) { free(nodes[idx].text.ptr); nodes[idx].text.ptr = 0; nodes[idx].text.len = 0; }
		```
		```
		#arch: aarch64
		// x19 = self, x1 = idx. Compute &nodes[idx].text (JsonNode size 56).
		ldr x0, [x19, #16]
		mov x3, #56
		madd x1, x1, x3, xzr
		add x0, x0, x1
		add x0, x0, #16
		ldr x2, [x0]
		cbz x2, .Ljsontree_free_text_skip
		str x0, [sp, #-16]!
		mov x0, x2
		bl _free
		ldr x0, [sp], #16
		str xzr, [x0]
		str xzr, [x0, #8]
		.Ljsontree_free_text_skip:
		```
	}

	// Free every strdup'd text pointer before reusing the slab, otherwise
	// re-parsing a document leaks the previous document's string/number texts.
	func reset = (ref self) {
		var i = 0
		while i < self.count; i += 1 {
			self.free_text(i)
		}
		self.count = 0
	}

	// Runs when the tree instance is destroyed (before its `nodes` buffer field
	// is freed): release the current document's strdup'd node texts, which live
	// raw in the slab and are otherwise invisible to the auto-destroy pass.
	func #destroy = () {
		var i = 0
		while i < self.count; i += 1 {
			self.free_text(i)
		}
		self.count = 0
	}

	// strdup directly into the slab — see file header for why this can't
	// go through load_T/store_T. (Under the fat-string ABI the C body is
	// emitted behind the _raw_ adapter, so `text` arrives as a thin char*;
	// aarch64 receives the pair x2 = ptr, x3 = len.)
	func set_text = (ref self, int idx, string text) {
		```
		#arch: c
		JsonNode *nodes = (JsonNode*)(unsigned long long)self->nodes.data;
		nodes[idx].text.ptr = strdup(text);
		nodes[idx].text.len = (long)strlen(text);
		```
		```
		#arch: aarch64
		// x19 = self, x1 = idx, x2 = text.ptr, x3 = text.len
		// nodes.data is at self+16 (JsonTree.vt[0] + Buffer.vt[8])
		// text field is at offset 16 in JsonNode (vt[0] + kind[8]); the fat
		// field is ptr@+16, len@+24; sizeof(JsonNode) = 56.
		sub sp, sp, #32
		str x1, [sp, #0]
		str x3, [sp, #8]
		mov x0, x2
		bl _strdup
		str x0, [sp, #16]
		ldr x0, [x19, #16]
		ldr x1, [sp, #0]
		mov x3, #56
		madd x1, x1, x3, xzr
		add x0, x0, x1
		add x0, x0, #16
		ldr x1, [sp, #16]
		str x1, [x0]
		ldr x1, [sp, #8]
		str x1, [x0, #8]
		add sp, sp, #32
		```
	}

	func set_kind = (ref self, int idx, int val) {
		var JsonNode n = self.nodes.load_T(idx)
		n.kind = val
		self.nodes.store_T(idx, n)
	}

	func set_child = (ref self, int idx, int val) {
		var JsonNode n = self.nodes.load_T(idx)
		n.child = val
		self.nodes.store_T(idx, n)
	}

	func set_next = (ref self, int idx, int val) {
		var JsonNode n = self.nodes.load_T(idx)
		n.next = val
		self.nodes.store_T(idx, n)
	}

	func set_val = (ref self, int idx, int val) {
		var JsonNode n = self.nodes.load_T(idx)
		n.val = val
		self.nodes.store_T(idx, n)
	}

	func get_kind = (self, int idx, out int) {
		var JsonNode n = self.nodes.load_T(idx)
		return n.kind
	}

	func get_text = (self, int idx, out string) {
		var JsonNode n = self.nodes.load_T(idx)
		return n.text
	}

	func get_child = (self, int idx, out int) {
		var JsonNode n = self.nodes.load_T(idx)
		return n.child
	}

	func get_next = (self, int idx, out int) {
		var JsonNode n = self.nodes.load_T(idx)
		return n.next
	}

	func get_val = (self, int idx, out int) {
		var JsonNode n = self.nodes.load_T(idx)
		return n.val
	}
}
