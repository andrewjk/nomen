// JsonTree: a flat pool of JSON tree nodes backed by a StableList<JsonNode>.
// Each node is a value struct appended to the list; node indices are list
// indices, and list slots never move. The caller creates a JsonTree once and
// calls reset() per document. The pool owns its node texts end to end —
// set_text/take_text's interior field write frees the displaced text and the
// list's own destroy reclaims every node — so there is no manual text
// lifecycle. (The pre-StableList version kept a raw Buffer slab with a
// hand-encoded element layout and a strdup/free dance; see the stable grow-only
// arrays".)
//
// Accessors read and write through the slot alias (`ref JsonNode n =
// self.nodes.at(idx)`), the checked interior-mutation form: the alias binds
// the slot itself, so field writes land in the list and reads copy nothing.

// A node in a parsed JSON tree, stored by value in the pool.
//   kind: 0=null, 1=true, 2=number, 3=string, 4=array, 5=object, 6=false
//   child/next/val are node indices, -1 = none.
//
// `text` is nullable and seeds as `null` (the in-band zero pair): the auto
// constructor stores no pointer for it, so a fresh node costs NO allocation
// — every parsed node used to pay a strdup-of-"" seed plus the free when
// take_text displaced it (or at destroy for kinds that never carry text).
// set_text/take_text install the owned value; until then the field holds
// null and every read (get_text/get_text_view) answers the empty string.
mv struct JsonNode {
	var kind = 0
	var string? text = null
	var int child = -1
	var int next = -1
	var int val = -1
}

/**
 * A flat, pool-backed set of JSON tree nodes — the parsed representation `Json.parse` produces
 **/
pub mv struct JsonTree {
	var nodes = StableList<JsonNode>()

	// Append a fresh node and return its index.
	func alloc_node = (ref self { nodes }, out int) {
		self.nodes.push(JsonNode())
		return self.nodes.length - 1
	}

	// Drop the current document: the fresh StableList displaces the old one,
	// whose destroy frees every node (texts included) and its slabs. The
	// next parse starts from a clean pool.
	func reset = (ref self { nodes }) {
		self.nodes = StableList<JsonNode>()
	}

	// Install node `idx`'s text, TAKING ownership of the argument (the D3
	// mv convention): `set_text(n, mv s)` transfers the caller's buffer
	// into the pool with no copy anywhere — the field store moves the pair
	// raw and the caller's variable is invalidated. (Pass `.copy()` for the
	// keep-the-original spelling: `set_text(n, s.copy())`.) The pool owns
	// its node texts end to end, so the transferred buffer is freed exactly
	// once, by the list's destroy or the next text store. For strings
	// produced by a StringBuilder, `take_text` installs the builder's
	// buffer with no copy at all.
	func set_text = (ref self {}, int idx, mv string text) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.text = mv text
	}

	// Install node `idx`'s text by TAKING the builder's buffer — the parse
	// path's zero-copy store. `to_string` is a take (the builder hands its
	// heap buffer over and resets), and a fresh-call RHS stores into the
	// field directly, so per parsed string/key the only allocation in the
	// whole node lifecycle is the builder's own buffer — the node's null
	// seed costs nothing and there is no copy malloc, no seed free, no
	// temp free. (A `mv string` parameter cannot do this: the string-arg
	// ownership convention makes mv string arguments caller-owned
	// borrows, forcing the callee-side copy this method exists to skip.)
	func take_text = (ref self {}, int idx, ref StringBuilder sb {}) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.text = sb.to_string()
	}

	func set_kind = (ref self {}, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.kind = val
	}

	func set_child = (ref self {}, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.child = val
	}

	func set_next = (ref self {}, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.next = val
	}

	func set_val = (ref self {}, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.val = val
	}

	func get_kind = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.kind
	}

	func get_text = (self, int idx, out string) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		// The aarch64 `??` yields the left pair AS-IS (no dup), so the
		// coalesce spelling would return a borrow of the node's text — the
		// caller's free would take the pool's buffer. Spell the owned copy:
		// a null text answers a fresh "" and a non-null one takes
		// `.copy()` (the return contract — the caller owns the result —
		// is the `.copy()` shape the method always had).
		if n.text == null {
			return ""
		}
		return n.text.copy()
	}

	// A non-mv (ptr, len) view over node `idx`'s text — the zero-copy read.
	// The borrow roots at `self` and re-roots at the call-site receiver
	// (the `slice` convention), so it is invalidated by `reset()`/re-parse
	// like any pool borrow. Callers that immediately append, hash, or
	// inspect the text take this instead of paying `get_text`'s per-read
	// copy allocation. A node that never had text installed views the
	// empty string (a rodata-rooted empty borrow).
	func get_text_view = (self, int idx, out view string) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		if n.text == null {
			return "".slice(0, 0)
		}
		return n.text.slice(0, n.text.length)
	}

	func get_child = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.child
	}

	func get_next = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.next
	}

	func get_val = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.val
	}
}
