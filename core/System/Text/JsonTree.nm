// JsonTree: a flat pool of JSON tree nodes backed by a StableList<JsonNode>.
// Each node is a value struct appended to the list; node indices are list
// indices, and list slots never move. The caller creates a JsonTree once and
// calls reset() per document. The pool owns its node texts end to end —
// set_text's interior field write frees the displaced text and the list's own
// destroy reclaims every node — so there is no manual text lifecycle. (The
// pre-StableList version kept a raw Buffer slab with a hand-encoded element
// layout and a strdup/free dance; see the stable grow-only
// arrays".)
//
// Accessors read and write through the slot alias (`ref JsonNode n =
// self.nodes.at(idx)`), the checked interior-mutation form: the alias binds
// the slot itself, so field writes land in the list and reads copy nothing.

// A node in a parsed JSON tree, stored by value in the pool.
//   kind: 0=null, 1=true, 2=number, 3=string, 4=array, 5=object, 6=false
//   child/next/val are node indices, -1 = none.
mv struct JsonNode {
	var kind = 0
	var text = ""
	var int child = -1
	var int next = -1
	var int val = -1
}

/**
 * A flat, pool-backed set of JSON tree nodes — the parsed representation `Json.parse` produces
 **/
pub mv struct JsonTree {
	var nodes = StableList<JsonNode>()

	// Append a fresh node and return its index.
	func alloc_node = (ref self, out int) {
		self.nodes.push(JsonNode())
		return self.nodes.length - 1
	}

	// Drop the current document: the fresh StableList displaces the old one,
	// whose destroy frees every node (texts included) and its slabs. The
	// next parse starts from a clean pool.
	func reset = (ref self) {
		self.nodes = StableList<JsonNode>()
	}

	func set_text = (ref self, int idx, string text) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.text = text.copy()
	}

	func set_kind = (ref self, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.kind = val
	}

	func set_child = (ref self, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.child = val
	}

	func set_next = (ref self, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.next = val
	}

	func set_val = (ref self, int idx, int val) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		n.val = val
	}

	func get_kind = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.kind
	}

	func get_text = (self, int idx, out string) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.text.copy()
	}

	func get_child = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.child
	}

	func get_next = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.next
	}

	func get_val = (self, int idx, out int) {
		if idx < 0 || idx >= self.nodes.length {
			panic("index out of range")
		}
		ref JsonNode n = self.nodes.at(idx)
		return n.val
	}
}
