// Hexadecimal (base16, RFC 4648 section 8) encoding of byte strings, in
// pure Nomen. Strings are byte arrays, so any string — including a raw
// digest from Crypto::Sha256 — can be encoded.

/**
 * Hex (base16) encoding of bytes — lowercase `encode`, case-insensitive `decode`
 *
 *	Console.write(Hex.encode("\xDE\xAD"))   // "dead"
 *	match Hex.decode("DEad") {
 *		case .ok(bytes) -> Console.write("\{bytes.length}")   // 2
 *		case .fail(e) -> Console.write("bad hex")
 *	}
 **/
pub struct Hex {
	// Encode each byte of data as two lowercase hex digits.
	pub func encode = (view string data, mv out string) {
		var sb = StringBuilder()
		const len = data.length
		var i = 0
		while i < len; i += 1 {
			const b = data.char_code_at(i)
			sb.append_char(hex_digit(b >> 4))
			sb.append_char(hex_digit(b & 0x0F))
		}
		return sb.to_string()
	}

	// Decode pairs of hex digits (either case) back into bytes.
	pub func decode = (view string text, out string ! HexError) {
		const len = text.length
		if len % 2 != 0 {
			return .invalid_length
		}
		var sb = StringBuilder()
		var i = 0
		while i < len; i += 2 {
			const hi = hex_value(text.char_code_at_or(i, 0))
			if hi < 0 {
				return .invalid_character(i)
			}
			const lo = hex_value(text.char_code_at_or(i + 1, 0))
			if lo < 0 {
				return .invalid_character(i + 1)
			}
			sb.append_char(((hi << 4) | lo) as char)
		}
		return sb.to_string()
	}
}

// The lowercase hex digit for a nibble (0-15).
func hex_digit = (int nibble, out char) {
	if nibble < 10 {
		return (48 + nibble) as char
	}
	return (87 + nibble) as char
}

// The value of a hex digit byte, or -1 when it is not one.
func hex_value = (int code, out int) {
	switch {
		case code >= 48 && code <= 57 {
			return code - 48
		}
		case code >= 97 && code <= 102 {
			return code - 87
		}
		case code >= 65 && code <= 70 {
			return code - 55
		}
	}
	return -1
}
