pub struct Array<T> {
    pub const int length

    pub func #init = (...T items) {
        ```
        #arch: c
        self->length = _items_len;
        T* data = (T*)((char*)self + sizeof(*self));
        for (int i = 0; i < _items_len; i++) data[i] = items[i];
        ```
        ```
        #arch: aarch64
        // x19 = self (struct pointer), variadic items packed at call site
        // _items_len at [x29, #0], items ptr at [x29, #8]

        // Store length
        ldr x0, [x29, #0]
        str x0, [x19, #8]

        // Copy items: memcpy(self + 16, items, len * T_SIZE)
        ldr x2, [x29, #0]
        mov x3, #T_SIZE
        mul x2, x2, x3
        add x0, x19, #16
        ldr x1, [x29, #8]
        bl _memcpy
        ```
    }

    pub func at = (self, int index: index >= 0 && index < self.length, out T) {
        ```
        #arch: c
        return ((T*)&self)[index];
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x1 = index
        mov x2, #T_SIZE
        mul x1, x1, x2
        ldr x0, [x19, x1]
        ```
    }

    pub func at_end = (self, out T) {
        ```
        #arch: c
        return ((T*)&self)[self.length - 1];
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), length at [x19 - 8]
        ldr x0, [x19, #-8]
        sub x0, x0, #1
        mov x1, #T_SIZE
        mul x0, x0, x1
        ldr x0, [x19, x0]
        ```
    }

    pub func with_length = (self, int length: length >= 0, out Array) {
        ```
        #arch: c
        T result[length];
        int copy = self.length < length ? self.length : length;
        memcpy(result, &self, copy * sizeof(T));
        if (length > self.length) {
            memset(result + self.length, 0, (length - self.length) * sizeof(T));
        }
        return result;
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x1 = new length, x8 = return buf (first elem)
        // Save new length and return buf
        stp x1, x8, [sp, #-16]!

        // Determine copy count: min(self.length, new_length)
        ldr x2, [x19, #-8]
        cmp x2, x1
        csel x2, x2, x1, lt

        // Save copy count
        str x2, [sp, #16]

        // copy_bytes = copy_count * T_SIZE
        mov x3, #T_SIZE
        mul x2, x2, x3

        // memcpy(return_buf, self, copy_bytes)
        ldr x0, [sp, #8]
        mov x1, x19
        bl _memcpy

        // Zero-fill if extending
        ldr x4, [x19, #-8]
        ldr x5, [sp]
        cmp x5, x4
        ble .Larray_with_length_end

        // fill_bytes = (new_len - old_len) * T_SIZE
        sub x5, x5, x4
        mov x6, #T_SIZE
        mul x2, x5, x6

        // offset = copy_count * T_SIZE (reload since memcpy clobbered)
        ldr x4, [sp, #16]
        mul x3, x4, x6

        // memset(return_buf + offset, 0, fill_bytes)
        ldr x0, [sp, #8]
        add x0, x0, x3
        mov x1, #0
        bl _memset

        .Larray_with_length_end:
        add sp, sp, #16
        ```
    }

    pub func add = (self, Array other, out Array) {
        ```
        #arch: c
        T result[self.length + other->length];
        memcpy(result, &self, self.length * sizeof(T));
        memcpy(&result[self.length], other, other->length * sizeof(T));
        return result;
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x20 = other (first elem), x8 = return buf (first elem)
        // Length prefix is at [base - 8]

        // Save return buffer (clobbered by _memcpy)
        str x8, [sp, #-16]!

        // Load lengths and store result length
        ldr x2, [x19, #-8]
        ldr x3, [x20, #-8]
        add x4, x2, x3
        ldr x8, [sp]
        str x4, [x8, #-8]

        // self_bytes = self_len * T_SIZE
        mov x5, #T_SIZE
        mul x5, x2, x5

        // memcpy(return_buf, self, self_bytes)
        mov x0, x8
        mov x1, x19
        mov x2, x5
        bl _memcpy

        // Reload return buf and self_len (clobbered by memcpy)
        ldr x8, [sp]
        ldr x2, [x19, #-8]
        mov x5, #T_SIZE
        mul x5, x2, x5

        // other_bytes
        ldr x3, [x20, #-8]
        mov x6, #T_SIZE
        mul x6, x3, x6

        // memcpy(return_buf + self_bytes, other, other_bytes)
        add x0, x8, x5
        mov x1, x20
        mov x2, x6
        bl _memcpy

        add sp, sp, #16
        ```
    }

    pub func mul = (self, int other, out Array) {
        ```
        #arch: c
        T result[self.length * other];
        memcpy(result, &self, self.length * sizeof(T));
        for (int i = 1; i < other; i++) {
            memcpy(&result[self.length * i], &self, self.length * sizeof(T));
        }
        return result;
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x1 = multiplier, x8 = return buf (first elem)

        // Save return buf and multiplier
        stp x8, x1, [sp, #-16]!

        // self_len and self_bytes
        ldr x2, [x19, #-8]
        mov x5, #T_SIZE
        mul x5, x2, x5

        // result_len = self_len * multiplier
        mul x3, x2, x1
        ldr x8, [sp]
        str x3, [x8, #-8]

        // Loop: copy self to result multiplier times
        mov x4, #0

        .Larray_mul_loop:
        ldr x1, [sp, #8]
        cmp x4, x1
        b.ge .Larray_mul_end

        // dest = return_buf + x4 * self_bytes
        ldr x8, [sp]
        mul x6, x4, x5
        add x0, x8, x6

        // memcpy(dest, self, self_bytes)
        mov x1, x19
        mov x2, x5
        bl _memcpy

        add x4, x4, #1
        b .Larray_mul_loop

        .Larray_mul_end:
        add sp, sp, #16
        ```
    }
}
