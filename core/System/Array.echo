pub struct Array<T> {
    pub const int length

    pub func #init = (...T items) {
        ```
        #arch: c
        self->length = _items_len;
        T* data = (T*)((char*)self + sizeof(*self));
        for (int i = 0; i < _items_len; i++) data[i] = items[i];
        ```
        ```
        #arch: aarch64
        // x19 = self (struct pointer), variadic items packed at call site
        // _items_len at [x29, #0], items ptr at [x29, #8]

        // Store length
        ldr x0, [x29, #0]
        str x0, [x19, #8]

        // Copy items: memcpy(self + 16, items, len * T_SIZE)
        ldr x2, [x29, #0]
        mov x3, #T_SIZE
        mul x2, x2, x3
        add x0, x19, #16
        ldr x1, [x29, #8]
        bl _memcpy
        ```
    }

    pub func at = (self, int index: index >= 0 && index < self.length, out T) {
        ```
        #arch: c
        T* _data = (T*)((char*)self + sizeof(*self));
        return _data[index];
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x1 = index
        mov x2, #T_SIZE
        mul x1, x1, x2
        ldr x0, [x19, x1]
        ```
    }

    pub func first = (self: self.length > 0, out T) {
        ```
        #arch: c
        T* _data = (T*)((char*)self + sizeof(*self));
        return _data[0];
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem)
        ldr x0, [x19]
        ```
    }

    pub func set = (ref self, int index: index >= 0 && index < self.length, T value) {
        ```
        #arch: c
        T* _data = (T*)((char*)self + sizeof(*self));
        _data[index] = value;
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x1 = index, x2 = value
        mov x3, #T_SIZE
        mul x1, x1, x3
        str x2, [x19, x1]
        ```
    }

    pub func at_end = (self, out T) {
        ```
        #arch: c
        T* _data = (T*)((char*)self + sizeof(*self));
        return _data[self->length - 1];
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), length at [x19 - 8]
        ldr x0, [x19, #-8]
        sub x0, x0, #1
        mov x1, #T_SIZE
        mul x0, x0, x1
        ldr x0, [x19, x0]
        ```
    }

    pub func with = (T value, int count: count >= 0, out Array<T>) {
        ```
        #arch: c
        long _header = 16;
        void* _result = malloc(_header + count * T_SIZE);
        ((long*)_result)[1] = count;
        T* _data = (T*)((char*)_result + _header);
        for (long i = 0; i < count; i++) {
            _data[i] = value;
        }
        return _result;
        ```
        ```
        #arch: aarch64
        // x0 = value (first elem or scalar), x1 = count, x8 = return buf (first elem)
        // Save count and return buf
        stp x1, x8, [sp, #-16]!

        // If count is 0, skip to end
        cbz x1, .Larray_with_end

        // For struct types, we need to copy T_SIZE bytes per element
        // For simple types, we store the value directly
        mov x2, #0              // i = 0

        .Larray_with_loop:
        // Store value at return_buf[i]
        mov x3, #T_SIZE
        mul x4, x2, x3          // offset = i * T_SIZE
        add x5, x8, x4          // addr = return_buf + offset

        // Copy T_SIZE bytes from value to addr
        // For simple types (T_SIZE <= 8), we can use a single store
        cmp x3, #8
        b.gt .Larray_with_copy_loop

        // Simple type: single store
        str x0, [x5]
        b .Larray_with_next

        .Larray_with_copy_loop:
        // Complex type: copy byte by byte
        mov x6, #0              // j = 0
        .Larray_with_byte:
        ldrb w7, [x0, x6]
        strb w7, [x5, x6]
        add x6, x6, #1
        cmp x6, x3
        blt .Larray_with_byte

        .Larray_with_next:
        add x2, x2, #1
        ldr x1, [sp]
        cmp x2, x1
        blt .Larray_with_loop

        .Larray_with_end:
        add sp, sp, #16
        ```
    }

    pub func add = (self, Array other, out Array) {
        ```
        #arch: c
        typeof(*self) _result;
        _result.length = _self.length + other->length;
        T* self_data = (T*)(self + 1);
        T* other_data = (T*)(other + 1);
        return _result;
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x20 = other (first elem), x8 = return buf (first elem)
        // Length prefix is at [base - 8]

        // Save return buffer (clobbered by _memcpy)
        str x8, [sp, #-16]!

        // Load lengths and store result length
        ldr x2, [x19, #-8]
        ldr x3, [x20, #-8]
        add x4, x2, x3
        ldr x8, [sp]
        str x4, [x8, #-8]

        // self_bytes = self_len * T_SIZE
        mov x5, #T_SIZE
        mul x5, x2, x5

        // memcpy(return_buf, self, self_bytes)
        mov x0, x8
        mov x1, x19
        mov x2, x5
        bl _memcpy

        // Reload return buf and self_len (clobbered by memcpy)
        ldr x8, [sp]
        ldr x2, [x19, #-8]
        mov x5, #T_SIZE
        mul x5, x2, x5

        // other_bytes
        ldr x3, [x20, #-8]
        mov x6, #T_SIZE
        mul x6, x3, x6

        // memcpy(return_buf + self_bytes, other, other_bytes)
        add x0, x8, x5
        mov x1, x20
        mov x2, x6
        bl _memcpy

        add sp, sp, #16
        ```
    }

    pub func mul = (self, int other, out Array) {
        ```
        #arch: c
        typeof(*self) _result;
        _result.length = _self.length * other;
        return _result;
        ```
        ```
        #arch: aarch64
        // x19 = self (first elem), x1 = multiplier, x8 = return buf (first elem)

        // Save return buf and multiplier
        stp x8, x1, [sp, #-16]!

        // self_len and self_bytes
        ldr x2, [x19, #-8]
        mov x5, #T_SIZE
        mul x5, x2, x5

        // result_len = self_len * multiplier
        mul x3, x2, x1
        ldr x8, [sp]
        str x3, [x8, #-8]

        // Loop: copy self to result multiplier times
        mov x4, #0

        .Larray_mul_loop:
        ldr x1, [sp, #8]
        cmp x4, x1
        b.ge .Larray_mul_end

        // dest = return_buf + x4 * self_bytes
        ldr x8, [sp]
        mul x6, x4, x5
        add x0, x8, x6

        // memcpy(dest, self, self_bytes)
        mov x1, x19
        mov x2, x5
        bl _memcpy

        add x4, x4, #1
        b .Larray_mul_loop

        .Larray_mul_end:
        add sp, sp, #16
        ```
    }
}
