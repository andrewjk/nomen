const SAMPLE = `pub func main = () {
	Console.write_line("Hello, Nomen!")

	struct Point {
		var int x
		var int y
	}

	var Point p = Point(2, 3)
	Console.write_line("p = (\\{p.x}, \\{p.y})")

	for i of 1 .. 6 {
		Console.write_line("\\{i} squared is \\{i * i}")
	}
}
`;

const TIMEOUT_MS = 5_000;

interface ReplError {
	message: string;
	line: number;
	column: number;
}

/**
 * The Nomen REPL: compile on the server, run the emitted browser script in a
 * Worker (so a runaway loop can be terminated), and stream Console output.
 */
export default function ReplPage() {
	let $state = $watch({
		source: SAMPLE,
		output: "",
		errors: [] as ReplError[],
		warnings: [] as ReplError[],
		running: false,
	});

	let worker: Worker | undefined;
	let timer: ReturnType<typeof setTimeout> | undefined;

	function stop_worker() {
		if (timer) clearTimeout(timer);
		timer = undefined;
		worker?.terminate();
		worker = undefined;
	}

	function run() {
		if ($state.running) return;
		stop_worker();
		$state.running = true;
		$state.errors = [];
		$state.warnings = [];
		$state.output = "";

		void fetch("/api/compile", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify({ source: $state.source }),
		})
			.then((response) => response.json())
			.then((result) => {
				if (!result.ok) {
					$state.errors = result.errors ?? [
						{ message: "Compilation failed", line: 1, column: 1 },
					];
					return;
				}
				$state.warnings = result.warnings ?? [];
				execute(result.js);
			})
			.catch((error) => {
				$state.errors = [
					{ message: String(error?.message ?? error), line: 1, column: 1 },
				];
			})
			.finally(() => {
				$state.running = false;
			});
	}

	/** Run the compiled program in a classic Worker. The script is
	 *  self-contained (no imports) and reports output through
	 *  `globalThis.__nomen_write`. */
	function execute(js: string) {
		const program = `
self.__nomen_write = (text) => self.postMessage({ type: "out", text: String(text) });
try {
${js}
} catch (error) {
	const message = String(error && error.message ? error.message : error);
	if (!message.startsWith("__nomen_exit:")) {
		self.postMessage({ type: "error", message });
	}
}
self.postMessage({ type: "done" });
`;
		const url = URL.createObjectURL(new Blob([program], { type: "text/javascript" }));
		worker = new Worker(url);

		timer = setTimeout(() => {
			stop_worker();
			$state.errors = [
				{
					message: `Stopped after ${TIMEOUT_MS / 1000}s (infinite loop?)`,
					line: 1,
					column: 1,
				},
			];
		}, TIMEOUT_MS);

		worker.onmessage = (event: MessageEvent) => {
			const message = event.data;
			if (message?.type === "out") {
				$state.output += message.text;
			} else if (message?.type === "error") {
				$state.errors = [
					{ message: String(message.message), line: 1, column: 1 },
				];
			} else if (message?.type === "done") {
				stop_worker();
				URL.revokeObjectURL(url);
			}
		};
		worker.onerror = (event: ErrorEvent) => {
			$state.errors = [
				{ message: event.message || "The program crashed", line: 1, column: 1 },
			];
			stop_worker();
			URL.revokeObjectURL(url);
		};
	}

	function on_key_down(event: KeyboardEvent) {
		const enter = event.key === "Enter" && (event.metaKey || event.ctrlKey);
		if (enter) {
			event.preventDefault();
			run();
			return;
		}
		if (event.key === "Tab") {
			// Keep focus in the editor: indentation (Nomen uses tabs). The
			// insert/delete commands update the value and the caret while
			// staying on the undo stack, and fire `input` so `&value` syncs.
			event.preventDefault();
			const area = event.currentTarget as HTMLTextAreaElement;
			if (event.shiftKey) {
				const before = area.value.slice(0, area.selectionStart);
				if (before.endsWith("\t")) {
					area.selectionStart = area.selectionEnd = area.selectionStart - 1;
					document.execCommand("delete");
				}
			} else {
				document.execCommand("insertText", false, "\t");
			}
		}
	}

	@render {
		<main id="repl" onmount={() => run()}>
			<header id="repl-header">
				<h1>Nomen <span>REPL</span></h1>
				<p>
					Write a Nomen program and run it. The System library is
					imported automatically; output comes from <code>Console</code>.
				</p>
			</header>

			<div id="repl-columns">
				<section id="repl-input">
					<div class="pane-title">
						<h2>Program</h2>
						<button onclick={run} disabled={$state.running}>
							{$state.running ? "Running…" : "Run ⌘⏎"}
						</button>
					</div>
					<textarea
						spellcheck="false"
						autocomplete="off"
						&value={$state.source}
						onkeydown={on_key_down}
					/>
				</section>

				<section id="repl-output">
					<div class="pane-title">
						<h2>Output</h2>
					</div>
					<pre class="output">{$state.output}</pre>

					@if ($state.errors.length) {
						<div class="errors">
							<h3>Errors</h3>
							<ul>
								@for (let error of $state.errors) {
									<li>
										<span class="position">
											{error.line}:{error.column}
										</span>
										{error.message}
									</li>
								}
							</ul>
						</div>
					}

					@if ($state.warnings.length) {
						<div class="warnings">
							<h3>Warnings</h3>
							<ul>
								@for (let warning of $state.warnings) {
									<li>
										<span class="position">
											{warning.line}:{warning.column}
										</span>
										{warning.message}
									</li>
								}
							</ul>
						</div>
					}
				</section>
			</div>
		</main>
	}
}
