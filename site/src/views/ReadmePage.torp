import doc from "@/lib/docs/readme.generated";
import { TITLES } from "@/lib/titles.ts";

import DocPage from "./parts/DocPage.torp";

/** README.md, rendered at build time. */
export default function ReadmePage() {
	@head {
		<title>{TITLES.readme}</title>
	}

	@render {
		<DocPage current="readme" title="The Nomen Programming Language" doc={doc} />
	}
}
