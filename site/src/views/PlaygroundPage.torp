const SAMPLE = `struct Point {
	var int x
	var int y
}

pub func main = () {
	Console.write_line("Hello, Nomen!")

	const Point p = Point(2, 3)
	Console.write_line("p = (\\{p.x}, \\{p.y})")

	for i of 1 .. 6 {
		Console.write_line("\\{i} squared is \\{i * i}")
	}
}
`;

import { MAX_SHARE_OUTPUT, MAX_SHARE_SOURCE, preview_path, share_url } from "@/lib/share";

const TIMEOUT_MS = 5_000;

interface Diagnostic {
	message: string;
	line: number;
	column: number;
}

/**
 * The Nomen playground: compile on the server, run the emitted browser script
 * in a Worker (so a runaway loop can be terminated), and stream Console output.
 */
export default function PlaygroundPage($props?: { embed?: boolean; data?: { source?: string } }) {
	let $state = $watch({
		source: $props?.data?.source ?? SAMPLE,
		output: "",
		errors: [] as Diagnostic[],
		warnings: [] as Diagnostic[],
		running: false,
		view: "program" as "program" | "output",
		shared: false,
		runtime_error: "",
		highlighted: "",
		highlight_ready: false,
		// The source that produced `output`; sharing/preview only carry output
		// that still belongs to the editor's current text.
		output_source: "",
		get preview_href() {
			const output =
				this.output_source === this.source ? this.output.slice(0, MAX_SHARE_OUTPUT) : "";
			return preview_path(this.source, output);
		},
	});

	let worker: Worker | undefined;
	let timer: ReturnType<typeof setTimeout> | undefined;
	let highlight_timer: ReturnType<typeof setTimeout> | undefined;
	let highlight_seq = 0;

	/** Highlight the editor with Shiki (lazy-loaded: it is the biggest client
	 *  dependency, and only needed once the page is interactive). */
	async function highlight_now() {
		const seq = ++highlight_seq;
		try {
			const { codeToHtml } = await import("nomen-shiki");
			const html = await codeToHtml($state.source, {
				lang: "nomen",
				theme: "dark-plus",
			});
			if (seq !== highlight_seq) return;
			$state.highlighted = html;
			$state.highlight_ready = true;
			sync_highlight_scroll();
		} catch {
			// Fall back to the plain (opaque) textarea.
			$state.highlight_ready = false;
		}
	}

	function schedule_highlight(delay = 40) {
		if (highlight_timer) clearTimeout(highlight_timer);
		highlight_timer = setTimeout(() => {
			highlight_timer = undefined;
			void highlight_now();
		}, delay);
	}

	function on_input() {
		// Editing invalidates the displayed output: it belongs to the previous
		// source, and share/preview links deliberately omit stale output. Clear
		// it (and stop a run in flight) so the screen matches what would be
		// shared.
		if ($state.running || $state.output_source) {
			stop_worker();
			$state.running = false;
			$state.output = "";
			$state.runtime_error = "";
			$state.output_source = "";
		}
		schedule_highlight();
	}

	function sync_highlight_scroll() {
		const area = document.getElementById("editor-input") as HTMLTextAreaElement | null;
		const layer = document.getElementById("editor-highlight");
		if (!area || !layer) return;
		layer.scrollTop = area.scrollTop;
		layer.scrollLeft = area.scrollLeft;
	}

	function stop_worker() {
		if (timer) clearTimeout(timer);
		timer = undefined;
		worker?.terminate();
		worker = undefined;
	}

	function is_narrow() {
		return (
			typeof window !== "undefined" &&
			window.matchMedia("(max-width: 900px)").matches
		);
	}

	/** Compile and run. `show_output` is false for the mount-time auto-run so
	 *  a narrow screen still starts on the program. */
	function run(show_output = true) {
		if ($state.running) return;
		stop_worker();
		$state.running = true;
		$state.errors = [];
		$state.warnings = [];
		$state.runtime_error = "";
		$state.output = "";
		$state.output_source = "";

		void fetch("/api/compile", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify({ source: $state.source }),
		})
			.then((response) => response.json())
			.then((result) => {
				if (!result.ok) {
					// Diagnostics belong to the program: bring it back into
					// view on a narrow screen.
					$state.errors = result.errors ?? [
						{ message: "Compilation failed", line: 1, column: 1 },
					];
					$state.view = "program";
					return;
				}
				$state.warnings = result.warnings ?? [];
				$state.output_source = $state.source;
				execute(result.js);
				if (show_output && is_narrow()) $state.view = "output";
			})
			.catch((error) => {
				$state.errors = [
					{ message: String(error?.message ?? error), line: 1, column: 1 },
				];
				$state.view = "program";
			})
			.finally(() => {
				$state.running = false;
			});
	}

	/** Run the compiled program in a classic Worker. The script is
	 *  self-contained (no imports) and reports output through
	 *  `globalThis.__nomen_write`. */
	function execute(js: string) {
		const program = `
self.__nomen_write = (text) => self.postMessage({ type: "out", text: String(text) });
try {
${js}
} catch (error) {
	const message = String(error && error.message ? error.message : error);
	if (!message.startsWith("__nomen_exit:")) {
		self.postMessage({ type: "error", message });
	}
}
self.postMessage({ type: "done" });
`;
		const url = URL.createObjectURL(new Blob([program], { type: "text/javascript" }));
		worker = new Worker(url);

		timer = setTimeout(() => {
			stop_worker();
			$state.runtime_error = `Stopped after ${TIMEOUT_MS / 1000}s (infinite loop?)`;
			$state.view = "output";
		}, TIMEOUT_MS);

		worker.onmessage = (event: MessageEvent) => {
			const message = event.data;
			if (message?.type === "out") {
				$state.output += message.text;
			} else if (message?.type === "error") {
				$state.runtime_error = String(message.message);
				$state.view = "output";
			} else if (message?.type === "done") {
				stop_worker();
				URL.revokeObjectURL(url);
			}
		};
		worker.onerror = (event: ErrorEvent) => {
			$state.runtime_error = event.message || "The program crashed";
			$state.view = "output";
			stop_worker();
			URL.revokeObjectURL(url);
		};
	}

	/** Copy a self-contained share link: the program is the URL, and the
	 *  link's social card is rendered from the same bytes. */
	function share() {
		if (!$state.source.trim()) {
			$state.errors = [
				{ message: "Write a program before sharing it", line: 1, column: 1 },
			];
			return;
		}
		if ($state.source.length > MAX_SHARE_SOURCE) {
			$state.errors = [
				{
					message: `Program is too long to share (max ${MAX_SHARE_SOURCE} characters)`,
					line: 1,
					column: 1,
				},
			];
			return;
		}
		const output =
			$state.output_source === $state.source ? $state.output.slice(0, MAX_SHARE_OUTPUT) : "";
		const url = share_url(window.location.origin, $state.source, output);
		const done = () => {
			$state.shared = true;
			setTimeout(() => {
				$state.shared = false;
			}, 1500);
		};
		if (navigator.clipboard?.writeText) {
			void navigator.clipboard.writeText(url).then(done, () => window.prompt("Copy this link", url));
		} else {
			window.prompt("Copy this link", url);
		}
	}

	function on_key_down(event: KeyboardEvent) {
		const enter = event.key === "Enter" && (event.metaKey || event.ctrlKey);
		if (enter) {
			event.preventDefault();
			run();
			return;
		}
		if (event.key === "Tab") {
			// Keep focus in the editor: indentation (Nomen uses tabs). The
			// insert/delete commands update the value and the caret while
			// staying on the undo stack, and fire `input` so `&value` syncs.
			event.preventDefault();
			const area = event.currentTarget as HTMLTextAreaElement;
			if (event.shiftKey) {
				const before = area.value.slice(0, area.selectionStart);
				if (before.endsWith("\t")) {
					area.selectionStart = area.selectionEnd = area.selectionStart - 1;
					document.execCommand("delete");
				}
			} else {
				document.execCommand("insertText", false, "\t");
			}
		}
	}

	@render {
		<main
			id="repl"
			class={$props?.embed ? "embed" : ""}
			onmount={() => {
				run(false);
				schedule_highlight(0);
			}}
		>
			<header id="repl-header">
				<h1>Nomen <span>Playground</span></h1>
				<p>
					Write a Nomen program and run it. The System library is
					imported automatically. Show output with <code>Console.write_line</code>.
				</p>
			</header>

			<div id="repl-columns" class={$state.view}>
				<section id="repl-input">
					<div class="pane-title">
						<h2>Program</h2>
						<div class="pane-actions">
							<a class="ghost" href={$state.preview_href} target="_blank" rel="noopener">
								Preview share
							</a>
							<button class="ghost" onclick={share}>
								{$state.shared ? "Copied" : "Share"}
							</button>
							<button onclick={() => run()} disabled={$state.running}>
								{$state.running ? "Running…" : "Run ⌘⏎"}
							</button>
						</div>
					</div>
					<div
						id="editor"
						class={$state.highlight_ready ? "ready" : ""}
					>
						<div id="editor-highlight" aria-hidden="true">
							@html($state.highlighted)
						</div>
						<textarea
							id="editor-input"
							wrap="off"
							spellcheck="false"
							autocomplete="off"
							autocapitalize="off"
							&value={$state.source}
							oninput={on_input}
							onscroll={sync_highlight_scroll}
							onkeydown={on_key_down}
						/>
					</div>

					@if ($state.errors.length) {
					<div class="errors">
						<h3>Errors</h3>
						<ul>
							@for (let error of $state.errors) {
								<li>
									<span class="position">
										{error.line}:{error.column}
									</span>
									{error.message}
								</li>
							}
						</ul>
					</div>
					}

					@if ($state.warnings.length) {
					<div class="warnings">
						<h3>Warnings</h3>
						<ul>
							@for (let warning of $state.warnings) {
								<li>
									<span class="position">
										{warning.line}:{warning.column}
									</span>
									{warning.message}
								</li>
							}
						</ul>
					</div>
					}
				</section>

				<section id="repl-output">
					<div class="pane-title">
						<h2>Output</h2>
						<button
							class="back-button"
							onclick={() => {
								$state.view = "program";
							}}
						>
							← Program
						</button>
					</div>
					<pre class="output">{$state.output}</pre>

					@if ($state.runtime_error) {
						<div class="errors">
							<h3>Runtime error</h3>
							<ul>
								<li>{$state.runtime_error}</li>
							</ul>
						</div>
					}

				</section>
			</div>
		</main>
	}
}
