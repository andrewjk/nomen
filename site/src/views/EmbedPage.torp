import PlaygroundPage from "./PlaygroundPage.torp";

/**
 * The compact playground served as an X/Twitter player card
 * (`twitter:player`). It is the same component in embed mode: no page header,
 * inner scrolling, and a side-by-side program/output at the card's 640px width.
 */
export default function EmbedPage() {
	@render {
		<PlaygroundPage embed={true} />
	}
}
